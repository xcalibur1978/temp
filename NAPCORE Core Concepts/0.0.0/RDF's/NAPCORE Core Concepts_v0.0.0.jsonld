  },
  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775026821724",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027256396"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Qualquer pessoa coletiva, pública ou privada, como autoridades de transportes, operadores de transportes, gestores de infraestruturas ou prestadores de serviços de transporte a pedido, que tenha o direito de conceder acesso aos dados sob o seu controlo ou de os partilhar."
      },
      {
        "@language": "lv",
        "@value": "Jebkura juridiska persona, publiska vai privāta, piemēram, transporta iestādes, transporta operatori, infrastruktūras pārvaldītāji vai transporta pakalpojumu pēc pieprasījuma sniedzēji, kam ir tiesības piešķirt piekļuvi tās kontrolē esošajiem datiem vai dalīties ar tiem."
      },
      {
        "@language": "mt",
        "@value": "Kwalunkwe persuna ġuridika, pubblika jew privata, bħal awtoritajiet tat-trasport, operaturi tat-trasport, maniġers tal-infrastruttura jew fornituri ta' servizzi tat-trasport fuq talba, li għandha d-dritt li tagħti aċċess għad-dejta taħt il-kontroll tagħha jew taqsamha."
      },
      {
        "@language": "nl",
        "@value": "Iedere rechtspersoon, publiek of privaat, zoals vervoersautoriteiten, vervoersexploitanten, infrastructuurbeheerders of aanbieders van vervoer op aanvraag, die het recht heeft toegang te verlenen tot of de onder zijn beheer staande gegevens te delen."
      },
      {
        "@language": "cs",
        "@value": "Jakákoli právnická osoba, veřejná nebo soukromá, jako jsou dopravní orgány, dopravní operátoři, správci infrastruktury nebo poskytovatelé dopravy na vyžádání, která má právo poskytnout přístup k údajům nebo sdílet údaje pod svou kontrolou."
      },
      {
        "@language": "da",
        "@value": "Enhver juridisk person, offentlig eller privat, som f.eks. transportmyndigheder, transportoperatører, infrastrukturforvaltere eller udbydere af transport efter behov, der har ret til at give adgang til eller dele de data under dens kontrol."
      },
      {
        "@language": "de",
        "@value": "Jede juristische Person, öffentlich oder privat, wie Verkehrsbehörden, Verkehrsunternehmen, Infrastrukturbetreiber oder Anbieter von Bedarfsverkehrsdiensten, die das Recht hat, den Zugang zu den ihrer Kontrolle unterliegenden Daten zu gewähren oder diese zu teilen."
      },
      {
        "@language": "el",
        "@value": "Κάθε νομικό πρόσωπο, δημόσιο ή ιδιωτικό, όπως αρχές μεταφορών, φορείς εκμετάλλευσης μεταφορών, διαχειριστές υποδομών ή πάροχοι μεταφορών κατ' απαίτηση, που έχει το δικαίωμα να παρέχει πρόσβαση ή να μοιράζεται τα δεδομένα υπό τον έλεγχό του."
      },
      {
        "@language": "en",
        "@value": "Any legal person, public or private entity, such as transport authorities, transport operators, infrastructure managers or transport on demand service providers, who has the right to grant access to or to share the data under its control."
      },
      {
        "@language": "es",
        "@value": "Cualquier persona jurídica, pública o privada, como autoridades de transporte, operadores de transporte, gestores de infraestructuras o proveedores de servicios de transporte a la demanda, que tenga el derecho de conceder acceso a los datos bajo su control o compartirlos."
      },
      {
        "@language": "et",
        "@value": "Mis tahes juriidiline isik, avalik või eraõiguslik, nagu transpordiasutused, transpordiettevõtjad, taristuhaldajad või nõudepõhise transporditeenuse osutajad, kellel on õigus anda juurdepääs oma kontrolli all olevatele andmetele või neid jagada."
      },
      {
        "@language": "fi",
        "@value": "Mikä tahansa oikeushenkilö, julkinen tai yksityinen, kuten liikenneviranomaiset, liikenteenharjoittajat, infrastruktuurin haltijat tai kutsujoukkoliikenteen palveluntarjoajat, jolla on oikeus myöntää pääsy hallussaan oleviin tietoihin tai jakaa niitä."
      },
      {
        "@language": "fr",
        "@value": "Toute personne morale, publique ou privée, telle que les autorités de transport, les opérateurs de transport, les gestionnaires d'infrastructures ou les prestataires de services de transport à la demande, qui a le droit d'accorder l'accès aux données sous son contrôle ou de les partager."
      },
      {
        "@language": "ga",
        "@value": "Aon duine dlítheanach, poiblí nó príobháideach, amhail údaráis iompair, oibreoirí iompair, bainisteoirí bonneagair nó soláthraithe seirbhísí iompair ar éileamh, a bhfuil an ceart aige rochtain ar na sonraí faoina smacht a dheonú nó iad a roinnt."
      },
      {
        "@language": "hr",
        "@value": "Svaka pravna osoba, javna ili privatna, poput prometnih tijela, prijevoznika, upravitelja infrastrukture ili pružatelja prijevoznih usluga na zahtjev, koja ima pravo odobriti pristup podacima pod svojom kontrolom ili ih dijeliti."
      },
      {
        "@language": "hu",
        "@value": "Bármely jogi személy, közjogi vagy magánjogi, mint például közlekedési hatóságok, közlekedési üzemeltetők, infrastruktúra-kezelők vagy igény szerinti szállítási szolgáltatók, akinek joga van hozzáférést biztosítani az ellenőrzése alatt álló adatokhoz vagy megosztani azokat."
      },
      {
        "@language": "it",
        "@value": "Qualsiasi persona giuridica, pubblica o privata, come autorità dei trasporti, operatori di trasporto, gestori di infrastrutture o fornitori di servizi di trasporto a richiesta, che ha il diritto di concedere l'accesso ai dati sotto il suo controllo o di condividerli."
      },
      {
        "@language": "lt",
        "@value": "Bet kuris juridinis asmuo, viešasis ar privatus, pvz., transporto institucijos, transporto operatoriai, infrastruktūros valdytojai ar transporto pagal pareikalavimą paslaugų teikėjai, turintis teisę suteikti prieigą prie jo kontroliuojamų duomenų arba juos dalytis."
      },
      {
        "@language": "pl",
        "@value": "Każda osoba prawna, publiczna lub prywatna, taka jak organy transportowe, operatorzy transportu, zarządcy infrastruktury lub dostawcy usług transportu na żądanie, która ma prawo udzielić dostępu do danych będących pod jej kontrolą lub je udostępnić."
      },
      {
        "@language": "sk",
        "@value": "Akákoľvek právnická osoba, verejná alebo súkromná, ako napríklad dopravné orgány, dopravní operátori, správcovia infraštruktúry alebo poskytovatelia služieb dopravy na požiadanie, ktorá má právo poskytnúť prístup k údajom pod jej kontrolou alebo ich zdieľať."
      },
      {
        "@language": "sl",
        "@value": "Vsaka pravna oseba, javna ali zasebna, kot so prometni organi, prevozniki, upravljavci infrastrukture ali ponudniki prevoznih storitev na zahtevo, ki ima pravico odobriti dostop do podatkov pod njenim nadzorom ali jih deliti."
      },
      {
        "@language": "sv",
        "@value": "Varje juridisk person, offentlig eller privat, som transportmyndigheter, transportoperatörer, infrastrukturförvaltare eller leverantörer av beställningstransporttjänster, som har rätt att bevilja åtkomst till eller dela de data som den förfogar över."
      },
      {
        "@language": "bg",
        "@value": "Всяко юридическо лице, публично или частно, като транспортни органи, транспортни оператори, управители на инфраструктура или доставчици на транспортни услуги при поискване, което има право да предостави достъп до или да споделя данните под негов контрол."
      },
      {
        "@language": "ro",
        "@value": "Orice persoană juridică, publică sau privată, cum ar fi autoritățile de transport, operatorii de transport, administratorii de infrastructură sau furnizorii de servicii de transport la cerere, care are dreptul de a acorda acces la datele aflate sub controlul său sau de a le partaja."
      }
    ],
