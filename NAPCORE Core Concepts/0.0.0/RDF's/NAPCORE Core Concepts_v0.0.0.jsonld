  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027311097",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "bg",
        "@value": "Структурирано описание на съдържанието на данните, улесняващо откриването и използването на данните."
      },
      {
        "@language": "cs",
        "@value": "Strukturovaný popis obsahu dat usnadňující jejich vyhledávání a používání."
      },
      {
        "@language": "da",
        "@value": "En struktureret beskrivelse af indholdet af data, der letter opdagelsen og brugen af dataene."
      },
      {
        "@language": "de",
        "@value": "Strukturierte Beschreibung der Dateninhalte, die das Auffinden und die Nutzung der Daten erleichtert."
      },
      {
        "@language": "el",
        "@value": "Δομημένη περιγραφή του περιεχομένου των δεδομένων που διευκολύνει την ανακάλυψη και τη χρήση των δεδομένων."
      },
      {
        "@language": "en",
        "@value": "Structured description of the contents of the data facilitating the discovery and use of the data."
      },
      {
        "@language": "es",
        "@value": "Descripción estructurada del contenido de los datos que facilita el descubrimiento y la utilización de los datos."
      },
      {
        "@language": "et",
        "@value": "Andmete sisu struktureeritud kirjeldus, mis hõlbustab andmete avastamist ja kasutamist."
      },
      {
        "@language": "fi",
        "@value": "Tietojen sisällön rakenteellinen kuvaus, joka helpottaa tietojen löytämistä ja käyttöä."
      },
      {
        "@language": "fr",
        "@value": "Description structurée du contenu des données facilitant la découverte et l'utilisation des données."
      },
      {
        "@language": "ga",
        "@value": "Tuairisc struchtúrtha ar ábhar na sonraí a éascaíonn aimsiú agus úsáid na sonraí."
      },
      {
        "@language": "hr",
        "@value": "Strukturirani opis sadržaja podataka koji olakšava otkrivanje i upotrebu podataka."
      },
      {
        "@language": "hu",
        "@value": "Az adatok tartalmának strukturált leírása, amely megkönnyíti az adatok felfedezését és felhasználását."
      },
      {
        "@language": "it",
        "@value": "Descrizione strutturata del contenuto dei dati che facilita la scoperta e l'uso dei dati."
      },
      {
        "@language": "lt",
        "@value": "Struktūruotas duomenų turinio aprašymas, palengvinantis duomenų atradimą ir naudojimą."
      },
      {
        "@language": "lv",
        "@value": "Datu satura strukturēts apraksts, kas atvieglo datu atrašanu un izmantošanu."
      },
      {
        "@language": "mt",
        "@value": "Deskrizzjoni strutturata tal-kontenut tad-dejta li tiffaċilita l-iskoperta u l-użu tad-dejta."
      },
      {
        "@language": "nl",
        "@value": "Gestructureerde beschrijving van de inhoud van de gegevens die het ontdekken en gebruiken van de gegevens vergemakkelijkt."
      },
      {
        "@language": "pl",
        "@value": "Ustrukturyzowany opis zawartości danych ułatwiający odkrywanie i wykorzystanie danych."
      },
      {
        "@language": "pt",
        "@value": "Descrição estruturada do conteúdo dos dados que facilita a descoberta e a utilização dos dados."
      },
      {
        "@language": "ro",
        "@value": "Descriere structurată a conținutului datelor care facilitează descoperirea și utilizarea datelor."
      },
      {
        "@language": "sk",
        "@value": "Štruktúrovaný opis obsahu údajov uľahčujúci vyhľadávanie a používanie údajov."
      },
      {
        "@language": "sl",
        "@value": "Strukturiran opis vsebine podatkov, ki olajša odkrivanje in uporabo podatkov."
      },
      {
        "@language": "sv",
        "@value": "Strukturerad beskrivning av datainnehållet som underlättar upptäckt och användning av data."
      }
    ],
