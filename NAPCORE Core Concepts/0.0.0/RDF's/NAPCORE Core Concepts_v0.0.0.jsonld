  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027354843",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "da",
        "@value": "En tjeneste, der muliggør søgning efter de anmodede data ved hjælp af indholdet af de tilsvarende metadata og visning af sådant indhold."
      },
      {
        "@language": "de",
        "@value": "Dienst, der die Suche nach den angeforderten Daten anhand des Inhalts der entsprechenden Metadaten ermöglicht und solche Inhalte anzeigt."
      },
      {
        "@language": "bg",
        "@value": "Услуга, позволяваща търсене на исканите данни чрез съдържанието на съответните метаданни и показваща такова съдържание."
      },
      {
        "@language": "cs",
        "@value": "Služba umožňující vyhledávání požadovaných dat pomocí obsahu odpovídajících metadat a zobrazení takového obsahu."
      },
      {
        "@language": "en",
        "@value": "Service allowing for the search of the requested data using the contents of the corresponding Metadata and displaying such contents."
      },
      {
        "@language": "es",
        "@value": "Servicio que permite la búsqueda de los datos solicitados utilizando el contenido de los metadatos correspondientes y mostrando dicho contenido."
      },
      {
        "@language": "et",
        "@value": "Teenus, mis võimaldab otsida soovitud andmeid vastavate metaandmete sisu alusel ja kuvada sellist sisu."
      },
      {
        "@language": "fi",
        "@value": "Palvelu, joka mahdollistaa pyydettyjen tietojen haun vastaavien metatietojen sisällön perusteella ja näyttää tällaisen sisällön."
      },
      {
        "@language": "fr",
        "@value": "Service permettant la recherche des données demandées à l'aide du contenu des métadonnées correspondantes et affichant un tel contenu."
      },
      {
        "@language": "ga",
        "@value": "Seirbhís a cheadaíonn cuardach na sonraí iarrtha ag úsáid ábhar na meiteashonraí comhfhreagracha agus a thaispeánann ábhar den sórt sin."
      },
      {
        "@language": "hr",
        "@value": "Usluga koja omogućuje pretraživanje traženih podataka koristeći sadržaj odgovarajućih metapodataka i prikazivanje takvog sadržaja."
      },
      {
        "@language": "hu",
        "@value": "Szolgáltatás, amely lehetővé teszi a kért adatok keresését a megfelelő metaadatok tartalma alapján, és megjeleníti az ilyen tartalmat."
      },
      {
        "@language": "it",
        "@value": "Servizio che consente la ricerca dei dati richiesti utilizzando il contenuto dei metadati corrispondenti e visualizzando tale contenuto."
      },
      {
        "@language": "lt",
        "@value": "Paslauga, leidžianti ieškoti prašomų duomenų naudojant atitinkamų metaduomenų turinį ir rodanti tokį turinį."
      },
      {
        "@language": "lv",
        "@value": "Pakalpojums, kas ļauj meklēt pieprasītos datus, izmantojot attiecīgo metadatu saturu, un parāda šādu saturu."
      },
      {
        "@language": "mt",
        "@value": "Servizz li jippermetti t-tfittxija tad-dejta mitluba billi juża l-kontenut tal-metadejta korrispondenti u juri tali kontenut."
      },
      {
        "@language": "nl",
        "@value": "Dienst die het mogelijk maakt de gevraagde gegevens te doorzoeken aan de hand van de inhoud van de bijbehorende metadata en dergelijke inhoud weer te geven."
      },
      {
        "@language": "pl",
        "@value": "Usługa umożliwiająca wyszukiwanie żądanych danych przy wykorzystaniu treści odpowiednich metadanych i wyświetlanie takich treści."
      },
      {
        "@language": "pt",
        "@value": "Serviço que permite a pesquisa dos dados solicitados utilizando o conteúdo dos metadados correspondentes e apresentando esse conteúdo."
      },
      {
        "@language": "ro",
        "@value": "Serviciu care permite căutarea datelor solicitate utilizând conținutul metadatelor corespunzătoare și afișarea unui astfel de conținut."
      },
      {
        "@language": "sk",
        "@value": "Služba umožňujúca vyhľadávanie požadovaných údajov pomocou obsahu zodpovedajúcich metaúdajov a zobrazenie takéhoto obsahu."
      },
      {
        "@language": "sl",
        "@value": "Storitev, ki omogoča iskanje zahtevanih podatkov z uporabo vsebine ustreznih metapodatkov in prikazuje takšno vsebino."
      },
      {
        "@language": "sv",
        "@value": "Tjänst som möjliggör sökning av de begärda uppgifterna med hjälp av innehållet i motsvarande metadata och visning av sådant innehåll."
      },
      {
        "@language": "el",
        "@value": "Υπηρεσία που επιτρέπει την αναζήτηση των ζητούμενων δεδομένων χρησιμοποιώντας το περιεχόμενο των αντίστοιχων μεταδεδομένων και εμφανίζοντας τέτοιο περιεχόμενο."
      }
    ],
