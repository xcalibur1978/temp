      },
      {
        "@language": "da",
        "@value": "Metadatakatalog"
      },
      {
        "@language": "de",
        "@value": "Metadatenverzeichnis"
      },
      {
        "@language": "el",
        "@value": "Κατάλογος μεταδεδομένων"
      },
      {
        "@language": "en",
        "@value": "Metadata Directory"
      },
      {
        "@language": "es",
        "@value": "Directorio de metadatos"
      },
      {
        "@language": "et",
        "@value": "Metaandmete kataloog"
      },
      {
        "@language": "fi",
        "@value": "Metatietohakemisto"
      },
      {
        "@language": "fr",
        "@value": "Répertoire de métadonnées"
      },
      {
        "@language": "ga",
        "@value": "Eolaire meiteashonraí"
      },
      {
        "@language": "hr",
        "@value": "Direktorij metapodataka"
      },
      {
        "@language": "hu",
        "@value": "Metaadat-jegyzék"
      },
      {
        "@language": "it",
        "@value": "Directory dei metadati"
      },
