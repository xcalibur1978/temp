  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775026769925",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027256396"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "da",
        "@value": "En enhed (organisation) ansvarlig for at gøre kataloget tilgængeligt. Denne organisation er den direkte kontakt for platformens brugere, der har spørgsmål eller problemer vedrørende platformen og dens system."
      },
      {
        "@language": "lt",
        "@value": "Subjektas (organizacija), atsakingas už Katalogo prieinamumą. Ši organizacija yra tiesioginis kontaktas platformos naudotojams, turintiems klausimų ar problemų dėl platformos ir jos sistemos."
      },
      {
        "@language": "de",
        "@value": "Eine Einheit (Organisation), die für die Bereitstellung des Katalogs verantwortlich ist. Diese Organisation ist der direkte Ansprechpartner für Plattformnutzer, die Fragen oder Probleme bezüglich der Plattform und ihres Systems haben."
      },
      {
        "@language": "en",
        "@value": "An entity (organisation) responsible for making the Catalogue available. This organisation is the direct contact for platform users, who have questions or issues about the platform and its system."
      },
      {
        "@language": "lv",
        "@value": "Vienība (organizācija), kas ir atbildīga par Kataloga pieejamību. Šī organizācija ir tiešais kontaktpunkts platformas lietotājiem, kuriem ir jautājumi vai problēmas saistībā ar platformu un tās sistēmu."
      },
      {
        "@language": "es",
        "@value": "Una entidad (organización) responsable de poner a disposición el Catálogo. Esta organización es el contacto directo para los usuarios de la plataforma que tienen preguntas o problemas sobre la plataforma y su sistema."
      },
      {
        "@language": "mt",
        "@value": "Entità (organizzazzjoni) responsabbli biex tagħmel il-Katalogu disponibbli. Din l-organizzazzjoni hija l-kuntatt dirett għall-utenti tal-pjattaforma li għandhom mistoqsijiet jew kwistjonijiet dwar il-pjattaforma u s-sistema tagħha."
      },
      {
        "@language": "el",
        "@value": "Μια οντότητα (οργανισμός) υπεύθυνη για τη διάθεση του Καταλόγου. Αυτός ο οργανισμός είναι η άμεση επαφή για τους χρήστες της πλατφόρμας που έχουν ερωτήσεις ή προβλήματα σχετικά με την πλατφόρμα και το σύστημά της."
      },
      {
        "@language": "nl",
        "@value": "Een entiteit (organisatie) die verantwoordelijk is voor het beschikbaar maken van de Catalogus. Deze organisatie is het directe aanspreekpunt voor platformgebruikers die vragen of problemen hebben over het platform en het bijbehorende systeem."
      },
      {
        "@language": "bg",
        "@value": "Субект (организация), отговорен за предоставянето на каталога. Тази организация е прекият контакт за потребителите на платформата, които имат въпроси или проблеми относно платформата и нейната система."
      },
      {
        "@language": "pl",
        "@value": "Podmiot (organizacja) odpowiedzialny za udostępnienie Katalogu. Ta organizacja jest bezpośrednim kontaktem dla użytkowników platformy, którzy mają pytania lub problemy dotyczące platformy i jej systemu."
      },
      {
        "@language": "cs",
        "@value": "Subjekt (organizace) odpovědný za zpřístupnění katalogu. Tato organizace je přímým kontaktem pro uživatele platformy, kteří mají dotazy nebo problémy týkající se platformy a jejího systému."
      },
      {
        "@language": "fi",
        "@value": "Taho (organisaatio), joka vastaa luettelon saataville saattamisesta. Tämä organisaatio on suora yhteyshenkilö alustan käyttäjille, joilla on kysymyksiä tai ongelmia alustaan ja sen järjestelmään liittyen."
      },
      {
        "@language": "fr",
        "@value": "Une entité (organisation) responsable de rendre le Catalogue disponible. Cette organisation est le contact direct pour les utilisateurs de la plateforme qui ont des questions ou des problèmes concernant la plateforme et son système."
      },
      {
        "@language": "ga",
        "@value": "Aonán (eagraíocht) atá freagrach as an gCatalóg a chur ar fáil. Is í an eagraíocht seo an teagmhálaí díreach d'úsáideoirí an ardáin a bhfuil ceisteanna nó saincheisteanna acu faoin ardán agus a chóras."
      },
      {
        "@language": "hr",
        "@value": "Subjekt (organizacija) odgovoran za dostupnost Kataloga. Ova organizacija je izravni kontakt za korisnike platforme koji imaju pitanja ili probleme vezane uz platformu i njezin sustav."
      },
      {
        "@language": "it",
        "@value": "Un'entità (organizzazione) responsabile della messa a disposizione del Catalogo. Questa organizzazione è il contatto diretto per gli utenti della piattaforma che hanno domande o problemi riguardo alla piattaforma e al suo sistema."
      },
      {
        "@language": "pt",
        "@value": "Uma entidade (organização) responsável por disponibilizar o Catálogo. Esta organização é o contacto direto para os utilizadores da plataforma que têm questões ou problemas sobre a plataforma e o seu sistema."
      },
      {
        "@language": "ro",
        "@value": "O entitate (organizație) responsabilă de punerea la dispoziție a Catalogului. Această organizație este contactul direct pentru utilizatorii platformei care au întrebări sau probleme privind platforma și sistemul acesteia."
      },
      {
        "@language": "sk",
        "@value": "Subjekt (organizácia) zodpovedný za sprístupnenie Katalógu. Táto organizácia je priamym kontaktom pre používateľov platformy, ktorí majú otázky alebo problémy týkajúce sa platformy a jej systému."
      },
      {
        "@language": "sl",
        "@value": "Subjekt (organizacija), odgovoren za zagotavljanje Kataloga. Ta organizacija je neposredni stik za uporabnike platforme, ki imajo vprašanja ali težave glede platforme in njenega sistema."
      },
      {
        "@language": "sv",
        "@value": "En enhet (organisation) som ansvarar för att göra katalogen tillgänglig. Denna organisation är den direkta kontakten för plattformens användare som har frågor eller problem angående plattformen och dess system."
      },
      {
        "@language": "et",
        "@value": "Üksus (organisatsioon), kes vastutab kataloogi kättesaadavaks tegemise eest. See organisatsioon on otsekontakt platvormi kasutajatele, kellel on küsimusi või probleeme platvormi ja selle süsteemiga."
      },
      {
        "@language": "hu",
        "@value": "Egy entitás (szervezet), amely felelős a Katalógus elérhetővé tételéért. Ez a szervezet a közvetlen kapcsolattartó a platform felhasználói számára, akiknek kérdéseik vagy problémáik vannak a platformmal és annak rendszerével kapcsolatban."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
