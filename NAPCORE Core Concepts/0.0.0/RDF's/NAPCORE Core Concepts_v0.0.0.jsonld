  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027237243",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027256396"
      },
      {
        "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027204203"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "bg",
        "@value": "Физическо или юридическо лице, което има право да получи достъп до данните, произведени и предоставени от притежателя на данните, при определени условия за достъп с цел употреба."
      },
      {
        "@language": "cs",
        "@value": "Fyzická nebo právnická osoba, která má právo přistupovat k údajům vytvořeným a zpřístupněným držitelem dat za stanovených podmínek přístupu k použití."
      },
      {
        "@language": "da",
        "@value": "En fysisk eller juridisk person, der har ret til at få adgang til de data, der er produceret og gjort tilgængelige af dataholder, under specificerede adgangsbetingelser til brug."
      },
      {
        "@language": "de",
        "@value": "Natürliche oder juristische Person, die das Recht hat, auf die vom Dateninhaber erzeugten und bereitgestellten Daten unter festgelegten Zugangsbedingungen zur Nutzung zuzugreifen."
      },
      {
        "@language": "en",
        "@value": "Natural or legal person that has the right to access the data produced and made available by the Data Holder under specified access conditions for use."
      },
      {
        "@language": "es",
        "@value": "Persona física o jurídica que tiene derecho a acceder a los datos producidos y puestos a disposición por el titular de los datos en condiciones de acceso especificadas para su uso."
      },
      {
        "@language": "et",
        "@value": "Füüsiline või juriidiline isik, kellel on õigus pääseda juurde andmevaldaja toodetud ja kättesaadavaks tehtud andmetele kindlaksmääratud juurdepääsutingimustel kasutamiseks."
      },
      {
        "@language": "fi",
        "@value": "Luonnollinen tai oikeushenkilö, jolla on oikeus saada pääsy tiedon haltijan tuottamiin ja saataville asettamiin tietoihin määriteltyjen käyttöehtojen mukaisesti."
      },
      {
        "@language": "fr",
        "@value": "Personne physique ou morale qui a le droit d'accéder aux données produites et mises à disposition par le détenteur des données sous des conditions d'accès spécifiées en vue de leur utilisation."
      },
      {
        "@language": "ga",
        "@value": "Duine nádúrtha nó dlítheanach a bhfuil an ceart aige rochtain a fháil ar na sonraí a tháirgtear agus a chuirtear ar fáil ag sealbhóir na sonraí faoi choinníollacha rochtana sonraithe lena n-úsáid."
      },
      {
        "@language": "hr",
        "@value": "Fizička ili pravna osoba koja ima pravo pristupiti podacima koje je proizveo i stavio na raspolaganje vlasnik podataka pod određenim uvjetima pristupa radi korištenja."
      },
      {
        "@language": "hu",
        "@value": "Természetes vagy jogi személy, aki jogosult hozzáférni az adattulajdonos által előállított és elérhetővé tett adatokhoz meghatározott hozzáférési feltételek mellett felhasználás céljából."
      },
      {
        "@language": "it",
        "@value": "Persona fisica o giuridica che ha il diritto di accedere ai dati prodotti e messi a disposizione dal titolare dei dati secondo condizioni di accesso specificate per l'utilizzo."
      },
      {
        "@language": "lt",
        "@value": "Fizinis ar juridinis asmuo, turintis teisę gauti prieigą prie duomenų turėtojo pagamintų ir pateiktų duomenų pagal nustatytas prieigos sąlygas naudojimui."
      },
      {
        "@language": "lv",
        "@value": "Fiziska vai juridiska persona, kurai ir tiesības piekļūt datu turētāja sagatavotajiem un pieejamajiem datiem saskaņā ar noteiktiem piekļuves nosacījumiem izmantošanai."
      },
      {
        "@language": "mt",
        "@value": "Persuna naturali jew ġuridika li għandha d-dritt li taċċessa d-dejta prodotta u disponibbli mid-detentur tad-dejta taħt kundizzjonijiet ta' aċċess speċifikati għall-użu."
      },
      {
        "@language": "nl",
        "@value": "Natuurlijke of rechtspersoon die het recht heeft om onder vastgestelde toegangsvoorwaarden toegang te krijgen tot de door de gegevenshouder geproduceerde en beschikbaar gestelde gegevens ten behoeve van gebruik."
      },
      {
        "@language": "pl",
        "@value": "Osoba fizyczna lub prawna, która ma prawo dostępu do danych wytworzonych i udostępnionych przez posiadacza danych na określonych warunkach dostępu w celu ich wykorzystania."
      },
      {
        "@language": "pt",
        "@value": "Pessoa singular ou coletiva que tem o direito de aceder aos dados produzidos e disponibilizados pelo titular dos dados em condições de acesso especificadas para utilização."
      },
      {
        "@language": "ro",
        "@value": "Persoană fizică sau juridică care are dreptul de a accesa datele produse și puse la dispoziție de deținătorul datelor în condiții de acces specificate în vederea utilizării."
      },
      {
        "@language": "sk",
        "@value": "Fyzická alebo právnická osoba, ktorá má právo na prístup k údajom vyrobeným a sprístupneným držiteľom údajov za stanovených podmienok prístupu na účely použitia."
      },
      {
        "@language": "sl",
        "@value": "Fizična ali pravna oseba, ki ima pravico dostopa do podatkov, ki jih je izdelal in dal na voljo imetnik podatkov, pod določenimi pogoji dostopa za uporabo."
      },
      {
        "@language": "sv",
        "@value": "Fysisk eller juridisk person som har rätt att få åtkomst till de data som produceras och görs tillgängliga av datainnehavaren under specificerade åtkomstvillkor för användning."
      },
      {
        "@language": "el",
        "@value": "Φυσικό ή νομικό πρόσωπο που έχει δικαίωμα πρόσβασης στα δεδομένα που παράγονται και διατίθενται από τον κάτοχο δεδομένων υπό καθορισμένες συνθήκες πρόσβασης για χρήση."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://napcore.ontologica.nl/schemes/napcore-core-concepts"
      }
