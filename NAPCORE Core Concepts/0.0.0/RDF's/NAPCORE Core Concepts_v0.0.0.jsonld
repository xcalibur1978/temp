      },
      {
        "@language": "ga",
        "@value": "Faighteoir sonraí"
      },
      {
        "@language": "hr",
        "@value": "Primatelj podataka"
      },
      {
        "@language": "hu",
        "@value": "Adatátvevő"
      },
      {
        "@language": "it",
