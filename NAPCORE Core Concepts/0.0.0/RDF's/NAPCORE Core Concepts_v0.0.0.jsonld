  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027057267",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027256396"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "bg",
        "@value": "Организация или субект, който достъпва, извлича или използва данни или информация, предоставени чрез Националната точка за достъп, с цел разработване на услуги, приложения или анализи."
      },
      {
        "@language": "cs",
        "@value": "Organizace nebo subjekt, který přistupuje k datům nebo informacím, získává je nebo je využívá prostřednictvím Národního přístupového bodu za účelem vývoje služeb, aplikací nebo analýz."
      },
      {
        "@language": "da",
        "@value": "En organisation eller enhed, der tilgår, henter eller bruger data eller information, der er gjort tilgængelig via det nationale adgangspunkt, med henblik på at udvikle tjenester, applikationer eller analyser."
      },
      {
        "@language": "de",
        "@value": "Organisation oder Einheit, die über den Nationalen Zugangspunkt bereitgestellte Daten oder Informationen abruft, bezieht oder nutzt, um Dienste, Anwendungen oder Analysen zu entwickeln."
      },
      {
        "@language": "en",
        "@value": "Organisation or entity that accesses, retrieves, or uses data or information made available through the National Access Point for the purpose of developing services, applications, or analyses."
      },
      {
        "@language": "es",
        "@value": "Organización o entidad que accede, recupera o utiliza datos o información puesta a disposición a través del Punto de Acceso Nacional con el fin de desarrollar servicios, aplicaciones o análisis."
      },
      {
        "@language": "et",
        "@value": "Organisatsioon või üksus, mis pääseb juurde, hangib või kasutab riikliku pääsupunkti kaudu kättesaadavaks tehtud andmeid või teavet teenuste, rakenduste või analüüside arendamiseks."
      },
      {
        "@language": "fi",
        "@value": "Organisaatio tai taho, joka käyttää, noutaa tai hyödyntää kansallisen yhteyspisteen kautta saataville asetettuja tietoja tai informaatiota palvelujen, sovellusten tai analyysien kehittämiseksi."
      },
      {
        "@language": "fr",
        "@value": "Organisation ou entité qui accède, récupère ou utilise des données ou informations mises à disposition via le Point d'Accès National dans le but de développer des services, des applications ou des analyses."
      },
      {
        "@language": "ga",
        "@value": "Eagraíocht nó aonán a rochtannaíonn, a aisghabháileann nó a úsáideann sonraí nó faisnéis a cuireadh ar fáil tríd an bPointe Rochtana Náisiúnta chun seirbhísí, feidhmchláir nó anailísí a fhorbairt."
      },
      {
        "@language": "hr",
        "@value": "Organizacija ili subjekt koji pristupa, preuzima ili koristi podatke ili informacije dostupne putem Nacionalne pristupne točke u svrhu razvoja usluga, aplikacija ili analiza."
      },
      {
        "@language": "hu",
        "@value": "Szervezet vagy entitás, amely hozzáfér a Nemzeti Hozzáférési Ponton keresztül elérhető adatokhoz vagy információkhoz, lekéri vagy felhasználja azokat szolgáltatások, alkalmazások vagy elemzések fejlesztése céljából."
      },
      {
        "@language": "it",
        "@value": "Organizzazione o entità che accede, recupera o utilizza dati o informazioni resi disponibili attraverso il Punto di Accesso Nazionale allo scopo di sviluppare servizi, applicazioni o analisi."
      },
      {
        "@language": "lt",
        "@value": "Organizacija ar subjektas, kuris prieina, gauna ar naudoja duomenis ar informaciją, prieinamą per Nacionalinį prieigos tašką, paslaugų, programų ar analizių kūrimo tikslais."
      },
      {
        "@language": "lv",
        "@value": "Organizācija vai vienība, kas piekļūst, iegūst vai izmanto datus vai informāciju, kas pieejama caur Nacionālo piekļuves punktu, lai izstrādātu pakalpojumus, lietotnes vai veiktu analīzi."
      },
      {
        "@language": "mt",
        "@value": "Organizzazzjoni jew entità li taċċessa, tirkupra jew tuża dejta jew informazzjoni disponibbli permezz tal-Punt ta' Aċċess Nazzjonali bl-għan li tiżviluppa servizzi, applikazzjonijiet jew analiżi."
      },
      {
        "@language": "nl",
        "@value": "Organisatie of entiteit die gegevens of informatie die via het Nationaal Toegangspunt beschikbaar zijn gesteld, raadpleegt, ophaalt of gebruikt ten behoeve van de ontwikkeling van diensten, toepassingen of analyses."
      },
      {
        "@language": "pl",
        "@value": "Organizacja lub podmiot, który uzyskuje dostęp, pobiera lub wykorzystuje dane lub informacje udostępnione za pośrednictwem Krajowego Punktu Dostępu w celu opracowania usług, aplikacji lub analiz."
      },
      {
        "@language": "pt",
        "@value": "Organização ou entidade que acede, obtém ou utiliza dados ou informações disponibilizados através do Ponto de Acesso Nacional para efeitos de desenvolvimento de serviços, aplicações ou análises."
      },
      {
        "@language": "ro",
        "@value": "Organizație sau entitate care accesează, obține sau utilizează date sau informații puse la dispoziție prin Punctul Național de Acces în scopul dezvoltării de servicii, aplicații sau analize."
      },
      {
        "@language": "sk",
        "@value": "Organizácia alebo subjekt, ktorý pristupuje, získava alebo používa údaje alebo informácie sprístupnené prostredníctvom Národného prístupového bodu na účely vývoja služieb, aplikácií alebo analýz."
      },
      {
        "@language": "sl",
        "@value": "Organizacija ali subjekt, ki dostopa do podatkov ali informacij, jih pridobiva ali uporablja prek Nacionalne dostopne točke za namen razvoja storitev, aplikacij ali analiz."
      },
      {
        "@language": "sv",
        "@value": "Organisation eller enhet som åtkommer, hämtar eller använder data eller information som görs tillgänglig via den nationella åtkomstpunkten i syfte att utveckla tjänster, applikationer eller analyser."
      },
      {
        "@language": "el",
        "@value": "Οργανισμός ή οντότητα που προσπελάζει, ανακτά ή χρησιμοποιεί δεδομένα ή πληροφορίες που διατίθενται μέσω του Εθνικού Σημείου Πρόσβασης για τον σκοπό ανάπτυξης υπηρεσιών, εφαρμογών ή αναλύσεων."
      }
    ],
