[
  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775027031933",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "lt",
        "@value": "Juridinis asmuo, teikiantis paslaugas už atlygį galutiniam naudotojui, įskaitant įkrovimo ar degalų papildymo paslaugų pardavimą."
      },
      {
        "@language": "lv",
        "@value": "Juridiska persona, kas sniedz pakalpojumus par atlīdzību galalietotājam, tostarp uzlādes vai degvielas uzpildes pakalpojumu pārdošanu."
      },
      {
        "@language": "mt",
        "@value": "Persuna ġuridika li tipprovdi servizzi bi ħlas lil-utent finali, inkluż il-bejgħ ta' servizzi ta' ċċarġjar jew riforniment."
      },
      {
        "@language": "bg",
        "@value": "Юридическо лице, което предоставя услуги срещу заплащане на краен потребител, включително продажбата на услуги за зареждане с електричество или зареждане с гориво."
      },
      {
        "@language": "cs",
        "@value": "Právnická osoba, která poskytuje služby za úplatu koncovému uživateli, včetně prodeje služeb dobíjení nebo tankování."
      },
      {
        "@language": "de",
        "@value": "Juristische Person, die einem Endnutzer Dienstleistungen gegen Vergütung erbringt, einschließlich des Verkaufs von Lade- oder Betankungsdienstleistungen."
      },
      {
        "@language": "en",
        "@value": "Legal person that provides services in return for remuneration to an End Users, including the selling of recharging or refuelling services."
      },
      {
        "@language": "es",
        "@value": "Persona jurídica que presta servicios a cambio de una remuneración a un usuario final, incluida la venta de servicios de recarga o repostaje."
      },
      {
        "@language": "et",
        "@value": "Juriidiline isik, mis osutab lõppkasutajale tasu eest teenuseid, sealhulgas laadimis- või tankimisteenuste müüki."
      },
      {
        "@language": "fi",
        "@value": "Oikeushenkilö, joka tarjoaa palveluja korvausta vastaan loppukäyttäjälle, mukaan lukien lataus- tai tankkauspalvelujen myynti."
      },
      {
        "@language": "fr",
        "@value": "Personne morale qui fournit des services contre rémunération à un utilisateur final, y compris la vente de services de recharge ou de ravitaillement."
      },
      {
        "@language": "ga",
        "@value": "Duine dlítheanach a sholáthraíonn seirbhísí ar luach saothair d'úsáideoir deiridh, lena n-áirítear díol seirbhísí athluchtaithe nó athbhreoslaithe."
      },
      {
        "@language": "hr",
        "@value": "Pravna osoba koja pruža usluge uz naknadu krajnjem korisniku, uključujući prodaju usluga punjenja ili goriva."
      },
      {
        "@language": "hu",
        "@value": "Olyan jogi személy, amely díjazás ellenében szolgáltatásokat nyújt végfelhasználónak, beleértve a töltési vagy tankolási szolgáltatások értékesítését."
      },
      {
        "@language": "it",
        "@value": "Persona giuridica che fornisce servizi a titolo oneroso a un utente finale, compresa la vendita di servizi di ricarica o rifornimento."
      },
      {
        "@language": "nl",
        "@value": "Rechtspersoon die tegen vergoeding diensten verleent aan een eindgebruiker, met inbegrip van de verkoop van oplaad- of tankdiensten."
      },
      {
        "@language": "pl",
        "@value": "Osoba prawna świadcząca usługi odpłatnie na rzecz użytkownika końcowego, w tym sprzedaż usług ładowania lub tankowania."
      },
      {
        "@language": "pt",
        "@value": "Pessoa coletiva que presta serviços a título oneroso a um utilizador final, incluindo a venda de serviços de carregamento ou abastecimento."
      },
      {
        "@language": "ro",
        "@value": "Persoană juridică care furnizează servicii contra cost unui utilizator final, inclusiv vânzarea de servicii de încărcare sau realimentare."
      },
      {
        "@language": "sk",
        "@value": "Právnická osoba, ktorá poskytuje služby za odplatu koncovému používateľovi, vrátane predaja služieb nabíjania alebo tankovania."
      },
      {
        "@language": "sl",
        "@value": "Pravna oseba, ki zagotavlja storitve proti plačilu končnemu uporabniku, vključno s prodajo storitev polnjenja ali oskrbe z gorivom."
      },
      {
        "@language": "sv",
        "@value": "Juridisk person som tillhandahåller tjänster mot ersättning till en slutanvändare, inklusive försäljning av laddnings- eller tankningstjänster."
      },
      {
        "@language": "el",
        "@value": "Νομικό πρόσωπο που παρέχει υπηρεσίες έναντι αμοιβής σε τελικό χρήστη, συμπεριλαμβανομένης της πώλησης υπηρεσιών επαναφόρτισης ή ανεφοδιασμού."
      },
      {
        "@language": "da",
        "@value": "En juridisk person, der leverer tjenester mod betaling til en slutbruger, herunder salg af opladnings- eller optankningsydelser."
      }
    ],
