      },
      {
        "@language": "el",
        "@value": "Καταναλωτής δεδομένων"
      },
      {
        "@language": "en",
        "@value": "Data Consumer"
      },
      {
        "@language": "es",
        "@value": "Consumidor de datos"
      },
      {
        "@language": "et",
        "@value": "Andmetarbija"
      },
      {
        "@language": "fi",
        "@value": "Tiedon käyttäjä"
      },
      {
        "@language": "fr",
        "@value": "Consommateur de données"
      },
      {
        "@language": "ga",
        "@value": "Tomhaltóir sonraí"
      },
      {
        "@language": "hr",
        "@value": "Korisnik podataka"
      },
      {
        "@language": "hu",
        "@value": "Adatfelhasználó"
      },
      {
        "@language": "it",
        "@value": "Consumatore di dati"
      },
      {
        "@language": "lt",
        "@value": "Duomenų vartotojas"
      },
      {
        "@language": "lv",
        "@value": "Datu patērētājs"
      },
      {
        "@language": "mt",
        "@value": "Konsumatur tad-data"
      },
      {
        "@language": "nl",
