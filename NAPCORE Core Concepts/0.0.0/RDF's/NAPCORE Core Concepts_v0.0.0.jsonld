  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775026896596",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sv",
        "@value": "Varje offentlig eller privat leverantör av minst en rese- och trafikinformationstjänst till dataanvändare och slutanvändare, med undantag för en enkel informationsomvandlare."
      },
      {
        "@language": "cs",
        "@value": "Jakýkoli veřejný nebo soukromý poskytovatel alespoň jedné služby cestovních a dopravních informací uživatelům dat a koncovým uživatelům, s výjimkou pouhého převodce informací."
      },
      {
        "@language": "da",
        "@value": "Enhver offentlig eller privat udbyder af mindst én rejse- og trafikinformationstjeneste til databrugere og slutbrugere, med undtagelse af en ren konverter af information."
      },
      {
        "@language": "de",
        "@value": "Jeder öffentliche oder private Anbieter mindestens einer Reise- und Verkehrsinformationsdiensts an Datennutzer und Endnutzer, mit Ausnahme eines bloßen Umwandlers von Informationen."
      },
      {
        "@language": "el",
        "@value": "Κάθε δημόσιος ή ιδιωτικός πάροχος τουλάχιστον μίας υπηρεσίας πληροφοριών ταξιδιού και κυκλοφορίας σε χρήστες δεδομένων και τελικούς χρήστες, εξαιρουμένου ενός απλού μετατροπέα πληροφοριών."
      },
      {
        "@language": "en",
        "@value": "Any public or private provider of at least one travel and traffic information, to Data Users and End Users, excluding a mere converter of information."
      },
      {
        "@language": "es",
        "@value": "Cualquier proveedor público o privado de al menos un servicio de información de viaje y tráfico a usuarios de datos y usuarios finales, excluyendo un mero convertidor de información."
      },
      {
        "@language": "et",
        "@value": "Mis tahes avalik või eraõiguslik vähemalt ühe reisi- ja liiklusinformatsiooniteenuse osutaja andmekasutajatele ja lõppkasutajatele, välja arvatud pelgalt informatsiooni teisendaja."
      },
      {
        "@language": "fi",
        "@value": "Mikä tahansa julkinen tai yksityinen vähintään yhden matka- ja liikennetietopalvelun tarjoaja tiedon käyttäjille ja loppukäyttäjille, lukuun ottamatta pelkkää tiedon muuntajaa."
      },
      {
        "@language": "fr",
        "@value": "Tout fournisseur public ou privé d'au moins un service d'information de voyage et de trafic aux utilisateurs de données et aux utilisateurs finaux, à l'exclusion d'un simple convertisseur d'informations."
      },
      {
        "@language": "ga",
        "@value": "Aon soláthraí poiblí nó príobháideach ar a laghad seirbhís amháin faisnéise taistil agus tráchta d'úsáideoirí sonraí agus d'úsáideoirí deiridh, gan tiontaire simplí faisnéise a áireamh."
      },
      {
        "@language": "hr",
        "@value": "Svaki javni ili privatni pružatelj barem jedne usluge putnih i prometnih informacija korisnicima podataka i krajnjim korisnicima, isključujući puki pretvarač informacija."
      },
      {
        "@language": "hu",
        "@value": "Bármely legalább egy utazási és forgalmi információs szolgáltatást nyújtó köz- vagy magánszolgáltató az adatfelhasználók és a végfelhasználók számára, kivéve az információ puszta átalakítóját."
      },
      {
        "@language": "it",
        "@value": "Qualsiasi fornitore pubblico o privato di almeno un servizio di informazione di viaggio e traffico agli utenti dei dati e agli utenti finali, escluso un mero convertitore di informazioni."
      },
      {
        "@language": "lt",
        "@value": "Bet kuris viešasis ar privatus bent vienos kelionių ir eismo informacijos paslaugų teikėjas duomenų naudotojams ir galutiniams naudotojams, išskyrus paprastą informacijos keitiklį."
      },
      {
        "@language": "lv",
        "@value": "Jebkurš publisks vai privāts vismaz viena ceļojumu un satiksmes informācijas pakalpojuma sniedzējs datu lietotājiem un galalietotājiem, izņemot vienkāršu informācijas pārveidotāju."
      },
      {
        "@language": "mt",
        "@value": "Kwalunkwe fornitur pubbliku jew privat ta' mill-inqas servizz wieħed ta' informazzjoni dwar l-ivvjaġġar u t-traffiku lill-utenti tad-dejta u l-utenti finali, esklużi konvertitur sempliċi ta' informazzjoni."
      },
      {
        "@language": "nl",
        "@value": "Iedere publieke of private aanbieder van ten minste één reis- en verkeersinformatiedienst aan gegevensgebruikers en eindgebruikers, met uitzondering van een louter omzetter van informatie."
      },
      {
        "@language": "pl",
        "@value": "Każdy publiczny lub prywatny dostawca co najmniej jednej usługi informacji podróżnej i drogowej dla użytkowników danych i użytkowników końcowych, z wyłączeniem samego konwertera informacji."
      },
      {
        "@language": "pt",
        "@value": "Qualquer prestador público ou privado de pelo menos um serviço de informação de viagem e de tráfego aos utilizadores de dados e aos utilizadores finais, excluindo um mero conversor de informação."
      },
      {
        "@language": "ro",
        "@value": "Orice furnizor public sau privat al cel puțin unui serviciu de informații de călătorie și de trafic către utilizatorii de date și utilizatorii finali, excluzând un simplu convertor de informații."
      },
      {
        "@language": "sk",
        "@value": "Akýkoľvek verejný alebo súkromný poskytovateľ aspoň jednej služby cestovných a dopravných informácií používateľom údajov a koncovým používateľom, s výnimkou jednoduchého prevodníka informácií."
      },
      {
        "@language": "sl",
        "@value": "Vsak javni ali zasebni ponudnik vsaj ene storitve potovalnih in prometnih informacij uporabnikom podatkov in končnim uporabnikom, razen zgolj pretvornika informacij."
      },
      {
        "@language": "bg",
        "@value": "Всеки публичен или частен доставчик на поне една услуга за пътна и транспортна информация за потребители на данни и крайни потребители, с изключение на простото преобразуване на информация."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://napcore.ontologica.nl/schemes/napcore-core-concepts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "bg",
        "@value": "Доставчик на услуги за пътна информация"
      },
      {
        "@language": "cs",
        "@value": "Poskytovatel cestovních informačních služeb"
      },
      {
        "@language": "da",
        "@value": "Udbyder af rejseinformationstjenester"
      },
      {
        "@language": "de",
        "@value": "Anbieter von Reiseinformationsdiensten"
      },
      {
        "@language": "el",
        "@value": "Πάροχος υπηρεσιών ταξιδιωτικών πληροφοριών"
      },
      {
        "@language": "en",
        "@value": "Travel Information Service Provider"
      },
      {
        "@language": "es",
        "@value": "Proveedor de servicios de información sobre viajes"
      },
      {
        "@language": "et",
        "@value": "Reisiinfo teenusepakkuja"
      },
      {
        "@language": "fi",
        "@value": "Matkustustietopalvelun tarjoaja"
      },
      {
        "@language": "fr",
        "@value": "Fournisseur de services d'information sur les déplacements"
      },
      {
        "@language": "ga",
        "@value": "Soláthraí seirbhíse faisnéise taistil"
      },
      {
        "@language": "hr",
        "@value": "Pružatelj usluga putnih informacija"
      },
      {
        "@language": "hu",
        "@value": "Utazási információs szolgáltató"
      },
      {
        "@language": "it",
        "@value": "Fornitore di servizi di informazione sui viaggi"
      },
      {
        "@language": "lt",
        "@value": "Kelionių informacijos paslaugų teikėjas"
      },
      {
        "@language": "lv",
        "@value": "Ceļojumu informācijas pakalpojumu sniedzējs"
      },
      {
        "@language": "nl",
        "@value": "Aanbieder van reisinformatiediensten"
      },
      {
        "@language": "pl",
        "@value": "Dostawca usług informacji podróżnych"
      },
      {
        "@language": "pt",
        "@value": "Prestador de serviços de informação sobre viagens"
      },
      {
        "@language": "ro",
        "@value": "Furnizor de servicii de informații privind călătoriile"
      },
      {
        "@language": "sl",
        "@value": "Ponudnik potovalnih informacijskih storitev"
      },
      {
        "@language": "sv",
        "@value": "Leverantör av reseinformationstjänster"
      },
      {
        "@language": "mt",
        "@value": "Fornitur tas-servizz ta' informazzjoni dwar l-ivvjaġġar"
      },
      {
        "@language": "sk",
        "@value": "Poskytovateľ cestovných informačných služieb"
      }
    ]
  },
  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775026675566",
