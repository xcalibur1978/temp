  {
    "@id": "https://napcore.ontologica.nl/schemes/napcore-core-concepts",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-05-18T08:34:47.245288+00:00"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "bg",
        "@value": "Основна терминология на референтната архитектура на NAPCORE за националните точки за достъп, обхващаща видове НТД, роли в екосистемата и ключови концепции за услуги в мобилността."
      },
      {
        "@language": "cs",
        "@value": "Základní terminologie referenční architektury NAPCORE pro národní přístupové body, zahrnující typy NAP, role v ekosystému a klíčové pojmy služeb mobility."
      },
      {
        "@language": "da",
        "@value": "Kerneterminologi for NAPCORE-referencearkitekturen for nationale adgangspunkter, der dækker NAP-typer, økosystemroller og centrale begreber for mobilitetstjenester."
      },
      {
        "@language": "de",
        "@value": "Kernterminologie der NAPCORE-Referenzarchitektur für Nationale Zugangspunkte, einschließlich NAP-Typen, Rollen im Ökosystem und zentrale Konzepte für Mobilitätsdienste."
      },
      {
        "@language": "el",
        "@value": "Βασική ορολογία της αρχιτεκτονικής αναφοράς NAPCORE για εθνικά σημεία πρόσβασης, καλύπτοντας τύπους ΕΣΠ, ρόλους στο οικοσύστημα και βασικές έννοιες υπηρεσιών κινητικότητας."
      },
      {
        "@language": "en",
        "@value": "Core terminology of the NAPCORE reference architecture for National Access Points, covering NAP types, ecosystem roles and key mobility service concepts."
      },
      {
        "@language": "es",
        "@value": "Terminología fundamental de la arquitectura de referencia NAPCORE para Puntos de Acceso Nacionales, que cubre tipos de PAN, roles del ecosistema y conceptos clave de servicios de movilidad."
      },
      {
        "@language": "et",
        "@value": "NAPCORE riiklike juurdepääsupunktide võrdlusarhitektuuri põhiterminoloogia, mis hõlmab NAP-tüüpe, ökosüsteemi rolle ja peamisi liikuvusteenuste mõisteid."
      },
      {
        "@language": "fi",
        "@value": "NAPCORE-viitearkkitehtuurin ydinterminologia kansallisille yhteyspisteille, kattaen NAP-tyypit, ekosysteemiroolit ja keskeiset liikkuvuuspalvelujen käsitteet."
      },
      {
        "@language": "fr",
        "@value": "Terminologie fondamentale de l'architecture de référence NAPCORE pour les Points d'Accès Nationaux, couvrant les types de PAN, les rôles de l'écosystème et les concepts clés des services de mobilité."
      },
      {
        "@language": "ga",
        "@value": "Croíthéarmaíocht ailtireacht thagartha NAPCORE le haghaidh Pointí Rochtana Náisiúnta, lena gcumhdaítear cineálacha NAP, róil éiceachórais agus príomhchoincheapa seirbhísí soghluaisteachta."
      },
      {
        "@language": "hr",
        "@value": "Temeljna terminologija referentne arhitekture NAPCORE za nacionalne pristupne točke, obuhvaća tipove NPT, uloge ekosustava i ključne pojmove usluga mobilnosti."
      },
      {
        "@language": "hu",
        "@value": "A NAPCORE referenciaarchitektúrájának alapterminológiája a nemzeti hozzáférési pontokhoz, amely lefedi a NAP-típusokat, ökoszisztéma-szerepeket és a mobilitási szolgáltatások kulcsfogalmait."
      },
      {
        "@language": "it",
        "@value": "Terminologia fondamentale dell'architettura di riferimento NAPCORE per i Punti di Accesso Nazionali, che copre tipi di PAN, ruoli dell'ecosistema e concetti chiave dei servizi di mobilità."
      },
      {
        "@language": "lt",
        "@value": "Pagrindinė NAPCORE atskaitos architektūros terminologija nacionaliniams prieigos taškams, apimanti NPT tipus, ekosistemos vaidmenis ir pagrindines judumo paslaugų sąvokas."
      },
      {
        "@language": "lv",
        "@value": "NAPCORE atsauces arhitektūras pamatterminoloģija valsts piekļuves punktiem, kas aptver VPP veidus, ekosistēmas lomas un galvenos mobilitātes pakalpojumu jēdzienus."
      },
      {
        "@language": "mt",
        "@value": "Terminoloġija ewlenija tal-arkitettura ta' referenza NAPCORE għall-Punti ta' Aċċess Nazzjonali, li tkopri tipi ta' NAP, rwoli tal-ekosistema u kunċetti ewlenin tas-servizzi tal-mobilità."
      },
      {
        "@language": "nl",
        "@value": "Kernterminologie van de NAPCORE-referentiearchitectuur voor Nationale Toegangspunten, met NAP-types, ecosysteemrollen en centrale concepten voor mobiliteitsdiensten."
      },
      {
        "@language": "pl",
        "@value": "Podstawowa terminologia architektury referencyjnej NAPCORE dla krajowych punktów dostępowych, obejmująca typy KPD, role ekosystemu i kluczowe pojęcia usług mobilności."
      },
      {
        "@language": "pt",
        "@value": "Terminologia fundamental da arquitetura de referência NAPCORE para Pontos de Acesso Nacionais, abrangendo tipos de PAN, papéis do ecossistema e conceitos-chave de serviços de mobilidade."
      },
      {
        "@language": "ro",
        "@value": "Terminologia fundamentală a arhitecturii de referință NAPCORE pentru punctele de acces naționale, acoperind tipuri de PAN, roluri în ecosistem și concepte cheie ale serviciilor de mobilitate."
      },
      {
        "@language": "sk",
        "@value": "Základná terminológia referenčnej architektúry NAPCORE pre národné prístupové body, zahŕňajúca typy NAP, role v ekosystéme a kľúčové pojmy služieb mobility."
      },
      {
        "@language": "sl",
        "@value": "Temeljna terminologija referenčne arhitekture NAPCORE za nacionalne dostopne točke, ki zajema vrste NDT, vloge ekosistema in ključne pojme storitev mobilnosti."
      },
      {
        "@language": "sv",
        "@value": "Kärnterminologi för NAPCORE-referensarkitekturen för nationella åtkomstpunkter, inklusive NAP-typer, ekosystemroller och centrala begrepp för mobilitetstjänster."
      }
    ],
