      }
    ]
  },
  {
    "@id": "https://github.com/NAPCORE/NAP-Reference-Architecture/concept-1775026978939",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Cualquier proveedor público o privado de un servicio de información de tráfico en tiempo real, excluyendo un mero transmisor de datos a usuarios de datos."
      },
      {
        "@language": "et",
        "@value": "Mis tahes avalik või eraõiguslik reaalajas liiklusinformatsiooniteenuse osutaja, välja arvatud pelgalt andmete edastaja andmekasutajatele."
      },
      {
        "@language": "fi",
        "@value": "Mikä tahansa julkinen tai yksityinen reaaliaikaisen liikennetietopalvelun tarjoaja, lukuun ottamatta pelkkää tiedon välittäjää tiedon käyttäjille."
      },
      {
        "@language": "en",
        "@value": "Any public or private provider of a real-time traffic information service, excluding a mere conveyer of data to data users."
      },
      {
        "@language": "cs",
        "@value": "Jakýkoli veřejný nebo soukromý poskytovatel služby dopravních informací v reálném čase, s výjimkou pouhého předávání dat uživatelům dat."
      },
      {
        "@language": "da",
        "@value": "Enhver offentlig eller privat udbyder af en trafikinformationstjeneste i realtid, med undtagelse af en ren formidler af data til databrugere."
      },
      {
        "@language": "de",
        "@value": "Jeder öffentliche oder private Anbieter eines Echtzeit-Verkehrsinformationsdienstes, mit Ausnahme eines bloßen Übermittlers von Daten an Datennutzer."
      },
      {
        "@language": "el",
        "@value": "Κάθε δημόσιος ή ιδιωτικός πάροχος υπηρεσίας πληροφοριών κυκλοφορίας σε πραγματικό χρόνο, εξαιρουμένου ενός απλού μεταφορέα δεδομένων σε χρήστες δεδομένων."
      },
      {
        "@language": "fr",
        "@value": "Tout fournisseur public ou privé d'un service d'information routière en temps réel, à l'exclusion d'un simple transmetteur de données aux utilisateurs de données."
      },
      {
        "@language": "ga",
        "@value": "Aon soláthraí poiblí nó príobháideach seirbhíse faisnéise tráchta i bhfíor-am, gan iompróir simplí sonraí d'úsáideoirí sonraí a áireamh."
      },
      {
        "@language": "hr",
        "@value": "Svaki javni ili privatni pružatelj usluge prometnih informacija u stvarnom vremenu, isključujući puki prenositelj podataka korisnicima podataka."
      },
      {
        "@language": "hu",
        "@value": "Bármely valós idejű forgalmi információs szolgáltatást nyújtó köz- vagy magánszolgáltató, kivéve az adatok puszta továbbítóját az adatfelhasználók számára."
      },
      {
        "@language": "it",
        "@value": "Qualsiasi fornitore pubblico o privato di un servizio di informazione sul traffico in tempo reale, escluso un mero trasmettitore di dati agli utenti dei dati."
      },
      {
        "@language": "lt",
        "@value": "Bet kuris viešasis ar privatus realaus laiko eismo informacijos paslaugos teikėjas, išskyrus paprastą duomenų perdavėją duomenų naudotojams."
      },
      {
        "@language": "lv",
        "@value": "Jebkurš publisks vai privāts reāllaika satiksmes informācijas pakalpojuma sniedzējs, izņemot vienkāršu datu pārsūtītāju datu lietotājiem."
      },
      {
        "@language": "mt",
        "@value": "Kwalunkwe fornitur pubbliku jew privat ta' servizz ta' informazzjoni dwar it-traffiku f'ħin reali, esklużi trasmettitur sempliċi ta' dejta lill-utenti tad-dejta."
      },
      {
        "@language": "nl",
        "@value": "Iedere publieke of private aanbieder van een real-time verkeersinformatiedienst, met uitzondering van een louter doorgeefluik van gegevens aan gegevensgebruikers."
      },
      {
        "@language": "pl",
        "@value": "Każdy publiczny lub prywatny dostawca usługi informacji o ruchu drogowym w czasie rzeczywistym, z wyłączeniem samego przekaźnika danych dla użytkowników danych."
      },
      {
        "@language": "pt",
        "@value": "Qualquer prestador público ou privado de um serviço de informação de tráfego em tempo real, excluindo um mero transmissor de dados aos utilizadores de dados."
      },
      {
        "@language": "ro",
        "@value": "Orice furnizor public sau privat al unui serviciu de informații de trafic în timp real, excluzând un simplu transmițător de date către utilizatorii de date."
      },
      {
        "@language": "sk",
        "@value": "Akýkoľvek verejný alebo súkromný poskytovateľ služby dopravných informácií v reálnom čase, s výnimkou jednoduchého prenášača údajov používateľom údajov."
      },
      {
        "@language": "sl",
        "@value": "Vsak javni ali zasebni ponudnik storitve prometnih informacij v realnem času, razen zgolj posrednika podatkov uporabnikom podatkov."
      },
      {
        "@language": "sv",
        "@value": "Varje offentlig eller privat leverantör av en trafikinformationstjänst i realtid, med undantag för en enkel vidarebefordrare av data till dataanvändare."
      },
      {
        "@language": "bg",
        "@value": "Всеки публичен или частен доставчик на услуга за пътна информация в реално време, с изключение на простото предаване на данни на потребители на данни."
      }
    ],
