    <skos:altLabel xml:lang="el">Εθνικός φορέας</skos:altLabel>
    <skos:altLabel xml:lang="en">National Body</skos:altLabel>
    <skos:altLabel xml:lang="es">Organismo nacional</skos:altLabel>
    <skos:altLabel xml:lang="et">Riiklik asutus</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kansallinen elin</skos:altLabel>
