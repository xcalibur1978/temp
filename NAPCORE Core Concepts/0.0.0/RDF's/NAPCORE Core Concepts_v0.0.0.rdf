    <skos:prefLabel xml:lang="ga">Ardán sonraí</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Platforma podataka</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatplatform</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Piattaforma dati</skos:prefLabel>
