<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0067">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Train departures information</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Informace o odjezdech vlaků</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Information om tågavgångar</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Πληροφορίες για τις αναχωρήσεις τρένων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Información sobre las salidas de trenes</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Informations sur les départs des trains</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A vonatindulásokra vonatkozó információk</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Informazioni sulle partenze dei treni</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Informatie over treinvertrekken</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Informacje o odjazdach pociągów</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Informações sobre as partidas dos comboios</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Informații privind plecările trenurilor</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Informationen über Zugabfahrten</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Информация за заминаванията на влаковете</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Oplysninger om togafgange</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Teave rongide väljumiste kohta</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tiedot junien lähdöistä</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Faisnéis faoi imeachtaí na dtraenacha</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Informacije o polascima vlakova</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Informacija apie traukinių išvykimą</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Informazzjoni dwar it-tluq tal-ferroviji</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Informácie o odchodoch vlakov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Informacije o odhodih vlakov</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Informācija par vilcienu atiešanu</skos:prefLabel>
    <skos:definition xml:lang="en">Data on train departures for display at stations.</skos:definition>
    <skos:definition xml:lang="cs">Údaje o odjezdech vlaků k zobrazení na stanicích.</skos:definition>
    <skos:definition xml:lang="de">Daten über Zugabfahrten zur Anzeige in Bahnhöfen.</skos:definition>
    <skos:definition xml:lang="el">Δεδομένα σχετικά με τις αναχωρήσεις τρένων προς εμφάνιση στους σταθμούς.</skos:definition>
    <skos:definition xml:lang="es">Datos sobre las salidas de trenes para su visualización en las estaciones.</skos:definition>
    <skos:definition xml:lang="fr">Données sur les départs des trains destinées à l'affichage dans les gares.</skos:definition>
    <skos:definition xml:lang="hu">A vonatindulásokra vonatkozó, az állomásokon való megjelenítésre szánt adatok.</skos:definition>
    <skos:definition xml:lang="it">Dati sulle partenze dei treni per la visualizzazione nelle stazioni.</skos:definition>
    <skos:definition xml:lang="nl">Gegevens over treinvertrekken voor weergave op stations.</skos:definition>
    <skos:definition xml:lang="pl">Dane o odjazdach pociągów do wyświetlania na stacjach.</skos:definition>
    <skos:definition xml:lang="pt">Dados sobre as partidas dos comboios para apresentação nas estações.</skos:definition>
    <skos:definition xml:lang="ro">Date privind plecările trenurilor pentru afișarea în stații.</skos:definition>
    <skos:definition xml:lang="sv">Uppgifter om tågavgångar för visning på stationer.</skos:definition>
    <skos:definition xml:lang="bg">Данни за заминаванията на влаковете за визуализиране на гарите.</skos:definition>
    <skos:definition xml:lang="da">Data om togafgange til visning på stationer.</skos:definition>
    <skos:definition xml:lang="et">Andmed rongide väljumiste kohta jaamades kuvamiseks.</skos:definition>
    <skos:definition xml:lang="fi">Junien lähtöjä koskevat tiedot asemilla näytettäviksi.</skos:definition>
    <skos:definition xml:lang="hr">Podaci o polascima vlakova za prikaz na kolodvorima.</skos:definition>
    <skos:definition xml:lang="lt">Duomenys apie traukinių išvykimą, skirti rodyti stotyse.</skos:definition>
    <skos:definition xml:lang="lv">Dati par vilcienu atiešanu rādīšanai stacijās.</skos:definition>
    <skos:definition xml:lang="mt">Data dwar it-tluq tal-ferroviji għall-wiri fl-istazzjonijiet.</skos:definition>
    <skos:definition xml:lang="sk">Údaje o odchodoch vlakov na zobrazenie na staniciach.</skos:definition>
    <skos:definition xml:lang="sl">Podatki o odhodih vlakov za prikaz na postajah.</skos:definition>
    <skos:definition xml:lang="ga">Sonraí faoi imeachtaí na dtraenacha lena dtaispeáint ag stáisiúin.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_18</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0094">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">ERA Ontology</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Ontologie agentury ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="de">ERA-Ontologie</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Οντολογία του ΟΣΕΕ</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Ontología de la ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Ontologie de l'ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">ERA-ontológia</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Ontologia dell'ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">ERA-ontologie</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Ontologia ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Ontologia da AFE</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Ontologia AUE</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Eras ontologi</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Онтология на ЖПА</skos:prefLabel>
    <skos:prefLabel xml:lang="da">ERA-ontologi</skos:prefLabel>
    <skos:prefLabel xml:lang="et">ERA ontoloogia</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ERAn ontologia</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Onteolaíocht ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Ontologija ERA-e</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">ERA ontologija</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">ERA ontoloģija</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Ontoloġija tal-ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Ontológia agentúry ERA</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Ontologija agencije ERA</skos:prefLabel>
    <skos:definition xml:lang="pl">Dokument techniczny wydany przez Agencję na podstawie art. 4 ust. 8 dyrektywy (UE) 2016/797, określający czytelne dla człowieka i nadające się do odczytu maszynowego definicje i prezentacje danych oraz powiązane wymogi dotyczące jakości i dokładności elementów danych systemu kolejowego Unii.</skos:definition>
    <skos:definition xml:lang="pt">Documento técnico publicado pela Agência nos termos do artigo 4.º, n.º 8, da Diretiva (UE) 2016/797, que estabelece definições e apresentações de dados legíveis por seres humanos e por máquina, bem como os requisitos de qualidade e precisão associados, para os elementos de dados do sistema ferroviário da União.</skos:definition>
    <skos:definition xml:lang="ro">Document tehnic publicat de agenție în temeiul articolului 4 alineatul (8) din Directiva (UE) 2016/797, care stabilește definiții și prezentări ale datelor lizibile de către om și automat, precum și cerințele de calitate și precizie asociate pentru elementele de date ale sistemului feroviar al Uniunii.</skos:definition>
    <skos:definition xml:lang="sv">Ett tekniskt dokument som utfärdas av byrån i enlighet med artikel 4.8 i direktiv (EU) 2016/797 och som fastställer människo- och maskinläsbara datadefinitioner och datapresentationer samt tillhörande kvalitets- och noggrannhetskrav för dataelement i unionens järnvägssystem.</skos:definition>
    <skos:definition xml:lang="cs">Technický dokument vydaný agenturou podle čl. 4 odst. 8 směrnice (EU) 2016/797, který stanoví člověkem a strojem čitelné definice a prezentace údajů a související požadavky na kvalitu a přesnost datových prvků železničního systému Unie.</skos:definition>
    <skos:definition xml:lang="el">Τεχνικό έγγραφο που εκδίδεται από τον Οργανισμό σύμφωνα με το άρθρο 4 παράγραφος 8 της οδηγίας (ΕΕ) 2016/797, το οποίο καθορίζει αναγνώσιμους από τον άνθρωπο και από μηχανές ορισμούς και παρουσιάσεις δεδομένων, καθώς και τις σχετικές απαιτήσεις ποιότητας και ακρίβειας για τα στοιχεία δεδομένων του σιδηροδρομικού συστήματος της Ένωσης.</skos:definition>
    <skos:definition xml:lang="es">Documento técnico publicado por la Agencia con arreglo al artículo 4, apartado 8, de la Directiva (UE) 2016/797, que establece definiciones y presentaciones de datos legibles por humanos y por máquinas, así como los requisitos de calidad y precisión asociados para los elementos de datos del sistema ferroviario de la Unión.</skos:definition>
    <skos:definition xml:lang="fr">Document technique publié par l'Agence en application de l'article 4, paragraphe 8, de la directive (UE) 2016/797, établissant des définitions et présentations de données lisibles par l'homme et par machine ainsi que les exigences de qualité et de précision associées pour les éléments de données du système ferroviaire de l'Union.</skos:definition>
    <skos:definition xml:lang="hu">Az ügynökség által az (EU) 2016/797 irányelv 4. cikkének (8) bekezdése alapján kiadott műszaki dokumentum, amely az uniós vasúti rendszer adatelemei tekintetében ember és gép által olvasható adatdefiníciókat és adatmegjelenítéseket, valamint a kapcsolódó minőségi és pontossági követelményeket határoz meg.</skos:definition>
    <skos:definition xml:lang="it">Documento tecnico pubblicato dall'Agenzia a norma dell'articolo 4, paragrafo 8, della direttiva (UE) 2016/797, che stabilisce definizioni e presentazioni dei dati leggibili dall'uomo e dalla macchina nonché i requisiti di qualità e precisione associati per gli elementi di dati del sistema ferroviario dell'Unione.</skos:definition>
    <skos:definition xml:lang="nl">Een door het Agentschap overeenkomstig artikel 4, lid 8, van Richtlijn (EU) 2016/797 uitgegeven technisch document waarin voor het spoorwegsysteem van de Unie de mens- en machineleesbare gegevensdefinities en -presentaties en de bijbehorende kwaliteits- en nauwkeurigheidsvereisten voor gegevenselementen worden vastgesteld.</skos:definition>
    <skos:definition xml:lang="de">Ein von der Agentur gemäß Artikel 4 Absatz 8 der Richtlinie (EU) 2016/797 herausgegebenes technisches Dokument, in dem für die Eisenbahn der Union maschinen- und menschenlesbare Datendefinitionen und -darstellungen sowie die zugehörigen Qualitäts- und Genauigkeitsanforderungen für Datenelemente festgelegt sind.</skos:definition>
    <skos:definition xml:lang="bg">Технически документ, издаван от агенцията съгласно член 4, параграф 8 от Директива (ЕС) 2016/797, в който се установяват четими от човек и машина дефиниции и представяния на данни, както и свързаните с тях изисквания за качество и точност за елементите от данни на железопътната система на Съюза.</skos:definition>
    <skos:definition xml:lang="da">Et teknisk dokument, der udstedes af agenturet i henhold til artikel 4, stk. 8, i direktiv (EU) 2016/797, og som fastlægger menneske- og maskinlæsbare datadefinitioner og -præsentationer samt de tilhørende kvalitets- og nøjagtighedskrav for dataelementer i Unionens jernbanesystem.</skos:definition>
    <skos:definition xml:lang="en">A technical document issued by the Agency pursuant to Article 4(8) of Directive (EU) 2016/797, setting out human-readable and machine-readable data definitions and presentations and the associated quality and accuracy requirements for data elements of the Union rail system.</skos:definition>
    <skos:definition xml:lang="et">Tehniline dokument, mille amet annab välja direktiivi (EL) 2016/797 artikli 4 lõike 8 alusel ja milles sätestatakse liidu raudteesüsteemi andmeelementide inim- ja masinloetavad andmemääratlused ja -esitlused ning nendega seonduvad kvaliteedi- ja täpsusnõuded.</skos:definition>
    <skos:definition xml:lang="fi">Viraston direktiivin (EU) 2016/797 4 artiklan 8 kohdan nojalla antama tekninen asiakirja, jossa vahvistetaan ihmisen ja koneen luettavissa olevat datan määritelmät ja esitykset sekä niihin liittyvät laatu- ja tarkkuusvaatimukset unionin rautatiejärjestelmän dataelementeille.</skos:definition>
    <skos:definition xml:lang="ga">Doiciméad teicniúil arna eisiúint ag an nGníomhaireacht de bhun Airteagal 4(8) de Threoir (AE) 2016/797, lena mbunaítear sainmhínithe agus cur i láthair sonraí atá inléite ag an duine agus ag an meaisín, chomh maith leis na ceanglais cháilíochta agus chruinnis ghaolmhara le haghaidh eilimintí sonraí chóras iarnróid an Aontais.</skos:definition>
    <skos:definition xml:lang="hr">Tehnički dokument koji Agencija izdaje na temelju članka 4. stavka 8. Direktive (EU) 2016/797 i kojim se utvrđuju strojno i ljudski čitljive definicije i prikazi podataka te povezani zahtjevi u pogledu kvalitete i točnosti za podatkovne elemente željezničkog sustava Unije.</skos:definition>
    <skos:definition xml:lang="lv">Tehnisks dokuments, ko aģentūra izdod saskaņā ar Direktīvas (ES) 2016/797 4. panta 8. punktu un kurā noteiktas cilvēklasāmas un mašīnlasāmas datu definīcijas un prezentācijas, kā arī saistītās kvalitātes un precizitātes prasības Savienības dzelzceļa sistēmas datu elementiem.</skos:definition>
    <skos:definition xml:lang="mt">Dokument tekniku maħruġ mill-Aġenzija skont l-Artikolu 4(8) tad-Direttiva (UE) 2016/797, li jistabbilixxi definizzjonijiet u preżentazzjonijiet tad-data li jinqraw mill-bniedem u mill-magna, kif ukoll ir-rekwiżiti tal-kwalità u l-preċiżjoni assoċjati għall-elementi tad-data tas-sistema ferrovjarja tal-Unjoni.</skos:definition>
    <skos:definition xml:lang="sk">Technický dokument vydaný agentúrou podľa článku 4 ods. 8 smernice (EÚ) 2016/797, ktorý stanovuje človekom a strojom čitateľné definície a prezentácie údajov a súvisiace požiadavky na kvalitu a presnosť dátových prvkov železničného systému Únie.</skos:definition>
    <skos:definition xml:lang="sl">Tehnični dokument, ki ga agencija izda v skladu s členom 4(8) Direktive (EU) 2016/797 in v katerem so določene človeško in strojno berljive opredelitve in predstavitve podatkov ter povezane zahteve glede kakovosti in natančnosti za podatkovne elemente železniškega sistema Unije.</skos:definition>
    <skos:definition xml:lang="lt">Techninis dokumentas, kurį agentūra išleidžia pagal Direktyvos (ES) 2016/797 4 straipsnio 8 dalį ir kuriame nustatytos žmogui ir mašinai nuskaitomos duomenų apibrėžtys ir pateiktys bei susiję Sąjungos geležinkelių sistemos duomenų elementų kokybės ir tikslumo reikalavimai.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_16</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0090">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Data holder</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Držitel údajů</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Dateninhaber</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Κάτοχος δεδομένων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Titular de los datos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Détenteur de données</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Az adatok birtokosa</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Detentore dei dati</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevenshouder</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Posiadacz danych</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Detentor dos dados</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Deținător de date</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Datainnehavare</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Притежател на данни</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Dataindehaver</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmevaldaja</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Datan haltija</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Sealbhóir sonraí</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Posjednik podataka</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Duomenų valdytojas</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Datu turētājs</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Detentur tad-data</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Držiteľ údajov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Imetnik podatkov</skos:prefLabel>
    <skos:definition xml:lang="en">A natural or legal person that has the right to use or an obligation to produce and make available data.</skos:definition>
    <skos:definition xml:lang="sv">En fysisk eller juridisk person som har rätt att använda eller skyldighet att framställa och tillgängliggöra data.</skos:definition>
    <skos:definition xml:lang="de">Eine natürliche oder juristische Person, die das Recht hat, Daten zu nutzen, oder die Pflicht hat, Daten zu erzeugen und bereitzustellen.</skos:definition>
    <skos:definition xml:lang="es">Persona física o jurídica que tiene el derecho de utilizar o la obligación de producir y poner a disposición datos.</skos:definition>
    <skos:definition xml:lang="fr">Personne physique ou morale qui a le droit d'utiliser ou l'obligation de produire et de mettre à disposition des données.</skos:definition>
    <skos:definition xml:lang="hu">Olyan természetes vagy jogi személy, amely jogosult az adatok felhasználására, vagy köteles az adatok előállítására és rendelkezésre bocsátására.</skos:definition>
    <skos:definition xml:lang="it">Persona fisica o giuridica che ha il diritto di utilizzare o l'obbligo di produrre e mettere a disposizione i dati.</skos:definition>
    <skos:definition xml:lang="nl">Een natuurlijke of rechtspersoon die het recht heeft gegevens te gebruiken of de verplichting heeft gegevens te produceren en beschikbaar te stellen.</skos:definition>
    <skos:definition xml:lang="pl">Osoba fizyczna lub prawna, która ma prawo do wykorzystywania danych lub obowiązek ich wytwarzania i udostępniania.</skos:definition>
    <skos:definition xml:lang="pt">Pessoa singular ou coletiva que tem o direito de utilizar ou a obrigação de produzir e disponibilizar dados.</skos:definition>
    <skos:definition xml:lang="ro">Persoană fizică sau juridică care are dreptul de a utiliza sau obligația de a produce și de a pune la dispoziție date.</skos:definition>
    <skos:definition xml:lang="bg">Физическо или юридическо лице, което има право да използва или задължение да създава и предоставя данни.</skos:definition>
    <skos:definition xml:lang="cs">Fyzická nebo právnická osoba, která má právo údaje využívat nebo povinnost údaje vytvářet a zpřístupňovat.</skos:definition>
    <skos:definition xml:lang="da">En fysisk eller juridisk person, der har ret til at anvende eller pligt til at producere og stille data til rådighed.</skos:definition>
    <skos:definition xml:lang="el">Φυσικό ή νομικό πρόσωπο που έχει το δικαίωμα να χρησιμοποιεί ή την υποχρέωση να παράγει και να καθιστά διαθέσιμα δεδομένα.</skos:definition>
    <skos:definition xml:lang="et">Füüsiline või juriidiline isik, kellel on õigus kasutada andmeid või kohustus andmeid luua ja kättesaadavaks teha.</skos:definition>
    <skos:definition xml:lang="fi">Luonnollinen henkilö tai oikeushenkilö, jolla on oikeus käyttää dataa tai velvollisuus tuottaa ja asettaa saataville dataa.</skos:definition>
    <skos:definition xml:lang="ga">Duine nádúrtha nó dlítheanach a bhfuil an ceart aige sonraí a úsáid nó an oibleagáid air sonraí a tháirgeadh agus a chur ar fáil.</skos:definition>
    <skos:definition xml:lang="hr">Fizička ili pravna osoba koja ima pravo upotrebljavati podatke ili obvezu izrađivati i stavljati na raspolaganje podatke.</skos:definition>
    <skos:definition xml:lang="lt">Fizinis arba juridinis asmuo, turintis teisę naudoti duomenis arba pareigą juos rengti ir teikti.</skos:definition>
    <skos:definition xml:lang="lv">Fiziska vai juridiska persona, kurai ir tiesības izmantot datus vai pienākums tos sagatavot un darīt pieejamus.</skos:definition>
    <skos:definition xml:lang="mt">Persuna fiżika jew ġuridika li jkollha d-dritt li tuża jew l-obbligu li tipproduċi u tqiegħed għad-dispożizzjoni d-data.</skos:definition>
    <skos:definition xml:lang="sl">Fizična ali pravna oseba, ki ima pravico do uporabe ali obveznost ustvarjanja in dajanja na voljo podatkov.</skos:definition>
    <skos:definition xml:lang="sk">Fyzická alebo právnická osoba, ktorá má právo údaje využívať alebo povinnosť údaje vytvárať a sprístupňovať.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_12</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0018">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="cs">TrainRunningForecastMessage (zpráva o predikci jízdy vlaku)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">TrainRunningForecastMessage (Zuglaufprognosenachricht)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">TrainRunningForecastMessage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">TrainRunningForecastMessage (mensaje de previsión de circulación del tren)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">TrainRunningForecastMessage (message de prévision de circulation du train)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">TrainRunningForecastMessage (vonatközlekedési előrejelzési üzenet)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">TrainRunningForecastMessage (messaggio di previsione di circolazione del treno)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">TrainRunningForecastMessage (treinloopprognosebericht)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">TrainRunningForecastMessage (komunikat prognozy jazdy pociągu)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">TrainRunningForecastMessage (mensagem de previsão da circulação do comboio)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">TrainRunningForecastMessage (mesaj de prognoză a circulației trenului)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">TrainRunningForecastMessage (meddelande om tågförings­prognos)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">TrainRunningForecastMessage (μήνυμα πρόβλεψης κυκλοφορίας τρένου)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">TrainRunningForecastMessage (съобщение с прогноза за движението на влака)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">TrainRunningForecastMessage (meddelelse om togdriftsprognose)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">TrainRunningForecastMessage (rongiliikluse prognoosi sõnum)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">TrainRunningForecastMessage (junan liikennöinnin ennusteviesti)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">TrainRunningForecastMessage (teachtaireacht réamhaisnéise faoi ghluaiseacht na traenach)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">TrainRunningForecastMessage (poruka o prognozi vožnje vlaka)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">TrainRunningForecastMessage (traukinio eismo prognozės pranešimas)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">TrainRunningForecastMessage (vilciena kustības prognozes ziņojums)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">TrainRunningForecastMessage (messaġġ ta' tbassir tal-moviment tal-ferrovija)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">TrainRunningForecastMessage (správa o predpovedi jazdy vlaku)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">TrainRunningForecastMessage (sporočilo o napovedi vožnje vlaka)</skos:prefLabel>
    <skos:definition xml:lang="en">Message conveying forecast train running information, with expected accuracy as set out in the regulation's accuracy methodology.</skos:definition>
    <skos:definition xml:lang="cs">Zpráva předávající predikci jízdy vlaku s očekávanou přesností stanovenou metodikou přesnosti uvedenou v nařízení.</skos:definition>
    <skos:definition xml:lang="de">Nachricht zur Übermittlung der Prognose des Zuglaufs mit der in der Genauigkeitsmethodik der Verordnung festgelegten erwarteten Genauigkeit.</skos:definition>
    <skos:definition xml:lang="el">Μήνυμα που διαβιβάζει την πρόβλεψη κυκλοφορίας του τρένου, με την αναμενόμενη ακρίβεια που καθορίζεται από τη μεθοδολογία ακρίβειας του κανονισμού.</skos:definition>
    <skos:definition xml:lang="fr">Message transmettant la prévision de circulation du train, avec la précision attendue définie par la méthodologie de précision du règlement.</skos:definition>
    <skos:definition xml:lang="hu">Üzenet, amely továbbítja a vonatközlekedés előrejelzését, a rendelet pontossági módszertanában meghatározott várható pontossággal.</skos:definition>
    <skos:definition xml:lang="it">Messaggio che trasmette la previsione di circolazione del treno, con la precisione attesa definita dalla metodologia di precisione del regolamento.</skos:definition>
    <skos:definition xml:lang="nl">Bericht dat de prognose van de treinloop doorgeeft, met de verwachte nauwkeurigheid zoals bepaald in de nauwkeurigheidsmethodiek van de verordening.</skos:definition>
    <skos:definition xml:lang="pl">Komunikat przekazujący prognozę jazdy pociągu, z oczekiwaną dokładnością określoną metodyką dokładności rozporządzenia.</skos:definition>
    <skos:definition xml:lang="pt">Mensagem que transmite a previsão da circulação do comboio, com a precisão esperada definida pela metodologia de precisão do regulamento.</skos:definition>
    <skos:definition xml:lang="ro">Mesaj care transmite prognoza circulației trenului, cu precizia preconizată stabilită prin metodologia de precizie a regulamentului.</skos:definition>
    <skos:definition xml:lang="sv">Meddelande som överför prognosen för tågföringen, med den förväntade noggrannhet som fastställs i förordningens noggrannhetsmetod.</skos:definition>
    <skos:definition xml:lang="lt">Pranešimas, kuriuo perduodama traukinio eismo prognozė su numatomu tikslumu, nustatytu reglamento tikslumo metodikoje.</skos:definition>
    <skos:definition xml:lang="lv">Ziņojums, ar kuru nodod vilciena kustības prognozi ar paredzamo precizitāti, kas noteikta regulas precizitātes metodikā.</skos:definition>
    <skos:definition xml:lang="mt">Messaġġ li jittrażmetti t-tbassir tal-moviment tal-ferrovija bil-preċiżjoni mistennija stabbilita fil-metodoloġija tal-preċiżjoni tar-regolament.</skos:definition>
    <skos:definition xml:lang="sk">Správa prenášajúca predpoveď jazdy vlaku s očakávanou presnosťou stanovenou metodikou presnosti uvedenou v nariadení.</skos:definition>
    <skos:definition xml:lang="sl">Sporočilo, ki posreduje napoved vožnje vlaka s pričakovano natančnostjo, določeno z metodologijo natančnosti iz uredbe.</skos:definition>
    <skos:definition xml:lang="da">Meddelelse, der overfører prognosen for togdriften med den forventede nøjagtighed, der er fastsat i forordningens nøjagtighedsmetode.</skos:definition>
    <skos:definition xml:lang="es">Mensaje que transmite la previsión de circulación del tren, con la precisión esperada definida por la metodología de precisión del reglamento.</skos:definition>
    <skos:definition xml:lang="et">Sõnum, millega edastatakse rongiliikluse prognoos määruse täpsusmetoodikas sätestatud eeldatava täpsusega.</skos:definition>
    <skos:definition xml:lang="fi">Viesti, jolla välitetään junan liikennöinnin ennuste asetuksen tarkkuusmenetelmässä määritetyllä odotetulla tarkkuudella.</skos:definition>
    <skos:definition xml:lang="ga">Teachtaireacht lena ndéantar réamhaisnéis faoi ghluaiseacht na traenach a tharchur leis an gcruinneas a bhfuiltear ag súil leis arna shocrú i modheolaíocht chruinnis an rialacháin.</skos:definition>
    <skos:definition xml:lang="hr">Poruka kojom se prenosi prognoza vožnje vlaka s očekivanom točnošću utvrđenom metodologijom točnosti iz uredbe.</skos:definition>
    <skos:definition xml:lang="bg">Съобщение, с което се предава прогнозата за движението на влака с очакваната точност, определена в методиката за точност на регламента.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0086">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Application programming interface</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Rozhraní pro programování aplikací (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anwendungsprogrammierschnittstelle (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Διεπαφή προγραμματισμού εφαρμογών (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Interfaz de programación de aplicaciones (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Interface de programmation d'application (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Alkalmazásprogramozási felület (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Interfaccia di programmazione delle applicazioni (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Applicatieprogrammeerinterface (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Interfejs programowania aplikacji (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Interface de programação de aplicações (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Interfață de programare a aplicațiilor (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Gränssnitt för applikationsprogrammering (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Приложно-програмен интерфейс (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Applikationsprogrammeringsgrænseflade (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Rakendusliides (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Vmesnik za aplikacijsko programiranje (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Comhéadan ríomhchláraithe feidhmchlár (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Sučelje za programiranje aplikacija (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Taikomųjų programų sąsaja (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Lietojumprogrammu saskarne (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Interfaċċa tal-ipprogrammar tal-applikazzjonijiet (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Rozhranie na programovanie aplikácií (API)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Sovellusrajapinta (API)</skos:prefLabel>
    <skos:definition xml:lang="en">A set of functions, procedures, definitions and protocols for interoperable data sharing between telematics applications.</skos:definition>
    <skos:definition xml:lang="el">Σύνολο λειτουργιών, διαδικασιών, ορισμών και πρωτοκόλλων για τη διαλειτουργική ανταλλαγή δεδομένων μεταξύ τηλεματικών εφαρμογών.</skos:definition>
    <skos:definition xml:lang="es">Conjunto de funciones, procedimientos, definiciones y protocolos para el intercambio interoperable de datos entre aplicaciones telemáticas.</skos:definition>
    <skos:definition xml:lang="fr">Ensemble de fonctions, de procédures, de définitions et de protocoles permettant le partage interopérable de données entre applications télématiques.</skos:definition>
    <skos:definition xml:lang="hu">Funkciók, eljárások, definíciók és protokollok összessége a telematikai alkalmazások közötti interoperábilis adatmegosztáshoz.</skos:definition>
    <skos:definition xml:lang="it">Insieme di funzioni, procedure, definizioni e protocolli per la condivisione interoperabile dei dati tra applicazioni telematiche.</skos:definition>
    <skos:definition xml:lang="nl">Een geheel van functies, procedures, definities en protocollen voor interoperabele gegevensdeling tussen telematicatoepassingen.</skos:definition>
    <skos:definition xml:lang="pl">Zbiór funkcji, procedur, definicji i protokołów umożliwiających interoperacyjną wymianę danych między aplikacjami telematycznymi.</skos:definition>
    <skos:definition xml:lang="pt">Conjunto de funções, procedimentos, definições e protocolos para a partilha interoperável de dados entre aplicações telemáticas.</skos:definition>
    <skos:definition xml:lang="ro">Set de funcții, proceduri, definiții și protocoale pentru partajarea interoperabilă a datelor între aplicațiile telematice.</skos:definition>
    <skos:definition xml:lang="sv">En uppsättning funktioner, förfaranden, definitioner och protokoll för interoperabel datadelning mellan telematikapplikationer.</skos:definition>
    <skos:definition xml:lang="cs">Soubor funkcí, postupů, definic a protokolů pro interoperabilní sdílení údajů mezi telematickými aplikacemi.</skos:definition>
    <skos:definition xml:lang="de">Eine Reihe von Funktionen, Verfahren, Definitionen und Protokollen für den interoperablen Datenaustausch zwischen Telematikanwendungen.</skos:definition>
    <skos:definition xml:lang="fi">Joukko toimintoja, menettelyjä, määritelmiä ja protokollia telematiikkasovellusten väliseen yhteentoimivaan datan jakamiseen.</skos:definition>
    <skos:definition xml:lang="ga">Sraith feidhmeanna, nósanna imeachta, sainmhínithe agus prótacal le haghaidh comhroinnt sonraí idir-inoibritheach idir feidhmchláir theileamaitice.</skos:definition>
    <skos:definition xml:lang="hr">Skup funkcija, postupaka, definicija i protokola za interoperabilnu razmjenu podataka među telematičkim aplikacijama.</skos:definition>
    <skos:definition xml:lang="lt">Funkcijų, procedūrų, apibrėžčių ir protokolų rinkinys, skirtas sąveikiajam dalijimuisi duomenimis tarp telematikos taikomųjų programų.</skos:definition>
    <skos:definition xml:lang="lv">Funkciju, procedūru, definīciju un protokolu kopums sadarbspējīgai datu kopīgošanai starp telemātikas lietojumprogrammām.</skos:definition>
    <skos:definition xml:lang="mt">Sett ta' funzjonijiet, proċeduri, definizzjonijiet u protokolli għall-kondiviżjoni interoperabbli tad-data bejn l-applikazzjonijiet telematiċi.</skos:definition>
    <skos:definition xml:lang="sk">Súbor funkcií, postupov, definícií a protokolov na interoperabilné zdieľanie údajov medzi telematickými aplikáciami.</skos:definition>
    <skos:definition xml:lang="sl">Niz funkcij, postopkov, opredelitev in protokolov za interoperabilno izmenjavo podatkov med telematskimi aplikacijami.</skos:definition>
    <skos:definition xml:lang="bg">Набор от функции, процедури, дефиниции и протоколи за оперативно съвместимо споделяне на данни между телематичните приложения.</skos:definition>
    <skos:definition xml:lang="da">Et sæt funktioner, procedurer, definitioner og protokoller til interoperabel datadeling mellem telematikapplikationer.</skos:definition>
    <skos:definition xml:lang="et">Funktsioonide, protseduuride, määratluste ja protokollide kogum koostalitlusvõimeliseks andmete jagamiseks telemaatikarakenduste vahel.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_22</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0047">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Empty freight wagon under fleet management control</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Leerer Güterwagen unter Flottenmanagementkontrolle</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Vagón de mercancías vacío bajo control de la gestión de flota</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Wagon de fret vide sous contrôle de la gestion de flotte</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Üres tehervagon flottakezelési ellenőrzés alatt</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Carro merci vuoto sotto il controllo della gestione della flotta</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Vagão de mercadorias vazio sob controlo da gestão de frota</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Vagon de marfă gol sub controlul gestionării parcului</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tom godsvagn under flottförvaltningskontroll</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Lege goederenwagen onder vlootbeheercontrole</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Prázdný nákladní vůz pod kontrolou správy vozového parku</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Pusty wagon towarowy pod kontrolą zarządzania flotą</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Tom godsvogn under flådestyringskontrol</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Κενό εμπορευματικό βαγόνι υπό τον έλεγχο διαχείρισης στόλου</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Tühi kaubavagun pargihalduse kontrolli all</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tyhjä tavaravaunu kalustonhallinnan valvonnassa</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Vaigín lasta folamh faoi rialú bainistithe an chabhlaigh</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Prazni teretni vagon pod kontrolom upravljanja voznim parkom</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Tuščias prekinis vagonas, kontroliuojamas parko valdymo</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Tukšs kravas vagons parka pārvaldības kontrolē</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Vagun tal-merkanzija vojt taħt il-kontroll tal-ġestjoni tal-flotta</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Prázdny nákladný vozeň pod kontrolou správy vozového parku</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Prazni tovorni vagon pod nadzorom upravljanja voznega parka</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Празен товарен вагон под контрола на управлението на парка</skos:prefLabel>
    <skos:definition xml:lang="hu">Működési állapot, amely azt jelzi, hogy egy üres tehervagon flottakezelési ellenőrzés alatt áll.</skos:definition>
    <skos:definition xml:lang="en">Operational state indicating that an empty freight wagon is under fleet management control.</skos:definition>
    <skos:definition xml:lang="cs">Provozní stav označující, že prázdný nákladní vůz je pod kontrolou správy vozového parku.</skos:definition>
    <skos:definition xml:lang="de">Betriebszustand, der angibt, dass ein leerer Güterwagen der Flottenmanagementkontrolle unterliegt.</skos:definition>
    <skos:definition xml:lang="el">Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα κενό εμπορευματικό βαγόνι βρίσκεται υπό τον έλεγχο διαχείρισης στόλου.</skos:definition>
    <skos:definition xml:lang="es">Estado operativo que indica que un vagón de mercancías vacío está bajo el control de la gestión de flota.</skos:definition>
    <skos:definition xml:lang="fr">État opérationnel indiquant qu'un wagon de fret vide est sous le contrôle de la gestion de flotte.</skos:definition>
    <skos:definition xml:lang="it">Stato operativo che indica che un carro merci vuoto è sotto il controllo della gestione della flotta.</skos:definition>
    <skos:definition xml:lang="nl">Operationele toestand die aangeeft dat een lege goederenwagen onder vlootbeheercontrole valt.</skos:definition>
    <skos:definition xml:lang="pl">Stan operacyjny wskazujący, że pusty wagon towarowy znajduje się pod kontrolą zarządzania flotą.</skos:definition>
    <skos:definition xml:lang="pt">Estado operacional que indica que um vagão de mercadorias vazio está sob o controlo da gestão de frota.</skos:definition>
    <skos:definition xml:lang="ro">Stare operațională care indică faptul că un vagon de marfă gol se află sub controlul gestionării parcului.</skos:definition>
    <skos:definition xml:lang="sv">Operativt tillstånd som anger att en tom godsvagn är under flottförvaltningskontroll.</skos:definition>
    <skos:definition xml:lang="da">Operationel tilstand, der angiver, at en tom godsvogn er under flådestyringskontrol.</skos:definition>
    <skos:definition xml:lang="et">Operatiivseisund, mis näitab, et tühi kaubavagun on pargihalduse kontrolli all.</skos:definition>
    <skos:definition xml:lang="fi">Operatiivinen tila, joka ilmaisee, että tyhjä tavaravaunu on kalustonhallinnan valvonnassa.</skos:definition>
    <skos:definition xml:lang="mt">Stat operazzjonali li jindika li vagun tal-merkanzija vojt jinsab taħt il-kontroll tal-ġestjoni tal-flotta.</skos:definition>
    <skos:definition xml:lang="sk">Prevádzkový stav označujúci, že prázdny nákladný vozeň je pod kontrolou správy vozového parku.</skos:definition>
    <skos:definition xml:lang="ga">Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta folamh faoi rialú bainistithe an chabhlaigh.</skos:definition>
    <skos:definition xml:lang="hr">Operativno stanje kojim se označava da je prazni teretni vagon pod kontrolom upravljanja voznim parkom.</skos:definition>
    <skos:definition xml:lang="lt">Veiklos būsena, kuria nurodoma, kad tuščias prekinis vagonas yra kontroliuojamas parko valdymo.</skos:definition>
    <skos:definition xml:lang="lv">Operatīvais stāvoklis, ar kuru norāda, ka tukšs kravas vagons ir parka pārvaldības kontrolē.</skos:definition>
    <skos:definition xml:lang="bg">Оперативно състояние, с което се обозначава, че празен товарен вагон е под контрола на управлението на парка.</skos:definition>
    <skos:definition xml:lang="sl">Operativno stanje, ki označuje, da je prazni tovorni vagon pod nadzorom upravljanja voznega parka.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0009">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">PathConfirmedMessage</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">PathConfirmedMessage (zpráva o potvrzení trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">PathConfirmedMessage (Trassenbestätigungsnachricht)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">PathConfirmedMessage (μήνυμα επιβεβαίωσης διαδρομής)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">PathConfirmedMessage (mensaje de confirmación del surco)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">PathConfirmedMessage (message de confirmation du sillon)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">PathConfirmedMessage (menetvonal-megerősítési üzenet)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">PathConfirmedMessage (messaggio di conferma della traccia)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">PathConfirmedMessage (padbevestigingsbericht)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">PathConfirmedMessage (komunikat potwierdzenia trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">PathConfirmedMessage (mesaj de confirmare a trasei)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">PathConfirmedMessage (meddelande om bekräftat tågläge)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">PathConfirmedMessage (mensagem de confirmação do canal horário)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">PathConfirmedMessage (съобщение за потвърждаване на влаковия маршрут)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">PathConfirmedMessage (kanalbekræftelsesmeddelelse)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">PathConfirmedMessage (rongiliini kinnitamise sõnum)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">PathConfirmedMessage (reitin vahvistusviesti)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">PathConfirmedMessage (teachtaireacht dheimhnithe uaire)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">PathConfirmedMessage (poruka o potvrdi trase)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">PathConfirmedMessage (trasos patvirtinimo pranešimas)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">PathConfirmedMessage (messaġġ ta' konferma tal-mogħdija)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">PathConfirmedMessage (správa o potvrdení trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">PathConfirmedMessage (sporočilo o potrditvi vlakovne poti)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">PathConfirmedMessage (ceļa apstiprinājuma ziņojums)</skos:prefLabel>
    <skos:definition xml:lang="el">Μήνυμα με το οποίο ο αιτών επιβεβαιώνει τις λεπτομέρειες της διαδρομής που προτείνει ο διαχειριστής υποδομής.</skos:definition>
    <skos:definition xml:lang="cs">Zpráva, kterou žadatel potvrzuje podrobnosti o trase navržené provozovatelem infrastruktury.</skos:definition>
    <skos:definition xml:lang="de">Nachricht, mit der der Antragsteller die vom Infrastrukturbetreiber vorgeschlagenen Trassendetails bestätigt.</skos:definition>
    <skos:definition xml:lang="sv">Meddelande genom vilket den sökande bekräftar de tåglägesuppgifter som infrastrukturförvaltaren föreslagit.</skos:definition>
    <skos:definition xml:lang="en">Message by which the applicant confirms the path details proposed by the infrastructure manager.</skos:definition>
    <skos:definition xml:lang="es">Mensaje por el que el candidato confirma los detalles del surco propuestos por el administrador de infraestructuras.</skos:definition>
    <skos:definition xml:lang="fr">Message par lequel le candidat confirme les détails du sillon proposés par le gestionnaire de l'infrastructure.</skos:definition>
    <skos:definition xml:lang="hu">Üzenet, amellyel a kérelmező megerősíti a pályahálózat-működtető által javasolt menetvonal-részleteket.</skos:definition>
    <skos:definition xml:lang="it">Messaggio con cui il richiedente conferma i dettagli della traccia proposti dal gestore dell'infrastruttura.</skos:definition>
    <skos:definition xml:lang="nl">Bericht waarmee de aanvrager de door de infrastructuurbeheerder voorgestelde paddetails bevestigt.</skos:definition>
    <skos:definition xml:lang="pl">Komunikat, za pomocą którego wnioskodawca potwierdza szczegóły trasy zaproponowane przez zarządcę infrastruktury.</skos:definition>
    <skos:definition xml:lang="pt">Mensagem pela qual o requerente confirma os pormenores do canal horário propostos pelo gestor de infraestrutura.</skos:definition>
    <skos:definition xml:lang="ro">Mesaj prin care solicitantul confirmă detaliile trasei propuse de administratorul de infrastructură.</skos:definition>
    <skos:definition xml:lang="da">Meddelelse, hvormed ansøgeren bekræfter de kanaldetaljer, som infrastrukturforvalteren har foreslået.</skos:definition>
    <skos:definition xml:lang="et">Sõnum, millega taotleja kinnitab taristuettevõtja pakutud rongiliini üksikasjad.</skos:definition>
    <skos:definition xml:lang="fi">Viesti, jolla hakija vahvistaa rataverkon haltijan ehdottamat reitin yksityiskohdat.</skos:definition>
    <skos:definition xml:lang="ga">Teachtaireacht trína ndeimhníonn an t-iarratasóir na sonraí uaire arna moladh ag an mbainisteoir bonneagair.</skos:definition>
    <skos:definition xml:lang="hr">Poruka kojom podnositelj zahtjeva potvrđuje pojedinosti o trasi koje je predložio upravitelj infrastrukture.</skos:definition>
    <skos:definition xml:lang="lt">Pranešimas, kuriuo pareiškėjas patvirtina infrastruktūros valdytojo pasiūlytus trasos duomenis.</skos:definition>
    <skos:definition xml:lang="lv">Ziņojums, ar kuru pieteikuma iesniedzējs apstiprina infrastruktūras pārvaldītāja ierosinātās ceļa detaļas.</skos:definition>
    <skos:definition xml:lang="mt">Messaġġ li bih l-applikant jikkonferma d-dettalji tal-mogħdija proposti mill-maniġer tal-infrastruttura.</skos:definition>
    <skos:definition xml:lang="sk">Správa, ktorou žiadateľ potvrdzuje podrobnosti o trase navrhnuté manažérom infraštruktúry.</skos:definition>
    <skos:definition xml:lang="sl">Sporočilo, s katerim prosilec potrdi podrobnosti vlakovne poti, ki jih je predlagal upravljavec infrastrukture.</skos:definition>
    <skos:definition xml:lang="bg">Съобщение, с което заявителят потвърждава предложените от управителя на инфраструктурата подробности за влаковия маршрут.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0074">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Attributing system</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Přidělovací systém</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Zuteilungssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Σύστημα κατανομής</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Sistema de atribución</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Système d'attribution</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Kiosztási rendszer</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Sistema di attribuzione</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Toewijzingssysteem</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">System przydziału</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Sistema de atribuição</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Sistem de atribuire</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tilldelningssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Система за разпределение</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Tildelingssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Jaotussüsteem</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Jakojärjestelmä</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Córas leithdháilte</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Sustav dodjele</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Priskyrimo sistema</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Piešķiršanas sistēma</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Sistema ta' allokazzjoni</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Prideľovací systém</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Sistem dodeljevanja</skos:prefLabel>
    <skos:definition xml:lang="en">The railway undertaking's digital system hosting the online catalogue of individual rail transport services and enabling distributors to check availability and make reservations.</skos:definition>
    <skos:definition xml:lang="es">Sistema digital de la empresa ferroviaria que aloja el catálogo en línea de los distintos servicios de transporte ferroviario y permite a los distribuidores comprobar la disponibilidad y realizar reservas.</skos:definition>
    <skos:definition xml:lang="fr">Système numérique de l'entreprise ferroviaire hébergeant le catalogue en ligne des services de transport ferroviaire individuels et permettant aux distributeurs de vérifier la disponibilité et d'effectuer des réservations.</skos:definition>
    <skos:definition xml:lang="hu">A vasúti társaság digitális rendszere, amely az egyes vasúti szállítási szolgáltatások online katalógusát tárolja, és lehetővé teszi a forgalmazók számára a rendelkezésre állás ellenőrzését és a foglalások végrehajtását.</skos:definition>
    <skos:definition xml:lang="it">Sistema digitale dell'impresa ferroviaria che ospita il catalogo online dei singoli servizi di trasporto ferroviario e consente ai distributori di verificare la disponibilità ed effettuare prenotazioni.</skos:definition>
    <skos:definition xml:lang="nl">Het digitale systeem van de spoorwegonderneming dat de onlinecatalogus van de afzonderlijke spoorvervoersdiensten bevat en distributeurs in staat stelt de beschikbaarheid te controleren en reserveringen te maken.</skos:definition>
    <skos:definition xml:lang="pl">Cyfrowy system przedsiębiorstwa kolejowego, w którym znajduje się internetowy katalog poszczególnych przewozów kolejowych i który umożliwia dystrybutorom sprawdzanie dostępności oraz dokonywanie rezerwacji.</skos:definition>
    <skos:definition xml:lang="pt">Sistema digital da empresa ferroviária que aloja o catálogo em linha dos serviços de transporte ferroviário individuais e que permite aos distribuidores verificar a disponibilidade e efetuar reservas.</skos:definition>
    <skos:definition xml:lang="ro">Sistemul digital al întreprinderii feroviare care găzduiește catalogul online al serviciilor individuale de transport feroviar și care permite distribuitorilor să verifice disponibilitatea și să efectueze rezervări.</skos:definition>
    <skos:definition xml:lang="sv">Järnvägsföretagets digitala system som hyser onlinekatalogen över de enskilda järnvägstransporttjänsterna och gör det möjligt för distributörer att kontrollera tillgänglighet och göra bokningar.</skos:definition>
    <skos:definition xml:lang="cs">Digitální systém železničního podniku, který hostí online katalog jednotlivých služeb železniční dopravy a umožňuje distributorům ověřovat dostupnost a provádět rezervace.</skos:definition>
    <skos:definition xml:lang="de">Digitales System des Eisenbahnunternehmens, das den Online-Katalog der einzelnen Schienenverkehrsdienste beherbergt und es Vertreibern ermöglicht, die Verfügbarkeit zu prüfen und Reservierungen vorzunehmen.</skos:definition>
    <skos:definition xml:lang="el">Το ψηφιακό σύστημα της σιδηροδρομικής επιχείρησης που φιλοξενεί τον διαδικτυακό κατάλογο των επιμέρους υπηρεσιών σιδηροδρομικής μεταφοράς και επιτρέπει στους διανομείς να ελέγχουν τη διαθεσιμότητα και να πραγματοποιούν κρατήσεις.</skos:definition>
    <skos:definition xml:lang="bg">Цифровата система на железопътното предприятие, в която се намира онлайн каталогът на отделните услуги за железопътен превоз и която позволява на дистрибуторите да проверяват наличността и да правят резервации.</skos:definition>
    <skos:definition xml:lang="da">Jernbanevirksomhedens digitale system, der huser onlinekataloget over de enkelte jernbanetransporttjenester og giver distributører mulighed for at kontrollere tilgængeligheden og foretage reservationer.</skos:definition>
    <skos:definition xml:lang="et">Raudteeveo-ettevõtja digisüsteem, milles paikneb üksikute raudteeveoteenuste internetikataloog ja mis võimaldab turustajatel kontrollida saadavust ja teha broneeringuid.</skos:definition>
    <skos:definition xml:lang="fi">Rautatieyrityksen digitaalinen järjestelmä, johon yksittäisten rautatiekuljetuspalvelujen verkkoluettelo on tallennettu ja jonka avulla jakelijat voivat tarkistaa saatavuuden ja tehdä varauksia.</skos:definition>
    <skos:definition xml:lang="ga">Córas digiteach an ghnóthais iarnróid ina bhfuil catalóg ar líne na seirbhísí iompair iarnróid aonair agus a chuireann ar chumas dáileoirí an infhaighteacht a sheiceáil agus áirithintí a dhéanamh.</skos:definition>
    <skos:definition xml:lang="hr">Digitalni sustav željezničkog prijevoznika u kojem se nalazi internetski katalog pojedinačnih usluga željezničkog prijevoza i koji distributerima omogućuje provjeru dostupnosti i obavljanje rezervacija.</skos:definition>
    <skos:definition xml:lang="lv">Dzelzceļa pārvadājumu uzņēmuma digitālā sistēma, kurā izvietots atsevišķo dzelzceļa pārvadājumu pakalpojumu tiešsaistes katalogs un kura izplatītājiem ļauj pārbaudīt pieejamību un veikt rezervācijas.</skos:definition>
    <skos:definition xml:lang="mt">Is-sistema diġitali tal-impriża ferrovjarja li tospita l-katalgu online tas-servizzi individwali tat-trasport ferrovjarju u li tippermetti lid-distributuri jivverifikaw id-disponibbiltà u jagħmlu riżervazzjonijiet.</skos:definition>
    <skos:definition xml:lang="sk">Digitálny systém železničného podniku, ktorý hosťuje online katalóg jednotlivých služieb železničnej dopravy a umožňuje distribútorom overovať dostupnosť a vykonávať rezervácie.</skos:definition>
    <skos:definition xml:lang="sl">Digitalni sistem prevoznika v železniškem prometu, ki gosti spletni katalog posameznih storitev železniškega prevoza in distributerjem omogoča preverjanje razpoložljivosti in opravljanje rezervacij.</skos:definition>
    <skos:definition xml:lang="lt">Geležinkelio įmonės skaitmeninė sistema, kurioje saugomas internetinis atskirų geležinkelių vežimo paslaugų katalogas ir kuri leidžia platintojams tikrinti prieinamumą ir atlikti rezervacijas.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_41</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0012">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">PathNotAvailableMessage</skos:prefLabel>
    <skos:prefLabel xml:lang="de">PathNotAvailableMessage (Trasse-nicht-verfügbar-Nachricht)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">PathNotAvailableMessage (μήνυμα μη διαθεσιμότητας διαδρομής)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">PathNotAvailableMessage (meddelande om att tågläge inte är tillgängligt)</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">PathNotAvailableMessage (zpráva o nedostupnosti trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">PathNotAvailableMessage (mensaje de surco no disponible)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">PathNotAvailableMessage (message de sillon non disponible)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">PathNotAvailableMessage (pad-niet-beschikbaar-bericht)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">PathNotAvailableMessage (meddelelse om at kanalen ikke er tilgængelig)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">PathNotAvailableMessage (rongiliini kättesaamatuse sõnum)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">PathNotAvailableMessage (viesti reitin saatavuuden puuttumisesta)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">PathNotAvailableMessage (съобщение за неналичност на влаковия маршрут)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">PathNotAvailableMessage (menetvonal nem áll rendelkezésre üzenet)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">PathNotAvailableMessage (messaggio di traccia non disponibile)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">PathNotAvailableMessage (pranešimas apie trasos neprieinamumą)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">PathNotAvailableMessage (ceļa nepieejamības ziņojums)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">PathNotAvailableMessage (messaġġ ta' indisponibbiltà tal-mogħdija)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">PathNotAvailableMessage (komunikat o niedostępności trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">PathNotAvailableMessage (mensagem de canal horário indisponível)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">PathNotAvailableMessage (mesaj de trasă indisponibilă)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">PathNotAvailableMessage (správa o nedostupnosti trasy)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">PathNotAvailableMessage (sporočilo o nerazpoložljivosti vlakovne poti)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">PathNotAvailableMessage (teachtaireacht maidir le neamhfháil uaire)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">PathNotAvailableMessage (poruka o nedostupnosti trase)</skos:prefLabel>
    <skos:definition xml:lang="el">Μήνυμα με το οποίο ο διαχειριστής υποδομής γνωστοποιεί ότι μια αιτηθείσα διαδρομή δεν είναι διαθέσιμη.</skos:definition>
    <skos:definition xml:lang="en">Message by which the infrastructure manager notifies that a requested path is not available.</skos:definition>
    <skos:definition xml:lang="cs">Zpráva, kterou provozovatel infrastruktury oznamuje, že požadovaná trasa není k dispozici.</skos:definition>
    <skos:definition xml:lang="de">Nachricht, mit der der Infrastrukturbetreiber mitteilt, dass eine beantragte Trasse nicht verfügbar ist.</skos:definition>
    <skos:definition xml:lang="es">Mensaje por el que el administrador de infraestructuras notifica que un surco solicitado no está disponible.</skos:definition>
    <skos:definition xml:lang="fr">Message par lequel le gestionnaire de l'infrastructure notifie qu'un sillon demandé n'est pas disponible.</skos:definition>
    <skos:definition xml:lang="hu">Üzenet, amellyel a pályahálózat-működtető értesítést küld arról, hogy egy igényelt menetvonal nem áll rendelkezésre.</skos:definition>
    <skos:definition xml:lang="it">Messaggio con cui il gestore dell'infrastruttura notifica che una traccia richiesta non è disponibile.</skos:definition>
    <skos:definition xml:lang="nl">Bericht waarmee de infrastructuurbeheerder meldt dat een aangevraagd pad niet beschikbaar is.</skos:definition>
    <skos:definition xml:lang="pl">Komunikat, za pomocą którego zarządca infrastruktury powiadamia, że wnioskowana trasa jest niedostępna.</skos:definition>
    <skos:definition xml:lang="pt">Mensagem pela qual o gestor de infraestrutura notifica que um canal horário solicitado não está disponível.</skos:definition>
    <skos:definition xml:lang="ro">Mesaj prin care administratorul de infrastructură notifică faptul că o trasă solicitată nu este disponibilă.</skos:definition>
    <skos:definition xml:lang="sv">Meddelande genom vilket infrastrukturförvaltaren meddelar att ett ansökt tågläge inte är tillgängligt.</skos:definition>
    <skos:definition xml:lang="sk">Správa, ktorou manažér infraštruktúry oznamuje, že požadovaná trasa nie je k dispozícii.</skos:definition>
    <skos:definition xml:lang="sl">Sporočilo, s katerim upravljavec infrastrukture obvesti, da zahtevana vlakovna pot ni na voljo.</skos:definition>
    <skos:definition xml:lang="bg">Съобщение, с което управителят на инфраструктурата уведомява, че поискан влаков маршрут не е наличен.</skos:definition>
    <skos:definition xml:lang="da">Meddelelse, hvormed infrastrukturforvalteren meddeler, at en ansøgt kanal ikke er tilgængelig.</skos:definition>
    <skos:definition xml:lang="et">Sõnum, millega taristuettevõtja teatab, et taotletud rongiliin ei ole kättesaadav.</skos:definition>
    <skos:definition xml:lang="fi">Viesti, jolla rataverkon haltija ilmoittaa, että pyydetty reitti ei ole saatavilla.</skos:definition>
    <skos:definition xml:lang="ga">Teachtaireacht trína gcuireann an bainisteoir bonneagair in iúl nach bhfuil uaire a iarradh ar fáil.</skos:definition>
    <skos:definition xml:lang="hr">Poruka kojom upravitelj infrastrukture obavješćuje da zatražena trasa nije dostupna.</skos:definition>
    <skos:definition xml:lang="lt">Pranešimas, kuriuo infrastruktūros valdytojas praneša, kad prašoma trasa neprieinama.</skos:definition>
    <skos:definition xml:lang="lv">Ziņojums, ar kuru infrastruktūras pārvaldītājs paziņo, ka pieprasītais ceļš nav pieejams.</skos:definition>
    <skos:definition xml:lang="mt">Messaġġ li bih il-maniġer tal-infrastruttura jinnotifika li mogħdija mitluba mhix disponibbli.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10</dct:source>
  </rdf:Description>
