    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Layer D — Governance and data quality</skos:prefLabel>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0094"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0095"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0096"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0097"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0098"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0099"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0100"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0101"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0102"/>
