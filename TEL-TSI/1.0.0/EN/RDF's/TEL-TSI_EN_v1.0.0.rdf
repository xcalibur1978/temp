    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0036"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0037"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0038"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0039"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0049"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0050"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0051"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0052"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0053"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0054"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0055"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0067"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0068"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0069"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0070"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0076">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Ticket control organisation</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Jegyellenőrző szervezet</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Organizzazione di controllo dei biglietti</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Vervoerbewijscontroleorganisatie</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Organizacja kontroli biletów</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Organização de controlo de bilhetes</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Organizație de control al biletelor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Biljettkontrollorganisation</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Organizace pro kontrolu jízdenek</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Fahrkartenkontrollorganisation</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Οργανισμός ελέγχου εισιτηρίων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Organización de control de billetes</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Organisation de contrôle des billets</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Организация за контрол на билети</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Billetkontrolorganisation</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Piletikontrolliorganisatsioon</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Lipuntarkastusorganisaatio</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Eagraíocht iniúchta ticéad</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Organizacija za kontrolu karata</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Bilietų kontrolės organizacija</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Biļešu kontroles organizācija</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Organizzazzjoni tal-kontroll tal-biljetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Organizácia pre kontrolu cestovných lístkov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Organizacija za nadzor vozovnic</skos:prefLabel>
    <skos:definition xml:lang="en">An organisation empowered to inspect passenger tickets, including at platform access doors.</skos:definition>
    <skos:definition xml:lang="cs">Organizace zmocněná kontrolovat jízdenky cestujících, mimo jiné u přístupových dveří na nástupiště.</skos:definition>
    <skos:definition xml:lang="de">Eine Organisation, die befugt ist, Fahrkarten von Fahrgästen zu kontrollieren, auch an den Zugangstüren zum Bahnsteig.</skos:definition>
    <skos:definition xml:lang="el">Οργανισμός εξουσιοδοτημένος να ελέγχει τα εισιτήρια των επιβατών, μεταξύ άλλων στις θύρες πρόσβασης στην αποβάθρα.</skos:definition>
    <skos:definition xml:lang="es">Organización facultada para inspeccionar los billetes de los viajeros, incluso en las puertas de acceso al andén.</skos:definition>
    <skos:definition xml:lang="fr">Organisation habilitée à contrôler les billets des voyageurs, y compris aux portes d'accès aux quais.</skos:definition>
    <skos:definition xml:lang="hu">Olyan szervezet, amely jogosult az utasok jegyeinek ellenőrzésére, többek között a peronhoz való hozzáférést biztosító ajtóknál.</skos:definition>
    <skos:definition xml:lang="it">Organizzazione abilitata a controllare i biglietti dei passeggeri, anche alle porte di accesso ai marciapiedi.</skos:definition>
    <skos:definition xml:lang="nl">Een organisatie die gemachtigd is de vervoerbewijzen van reizigers te controleren, ook bij de toegangsdeuren tot het perron.</skos:definition>
    <skos:definition xml:lang="pl">Organizacja uprawniona do kontroli biletów pasażerów, w tym przy drzwiach dostępu do peronu.</skos:definition>
    <skos:definition xml:lang="pt">Organização habilitada a inspecionar os bilhetes dos passageiros, inclusive nas portas de acesso à plataforma.</skos:definition>
    <skos:definition xml:lang="ro">Organizație abilitată să controleze biletele călătorilor, inclusiv la ușile de acces la peron.</skos:definition>
    <skos:definition xml:lang="sv">En organisation som har befogenhet att kontrollera resenärers biljetter, även vid åtkomstdörrarna till plattformen.</skos:definition>
    <skos:definition xml:lang="bg">Организация, оправомощена да контролира билетите на пътниците, включително при вратите за достъп до перона.</skos:definition>
    <skos:definition xml:lang="da">En organisation, der er bemyndiget til at kontrollere passagerers billetter, herunder ved adgangsdørene til perronen.</skos:definition>
    <skos:definition xml:lang="et">Organisatsioon, kellel on õigus kontrollida reisijate pileteid, sealhulgas perroonile juurdepääsu uste juures.</skos:definition>
    <skos:definition xml:lang="fi">Organisaatio, jolla on valtuudet tarkastaa matkustajien liput, myös laiturille pääsyn oville.</skos:definition>
    <skos:definition xml:lang="ga">Eagraíocht atá údaraithe ticéid na bpaisinéirí a iniúchadh, lena n-áirítear ag na doirse rochtana chuig an ardán.</skos:definition>
    <skos:definition xml:lang="hr">Organizacija ovlaštena za kontrolu karata putnika, među ostalim na pristupnim vratima na peron.</skos:definition>
    <skos:definition xml:lang="lt">Organizacija, įgaliota tikrinti keleivių bilietus, be kita ko, prie prieigos prie perono durų.</skos:definition>
    <skos:definition xml:lang="lv">Organizācija, kas pilnvarota kontrolēt pasažieru biļetes, tostarp pie piekļuves durvīm uz peronu.</skos:definition>
    <skos:definition xml:lang="mt">Organizzazzjoni awtorizzata tikkontrolla l-biljetti tal-passiġġieri, inkluż fil-bibien tal-aċċess għall-pjattaforma.</skos:definition>
    <skos:definition xml:lang="sk">Organizácia oprávnená kontrolovať cestovné lístky cestujúcich, a to aj pri prístupových dverách na nástupište.</skos:definition>
    <skos:definition xml:lang="sl">Organizacija, pooblaščena za nadzor vozovnic potnikov, tudi pri dostopnih vratih na peron.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_46</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0064">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Types and formats of tickets</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Είδη και μορφότυποι εισιτηρίων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Tipos y formatos de billetes</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Types et formats de billets</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A jegyek típusai és formátumai</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Tipi e formati di biglietti</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Soorten en formaten van vervoerbewijzen</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Rodzaje i formaty biletów</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Tipos e formatos de bilhetes</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Tipuri și formate de bilete</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Typer och format av biljetter</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Druhy a formáty jízdenek</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Arten und Formate von Fahrkarten</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Billettyper og -formater</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Piletite liigid ja vormingud</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Lippujen tyypit ja muodot</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Cineálacha agus formáidí ticéad</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Vrste i formati karata</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Bilietų rūšys ir formatai</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Biļešu veidi un formāti</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Tipi u formati tal-biljetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Vrste in oblike vozovnic</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Видове и формати на билети</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Druhy a formáty cestovných lístkov</skos:prefLabel>
    <skos:definition xml:lang="en">The catalogue of ticket types and formats, including secured-paper, blank-paper and mobile/flexible-size ticket layouts with their associated security models.</skos:definition>
    <skos:definition xml:lang="nl">De catalogus van soorten en formaten van vervoerbewijzen, met inbegrip van de lay-outs voor beveiligd papier, blanco papier en mobiele/flexibel geformatteerde vervoerbewijzen met de bijbehorende beveiligingsmodellen.</skos:definition>
    <skos:definition xml:lang="pl">Katalog rodzajów i formatów biletów, w tym układy na papierze zabezpieczonym, na papierze niezadrukowanym oraz biletu mobilnego/o elastycznym formacie, wraz z powiązanymi modelami bezpieczeństwa.</skos:definition>
    <skos:definition xml:lang="pt">O catálogo dos tipos e formatos de bilhetes, incluindo as apresentações em papel seguro, em papel branco e de bilhete móvel/de formato flexível, com os respetivos modelos de segurança.</skos:definition>
    <skos:definition xml:lang="ro">Catalogul tipurilor și formatelor de bilete, inclusiv prezentările pe hârtie securizată, pe hârtie albă și de bilet mobil/cu format flexibil, cu modelele de securitate asociate.</skos:definition>
    <skos:definition xml:lang="sv">Katalogen över biljettyper och biljettformat, inbegripet utformningar på säkerhetspapper, på blankt papper och för mobila/flexibelt formaterade biljetter med tillhörande säkerhetsmodeller.</skos:definition>
    <skos:definition xml:lang="cs">Katalog druhů a formátů jízdenek, včetně grafických úprav na zabezpečeném papíře, na nepotištěném papíře a mobilní/flexibilní jízdenky s příslušnými bezpečnostními modely.</skos:definition>
    <skos:definition xml:lang="de">Der Katalog der Fahrkartenarten und -formate, einschließlich der Layouts für gesicherte Vordrucke, Blankovordrucke und mobile/flexibel formatierte Fahrkarten mit den zugehörigen Sicherheitsmodellen.</skos:definition>
    <skos:definition xml:lang="es">El catálogo de los tipos y formatos de billetes, incluidas las presentaciones en papel seguro, en papel en blanco y de billete móvil/de formato flexible, con sus modelos de seguridad asociados.</skos:definition>
    <skos:definition xml:lang="fr">Le catalogue des types et formats de billets, y compris les présentations sur papier sécurisé, sur papier vierge et de billet mobile/de format flexible, avec leurs modèles de sécurité associés.</skos:definition>
    <skos:definition xml:lang="hu">A jegytípusok és jegyformátumok katalógusa, beleértve a biztonsági papíron, az üres papíron és a mobil/rugalmas formátumú jegyen alkalmazott elrendezéseket a kapcsolódó biztonsági modellekkel együtt.</skos:definition>
    <skos:definition xml:lang="it">Il catalogo dei tipi e formati di biglietti, comprese le presentazioni su carta protetta, su carta bianca e di biglietto mobile/di formato flessibile, con i relativi modelli di sicurezza.</skos:definition>
    <skos:definition xml:lang="el">Ο κατάλογος των ειδών και μορφοτύπων εισιτηρίων, συμπεριλαμβανομένων των διατάξεων σε ασφαλές χαρτί, σε λευκό χαρτί και κινητού/ευέλικτου μορφότυπου εισιτηρίου, με τα σχετικά μοντέλα ασφάλειας.</skos:definition>
    <skos:definition xml:lang="bg">Каталогът на видовете и форматите на билети, включително оформленията върху защитена хартия, върху празна хартия и на мобилен/гъвкаво форматиран билет със свързаните с тях модели за сигурност.</skos:definition>
    <skos:definition xml:lang="da">Kataloget over billettyper og -formater, herunder layout på sikret papir, på blankt papir og for mobile/fleksibelt formaterede billetter med tilhørende sikkerhedsmodeller.</skos:definition>
    <skos:definition xml:lang="et">Piletite liikide ja vormingute kataloog, sealhulgas turvapaberil, tühjal paberil ja mobiili-/paindlikus vormingus pileti küljendused koos seonduvate turvamudelitega.</skos:definition>
    <skos:definition xml:lang="fi">Luettelo lippujen tyypeistä ja muodoista, mukaan lukien suojatulle paperille, tyhjälle paperille ja mobiililipulle/joustavasti muotoillulle lipulle tarkoitetut asettelut niihin liittyvine turvamalleineen.</skos:definition>
    <skos:definition xml:lang="ga">An chatalóg de chineálacha agus formáidí ticéad, lena n-áirítear na leagain amach ar pháipéar slán, ar pháipéar bán agus do thicéad soghluaiste/formáidithe go solúbtha lena samhlacha slándála gaolmhara.</skos:definition>
    <skos:definition xml:lang="hr">Katalog vrsta i formata karata, uključujući izglede na zaštićenom papiru, na praznom papiru i za mobilnu/fleksibilno oblikovanu kartu s povezanim sigurnosnim modelima.</skos:definition>
    <skos:definition xml:lang="lt">Bilietų rūšių ir formatų katalogas, įskaitant išdėstymą apsaugotame popieriuje, neužpildytame popieriuje ir mobiliajame/lankstaus formato biliete su susijusiais saugumo modeliais.</skos:definition>
    <skos:definition xml:lang="mt">Il-katalgu tat-tipi u tal-formati tal-biljetti, inkluż il-preżentazzjonijiet fuq karta sigura, fuq karta vojta u ta' biljett mobbli/b'format flessibbli bil-mudelli tas-sigurtà assoċjati tagħhom.</skos:definition>
    <skos:definition xml:lang="sl">Katalog vrst in oblik vozovnic, vključno s postavitvami na zaščitenem papirju, na praznem papirju in za mobilno/prožno oblikovano vozovnico s povezanimi varnostnimi modeli.</skos:definition>
    <skos:definition xml:lang="lv">Biļešu veidu un formātu katalogs, tostarp izkārtojumi uz aizsargāta papīra, uz neaizpildīta papīra un mobilās/elastīgi formatētas biļetes ar saistītajiem drošības modeļiem.</skos:definition>
    <skos:definition xml:lang="sk">Katalóg druhov a formátov cestovných lístkov vrátane grafických úprav na zabezpečenom papieri, na nepotlačenom papieri a mobilného/flexibilného cestovného lístka s príslušnými bezpečnostnými modelmi.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0063">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="cs">Přepravní podmínky</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Beförderungsbedingungen</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Όροι μεταφοράς</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Conditions of carriage</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Conditions de transport</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Fuvarozási feltételek</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Vervoersvoorwaarden</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Warunki przewozu</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Condições de transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Condiții de transport</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Befordringsvillkor</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Condiciones de transporte</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Условия за превоз</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Befordringsbetingelser</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Veotingimused</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kuljetusehdot</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Coinníollacha iompair</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Uvjeti prijevoza</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Vežimo sąlygos</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Pārvadāšanas noteikumi</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Kundizzjonijiet tat-trasport</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Prepravné podmienky</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Prevozni pogoji</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Condizioni di trasporto</skos:prefLabel>
    <skos:definition xml:lang="en">Data establishing the conditions of carriage, decomposed for passengers, persons with reduced mobility (with rolling-stock and station accessibility), luggage, bicycles, and cars/motorcycles/boats.</skos:definition>
    <skos:definition xml:lang="cs">Údaje stanovící přepravní podmínky, rozčleněné pro cestující, osoby se sníženou pohyblivostí (s přístupností kolejových vozidel a stanic), zavazadla, jízdní kola a automobily/motocykly/plavidla.</skos:definition>
    <skos:definition xml:lang="de">Daten zur Festlegung der Beförderungsbedingungen, aufgegliedert für Fahrgäste, Personen mit eingeschränkter Mobilität (mit Zugänglichkeit von Fahrzeugen und Bahnhöfen), Gepäck, Fahrräder sowie Autos/Motorräder/Boote.</skos:definition>
    <skos:definition xml:lang="el">Δεδομένα που καθορίζουν τους όρους μεταφοράς, αναλυμένα για τους επιβάτες, τα άτομα με μειωμένη κινητικότητα (με την προσβασιμότητα του τροχαίου υλικού και των σταθμών), τις αποσκευές, τα ποδήλατα και τα αυτοκίνητα/μοτοσικλέτες/σκάφη.</skos:definition>
    <skos:definition xml:lang="es">Datos que establecen las condiciones de transporte, desglosadas para los viajeros, las personas con movilidad reducida (con la accesibilidad del material rodante y de las estaciones), el equipaje, las bicicletas y los automóviles/motocicletas/embarcaciones.</skos:definition>
    <skos:definition xml:lang="fr">Données établissant les conditions de transport, décomposées pour les voyageurs, les personnes à mobilité réduite (avec l'accessibilité du matériel roulant et des gares), les bagages, les vélos et les voitures/motos/bateaux.</skos:definition>
    <skos:definition xml:lang="hu">Olyan adatok, amelyek megállapítják a fuvarozási feltételeket, az utasokra, a csökkent mozgásképességű személyekre (a gördülőállomány és az állomások akadálymentességével), a poggyászra, a kerékpárokra, valamint a gépjárművekre/motorkerékpárokra/hajókra bontva.</skos:definition>
    <skos:definition xml:lang="it">Dati che stabiliscono le condizioni di trasporto, scomposte per passeggeri, persone a mobilità ridotta (con l'accessibilità del materiale rotabile e delle stazioni), bagagli, biciclette e automobili/motocicli/imbarcazioni.</skos:definition>
    <skos:definition xml:lang="nl">Gegevens die de vervoersvoorwaarden vaststellen, uitgesplitst voor reizigers, personen met beperkte mobiliteit (met toegankelijkheid van rollend materieel en stations), bagage, fietsen en auto's/motorfietsen/boten.</skos:definition>
    <skos:definition xml:lang="pt">Dados que estabelecem as condições de transporte, decompostas para os passageiros, as pessoas com mobilidade reduzida (com a acessibilidade do material circulante e das estações), a bagagem, as bicicletas e os automóveis/motociclos/embarcações.</skos:definition>
    <skos:definition xml:lang="ro">Date care stabilesc condițiile de transport, descompuse pentru călători, persoane cu mobilitate redusă (cu accesibilitatea materialului rulant și a stațiilor), bagaje, biciclete și autoturisme/motociclete/ambarcațiuni.</skos:definition>
    <skos:definition xml:lang="sv">Uppgifter som fastställer befordringsvillkoren, uppdelade för resenärer, personer med nedsatt rörlighet (med tillgänglighet till rullande materiel och stationer), bagage, cyklar och bilar/motorcyklar/båtar.</skos:definition>
    <skos:definition xml:lang="fi">Tiedot, joilla vahvistetaan kuljetusehdot eriteltyinä matkustajien, liikuntarajoitteisten henkilöiden (mukaan lukien liikkuvan kaluston ja asemien esteettömyys), matkatavaroiden, polkupyörien sekä autojen/moottoripyörien/veneiden osalta.</skos:definition>
    <skos:definition xml:lang="ga">Sonraí lena mbunaítear na coinníollacha iompair, arna miondealú do phaisinéirí, do dhaoine a bhfuil a soghluaisteacht laghdaithe (le hinrochtaineacht an rothstoic agus na stáisiún), do bhagáiste, do rothair agus do charranna/ghluaisrothair/bháid.</skos:definition>
    <skos:definition xml:lang="hr">Podaci kojima se utvrđuju uvjeti prijevoza, razrađeni za putnike, osobe smanjene pokretljivosti (s pristupačnošću željezničkih vozila i kolodvora), prtljagu, bicikle te automobile/motocikle/plovila.</skos:definition>
    <skos:definition xml:lang="lt">Duomenys, kuriais nustatomos vežimo sąlygos, suskirstytos pagal keleivius, riboto judumo asmenis (su riedmenų ir stočių prieinamumu), bagažą, dviračius ir automobilius/motociklus/laivus.</skos:definition>
    <skos:definition xml:lang="lv">Dati, ar kuriem nosaka pārvadāšanas noteikumus, sadalīti attiecībā uz pasažieriem, personām ar ierobežotām pārvietošanās spējām (ar ritošā sastāva un staciju piekļūstamību), bagāžu, velosipēdiem un automobiļiem/motocikliem/laivām.</skos:definition>
    <skos:definition xml:lang="mt">Data li tistabbilixxi l-kundizzjonijiet tat-trasport, maqsuma għall-passiġġieri, il-persuni b'mobbiltà mnaqqsa (bl-aċċessibbiltà tal-vetturi ferrovjarji u tal-istazzjonijiet), il-bagalji, ir-roti u l-karozzi/muturi/dgħajjes.</skos:definition>
    <skos:definition xml:lang="pl">Dane określające warunki przewozu, rozłożone na pasażerów, osoby o ograniczonej możliwości poruszania się (z dostępnością taboru i stacji), bagaż, rowery oraz samochody/motocykle/łodzie.</skos:definition>
    <skos:definition xml:lang="sk">Údaje stanovujúce prepravné podmienky, rozčlenené pre cestujúcich, osoby so zníženou pohyblivosťou (s prístupnosťou koľajových vozidiel a staníc), batožinu, bicykle a automobily/motocykle/plavidlá.</skos:definition>
    <skos:definition xml:lang="sl">Podatki, ki določajo prevozne pogoje, razčlenjeni za potnike, osebe z zmanjšano mobilnostjo (z dostopnostjo tirnih vozil in postaj), prtljago, kolesa ter avtomobile/motorna kolesa/plovila.</skos:definition>
    <skos:definition xml:lang="da">Data, der fastlægger befordringsbetingelserne, opdelt for passagerer, personer med nedsat mobilitet (med tilgængelighed af rullende materiel og stationer), bagage, cykler og biler/motorcykler/både.</skos:definition>
    <skos:definition xml:lang="et">Andmed, millega kehtestatakse veotingimused, mis on jaotatud reisijate, piiratud liikumisvõimega isikute (koos veeremi ja jaamade juurdepääsetavusega), pagasi, jalgrataste ning autode/mootorrataste/paatide kaupa.</skos:definition>
    <skos:definition xml:lang="bg">Данни, с които се установяват условията за превоз, разбити за пътници, лица с намалена подвижност (с достъпността на подвижния състав и гарите), багаж, велосипеди и автомобили/мотоциклети/плавателни съдове.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0080">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="cs">Sdílení údajů</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Data sharing</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Partajarea datelor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Datadelning</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Datenaustausch</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Ανταλλαγή δεδομένων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Intercambio de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Partage de données</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Adatmegosztás</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Condivisione dei dati</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevensdeling</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Udostępnianie danych</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Partilha de dados</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Споделяне на данни</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Datadeling</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Andmete jagamine</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Datan jakaminen</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Comhroinnt sonraí</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Dijeljenje podataka</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Dalijimasis duomenimis</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Datu kopīgošana</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Kondiviżjoni tad-data</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Zdieľanie údajov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Izmenjava podatkov</skos:prefLabel>
    <skos:definition xml:lang="ro">Punerea la dispoziție a datelor de către un deținător de date unui destinatar de date în scopul utilizării comune sau individuale a acestor date, în mod direct sau printr-un intermediar, de exemplu în temeiul unor licențe deschise sau comerciale, cu titlu oneros sau gratuit.</skos:definition>
    <skos:definition xml:lang="en">The provision of data by a data holder to a data recipient for the purpose of the joint or individual use of such data, directly or through an intermediary, for example under open or commercial licences subject to a fee or free of charge.</skos:definition>
    <skos:definition xml:lang="cs">Poskytnutí údajů držitelem údajů příjemci údajů za účelem společného nebo individuálního využití těchto údajů, přímo nebo prostřednictvím zprostředkovatele, například na základě otevřených nebo komerčních licencí za úplatu nebo bezplatně.</skos:definition>
    <skos:definition xml:lang="de">Die Bereitstellung von Daten durch einen Dateninhaber an einen Datenempfänger zum Zwecke der gemeinsamen oder individuellen Nutzung dieser Daten, unmittelbar oder über einen Vermittler, beispielsweise im Rahmen offener oder kommerzieller Lizenzen gegen Entgelt oder unentgeltlich.</skos:definition>
    <skos:definition xml:lang="es">Puesta a disposición de datos por parte de un titular de datos a un destinatario de datos con el fin de hacer un uso conjunto o individual de dichos datos, directamente o a través de un intermediario, por ejemplo, mediante licencias abiertas o comerciales a título oneroso o gratuito.</skos:definition>
    <skos:definition xml:lang="fr">Mise à disposition de données par un détenteur de données à un destinataire de données aux fins de l'utilisation conjointe ou individuelle de ces données, directement ou par l'intermédiaire d'un tiers, par exemple sous licence ouverte ou commerciale, à titre onéreux ou gratuit.</skos:definition>
    <skos:definition xml:lang="hu">Adatoknak az adatok birtokosa általi rendelkezésre bocsátása egy adatátvevő számára ezen adatok közös vagy egyéni felhasználása céljából, közvetlenül vagy közvetítőn keresztül, például nyílt vagy kereskedelmi licencek alapján, díjazás ellenében vagy ingyenesen.</skos:definition>
    <skos:definition xml:lang="it">Messa a disposizione di dati da parte di un detentore dei dati a un destinatario dei dati ai fini dell'uso congiunto o individuale di tali dati, direttamente o tramite un intermediario, ad esempio con licenze aperte o commerciali a titolo oneroso o gratuito.</skos:definition>
    <skos:definition xml:lang="nl">Het verstrekken van gegevens door een gegevenshouder aan een gegevensontvanger met het oog op het gezamenlijke of individuele gebruik van die gegevens, rechtstreeks of via een tussenpersoon, bijvoorbeeld in het kader van open of commerciële licenties tegen vergoeding of kosteloos.</skos:definition>
    <skos:definition xml:lang="pl">Udostępnianie danych przez posiadacza danych odbiorcy danych do celów wspólnego lub indywidualnego korzystania z takich danych, bezpośrednio lub za pośrednictwem pośrednika, na przykład na podstawie licencji otwartych lub komercyjnych odpłatnie lub nieodpłatnie.</skos:definition>
    <skos:definition xml:lang="pt">Disponibilização de dados por um detentor de dados a um destinatário de dados para efeitos da utilização conjunta ou individual desses dados, diretamente ou através de um intermediário, por exemplo ao abrigo de licenças abertas ou comerciais, a título oneroso ou gratuito.</skos:definition>
    <skos:definition xml:lang="sv">Tillhandahållande av data från en datainnehavare till en datamottagare för gemensam eller individuell användning av sådana data, direkt eller via en mellanhand, exempelvis enligt öppna eller kommersiella licenser mot avgift eller kostnadsfritt.</skos:definition>
    <skos:definition xml:lang="el">Η παροχή δεδομένων από κάτοχο δεδομένων σε αποδέκτη δεδομένων για τους σκοπούς της από κοινού ή ατομικής χρήσης των εν λόγω δεδομένων, απευθείας ή μέσω ενδιαμέσου, για παράδειγμα βάσει ανοικτών ή εμπορικών αδειών έναντι αμοιβής ή δωρεάν.</skos:definition>
    <skos:definition xml:lang="da">En dataindehavers tilrådighedsstillelse af data for en datamodtager med henblik på fælles eller individuel anvendelse af sådanne data, direkte eller gennem en mellemmand, f.eks. i henhold til åbne eller kommercielle licenser mod betaling eller gratis.</skos:definition>
    <skos:definition xml:lang="et">Andmevaldaja poolt andmete kättesaadavaks tegemine andmesaajale nende andmete ühiseks või individuaalseks kasutamiseks, otse või vahendaja kaudu, näiteks avatud või kaubanduslike litsentside alusel tasu eest või tasuta.</skos:definition>
    <skos:definition xml:lang="fi">Datan asettaminen datan haltijan toimesta datan vastaanottajan saataville kyseisen datan yhteistä tai yksittäistä käyttöä varten suoraan tai välittäjän kautta esimerkiksi avoimilla tai kaupallisilla lisensseillä maksua vastaan tai maksutta.</skos:definition>
    <skos:definition xml:lang="ga">Sonraí a chur ar fáil ag sealbhóir sonraí d'fhaighteoir sonraí chun na sonraí sin a úsáid go comhpháirteach nó go haonarach, go díreach nó trí idirghabhálaí, mar shampla faoi cheadúnais oscailte nó tráchtála ar tháille nó saor in aisce.</skos:definition>
    <skos:definition xml:lang="hr">Pružanje podataka koje posjednik podataka stavlja na raspolaganje primatelju podataka u svrhu zajedničke ili pojedinačne uporabe tih podataka, izravno ili putem posrednika, primjerice na temelju otvorenih ili komercijalnih licencija uz naknadu ili besplatno.</skos:definition>
    <skos:definition xml:lang="lt">Duomenų valdytojo atliekamas duomenų teikimas duomenų gavėjui, kad tais duomenimis būtų bendrai arba atskirai naudojamasi, tiesiogiai arba per tarpininką, pavyzdžiui, pagal atvirąsias arba komercines licencijas už atlygį arba nemokamai.</skos:definition>
    <skos:definition xml:lang="lv">Datu sniegšana, ko datu turētājs veic datu saņēmējam šo datu kopīgai vai individuālai izmantošanai, tieši vai ar starpnieka palīdzību, piemēram, saskaņā ar atvērtām vai komerciālām licencēm par maksu vai bez maksas.</skos:definition>
    <skos:definition xml:lang="mt">It-tqegħid għad-dispożizzjoni tad-data minn detentur tad-data lil riċevitur tad-data għall-finijiet tal-użu konġunt jew individwali ta' tali data, direttament jew permezz ta' intermedjarju, pereżempju taħt liċenzji miftuħa jew kummerċjali bi ħlas jew mingħajr ħlas.</skos:definition>
    <skos:definition xml:lang="sl">Zagotavljanje podatkov s strani imetnika podatkov prejemniku podatkov za skupno ali individualno uporabo teh podatkov, neposredno ali prek posrednika, na primer na podlagi odprtih ali komercialnih licenc proti plačilu ali brezplačno.</skos:definition>
    <skos:definition xml:lang="bg">Предоставянето на данни от притежател на данни на получател на данни с цел съвместно или индивидуално използване на тези данни, пряко или чрез посредник, например по силата на отворени или търговски лицензи срещу заплащане или безплатно.</skos:definition>
    <skos:definition xml:lang="sk">Poskytnutie údajov držiteľom údajov príjemcovi údajov na účely spoločného alebo individuálneho využívania týchto údajov, priamo alebo prostredníctvom sprostredkovateľa, napríklad na základe otvorených alebo komerčných licencií za odplatu alebo bezodplatne.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_2</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0061">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Rules for ticket issuing and ticket inspections</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Regeln für die Fahrkartenausstellung und Fahrkartenkontrolle</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Κανόνες για την έκδοση και τον έλεγχο εισιτηρίων</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Normas de emisión e inspección de billetes</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Règles d'émission et de contrôle des billets</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A jegykiadásra és a jegyellenőrzésre vonatkozó szabályok</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Regole per l'emissione e il controllo dei biglietti</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Regels voor de afgifte en controle van vervoerbewijzen</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Zasady wystawiania i kontroli biletów</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Regras de emissão e inspeção de bilhetes</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Norme privind emiterea și controlul biletelor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Regler för utfärdande och kontroll av biljetter</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Pravidla pro vydávání a kontrolu jízdenek</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Regler for udstedelse og kontrol af billetter</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Piletite väljaandmise ja kontrollimise reeglid</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Lippujen myöntämistä ja tarkastamista koskevat säännöt</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Rialacha maidir le heisiúint agus iniúchadh ticéad</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Pravila o izdavanju i kontroli karata</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Bilietų išdavimo ir tikrinimo taisyklės</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Biļešu izsniegšanas un kontroles noteikumi</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Regoli għall-ħruġ u l-kontroll tal-biljetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Pravidlá pre vydávanie a kontrolu cestovných lístkov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Pravila za izdajo in nadzor vozovnic</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Правила за издаване и контрол на билети</skos:prefLabel>
    <skos:definition xml:lang="fr">Données établissant les règles régissant l'émission des billets et le contrôle des billets.</skos:definition>
    <skos:definition xml:lang="en">Data establishing the rules governing the issuing of tickets and the inspection of tickets.</skos:definition>
    <skos:definition xml:lang="cs">Údaje stanovící pravidla upravující vydávání jízdenek a kontrolu jízdenek.</skos:definition>
    <skos:definition xml:lang="de">Daten zur Festlegung der Regeln für die Ausstellung von Fahrkarten und die Kontrolle von Fahrkarten.</skos:definition>
    <skos:definition xml:lang="el">Δεδομένα που καθορίζουν τους κανόνες που διέπουν την έκδοση εισιτηρίων και τον έλεγχο εισιτηρίων.</skos:definition>
    <skos:definition xml:lang="es">Datos que establecen las normas que rigen la emisión de billetes y la inspección de billetes.</skos:definition>
    <skos:definition xml:lang="hu">Olyan adatok, amelyek megállapítják a jegyek kiadását és a jegyek ellenőrzését szabályozó szabályokat.</skos:definition>
    <skos:definition xml:lang="it">Dati che stabiliscono le regole che disciplinano l'emissione dei biglietti e il controllo dei biglietti.</skos:definition>
    <skos:definition xml:lang="nl">Gegevens die de regels vaststellen voor de afgifte van vervoerbewijzen en de controle van vervoerbewijzen.</skos:definition>
    <skos:definition xml:lang="pl">Dane określające zasady regulujące wystawianie biletów i kontrolę biletów.</skos:definition>
    <skos:definition xml:lang="pt">Dados que estabelecem as regras que regem a emissão de bilhetes e a inspeção de bilhetes.</skos:definition>
    <skos:definition xml:lang="ro">Date care stabilesc normele care reglementează emiterea biletelor și controlul biletelor.</skos:definition>
    <skos:definition xml:lang="sv">Uppgifter som fastställer reglerna för utfärdande av biljetter och kontroll av biljetter.</skos:definition>
    <skos:definition xml:lang="bg">Данни, с които се установяват правилата, уреждащи издаването на билети и контрола на билети.</skos:definition>
    <skos:definition xml:lang="da">Data, der fastlægger reglerne for udstedelse af billetter og kontrol af billetter.</skos:definition>
    <skos:definition xml:lang="et">Andmed, millega kehtestatakse piletite väljaandmist ja piletite kontrollimist reguleerivad reeglid.</skos:definition>
    <skos:definition xml:lang="fi">Tiedot, joilla vahvistetaan lippujen myöntämistä ja lippujen tarkastamista koskevat säännöt.</skos:definition>
    <skos:definition xml:lang="ga">Sonraí lena mbunaítear na rialacha lena rialaítear eisiúint ticéad agus iniúchadh ticéad.</skos:definition>
    <skos:definition xml:lang="hr">Podaci kojima se utvrđuju pravila kojima se uređuju izdavanje karata i kontrola karata.</skos:definition>
    <skos:definition xml:lang="lt">Duomenys, kuriais nustatomos bilietų išdavimą ir bilietų tikrinimą reglamentuojančios taisyklės.</skos:definition>
    <skos:definition xml:lang="lv">Dati, ar kuriem nosaka biļešu izsniegšanu un biļešu kontroli reglamentējošos noteikumus.</skos:definition>
    <skos:definition xml:lang="mt">Data li tistabbilixxi r-regoli li jirregolaw il-ħruġ tal-biljetti u l-kontroll tal-biljetti.</skos:definition>
    <skos:definition xml:lang="sk">Údaje stanovujúce pravidlá upravujúce vydávanie cestovných lístkov a kontrolu cestovných lístkov.</skos:definition>
    <skos:definition xml:lang="sl">Podatki, ki določajo pravila, ki urejajo izdajo vozovnic in nadzor vozovnic.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0093">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Freight customer</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Cliente del trasporto merci</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Goederenklant</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Klient towarowy</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Cliente do transporte de mercadorias</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Client al transportului de marfă</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Godskund</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Zákazník nákladní dopravy</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Güterkunde</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Πελάτης εμπορευματικών μεταφορών</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Cliente del transporte de mercancías</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Client du fret</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Árufuvarozási ügyfél</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Клиент на товарен превоз</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Godskunde</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Kaubaveoklient</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tavaraliikenteen asiakas</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Custaiméir lasta</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Kupac u prijevozu tereta</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Krovinių vežimo klientas</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Kravu pārvadājumu klients</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Klijent tal-merkanzija</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Zákazník nákladnej dopravy</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Stranka tovornega prevoza</skos:prefLabel>
    <skos:definition xml:lang="ro">Entitatea care a emis informațiile privind expedierea către întreprinderea feroviară de marfă și care a încheiat un contract de transport; poate fi un furnizor de servicii logistice, un operator de transport intermodal, un expeditor, un gestionar al parcului de vagoane goale sau deținătorul datelor.</skos:definition>
    <skos:definition xml:lang="hu">Az a szervezet, amely a küldeményinformációkat a vasúti árufuvarozási társaságnak kibocsátotta, és amely fuvarozási szerződést kötött; lehet logisztikai szolgáltató, intermodális fuvarozási szolgáltató, szállítmányozó, üres vagonok flottakezelője vagy az adatok birtokosa.</skos:definition>
    <skos:definition xml:lang="it">Soggetto che ha trasmesso le informazioni sulla spedizione all'impresa ferroviaria merci e che ha concluso un contratto di trasporto; può essere un prestatore di servizi logistici, un operatore del trasporto intermodale, uno spedizioniere, un gestore della flotta di carri vuoti o il detentore dei dati.</skos:definition>
    <skos:definition xml:lang="nl">De entiteit die zendingsinformatie aan de goederenspoorwegonderneming heeft verstrekt en een vervoersovereenkomst heeft gesloten; kan een logistiekedienstverlener, een intermodale vervoersexploitant, een expediteur, een vlootbeheerder van lege wagens of de gegevenshouder zijn.</skos:definition>
    <skos:definition xml:lang="pt">Entidade que emitiu informações de expedição à empresa ferroviária de mercadorias e que celebrou um contrato de transporte; pode ser um prestador de serviços logísticos, um operador de transporte intermodal, um transitário, um gestor de frota de vagões vazios ou o detentor dos dados.</skos:definition>
    <skos:definition xml:lang="cs">Subjekt, který vydal informace o zásilce nákladnímu železničnímu podniku a který uzavřel přepravní smlouvu; může jím být poskytovatel logistických služeb, provozovatel intermodální dopravy, zasílatel, správce vozového parku prázdných vozů nebo držitel údajů.</skos:definition>
    <skos:definition xml:lang="de">Die Stelle, die dem Eisenbahnunternehmen des Güterverkehrs Sendungsinformationen übermittelt hat und einen Beförderungsvertrag geschlossen hat; kann ein Logistikdienstleister, ein intermodaler Verkehrsbetreiber, ein Spediteur, ein Flottenmanager leerer Wagen oder der Dateninhaber sein.</skos:definition>
    <skos:definition xml:lang="en">The entity that has issued consignment information to the freight railway undertaking and has concluded a contract of carriage; may be a logistics service provider, intermodal transport operator, freight forwarder, fleet manager of empty wagons, or the data holder.</skos:definition>
    <skos:definition xml:lang="es">Entidad que ha transmitido la información de la expedición a la empresa ferroviaria de mercancías y que ha celebrado un contrato de transporte; puede ser un proveedor de servicios logísticos, un operador de transporte intermodal, un transitario, un gestor de flota de vagones vacíos o el titular de los datos.</skos:definition>
    <skos:definition xml:lang="fr">Entité ayant transmis les informations relatives à l'envoi à l'entreprise ferroviaire de fret et ayant conclu un contrat de transport; il peut s'agir d'un prestataire de services logistiques, d'un opérateur de transport intermodal, d'un commissionnaire de transport, d'un gestionnaire de flotte de wagons vides ou du détenteur des données.</skos:definition>
    <skos:definition xml:lang="pl">Podmiot, który przekazał informacje o przesyłce towarowemu przedsiębiorstwu kolejowemu i zawarł umowę przewozu; może nim być dostawca usług logistycznych, operator transportu intermodalnego, spedytor, zarządca floty pustych wagonów lub posiadacz danych.</skos:definition>
    <skos:definition xml:lang="sv">Den enhet som har utfärdat sändningsinformationen till järnvägsföretaget för godstransport och som har ingått ett transportavtal; kan vara en logistiktjänsteleverantör, en verksamhetsutövare för intermodala transporter, en speditör, en flottförvaltare för tomma vagnar eller datainnehavaren.</skos:definition>
    <skos:definition xml:lang="bg">Субектът, който е издал информацията за пратката на железопътното предприятие за товарен превоз и който е сключил договор за превоз; може да бъде доставчик на логистични услуги, оператор на интермодален превоз, спедитор, управител на парк от празни вагони или притежателят на данните.</skos:definition>
    <skos:definition xml:lang="lv">Subjekts, kas izdevis sūtījuma informāciju dzelzceļa kravu pārvadājumu uzņēmumam un kas noslēdzis pārvadājuma līgumu; tas var būt loģistikas pakalpojumu sniedzējs, intermodālo pārvadājumu operators, ekspeditors, tukšo vagonu parka pārvaldītājs vai datu turētājs.</skos:definition>
    <skos:definition xml:lang="mt">L-entità li tkun ħarġet l-informazzjoni dwar il-konsenja lill-impriża ferrovjarja tal-merkanzija u li tkun ikkonkludiet kuntratt tat-trasport; tista' tkun fornitur ta' servizzi loġistiċi, operatur tat-trasport intermodali, spedizzjonier, maniġer tal-flotta ta' vaguni vojta jew id-detentur tad-data.</skos:definition>
    <skos:definition xml:lang="sk">Subjekt, ktorý vydal informácie o zásielke nákladnému železničnému podniku a ktorý uzavrel prepravnú zmluvu; môže ním byť poskytovateľ logistických služieb, prevádzkovateľ intermodálnej dopravy, zasielateľ, správca vozového parku prázdnych vozňov alebo držiteľ údajov.</skos:definition>
    <skos:definition xml:lang="sl">Subjekt, ki je izdal informacije o pošiljki prevozniku v železniškem tovornem prometu in je sklenil prevozno pogodbo; lahko je ponudnik logističnih storitev, izvajalec intermodalnega prevoza, špediter, upravljavec voznega parka praznih vagonov ali imetnik podatkov.</skos:definition>
    <skos:definition xml:lang="et">Üksus, kes on edastanud saadetise teabe raudtee-kaubaveo-ettevõtjale ja kes on sõlminud veolepingu; selleks võib olla logistikateenuse osutaja, intermodaalveo operaator, ekspedeerija, tühjade vagunite pargi haldaja või andmevaldaja.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on antanut lähetystiedot rautateiden tavaraliikenneyritykselle ja joka on tehnyt kuljetussopimuksen; voi olla logistiikkapalvelujen tarjoaja, intermodaalikuljetusten harjoittaja, huolitsija, tyhjien vaunujen kalustonhaltija tai datan haltija.</skos:definition>
    <skos:definition xml:lang="ga">An t-eintiteas a d'eisigh an fhaisnéis maidir leis an gcoinsíneacht chuig an ngnóthas iarnróid lasta agus a thug conradh iompair i gcrích; féadfaidh sé a bheith ina sholáthraí seirbhísí lóistíochta, ina oibreoir iompair idirmhódúil, ina choinsíneoir, ina bhainisteoir cabhlaigh vaigíní folmha nó ina shealbhóir sonraí.</skos:definition>
    <skos:definition xml:lang="hr">Subjekt koji je izdao informacije o pošiljci željezničkom prijevozniku tereta i koji je sklopio ugovor o prijevozu; može biti pružatelj logističkih usluga, operater intermodalnog prijevoza, otpremnik, upravitelj voznog parka praznih vagona ili posjednik podataka.</skos:definition>
    <skos:definition xml:lang="lt">Subjektas, pateikęs siuntos informaciją geležinkelių krovinių vežimo įmonei ir sudaręs vežimo sutartį; juo gali būti logistikos paslaugų teikėjas, įvairiarūšio vežimo operatorius, ekspeditorius, tuščių vagonų parko valdytojas arba duomenų valdytojas.</skos:definition>
    <skos:definition xml:lang="da">Den enhed, der har udstedt forsendelsesoplysningerne til jernbanegodsvirksomheden, og som har indgået en befordringsaftale; kan være en logistiktjenesteyder, en operatør af intermodal transport, en speditør, en flådeforvalter af tomme vogne eller dataindehaveren.</skos:definition>
    <skos:definition xml:lang="el">Η οντότητα που έχει εκδώσει τις πληροφορίες αποστολής προς τη σιδηροδρομική επιχείρηση εμπορευμάτων και έχει συνάψει σύμβαση μεταφοράς· μπορεί να είναι πάροχος υπηρεσιών εφοδιαστικής, φορέας εκμετάλλευσης διατροπικών μεταφορών, παραγγελιοδόχος μεταφοράς, διαχειριστής στόλου κενών βαγονιών ή ο κάτοχος των δεδομένων.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_35</dct:source>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0027">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Geo-localisation of freight wagons</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geolokalisatie van goederenwagens</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Geolokalizace nákladních vozů</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geolokalisierung von Güterwagen</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Γεωεντοπισμός εμπορευματικών βαγονιών</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Geolocalización de los vagones de mercancías</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Géolocalisation des wagons de fret</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Tehervagonok geolokalizációja</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Geolocalizzazione dei carri merci</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Geolocalizarea vagoanelor de marfă</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Geolokalisering av godsvagnar</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Geolokalizacja wagonów towarowych</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Geolocalização dos vagões de mercadorias</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Геолокализация на товарните вагони</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Geolokalisering af godsvogne</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Kaubavagunite geolokaliseerimine</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tavaravaunujen paikannus</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Geolóchianú vaigíní lasta</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Geolokalizacija teretnih vagona</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Prekinių vagonų geografinė lokalizacija</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Kravas vagonu ģeolokalizācija</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Ġeolokalizzazzjoni tal-vaguni tal-merkanzija</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Geolokalizácia nákladných vozňov</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Geolokalizacija tovornih vagonov</skos:prefLabel>
    <skos:definition xml:lang="en">Wagon event conveying the geographic position of a freight wagon.</skos:definition>
    <skos:definition xml:lang="it">Evento del carro che trasmette la posizione geografica di un carro merci.</skos:definition>
    <skos:definition xml:lang="fr">Événement de wagon transmettant la position géographique d'un wagon de fret.</skos:definition>
    <skos:definition xml:lang="es">Evento del vagón que transmite la posición geográfica de un vagón de mercancías.</skos:definition>
    <skos:definition xml:lang="hu">Kocsiesemény, amely egy tehervagon földrajzi helyzetét továbbítja.</skos:definition>
    <skos:definition xml:lang="cs">Událost vozu předávající zeměpisnou polohu nákladního vozu.</skos:definition>
    <skos:definition xml:lang="de">Wagenereignis zur Übermittlung der geografischen Position eines Güterwagens.</skos:definition>
    <skos:definition xml:lang="el">Συμβάν βαγονιού που διαβιβάζει τη γεωγραφική θέση ενός εμπορευματικού βαγονιού.</skos:definition>
    <skos:definition xml:lang="nl">Wagengebeurtenis die de geografische positie van een goederenwagen doorgeeft.</skos:definition>
    <skos:definition xml:lang="pl">Zdarzenie wagonu przekazujące położenie geograficzne wagonu towarowego.</skos:definition>
    <skos:definition xml:lang="pt">Evento de vagão que transmite a posição geográfica de um vagão de mercadorias.</skos:definition>
    <skos:definition xml:lang="ro">Eveniment de vagon care transmite poziția geografică a unui vagon de marfă.</skos:definition>
    <skos:definition xml:lang="sv">Vagnhändelse som överför en godsvagns geografiska position.</skos:definition>
    <skos:definition xml:lang="bg">Събитие на вагона, с което се предава географското положение на товарен вагон.</skos:definition>
    <skos:definition xml:lang="da">Vognhændelse, der overfører en godsvogns geografiske position.</skos:definition>
    <skos:definition xml:lang="et">Vagunisündmus, millega edastatakse kaubavaguni geograafiline asukoht.</skos:definition>
    <skos:definition xml:lang="fi">Vaunutapahtuma, jolla välitetään tavaravaunun maantieteellinen sijainti.</skos:definition>
    <skos:definition xml:lang="ga">Teagmhas vaigín lena ndéantar suíomh geografach vaigín lasta a tharchur.</skos:definition>
    <skos:definition xml:lang="hr">Događaj vagona kojim se prenosi zemljopisni položaj teretnog vagona.</skos:definition>
    <skos:definition xml:lang="lt">Vagono įvykis, kuriuo perduodama prekinio vagono geografinė padėtis.</skos:definition>
    <skos:definition xml:lang="lv">Vagona notikums, ar kuru nodod kravas vagona ģeogrāfisko atrašanās vietu.</skos:definition>
    <skos:definition xml:lang="mt">Avveniment tal-vagun li jittrażmetti l-pożizzjoni ġeografika ta' vagun tal-merkanzija.</skos:definition>
    <skos:definition xml:lang="sk">Udalosť vozňa prenášajúca geografickú polohu nákladného vozňa.</skos:definition>
    <skos:definition xml:lang="sl">Dogodek vagona, ki posreduje geografski položaj tovornega vagona.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0059">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Offer</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Nabídka</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Angebot</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Προσφορά</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Oferta</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Ajánlat</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Offerta</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Aanbod</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Oferta</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Oferta</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Ofertă</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Erbjudande</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Offre</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Offerta</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Ponuka</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Ponudba</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Tilbud</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Pakkumine</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Tairiscint</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Ponuda</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Pasiūlymas</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Piedāvājums</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Оферта</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tarjous</skos:prefLabel>
    <skos:definition xml:lang="cs">Agregované údaje stanovené distributorem, které kombinují použitelné tarify, s cenou železničního produktu, kterou maloobchodník dluží distributorovi.</skos:definition>
    <skos:definition xml:lang="el">Συγκεντρωτικά δεδομένα που καταρτίζονται από διανομέα και συνδυάζουν τα ισχύοντα τιμολόγια, με την τιμή του σιδηροδρομικού προϊόντος που οφείλεται από τον λιανοπωλητή στον διανομέα.</skos:definition>
    <skos:definition xml:lang="en">Aggregated data established by a distributor combining applicable tariffs, with the rail-product price due by the retailer to the distributor.</skos:definition>
    <skos:definition xml:lang="sv">Aggregerade uppgifter som fastställs av en distributör och som kombinerar tillämpliga tariffer, med det pris för järnvägsprodukten som återförsäljaren är skyldig distributören.</skos:definition>
    <skos:definition xml:lang="de">Von einem Vertreiber erstellte aggregierte Daten, die anwendbare Tarife kombinieren, mit dem vom Einzelhändler an den Vertreiber zu zahlenden Preis des Bahnprodukts.</skos:definition>
    <skos:definition xml:lang="es">Datos agregados establecidos por un distribuidor que combinan las tarifas aplicables, con el precio del producto ferroviario que el minorista debe abonar al distribuidor.</skos:definition>
    <skos:definition xml:lang="fr">Données agrégées établies par un distributeur combinant les tarifs applicables, avec le prix du produit ferroviaire dû par le détaillant au distributeur.</skos:definition>
    <skos:definition xml:lang="hu">Egy forgalmazó által megállapított összesített adatok, amelyek az alkalmazandó tarifákat kombinálják, a vasúti terméknek a kiskereskedő által a forgalmazónak fizetendő árával.</skos:definition>
    <skos:definition xml:lang="it">Dati aggregati stabiliti da un distributore che combinano le tariffe applicabili, con il prezzo del prodotto ferroviario dovuto dal rivenditore al distributore.</skos:definition>
    <skos:definition xml:lang="nl">Door een distributeur vastgestelde geaggregeerde gegevens die toepasselijke tarieven combineren, met de door de detailhandelaar aan de distributeur verschuldigde prijs van het spoorproduct.</skos:definition>
    <skos:definition xml:lang="pl">Zagregowane dane ustalone przez dystrybutora łączące mające zastosowanie taryfy, wraz z ceną produktu kolejowego należną od sprzedawcy detalicznego dystrybutorowi.</skos:definition>
    <skos:definition xml:lang="pt">Dados agregados estabelecidos por um distribuidor que combinam as tarifas aplicáveis, com o preço do produto ferroviário devido pelo retalhista ao distribuidor.</skos:definition>
    <skos:definition xml:lang="ro">Date agregate stabilite de un distribuitor care combină tarifele aplicabile, cu prețul produsului feroviar datorat de comerciantul cu amănuntul distribuitorului.</skos:definition>
    <skos:definition xml:lang="bg">Агрегирани данни, установени от дистрибутор, които комбинират приложимите тарифи, с цената на железопътния продукт, дължима от търговеца на дребно на дистрибутора.</skos:definition>
    <skos:definition xml:lang="da">Aggregerede data, der fastlægges af en distributør, og som kombinerer de gældende tariffer, med den pris for jernbaneproduktet, som detailhandleren skylder distributøren.</skos:definition>
    <skos:definition xml:lang="et">Koondatud andmed, mille kehtestab turustaja ja mis ühendavad kohaldatavaid tariife, koos raudteetoote hinnaga, mille jaemüüja võlgneb turustajale.</skos:definition>
    <skos:definition xml:lang="fi">Jakelijan vahvistamat koostetut tiedot, joissa yhdistetään sovellettavat tariffit, ja joihin sisältyy rautatietuotteen hinta, jonka vähittäismyyjä on velkaa jakelijalle.</skos:definition>
    <skos:definition xml:lang="ga">Sonraí comhiomlánaithe arna mbunú ag dáileoir lena gcomhcheanglaítear na taraifí is infheidhme, le praghas an táirge iarnróid atá dlite ag an miondíoltóir don dáileoir.</skos:definition>
    <skos:definition xml:lang="hr">Skupni podaci koje utvrđuje distributer i kojima se kombiniraju primjenjive tarife, s cijenom željezničkog proizvoda koju trgovac na malo duguje distributeru.</skos:definition>
    <skos:definition xml:lang="lt">Suvestiniai duomenys, kuriuos nustato platintojas ir kuriuose derinami taikytini tarifai, su geležinkelių produkto kaina, kurią mažmenininkas turi sumokėti platintojui.</skos:definition>
    <skos:definition xml:lang="mt">Data aggregata stabbilita minn distributur li tikkombina t-tariffi applikabbli, bil-prezz tal-prodott ferrovjarju dovut min-negozjant bl-imnut lid-distributur.</skos:definition>
    <skos:definition xml:lang="sk">Agregované údaje stanovené distribútorom, ktoré kombinujú uplatniteľné tarify, s cenou železničného produktu, ktorú maloobchodník dlhuje distribútorovi.</skos:definition>
    <skos:definition xml:lang="sl">Združeni podatki, ki jih določi distributer in združujejo veljavne tarife, s ceno železniškega proizvoda, ki jo trgovec na drobno dolguje distributerju.</skos:definition>
    <skos:definition xml:lang="lv">Apkopoti dati, ko nosaka izplatītājs un kas apvieno piemērojamos tarifus, ar dzelzceļa produkta cenu, ko mazumtirgotājs ir parādā izplatītājam.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_44</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0056">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Passenger timetable</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Jízdní řád pro cestující</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Personenfahrplan</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Πίνακας δρομολογίων επιβατών</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Horario de viajeros</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Utasmenetrend</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Orario passeggeri</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Rozkład jazdy dla pasażerów</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Horário de passageiros</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Orarul pentru călători</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Resenärstidtabell</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Horaire des voyageurs</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Reizigersdienstregeling</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Passagerkøreplan</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Reisijate sõidugraafik</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Amchlár paisinéirí</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Vozni red za putnike</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Skeda tal-passiġġieri</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Cestovný poriadok pre cestujúcich</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Разписание за пътници</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Matkustaja-aikataulu</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Pasažieru kustības grafiks</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Vozni red za potnike</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Keleivių tvarkaraštis</skos:prefLabel>
    <skos:definition xml:lang="en">The date and time of passenger rail transport services operated as a commercial service by a railway undertaking during a given time interval, used in the context of rail ticketing and rail passenger travel information referred to in Section 4 of the Annex.</skos:definition>
    <skos:definition xml:lang="pt">Data e hora dos serviços de transporte ferroviário de passageiros explorados como serviço comercial por uma empresa ferroviária durante um determinado intervalo de tempo, utilizados no contexto da bilhética ferroviária e da informação de viagem aos passageiros referida na secção 4 do anexo.</skos:definition>
    <skos:definition xml:lang="ro">Data și ora serviciilor de transport feroviar de călători exploatate ca serviciu comercial de către o întreprindere feroviară într-un anumit interval de timp, utilizate în contextul emiterii biletelor feroviare și al informării privind călătoria pentru călători menționate în secțiunea 4 din anexă.</skos:definition>
    <skos:definition xml:lang="sv">Datum och tid för de persontrafiktjänster på järnväg som ett järnvägsföretag bedriver som kommersiell tjänst under ett visst tidsintervall, vilka används i samband med järnvägsbiljettförsäljning och reseinformation för resenärer som avses i avsnitt 4 i bilagan.</skos:definition>
    <skos:definition xml:lang="de">Datum und Uhrzeit der von einem Eisenbahnunternehmen als kommerzieller Dienst betriebenen Schienenpersonenverkehrsdienste während eines bestimmten Zeitraums, die im Zusammenhang mit dem Bahnticketing und der Reiseinformation für Fahrgäste gemäß Abschnitt 4 des Anhangs verwendet werden.</skos:definition>
    <skos:definition xml:lang="nl">De datum en tijd van de door een spoorwegonderneming als commerciële dienst geëxploiteerde reizigersvervoersdiensten gedurende een bepaald tijdsinterval, gebruikt in het kader van spoorticketing en reisinformatie voor reizigers als bedoeld in afdeling 4 van de bijlage.</skos:definition>
    <skos:definition xml:lang="pl">Data i godzina kolejowych przewozów pasażerskich realizowanych jako usługa komercyjna przez przedsiębiorstwo kolejowe w danym przedziale czasowym, wykorzystywane w kontekście sprzedaży biletów kolejowych i informacji o podróży dla pasażerów, o których mowa w sekcji 4 załącznika.</skos:definition>
    <skos:definition xml:lang="da">Dato og klokkeslæt for de jernbanepassagertransporttjenester, der drives som en kommerciel tjeneste af en jernbanevirksomhed i et givet tidsinterval, og som anvendes i forbindelse med jernbanebilletter og rejseinformation til passagerer som omhandlet i afdeling 4 i bilaget.</skos:definition>
    <skos:definition xml:lang="fi">Rautatieyrityksen kaupallisena palveluna tietyn aikavälin aikana liikennöimien rautateiden henkilöliikennepalvelujen päivämäärä ja kellonaika, joita käytetään liitteen 4 jaksossa tarkoitetun rautatielippujen myynnin ja matkustajille tarkoitettujen matkatietojen yhteydessä.</skos:definition>
    <skos:definition xml:lang="lt">Geležinkelių keleivių vežimo paslaugų, kurias geležinkelio įmonė teikia kaip komercinę paslaugą tam tikru laikotarpiu, data ir laikas, naudojami geležinkelių bilietų pardavimo ir keleiviams skirtos kelionės informacijos, nurodytų priedo 4 skirsnyje, kontekste.</skos:definition>
    <skos:definition xml:lang="lv">Datums un laiks dzelzceļa pasažieru pārvadājumu pakalpojumiem, ko dzelzceļa pārvadājumu uzņēmums kā komerciālu pakalpojumu sniedz noteiktā laika intervālā un ko izmanto saistībā ar dzelzceļa biļešu pārdošanu un pielikuma 4. iedaļā minēto ceļojuma informāciju pasažieriem.</skos:definition>
    <skos:definition xml:lang="sk">Dátum a čas služieb železničnej osobnej dopravy prevádzkovaných ako komerčná služba železničným podnikom počas daného časového intervalu, ktoré sa používajú v kontexte predaja železničných cestovných lístkov a informácií o cestovaní pre cestujúcich uvedených v oddiele 4 prílohy.</skos:definition>
    <skos:definition xml:lang="sl">Datum in čas storitev železniškega potniškega prevoza, ki jih prevoznik v železniškem prometu opravlja kot komercialno storitev v določenem časovnem intervalu in se uporabljajo v okviru izdaje železniških vozovnic ter informacij o potovanju za potnike iz oddelka 4 Priloge.</skos:definition>
    <skos:definition xml:lang="mt">Id-data u l-ħin tas-servizzi tat-trasport ferrovjarju tal-passiġġieri operati bħala servizz kummerċjali minn impriża ferrovjarja matul intervall ta' żmien partikolari, użati fil-kuntest tal-ħruġ tal-biljetti ferrovjarji u tal-informazzjoni dwar l-ivvjaġġar għall-passiġġieri msemmija fit-Taqsima 4 tal-Anness.</skos:definition>
    <skos:definition xml:lang="et">Raudteereisijateveoteenuste, mida raudteeveo-ettevõtja osutab kommertsteenusena teataval ajavahemikul, kuupäev ja kellaaeg, mida kasutatakse seoses raudteepiletimüügi ja lisa 4. jaos osutatud reisijatele mõeldud reisiteabega.</skos:definition>
    <skos:definition xml:lang="bg">Датата и часът на услугите за железопътен превоз на пътници, извършвани като търговска услуга от железопътно предприятие през даден интервал от време, използвани в контекста на издаването на железопътни билети и информацията за пътуване за пътниците, посочени в раздел 4 от приложението.</skos:definition>
    <skos:definition xml:lang="es">Fecha y hora de los servicios de transporte ferroviario de viajeros operados como servicio comercial por una empresa ferroviaria durante un intervalo de tiempo determinado, utilizados en el contexto de la venta de billetes ferroviarios y la información de viaje para los viajeros a que se refiere la sección 4 del anexo.</skos:definition>
    <skos:definition xml:lang="cs">Datum a čas služeb železniční přepravy cestujících provozovaných jako komerční služba železničním podnikem během daného časového intervalu, používané v kontextu odbavení v železniční dopravě a informací o cestování pro cestující uvedených v oddíle 4 přílohy.</skos:definition>
    <skos:definition xml:lang="el">Η ημερομηνία και η ώρα των υπηρεσιών σιδηροδρομικής μεταφοράς επιβατών που εκτελούνται ως εμπορική υπηρεσία από σιδηροδρομική επιχείρηση κατά τη διάρκεια συγκεκριμένου χρονικού διαστήματος, οι οποίες χρησιμοποιούνται στο πλαίσιο της έκδοσης σιδηροδρομικών εισιτηρίων και των πληροφοριών ταξιδιού για τους επιβάτες που αναφέρονται στο τμήμα 4 του παραρτήματος.</skos:definition>
    <skos:definition xml:lang="fr">Date et heure des services de transport ferroviaire de voyageurs exploités en tant que service commercial par une entreprise ferroviaire pendant un intervalle de temps donné, utilisés dans le contexte de la billettique ferroviaire et de l'information sur les voyages des voyageurs visés à la section 4 de l'annexe.</skos:definition>
    <skos:definition xml:lang="ga">Dáta agus am na seirbhísí iompair iarnróid do phaisinéirí arna n-oibriú mar sheirbhís tráchtála ag gnóthas iarnróid le linn eatramh ama áirithe, a úsáidtear i gcomhthéacs eisiúint ticéad iarnróid agus na faisnéise taistil do phaisinéirí dá dtagraítear i Roinn 4 den Iarscríbhinn.</skos:definition>
    <skos:definition xml:lang="hr">Datum i vrijeme usluga željezničkog prijevoza putnika koje željeznički prijevoznik obavlja kao komercijalnu uslugu tijekom danog vremenskog intervala, koji se upotrebljavaju u kontekstu izdavanja željezničkih karata i informacija o putovanju za putnike iz odjeljka 4. Priloga.</skos:definition>
    <skos:definition xml:lang="hu">Egy vasúti társaság által egy adott időintervallumban kereskedelmi szolgáltatásként üzemeltetett vasúti személyszállítási szolgáltatások időpontja, amelyeket a vasúti jegykezelés és a melléklet 4. szakaszában említett, utasoknak szóló utazási információk keretében használnak.</skos:definition>
    <skos:definition xml:lang="it">Data e ora dei servizi di trasporto ferroviario di passeggeri operati come servizio commerciale da un'impresa ferroviaria durante un determinato intervallo di tempo, utilizzati nel contesto della biglietteria ferroviaria e dell'informazione di viaggio per i passeggeri di cui alla sezione 4 dell'allegato.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_33</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0100">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="cs">Úplnost (rozměr kvality údajů)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Vollständigkeit (Datenqualitätsdimension)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Πληρότητα (διάσταση ποιότητας δεδομένων)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Completeness (data quality dimension)</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Exhaustividad (dimensión de la calidad de los datos)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Exhaustivité (dimension de qualité des données)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Teljesség (adatminőségi dimenzió)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Completezza (dimensione della qualità dei dati)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Volledigheid (gegevenskwaliteitsdimensie)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Kompletność (wymiar jakości danych)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Exaustividade (dimensão da qualidade dos dados)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Exhaustivitate (dimensiune a calității datelor)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Fullständighet (datakvalitetsdimension)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Пълнота (измерение на качеството на данните)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Fuldstændighed (datakvalitetsdimension)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Täielikkus (andmekvaliteedi mõõde)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Täydellisyys (datan laadun ulottuvuus)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Iomláine (gné de cháilíocht sonraí)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Išsamumas (duomenų kokybės aspektas)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Pilnīgums (datu kvalitātes dimensija)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Kompletezza (dimensjoni tal-kwalità tad-data)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Úplnosť (rozmer kvality údajov)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Popolnost (razsežnost kakovosti podatkov)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Potpunost (dimenzija kvalitete podataka)</skos:prefLabel>
    <skos:definition xml:lang="en">Data quality dimension expressing the degree to which all required data is present.</skos:definition>
    <skos:definition xml:lang="cs">Rozměr kvality údajů vyjadřující míru, v jaké jsou přítomny všechny požadované údaje.</skos:definition>
    <skos:definition xml:lang="de">Datenqualitätsdimension, die den Grad ausdrückt, in dem alle erforderlichen Daten vorhanden sind.</skos:definition>
    <skos:definition xml:lang="el">Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο είναι παρόντα όλα τα απαιτούμενα δεδομένα.</skos:definition>
    <skos:definition xml:lang="es">Dimensión de la calidad de los datos que expresa el grado en que están presentes todos los datos requeridos.</skos:definition>
    <skos:definition xml:lang="fr">Dimension de qualité des données exprimant le degré auquel toutes les données requises sont présentes.</skos:definition>
    <skos:definition xml:lang="hu">Adatminőségi dimenzió, amely azt fejezi ki, hogy az összes szükséges adat milyen mértékben van jelen.</skos:definition>
    <skos:definition xml:lang="it">Dimensione della qualità dei dati che esprime il grado in cui tutti i dati richiesti sono presenti.</skos:definition>
    <skos:definition xml:lang="nl">Gegevenskwaliteitsdimensie die de mate uitdrukt waarin alle vereiste gegevens aanwezig zijn.</skos:definition>
    <skos:definition xml:lang="pl">Wymiar jakości danych wyrażający stopień, w jakim obecne są wszystkie wymagane dane.</skos:definition>
    <skos:definition xml:lang="pt">Dimensão da qualidade dos dados que exprime o grau em que todos os dados exigidos estão presentes.</skos:definition>
    <skos:definition xml:lang="ro">Dimensiune a calității datelor care exprimă gradul în care sunt prezente toate datele necesare.</skos:definition>
    <skos:definition xml:lang="sv">Datakvalitetsdimension som uttrycker i vilken grad alla nödvändiga data finns närvarande.</skos:definition>
    <skos:definition xml:lang="bg">Измерение на качеството на данните, изразяващо степента, в която са налице всички изисквани данни.</skos:definition>
    <skos:definition xml:lang="da">Datakvalitetsdimension, der udtrykker, i hvilken grad alle påkrævede data er til stede.</skos:definition>
    <skos:definition xml:lang="et">Andmekvaliteedi mõõde, mis väljendab seda, mil määral on olemas kõik nõutavad andmed.</skos:definition>
    <skos:definition xml:lang="fi">Datan laadun ulottuvuus, joka ilmaisee, missä määrin kaikki vaaditut tiedot ovat läsnä.</skos:definition>
    <skos:definition xml:lang="ga">Gné de cháilíocht sonraí lena léirítear an méid atá na sonraí riachtanacha uile i láthair.</skos:definition>
    <skos:definition xml:lang="hr">Dimenzija kvalitete podataka kojom se izražava stupanj u kojem su prisutni svi potrebni podaci.</skos:definition>
    <skos:definition xml:lang="lt">Duomenų kokybės aspektas, išreiškiantis, kokiu mastu pateikiami visi reikalingi duomenys.</skos:definition>
    <skos:definition xml:lang="lv">Datu kvalitātes dimensija, kas izsaka pakāpi, kādā ir pieejami visi prasītie dati.</skos:definition>
    <skos:definition xml:lang="mt">Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn id-data kollha meħtieġa hija preżenti.</skos:definition>
    <skos:definition xml:lang="sk">Rozmer kvality údajov vyjadrujúci mieru, v akej sú prítomné všetky požadované údaje.</skos:definition>
    <skos:definition xml:lang="sl">Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere so prisotni vsi zahtevani podatki.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0015">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="cs">PassengerTrainCompositionMessage (zpráva o řazení osobního vlaku)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">PassengerTrainCompositionMessage (Reisezugbildungsnachricht)</skos:prefLabel>
    <skos:prefLabel xml:lang="el">PassengerTrainCompositionMessage (μήνυμα σύνθεσης επιβατικού τρένου)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">PassengerTrainCompositionMessage</skos:prefLabel>
    <skos:prefLabel xml:lang="es">PassengerTrainCompositionMessage (mensaje de composición del tren de viajeros)</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">PassengerTrainCompositionMessage (message de composition du train de voyageurs)</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">PassengerTrainCompositionMessage (személyszállító vonat összeállítási üzenet)</skos:prefLabel>
    <skos:prefLabel xml:lang="it">PassengerTrainCompositionMessage (messaggio di composizione del treno passeggeri)</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">PassengerTrainCompositionMessage (reizigerstreinsamenstellingsbericht)</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">PassengerTrainCompositionMessage (komunikat zestawienia pociągu pasażerskiego)</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">PassengerTrainCompositionMessage (mensagem de composição do comboio de passageiros)</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">PassengerTrainCompositionMessage (mesaj de compunere a trenului de călători)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">PassengerTrainCompositionMessage (meddelande om persontågs sammansättning)</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">PassengerTrainCompositionMessage (съобщение за състава на пътническия влак)</skos:prefLabel>
    <skos:prefLabel xml:lang="da">PassengerTrainCompositionMessage (sammensætningsmeddelelse for passagertog)</skos:prefLabel>
    <skos:prefLabel xml:lang="et">PassengerTrainCompositionMessage (reisirongi koosseisu sõnum)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">PassengerTrainCompositionMessage (matkustajajunan kokoonpanoviesti)</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">PassengerTrainCompositionMessage (teachtaireacht maidir le comhdhéanamh na traenach paisinéirí)</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">PassengerTrainCompositionMessage (poruka o sastavu putničkog vlaka)</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">PassengerTrainCompositionMessage (keleivinio traukinio sąstato pranešimas)</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">PassengerTrainCompositionMessage (pasažieru vilciena sastāva ziņojums)</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">PassengerTrainCompositionMessage (messaġġ tal-kompożizzjoni tal-ferrovija tal-passiġġieri)</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">PassengerTrainCompositionMessage (správa o radení osobného vlaku)</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">PassengerTrainCompositionMessage (sporočilo o sestavi potniškega vlaka)</skos:prefLabel>
    <skos:definition xml:lang="en">Message conveying the composition of a passenger train, including seating maps, classes, coaches for persons with reduced mobility and bicycle spaces.</skos:definition>
    <skos:definition xml:lang="de">Nachricht zur Übermittlung der Zusammensetzung eines Reisezuges, einschließlich Sitzplänen, Klassen, Wagen für Personen mit eingeschränkter Mobilität und Fahrradstellplätzen.</skos:definition>
    <skos:definition xml:lang="el">Μήνυμα που διαβιβάζει τη σύνθεση ενός επιβατικού τρένου, συμπεριλαμβανομένων των διαγραμμάτων θέσεων, των κατηγοριών, των οχημάτων για άτομα με μειωμένη κινητικότητα και των χώρων για ποδήλατα.</skos:definition>
    <skos:definition xml:lang="es">Mensaje que transmite la composición de un tren de viajeros, incluidos los planos de asientos, las clases, los coches para personas con movilidad reducida y las plazas para bicicletas.</skos:definition>
    <skos:definition xml:lang="fr">Message transmettant la composition d'un train de voyageurs, y compris les plans de places assises, les classes, les voitures pour les personnes à mobilité réduite et les emplacements pour vélos.</skos:definition>
    <skos:definition xml:lang="hu">Üzenet, amely továbbítja egy személyszállító vonat összeállítását, beleértve az ülőhelytérképeket, az osztályokat, a csökkent mozgásképességű személyek számára fenntartott kocsikat és a kerékpárhelyeket.</skos:definition>
    <skos:definition xml:lang="it">Messaggio che trasmette la composizione di un treno passeggeri, compresi i piani dei posti a sedere, le classi, le carrozze per persone a mobilità ridotta e gli spazi per biciclette.</skos:definition>
    <skos:definition xml:lang="nl">Bericht dat de samenstelling van een reizigerstrein doorgeeft, met inbegrip van stoelplattegronden, klassen, rijtuigen voor personen met beperkte mobiliteit en fietsplaatsen.</skos:definition>
    <skos:definition xml:lang="pl">Komunikat przekazujący zestawienie pociągu pasażerskiego, w tym plany miejsc siedzących, klasy, wagony dla osób o ograniczonej możliwości poruszania się oraz miejsca na rowery.</skos:definition>
    <skos:definition xml:lang="pt">Mensagem que transmite a composição de um comboio de passageiros, incluindo plantas de lugares, classes, carruagens para pessoas com mobilidade reduzida e espaços para bicicletas.</skos:definition>
    <skos:definition xml:lang="ro">Mesaj care transmite compunerea unui tren de călători, inclusiv planurile locurilor, clasele, vagoanele pentru persoane cu mobilitate redusă și spațiile pentru biciclete.</skos:definition>
    <skos:definition xml:lang="sv">Meddelande som överför ett persontågs sammansättning, inbegripet sittplatskartor, klasser, vagnar för personer med nedsatt rörlighet och cykelplatser.</skos:definition>
    <skos:definition xml:lang="cs">Zpráva předávající řazení osobního vlaku, včetně plánů sedadel, tříd, vozů pro osoby se sníženou pohyblivostí a míst pro jízdní kola.</skos:definition>
    <skos:definition xml:lang="lv">Ziņojums, ar kuru nodod pasažieru vilciena sastāvu, tostarp sēdvietu plānus, klases, vagonus personām ar ierobežotām pārvietošanās spējām un velosipēdu vietas.</skos:definition>
    <skos:definition xml:lang="da">Meddelelse, der overfører et passagertogs sammensætning, herunder siddepladskort, klasser, vogne til personer med nedsat mobilitet og cykelpladser.</skos:definition>
    <skos:definition xml:lang="et">Sõnum, millega edastatakse reisirongi koosseis, sealhulgas istekohtade plaanid, klassid, piiratud liikumisvõimega isikutele mõeldud vagunid ja jalgrattakohad.</skos:definition>
    <skos:definition xml:lang="fi">Viesti, jolla välitetään matkustajajunan kokoonpano, mukaan lukien istumapaikkakartat, luokat, liikuntarajoitteisille henkilöille tarkoitetut vaunut ja polkupyöräpaikat.</skos:definition>
    <skos:definition xml:lang="ga">Teachtaireacht lena ndéantar comhdhéanamh traenach paisinéirí a tharchur, lena n-áirítear pleananna suíocháin, ranganna, carráistí do dhaoine a bhfuil a soghluaisteacht laghdaithe agus áiteanna do rothair.</skos:definition>
    <skos:definition xml:lang="hr">Poruka kojom se prenosi sastav putničkog vlaka, uključujući rasporede sjedala, razrede, vagone za osobe smanjene pokretljivosti i mjesta za bicikle.</skos:definition>
    <skos:definition xml:lang="lt">Pranešimas, kuriuo perduodamas keleivinio traukinio sąstatas, įskaitant sėdimų vietų planus, klases, riboto judumo asmenims skirtus vagonus ir vietas dviračiams.</skos:definition>
    <skos:definition xml:lang="bg">Съобщение, с което се предава съставът на пътнически влак, включително схеми на местата, класове, вагони за лица с намалена подвижност и места за велосипеди.</skos:definition>
    <skos:definition xml:lang="sk">Správa prenášajúca radenie osobného vlaku vrátane plánov sedadiel, tried, vozňov pre osoby so zníženou pohyblivosťou a miest pre bicykle.</skos:definition>
    <skos:definition xml:lang="sl">Sporočilo, ki posreduje sestavo potniškega vlaka, vključno z razporedi sedežev, razredi, vagoni za osebe z zmanjšano mobilnostjo in mesti za kolesa.</skos:definition>
    <skos:definition xml:lang="mt">Messaġġ li jittrażmetti l-kompożizzjoni ta' ferrovija tal-passiġġieri, inkluż il-pjanti tal-postijiet bilqiegħda, il-klassijiet, il-vaguni għal persuni b'mobbiltà mnaqqsa u l-postijiet għar-roti.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0042">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Wagon and intermodal loading unit operational databases</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Provozní databáze nákladních vozů a intermodálních nákladových jednotek</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Betriebsdatenbanken für Güterwagen und intermodale Ladeeinheiten</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Επιχειρησιακές βάσεις δεδομένων εμπορευματικών βαγονιών και μονάδων διατροπικής φόρτωσης</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Bases de datos operativas de los vagones y las unidades de carga intermodal</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Bases de données opérationnelles des wagons et des unités de chargement intermodal</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A tehervagonok és az intermodális rakományegységek működési adatbázisai</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Banche dati operative dei carri e delle unità di carico intermodale</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Operationele databanken voor goederenwagens en intermodale laadeenheden</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Operacyjne bazy danych wagonów i intermodalnych jednostek ładunkowych</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Bases de dados operacionais dos vagões e das unidades de carga intermodal</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Baze de date operaționale privind vagoanele și unitățile de încărcare intermodală</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Operativa databaser för godsvagnar och intermodala lastenheter</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Оперативни бази данни за товарните вагони и интермодалните товарни единици</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Operationelle databaser for godsvogne og intermodale lastenheder</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Kaubavagunite ja intermodaalsete laadimisüksuste operatiivandmebaasid</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Operativne podatkovne zbirke tovornih vagonov in intermodalnih nakladalnih enot</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Operativne baze podataka teretnih vagona i intermodalnih utovarnih jedinica</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Prekinių vagonų ir įvairiarūšio krovimo vienetų veiklos duomenų bazės</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Kravas vagonu un intermodālo kravas vienību operatīvās datubāzes</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Bażijiet tad-data operazzjonali tal-vaguni tal-merkanzija u tal-unitajiet tat-tagħbija intermodali</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Prevádzkové databázy nákladných vozňov a intermodálnych nákladových jednotiek</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tavaravaunujen ja intermodaalisten kuormausyksiköiden operatiiviset tietokannat</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Bunachair sonraí oibríochtúla na vaigíní lasta agus na n-aonad lódála idirmhódúil</skos:prefLabel>
    <skos:definition xml:lang="en">Operational databases recording the operational states of freight wagons and intermodal loading units across their movement.</skos:definition>
    <skos:definition xml:lang="es">Bases de datos operativas que registran los estados operativos de los vagones de mercancías y las unidades de carga intermodal a lo largo de su movimiento.</skos:definition>
    <skos:definition xml:lang="it">Banche dati operative che registrano gli stati operativi dei carri merci e delle unità di carico intermodale lungo il loro movimento.</skos:definition>
    <skos:definition xml:lang="pt">Bases de dados operacionais que registam os estados operacionais dos vagões de mercadorias e das unidades de carga intermodal ao longo do seu movimento.</skos:definition>
    <skos:definition xml:lang="ro">Baze de date operaționale care înregistrează stările operaționale ale vagoanelor de marfă și ale unităților de încărcare intermodală pe parcursul mișcării lor.</skos:definition>
    <skos:definition xml:lang="sv">Operativa databaser som registrerar de operativa tillstånden för godsvagnar och intermodala lastenheter under hela deras förflyttning.</skos:definition>
    <skos:definition xml:lang="cs">Provozní databáze zaznamenávající provozní stavy nákladních vozů a intermodálních nákladových jednotek v průběhu jejich pohybu.</skos:definition>
    <skos:definition xml:lang="nl">Operationele databanken die de operationele toestanden van goederenwagens en intermodale laadeenheden gedurende hun beweging registreren.</skos:definition>
    <skos:definition xml:lang="pl">Operacyjne bazy danych rejestrujące stany operacyjne wagonów towarowych i intermodalnych jednostek ładunkowych w trakcie ich ruchu.</skos:definition>
    <skos:definition xml:lang="de">Betriebsdatenbanken zur Erfassung der Betriebszustände von Güterwagen und intermodalen Ladeeinheiten während ihrer Bewegung.</skos:definition>
    <skos:definition xml:lang="sk">Prevádzkové databázy zaznamenávajúce prevádzkové stavy nákladných vozňov a intermodálnych nákladových jednotiek počas ich pohybu.</skos:definition>
    <skos:definition xml:lang="sl">Operativne podatkovne zbirke, ki beležijo operativna stanja tovornih vagonov in intermodalnih nakladalnih enot med njihovim gibanjem.</skos:definition>
    <skos:definition xml:lang="bg">Оперативни бази данни, в които се записват оперативните състояния на товарните вагони и интермодалните товарни единици през цялото им движение.</skos:definition>
    <skos:definition xml:lang="lt">Veiklos duomenų bazės, kuriose registruojamos prekinių vagonų ir įvairiarūšio krovimo vienetų veiklos būsenos per visą jų judėjimą.</skos:definition>
    <skos:definition xml:lang="lv">Operatīvās datubāzes, kurās reģistrē kravas vagonu un intermodālo kravas vienību operatīvos stāvokļus visā to kustības laikā.</skos:definition>
    <skos:definition xml:lang="mt">Bażijiet tad-data operazzjonali li jirreġistraw l-istati operazzjonali tal-vaguni tal-merkanzija u tal-unitajiet tat-tagħbija intermodali matul il-moviment tagħhom.</skos:definition>
    <skos:definition xml:lang="el">Επιχειρησιακές βάσεις δεδομένων που καταγράφουν τις επιχειρησιακές καταστάσεις των εμπορευματικών βαγονιών και των μονάδων διατροπικής φόρτωσης καθ' όλη τη διάρκεια της κίνησής τους.</skos:definition>
    <skos:definition xml:lang="da">Operationelle databaser, der registrerer de operationelle tilstande for godsvogne og intermodale lastenheder i hele deres bevægelse.</skos:definition>
    <skos:definition xml:lang="fi">Operatiiviset tietokannat, joihin kirjataan tavaravaunujen ja intermodaalisten kuormausyksiköiden operatiiviset tilat niiden koko liikkumisen ajan.</skos:definition>
    <skos:definition xml:lang="fr">Bases de données opérationnelles enregistrant les états opérationnels des wagons de fret et des unités de chargement intermodal tout au long de leur mouvement.</skos:definition>
    <skos:definition xml:lang="ga">Bunachair sonraí oibríochtúla lena dtaifeadtar staideanna oibríochtúla na vaigíní lasta agus na n-aonad lódála idirmhódúil le linn a ngluaiseachta.</skos:definition>
    <skos:definition xml:lang="hr">Operativne baze podataka u kojima se bilježe operativna stanja teretnih vagona i intermodalnih utovarnih jedinica tijekom njihova kretanja.</skos:definition>
    <skos:definition xml:lang="et">Operatiivandmebaasid, milles registreeritakse kaubavagunite ja intermodaalsete laadimisüksuste operatiivseisundid kogu nende liikumise jooksul.</skos:definition>
    <skos:definition xml:lang="hu">Működési adatbázisok, amelyek a tehervagonok és az intermodális rakományegységek működési állapotait rögzítik mozgásuk során.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/concept-0051">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">PRM-assistance availability and reservation</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Dostupnost a rezervace asistence pro osoby se sníženou pohyblivostí</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Verfügbarkeit und Reservierung von PRM-Hilfeleistung</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Διαθεσιμότητα και κράτηση συνδρομής για ΑμΕΑ</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Disponibilidad y reserva de asistencia PMR</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Disponibilità e prenotazione dell'assistenza PMR</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Beschikbaarheid en reservering van PRM-assistentie</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Dostępność i rezerwacja pomocy dla osób o ograniczonej możliwości poruszania się</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Disponibilidade e reserva de assistência PMR</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Disponibilitatea și rezervarea asistenței pentru PMR</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tillgänglighet och bokning av assistans för personer med nedsatt rörlighet</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Disponibilité et réservation de l'assistance PMR</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A csökkent mozgásképességű személyeknek nyújtott segítség rendelkezésre állása és foglalása</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Tilgængelighed og reservation af assistance til personer med nedsat mobilitet</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Piiratud liikumisvõimega isikute abistamise saadavus ja broneerimine</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Liikuntarajoitteisten avustamisen saatavuus ja varaus</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Infhaighteacht agus áirithint cúnaimh do dhaoine a bhfuil a soghluaisteacht laghdaithe</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Dostupnost i rezervacija pomoći osobama smanjene pokretljivosti</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Pagalbos riboto judumo asmenims prieinamumas ir rezervacija</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Palīdzības personām ar ierobežotām pārvietošanās spējām pieejamība un rezervācija</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Disponibbiltà u riżervazzjoni ta' assistenza għal persuni b'mobbiltà mnaqqsa</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Dostupnosť a rezervácia pomoci pre osoby so zníženou pohyblivosťou</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Razpoložljivost in rezervacija pomoči za osebe z zmanjšano mobilnostjo</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Наличност и резервация на съдействие за лица с намалена подвижност</skos:prefLabel>
    <skos:definition xml:lang="el">Μήνυμα για τον έλεγχο της διαθεσιμότητας και την κράτηση συνδρομής για άτομα με αναπηρία ή μειωμένη κινητικότητα.</skos:definition>
    <skos:definition xml:lang="en">Message for checking availability of and reserving assistance for persons with disabilities or reduced mobility.</skos:definition>
    <skos:definition xml:lang="sv">Meddelande för att kontrollera tillgängligheten av och boka assistans för personer med funktionsnedsättning eller nedsatt rörlighet.</skos:definition>
    <skos:definition xml:lang="hu">Üzenet a fogyatékossággal élő vagy csökkent mozgásképességű személyeknek nyújtott segítség rendelkezésre állásának ellenőrzésére és foglalására.</skos:definition>
    <skos:definition xml:lang="it">Messaggio per verificare la disponibilità e prenotare l'assistenza per le persone con disabilità o a mobilità ridotta.</skos:definition>
    <skos:definition xml:lang="nl">Bericht om de beschikbaarheid te controleren van en assistentie te reserveren voor personen met een handicap of beperkte mobiliteit.</skos:definition>
    <skos:definition xml:lang="pl">Komunikat służący do sprawdzenia dostępności i rezerwacji pomocy dla osób z niepełnosprawnościami lub o ograniczonej możliwości poruszania się.</skos:definition>
    <skos:definition xml:lang="pt">Mensagem para verificar a disponibilidade e reservar assistência a pessoas com deficiência ou com mobilidade reduzida.</skos:definition>
    <skos:definition xml:lang="ro">Mesaj pentru verificarea disponibilității și rezervarea asistenței pentru persoanele cu handicap sau cu mobilitate redusă.</skos:definition>
    <skos:definition xml:lang="lt">Pranešimas, skirtas patikrinti prieinamumą ir rezervuoti pagalbą neįgaliesiems arba riboto judumo asmenims.</skos:definition>
    <skos:definition xml:lang="lv">Ziņojums, ar kuru pārbauda pieejamību un rezervē palīdzību personām ar invaliditāti vai ierobežotām pārvietošanās spējām.</skos:definition>
    <skos:definition xml:lang="mt">Messaġġ biex tiġi vverifikata d-disponibbiltà u tiġi rriżervata assistenza għal persuni b'diżabbiltà jew b'mobbiltà mnaqqsa.</skos:definition>
    <skos:definition xml:lang="bg">Съобщение за проверка на наличността и резервация на съдействие за лица с увреждания или с намалена подвижност.</skos:definition>
    <skos:definition xml:lang="sk">Správa na overenie dostupnosti a rezerváciu pomoci pre osoby so zdravotným postihnutím alebo so zníženou pohyblivosťou.</skos:definition>
    <skos:definition xml:lang="sl">Sporočilo za preverjanje razpoložljivosti in rezervacijo pomoči za invalide ali osebe z zmanjšano mobilnostjo.</skos:definition>
    <skos:definition xml:lang="hr">Poruka za provjeru dostupnosti i rezervaciju pomoći osobama s invaliditetom ili smanjene pokretljivosti.</skos:definition>
    <skos:definition xml:lang="cs">Zpráva pro ověření dostupnosti a rezervaci asistence pro osoby se zdravotním postižením nebo se sníženou pohyblivostí.</skos:definition>
    <skos:definition xml:lang="da">Meddelelse til kontrol af tilgængeligheden af og reservation af assistance til personer med handicap eller nedsat mobilitet.</skos:definition>
    <skos:definition xml:lang="de">Nachricht zur Prüfung der Verfügbarkeit und zur Reservierung von Hilfeleistung für Personen mit Behinderungen oder eingeschränkter Mobilität.</skos:definition>
    <skos:definition xml:lang="es">Mensaje para comprobar la disponibilidad y reservar asistencia para personas con discapacidad o movilidad reducida.</skos:definition>
    <skos:definition xml:lang="et">Sõnum, millega kontrollitakse puuetega või piiratud liikumisvõimega isikute abistamise saadavust ja broneeritakse see.</skos:definition>
    <skos:definition xml:lang="fi">Viesti, jolla tarkistetaan vammaisille tai liikuntarajoitteisille henkilöille tarkoitetun avustamisen saatavuus ja varataan se.</skos:definition>
    <skos:definition xml:lang="fr">Message permettant de vérifier la disponibilité et de réserver une assistance pour les personnes handicapées ou à mobilité réduite.</skos:definition>
    <skos:definition xml:lang="ga">Teachtaireacht chun an infhaighteacht a sheiceáil agus cúnamh a áirithiú do dhaoine faoi mhíchumas nó a bhfuil a soghluaisteacht laghdaithe.</skos:definition>
    <dct:source>http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17</dct:source>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/tel-tsi/collection-section-3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://github.com/NAPCORE/its-data-dictionary/tel-tsi"/>
    <skos:prefLabel xml:lang="en">Section 3 — Freight wagons and their load</skos:prefLabel>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0023"/>
    <skos:member rdf:resource="https://gegevenscatalogus.gov/tel-tsi/concept-0024"/>
