        "Trassenobjekt"@de,
        "Αντικείμενο διαδρομής"@el,
        "Path object"@en,
        "Objeto surco"@es,
        "Rongiliini objekt"@et,
        "Reittiobjekti"@fi,
        "Objet sillon"@fr,
        "Réad uaire"@ga,
        "Objekt trase"@hr,
        "Menetvonalobjektum"@hu,
        "Oggetto traccia"@it,
        "Trasos objektas"@lt,
