        "TrainCompositionMessage (Zugbildungsnachricht)"@de,
        "TrainCompositionMessage (μήνυμα σύνθεσης τρένου)"@el,
        "TrainCompositionMessage"@en,
        "TrainCompositionMessage (mensaje de composición del tren)"@es,
        "TrainCompositionMessage (rongi koosseisu sõnum)"@et,
        "TrainCompositionMessage (junan kokoonpanoviesti)"@fi,
        "TrainCompositionMessage (message de composition du train)"@fr,
        "TrainCompositionMessage (teachtaireacht maidir le comhdhéanamh na traenach)"@ga,
        "TrainCompositionMessage (poruka o sastavu vlaka)"@hr,
        "TrainCompositionMessage (vonatösszeállítási üzenet)"@hu,
        "TrainCompositionMessage (messaggio di composizione del treno)"@it,
        "TrainCompositionMessage (traukinio sąstato pranešimas)"@lt,
        "TrainCompositionMessage (vilciena sastāva ziņojums)"@lv,
        "TrainCompositionMessage (messaġġ tal-kompożizzjoni tal-ferrovija)"@mt,
        "TrainCompositionMessage (treinsamenstellingsbericht)"@nl,
        "TrainCompositionMessage (komunikat zestawienia pociągu)"@pl,
        "TrainCompositionMessage (mensagem de composição do comboio)"@pt,
        "TrainCompositionMessage (mesaj de compunere a trenului)"@ro,
