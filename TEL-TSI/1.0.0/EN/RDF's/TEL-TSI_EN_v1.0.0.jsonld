  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0029",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že nákladní vůz je připraven k pohybu."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass ein Güterwagen bewegungsbereit ist."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι ένα εμπορευματικό βαγόνι είναι έτοιμο να μετακινηθεί."
      },
      {
        "@language": "en",
        "@value": "Wagon event indicating that a freight wagon is ready to be moved."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que un vagón de mercancías está listo para ser movido."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'un wagon de fret est prêt à être déplacé."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy tehervagon készen áll a mozgatásra."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un carro merci è pronto a essere movimentato."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een goederenwagen klaar is om te worden bewogen."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wagon towarowy jest gotowy do przemieszczenia."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que um vagão de mercadorias está pronto para ser movimentado."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că un vagon de marfă este pregătit să fie deplasat."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en godsvagn är klar att förflyttas."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že nákladný vozeň je pripravený na pohyb."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je tovorni vagon pripravljen za premik."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je teretni vagon spreman za premještanje."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad prekinis vagonas parengtas judinti."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka kravas vagons ir gatavs pārvietošanai."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li vagun tal-merkanzija huwa lest biex jiġi mċaqlaq."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че товарен вагон е готов за придвижване."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en godsvogn er klar til at blive flyttet."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et kaubavagun on liigutamiseks valmis."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että tavaravaunu on valmis siirrettäväksi."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl go bhfuil vaigín lasta réidh le bogadh."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
