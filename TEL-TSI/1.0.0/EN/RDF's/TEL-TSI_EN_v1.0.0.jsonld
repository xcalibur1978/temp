  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0092",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_36"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Οντότητα που οργανώνει υπηρεσίες εμπορευματικών μεταφορών οι οποίες συνδέουν δύο ή περισσότερους εμπορευματικούς σταθμούς με περισσότερους από έναν τρόπους μεταφοράς."
      },
      {
        "@language": "en",
        "@value": "An entity that organises freight transport services connecting two or more freight terminals with more than one transport mode."
      },
      {
        "@language": "cs",
        "@value": "Subjekt, který organizuje služby nákladní dopravy spojující dva nebo více nákladních terminálů s využitím více než jednoho druhu dopravy."
      },
      {
        "@language": "de",
        "@value": "Eine Stelle, die Güterverkehrsdienste organisiert, die zwei oder mehr Güterterminals mit mehr als einem Verkehrsträger verbinden."
      },
      {
        "@language": "fr",
        "@value": "Entité qui organise des services de transport de fret reliant deux terminaux de fret ou plus avec plus d'un mode de transport."
      },
      {
        "@language": "it",
        "@value": "Soggetto che organizza servizi di trasporto merci che collegano due o più terminali merci con più di un modo di trasporto."
      },
      {
        "@language": "nl",
        "@value": "Een entiteit die goederenvervoersdiensten organiseert die twee of meer goederenterminals met meer dan één vervoerswijze verbinden."
      },
      {
        "@language": "pl",
        "@value": "Podmiot organizujący przewozy towarowe łączące co najmniej dwa terminale towarowe z wykorzystaniem więcej niż jednego środka transportu."
      },
      {
        "@language": "pt",
        "@value": "Entidade que organiza serviços de transporte de mercadorias que ligam dois ou mais terminais de mercadorias com mais do que um modo de transporte."
      },
      {
        "@language": "ro",
        "@value": "Entitate care organizează servicii de transport de marfă care leagă două sau mai multe terminale de marfă cu mai mult de un mod de transport."
      },
      {
        "@language": "sv",
        "@value": "En enhet som organiserar godstransporttjänster som förbinder två eller flera godsterminaler med fler än ett transportsätt."
      },
      {
        "@language": "es",
        "@value": "Entidad que organiza servicios de transporte de mercancías que conectan dos o más terminales de mercancías con más de un modo de transporte."
      },
      {
        "@language": "hu",
        "@value": "Olyan szervezet, amely két vagy több árufuvarozási terminált egynél több közlekedési móddal összekötő árufuvarozási szolgáltatásokat szervez."
      },
      {
        "@language": "bg",
        "@value": "Субект, който организира услуги за товарен превоз, свързващи два или повече товарни терминала с повече от един вид транспорт."
      },
      {
        "@language": "da",
        "@value": "En enhed, der organiserer godstransporttjenester, som forbinder to eller flere godsterminaler med mere end én transportform."
      },
      {
        "@language": "et",
        "@value": "Üksus, kes korraldab kaubaveoteenuseid, mis ühendavad kaht või enamat kaubaterminali rohkem kui ühe transpordiliigiga."
      },
      {
        "@language": "fi",
        "@value": "Yhteisö, joka järjestää tavaraliikennepalveluja, jotka yhdistävät kaksi tai useampia tavaraterminaaleja useammalla kuin yhdellä liikennemuodolla."
      },
      {
        "@language": "ga",
        "@value": "Eintiteas a eagraíonn seirbhísí iompair lasta a nascann dhá chríochfort lasta nó níos mó le níos mó ná modh iompair amháin."
      },
      {
        "@language": "hr",
        "@value": "Subjekt koji organizira usluge prijevoza tereta kojima se povezuju dva ili više teretnih terminala s pomoću više od jednog načina prijevoza."
      },
      {
        "@language": "lt",
        "@value": "Subjektas, organizuojantis krovinių vežimo paslaugas, kuriomis sujungiami du ar daugiau krovinių terminalų, naudojant daugiau nei vieną transporto rūšį."
      },
      {
        "@language": "lv",
        "@value": "Subjekts, kas organizē kravu pārvadājumu pakalpojumus, kuri savieno divus vai vairākus kravu termināļus ar vairāk nekā vienu transporta veidu."
      },
      {
        "@language": "mt",
        "@value": "Entità li torganizza servizzi tat-trasport tal-merkanzija li jgħaqqdu żewġ terminals tal-merkanzija jew aktar b'aktar minn mod wieħed ta' trasport."
      },
      {
        "@language": "sk",
        "@value": "Subjekt, ktorý organizuje služby nákladnej dopravy spájajúce dva alebo viaceré nákladné terminály s využitím viac ako jedného druhu dopravy."
      },
      {
        "@language": "sl",
        "@value": "Subjekt, ki organizira storitve tovornega prevoza, ki povezujejo dva ali več tovornih terminalov z več kot enim načinom prevoza."
      }
    ],
