    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που διαβιβάζει την τρέχουσα κατάσταση ενός εμπορευματικού βαγονιού."
      },
      {
        "@language": "en",
        "@value": "Wagon event conveying the current status of a freight wagon."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon aktuális állapotát továbbítja."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che trasmette lo stato attuale di un carro merci."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die de actuele status van een goederenwagen doorgeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu przekazujące bieżący status wagonu towarowego."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que transmite o estado atual de um vagão de mercadorias."
