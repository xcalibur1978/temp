      },
      {
        "@language": "et",
        "@value": "Teave internetimüügikanalite kohta"
      },
      {
        "@language": "fi",
        "@value": "Tiedot verkkomyyntikanavista"
      },
      {
        "@language": "ga",
        "@value": "Faisnéis faoi na bealaí díola ar líne"
      },
      {
        "@language": "hr",
        "@value": "Informacije o internetskim prodajnim kanalima"
      },
      {
        "@language": "lt",
        "@value": "Informacija apie internetinius pardavimo kanalus"
      },
      {
        "@language": "lv",
        "@value": "Informācija par tiešsaistes pārdošanas kanāliem"
      },
      {
        "@language": "mt",
        "@value": "Informazzjoni dwar il-kanali tal-bejgħ online"
      },
      {
        "@language": "sk",
        "@value": "Informácie o online predajných kanáloch"
      },
      {
        "@language": "sl",
        "@value": "Informacije o spletnih prodajnih kanalih"
      }
