  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0009",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ο αιτών επιβεβαιώνει τις λεπτομέρειες της διαδρομής που προτείνει ο διαχειριστής υποδομής."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou žadatel potvrzuje podrobnosti o trase navržené provozovatelem infrastruktury."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der der Antragsteller die vom Infrastrukturbetreiber vorgeschlagenen Trassendetails bestätigt."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket den sökande bekräftar de tåglägesuppgifter som infrastrukturförvaltaren föreslagit."
      },
      {
        "@language": "en",
        "@value": "Message by which the applicant confirms the path details proposed by the infrastructure manager."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que el candidato confirma los detalles del surco propuestos por el administrador de infraestructuras."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel le candidat confirme les détails du sillon proposés par le gestionnaire de l'infrastructure."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel a kérelmező megerősíti a pályahálózat-működtető által javasolt menetvonal-részleteket."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui il richiedente conferma i dettagli della traccia proposti dal gestore dell'infrastruttura."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee de aanvrager de door de infrastructuurbeheerder voorgestelde paddetails bevestigt."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego wnioskodawca potwierdza szczegóły trasy zaproponowane przez zarządcę infrastruktury."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual o requerente confirma os pormenores do canal horário propostos pelo gestor de infraestrutura."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care solicitantul confirmă detaliile trasei propuse de administratorul de infrastructură."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed ansøgeren bekræfter de kanaldetaljer, som infrastrukturforvalteren har foreslået."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega taotleja kinnitab taristuettevõtja pakutud rongiliini üksikasjad."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla hakija vahvistaa rataverkon haltijan ehdottamat reitin yksityiskohdat."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína ndeimhníonn an t-iarratasóir na sonraí uaire arna moladh ag an mbainisteoir bonneagair."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom podnositelj zahtjeva potvrđuje pojedinosti o trasi koje je predložio upravitelj infrastrukture."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo pareiškėjas patvirtina infrastruktūros valdytojo pasiūlytus trasos duomenis."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pieteikuma iesniedzējs apstiprina infrastruktūras pārvaldītāja ierosinātās ceļa detaļas."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih l-applikant jikkonferma d-dettalji tal-mogħdija proposti mill-maniġer tal-infrastruttura."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou žiadateľ potvrdzuje podrobnosti o trase navrhnuté manažérom infraštruktúry."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim prosilec potrdi podrobnosti vlakovne poti, ki jih je predlagal upravljavec infrastrukture."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което заявителят потвърждава предложените от управителя на инфраструктурата подробности за влаковия маршрут."
      }
    ],
