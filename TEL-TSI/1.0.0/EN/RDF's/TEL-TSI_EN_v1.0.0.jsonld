      {
        "@language": "el",
        "@value": "Κενό εμπορευματικό βαγόνι υπό τον έλεγχο διαχείρισης στόλου"
      },
      {
        "@language": "et",
        "@value": "Tühi kaubavagun pargihalduse kontrolli all"
      },
      {
        "@language": "fi",
        "@value": "Tyhjä tavaravaunu kalustonhallinnan valvonnassa"
      },
      {
        "@language": "ga",
        "@value": "Vaigín lasta folamh faoi rialú bainistithe an chabhlaigh"
      },
      {
        "@language": "hr",
        "@value": "Prazni teretni vagon pod kontrolom upravljanja voznim parkom"
