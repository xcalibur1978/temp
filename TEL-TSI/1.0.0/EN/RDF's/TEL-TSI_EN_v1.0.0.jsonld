  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0002",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Object (TrainID) dat een trein identificeert, vastgesteld door de hoofdspoorwegonderneming, waaraan de operationele treinloopgegevens worden gekoppeld."
      },
      {
        "@language": "bg",
        "@value": "Обект (TrainID), който идентифицира влак, определен от водещото железопътно предприятие, към който се отнасят оперативните данни за движението на влака."
      },
      {
        "@language": "da",
        "@value": "Objekt (TrainID), der identificerer et tog, fastlagt af den ledende jernbanevirksomhed, og som de operationelle togdriftsdata vedrører."
      },
      {
        "@language": "cs",
        "@value": "Objekt (TrainID) identifikující vlak, který stanoví vedoucí železniční podnik a k němuž se vztahují provozní údaje o jízdě vlaku."
      },
      {
        "@language": "de",
        "@value": "Objekt (TrainID) zur Identifizierung eines Zuges, das vom federführenden Eisenbahnunternehmen festgelegt wird und auf das sich die betrieblichen Zuglaufdaten beziehen."
      },
      {
        "@language": "en",
        "@value": "Object (TrainID) identifying a train, specified by the lead railway undertaking, to which operational train running data is related."
      },
      {
        "@language": "fr",
        "@value": "Objet (TrainID) identifiant un train, défini par l'entreprise ferroviaire chef de file, auquel se rapportent les données opérationnelles de circulation."
      },
      {
        "@language": "hu",
        "@value": "Vonatot azonosító objektum (TrainID), amelyet a vezető vasúti társaság határoz meg, és amelyhez a működési vonatközlekedési adatok kapcsolódnak."
      },
      {
        "@language": "pl",
        "@value": "Obiekt (TrainID) identyfikujący pociąg, określony przez wiodące przedsiębiorstwo kolejowe, do którego odnoszą się operacyjne dane o ruchu pociągu."
      },
      {
        "@language": "pt",
        "@value": "Objeto (TrainID) que identifica um comboio, definido pela empresa ferroviária principal, ao qual se referem os dados operacionais de circulação."
      },
      {
        "@language": "ro",
        "@value": "Obiect (TrainID) care identifică un tren, stabilit de întreprinderea feroviară principală, la care se raportează datele operaționale privind circulația."
      },
      {
        "@language": "sv",
        "@value": "Objekt (TrainID) som identifierar ett tåg, fastställt av det ledande järnvägsföretaget och som de operativa tågföringsuppgifterna avser."
      },
      {
        "@language": "lt",
        "@value": "Objektas (TrainID), identifikuojantis traukinį, kurį nustato vadovaujančioji geležinkelio įmonė ir su kuriuo siejami veiklos traukinio eismo duomenys."
      },
      {
        "@language": "lv",
        "@value": "Objekts (TrainID), kas identificē vilcienu, kuru nosaka vadošais dzelzceļa pārvadājumu uzņēmums un uz kuru attiecas vilciena kustības operatīvie dati."
      },
      {
        "@language": "mt",
        "@value": "Oġġett (TrainID) li jidentifika ferrovija, stabbilit mill-impriża ferrovjarja ewlenija, li miegħu jirrelataw id-data operazzjonali tal-moviment tal-ferrovija."
      },
      {
        "@language": "sk",
        "@value": "Objekt (TrainID) identifikujúci vlak, ktorý stanovuje vedúci železničný podnik a na ktorý sa vzťahujú prevádzkové údaje o jazde vlaku."
      },
      {
        "@language": "sl",
        "@value": "Objekt (TrainID), ki identificira vlak, določi ga vodilni prevoznik v železniškem prometu in se nanj nanašajo operativni podatki o vožnji vlaka."
      },
      {
        "@language": "es",
        "@value": "Objeto (TrainID) que identifica un tren, definido por la empresa ferroviaria principal, al que se refieren los datos operativos de circulación."
      },
      {
        "@language": "et",
        "@value": "Objekt (TrainID), mis identifitseerib rongi, mille määrab juhtiv raudteeveo-ettevõtja ja millega seostatakse rongi liikumise operatiivandmed."
      },
      {
        "@language": "fi",
        "@value": "Objekti (TrainID), joka yksilöi junan, jonka johtava rautatieyritys vahvistaa ja johon junan liikennöinnin operatiiviset tiedot liittyvät."
      },
      {
        "@language": "ga",
        "@value": "Réad (TrainID) lena sainaithnítear traein, arna shocrú ag an ngnóthas iarnróid ceannais, lena mbaineann na sonraí oibríochtúla faoi ghluaiseacht na traenach."
      },
      {
        "@language": "hr",
        "@value": "Objekt (TrainID) koji identificira vlak, koji utvrđuje vodeći željeznički prijevoznik i na koji se odnose operativni podaci o vožnji vlaka."
      },
      {
        "@language": "it",
        "@value": "Oggetto (TrainID) che identifica un treno, definito dall'impresa ferroviaria capofila, al quale sono riferiti i dati operativi di circolazione."
      },
      {
        "@language": "el",
        "@value": "Αντικείμενο (TrainID) που προσδιορίζει ένα τρένο, το οποίο καθορίζεται από την επικεφαλής σιδηροδρομική επιχείρηση και στο οποίο αναφέρονται τα λειτουργικά δεδομένα κυκλοφορίας."
      }
