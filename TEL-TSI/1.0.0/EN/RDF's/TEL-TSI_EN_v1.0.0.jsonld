  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0012",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ο διαχειριστής υποδομής γνωστοποιεί ότι μια αιτηθείσα διαδρομή δεν είναι διαθέσιμη."
      },
      {
        "@language": "en",
        "@value": "Message by which the infrastructure manager notifies that a requested path is not available."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou provozovatel infrastruktury oznamuje, že požadovaná trasa není k dispozici."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der der Infrastrukturbetreiber mitteilt, dass eine beantragte Trasse nicht verfügbar ist."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que el administrador de infraestructuras notifica que un surco solicitado no está disponible."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel le gestionnaire de l'infrastructure notifie qu'un sillon demandé n'est pas disponible."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel a pályahálózat-működtető értesítést küld arról, hogy egy igényelt menetvonal nem áll rendelkezésre."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui il gestore dell'infrastruttura notifica che una traccia richiesta non è disponibile."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee de infrastructuurbeheerder meldt dat een aangevraagd pad niet beschikbaar is."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego zarządca infrastruktury powiadamia, że wnioskowana trasa jest niedostępna."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual o gestor de infraestrutura notifica que um canal horário solicitado não está disponível."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care administratorul de infrastructură notifică faptul că o trasă solicitată nu este disponibilă."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket infrastrukturförvaltaren meddelar att ett ansökt tågläge inte är tillgängligt."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou manažér infraštruktúry oznamuje, že požadovaná trasa nie je k dispozícii."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim upravljavec infrastrukture obvesti, da zahtevana vlakovna pot ni na voljo."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което управителят на инфраструктурата уведомява, че поискан влаков маршрут не е наличен."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed infrastrukturforvalteren meddeler, at en ansøgt kanal ikke er tilgængelig."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega taristuettevõtja teatab, et taotletud rongiliin ei ole kättesaadav."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla rataverkon haltija ilmoittaa, että pyydetty reitti ei ole saatavilla."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína gcuireann an bainisteoir bonneagair in iúl nach bhfuil uaire a iarradh ar fáil."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom upravitelj infrastrukture obavješćuje da zatražena trasa nije dostupna."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo infrastruktūros valdytojas praneša, kad prašoma trasa neprieinama."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru infrastruktūras pārvaldītājs paziņo, ka pieprasītais ceļš nav pieejams."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih il-maniġer tal-infrastruttura jinnotifika li mogħdija mitluba mhix disponibbli."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "PathNotAvailableMessage"
      },
      {
        "@language": "de",
        "@value": "PathNotAvailableMessage (Trasse-nicht-verfügbar-Nachricht)"
      },
      {
        "@language": "el",
        "@value": "PathNotAvailableMessage (μήνυμα μη διαθεσιμότητας διαδρομής)"
      },
      {
        "@language": "sv",
        "@value": "PathNotAvailableMessage (meddelande om att tågläge inte är tillgängligt)"
      },
      {
        "@language": "cs",
        "@value": "PathNotAvailableMessage (zpráva o nedostupnosti trasy)"
      },
