  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0025",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "et",
        "@value": "Andmed, millega edastatakse intermodaalse laadimisüksuse liikumine."
      },
      {
        "@language": "fi",
        "@value": "Tiedot, joilla välitetään intermodaalisen kuormausyksikön liike."
      },
      {
        "@language": "ga",
        "@value": "Sonraí lena ndéantar gluaiseacht aonaid lódála idirmhódúil a tharchur."
      },
      {
        "@language": "hr",
        "@value": "Podaci kojima se prenosi kretanje intermodalne utovarne jedinice."
      },
      {
        "@language": "lt",
        "@value": "Duomenys, kuriais perduodamas įvairiarūšio krovimo vieneto judėjimas."
      },
      {
        "@language": "lv",
        "@value": "Dati, ar kuriem nodod intermodālās kravas vienības kustību."
      },
      {
        "@language": "en",
        "@value": "Data conveying the movement of an intermodal loading unit."
      },
      {
        "@language": "it",
        "@value": "Dati che trasmettono il movimento di un'unità di carico intermodale."
      },
      {
        "@language": "nl",
        "@value": "Gegevens die de beweging van een intermodale laadeenheid doorgeven."
      },
      {
        "@language": "pl",
        "@value": "Dane przekazujące ruch intermodalnej jednostki ładunkowej."
      },
      {
        "@language": "pt",
        "@value": "Dados que transmitem o movimento de uma unidade de carga intermodal."
      },
      {
        "@language": "ro",
        "@value": "Date care transmit mișcarea unei unități de încărcare intermodală."
      },
      {
        "@language": "sv",
        "@value": "Uppgifter som överför förflyttningen av en intermodal lastenhet."
      },
      {
        "@language": "cs",
        "@value": "Údaje předávající pohyb intermodální nákladové jednotky."
      },
      {
        "@language": "de",
        "@value": "Daten zur Übermittlung der Bewegung einer intermodalen Ladeeinheit."
      },
      {
        "@language": "el",
        "@value": "Δεδομένα που διαβιβάζουν την κίνηση μιας μονάδας διατροπικής φόρτωσης."
      },
      {
        "@language": "es",
        "@value": "Datos que transmiten el movimiento de una unidad de carga intermodal."
      },
      {
        "@language": "fr",
        "@value": "Données transmettant le mouvement d'une unité de chargement intermodal."
      },
      {
        "@language": "hu",
        "@value": "Egy intermodális rakományegység mozgását továbbító adatok."
      },
      {
        "@language": "da",
        "@value": "Data, der overfører bevægelsen af en intermodal lastenhed."
      },
      {
        "@language": "bg",
        "@value": "Данни, с които се предава движението на интермодална товарна единица."
      },
      {
        "@language": "sk",
        "@value": "Údaje prenášajúce pohyb intermodálnej nákladovej jednotky."
      },
      {
        "@language": "sl",
        "@value": "Podatki, ki posredujejo premik intermodalne nakladalne enote."
      },
      {
        "@language": "mt",
        "@value": "Data li tittrażmetti l-moviment ta' unità tat-tagħbija intermodali."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
