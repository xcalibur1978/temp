  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0087",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_26"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Trajeto de ponta a ponta de um passageiro ou de uma carga que pode incluir vários segmentos."
      },
      {
        "@language": "ro",
        "@value": "Deplasare de la un capăt la altul a unui călător sau a unei încărcături care poate include mai multe segmente."
      },
      {
        "@language": "en",
        "@value": "An end-to-end trip of a passenger or a load that can include multiple legs."
      },
      {
        "@language": "pl",
        "@value": "Przejazd pasażera lub ładunku od początku do końca, który może obejmować wiele odcinków."
      },
      {
        "@language": "cs",
        "@value": "Cesta cestujícího nebo nákladu z jednoho konce na druhý, která může zahrnovat více úseků."
      },
      {
        "@language": "de",
        "@value": "Eine durchgehende Fahrt eines Fahrgasts oder einer Ladung, die mehrere Teilstrecken umfassen kann."
      },
      {
        "@language": "el",
        "@value": "Διαδρομή από άκρο σε άκρο ενός επιβάτη ή ενός φορτίου που μπορεί να περιλαμβάνει πολλαπλά σκέλη."
      },
      {
        "@language": "es",
        "@value": "Trayecto de principio a fin de un viajero o de una carga que puede incluir varios tramos."
      },
      {
        "@language": "fr",
        "@value": "Trajet de bout en bout d'un voyageur ou d'un chargement pouvant comporter plusieurs segments."
      },
      {
        "@language": "hu",
        "@value": "Egy utas vagy egy rakomány teljes, kezdőponttól végpontig tartó útja, amely több szakaszt is magában foglalhat."
      },
      {
        "@language": "it",
        "@value": "Tragitto da punto a punto di un passeggero o di un carico che può comprendere più tratte."
      },
      {
        "@language": "nl",
        "@value": "Een doorgaande verplaatsing van een reiziger of een lading die meerdere deeltrajecten kan omvatten."
      },
      {
        "@language": "sv",
        "@value": "En resa från ände till ände för en resenär eller en last som kan omfatta flera delsträckor."
      },
      {
        "@language": "bg",
        "@value": "Пътуване на пътник или товар от край до край, което може да включва няколко участъка."
      },
      {
        "@language": "da",
        "@value": "En gennemgående rejse for en passager eller en last, der kan omfatte flere delstrækninger."
      },
      {
        "@language": "et",
        "@value": "Reisija või lasti otsast lõpuni kestev reis, mis võib hõlmata mitut etappi."
      },
      {
        "@language": "fi",
        "@value": "Matkustajan tai kuorman päästä päähän ulottuva matka, joka voi sisältää useita osuuksia."
      },
      {
        "@language": "ga",
        "@value": "Aistear ó cheann ceann do phaisinéir nó do lasta a fhéadfaidh roinnt teascán a áireamh."
      },
      {
        "@language": "hr",
        "@value": "Putovanje putnika ili tereta od početka do kraja koje može uključivati više dionica."
      },
      {
        "@language": "lt",
        "@value": "Keleivio arba krovinio kelionė nuo pradžios iki pabaigos, kuri gali apimti kelias atkarpas."
      },
      {
        "@language": "lv",
        "@value": "Pasažiera vai kravas ceļojums no sākuma līdz galam, kas var ietvert vairākus posmus."
      },
      {
        "@language": "mt",
        "@value": "Vjaġġ minn tarf sa tarf ta' passiġġier jew tagħbija li jista' jinkludi diversi segmenti."
      },
      {
        "@language": "sk",
        "@value": "Cesta cestujúceho alebo nákladu z jedného konca na druhý, ktorá môže zahŕňať viacero úsekov."
      },
      {
        "@language": "sl",
        "@value": "Potovanje potnika ali tovora od začetka do konca, ki lahko vključuje več delov."
      }
    ],
