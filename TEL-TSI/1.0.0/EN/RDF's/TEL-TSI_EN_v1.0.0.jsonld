  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0100",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Data quality dimension expressing the degree to which all required data is present."
      },
      {
        "@language": "cs",
        "@value": "Rozměr kvality údajů vyjadřující míru, v jaké jsou přítomny všechny požadované údaje."
      },
      {
        "@language": "de",
        "@value": "Datenqualitätsdimension, die den Grad ausdrückt, in dem alle erforderlichen Daten vorhanden sind."
      },
      {
        "@language": "el",
        "@value": "Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο είναι παρόντα όλα τα απαιτούμενα δεδομένα."
      },
      {
        "@language": "es",
        "@value": "Dimensión de la calidad de los datos que expresa el grado en que están presentes todos los datos requeridos."
      },
      {
        "@language": "fr",
        "@value": "Dimension de qualité des données exprimant le degré auquel toutes les données requises sont présentes."
      },
      {
        "@language": "hu",
        "@value": "Adatminőségi dimenzió, amely azt fejezi ki, hogy az összes szükséges adat milyen mértékben van jelen."
      },
      {
        "@language": "it",
        "@value": "Dimensione della qualità dei dati che esprime il grado in cui tutti i dati richiesti sono presenti."
      },
      {
        "@language": "nl",
        "@value": "Gegevenskwaliteitsdimensie die de mate uitdrukt waarin alle vereiste gegevens aanwezig zijn."
      },
      {
        "@language": "pl",
        "@value": "Wymiar jakości danych wyrażający stopień, w jakim obecne są wszystkie wymagane dane."
      },
      {
        "@language": "pt",
        "@value": "Dimensão da qualidade dos dados que exprime o grau em que todos os dados exigidos estão presentes."
      },
      {
        "@language": "ro",
        "@value": "Dimensiune a calității datelor care exprimă gradul în care sunt prezente toate datele necesare."
      },
      {
        "@language": "sv",
        "@value": "Datakvalitetsdimension som uttrycker i vilken grad alla nödvändiga data finns närvarande."
      },
      {
        "@language": "bg",
        "@value": "Измерение на качеството на данните, изразяващо степента, в която са налице всички изисквани данни."
      },
      {
        "@language": "da",
        "@value": "Datakvalitetsdimension, der udtrykker, i hvilken grad alle påkrævede data er til stede."
      },
      {
        "@language": "et",
        "@value": "Andmekvaliteedi mõõde, mis väljendab seda, mil määral on olemas kõik nõutavad andmed."
      },
      {
        "@language": "fi",
        "@value": "Datan laadun ulottuvuus, joka ilmaisee, missä määrin kaikki vaaditut tiedot ovat läsnä."
      },
      {
        "@language": "ga",
        "@value": "Gné de cháilíocht sonraí lena léirítear an méid atá na sonraí riachtanacha uile i láthair."
      },
      {
        "@language": "hr",
        "@value": "Dimenzija kvalitete podataka kojom se izražava stupanj u kojem su prisutni svi potrebni podaci."
      },
      {
        "@language": "lt",
        "@value": "Duomenų kokybės aspektas, išreiškiantis, kokiu mastu pateikiami visi reikalingi duomenys."
      },
      {
        "@language": "lv",
        "@value": "Datu kvalitātes dimensija, kas izsaka pakāpi, kādā ir pieejami visi prasītie dati."
      },
      {
        "@language": "mt",
        "@value": "Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn id-data kollha meħtieġa hija preżenti."
      },
      {
        "@language": "sk",
        "@value": "Rozmer kvality údajov vyjadrujúci mieru, v akej sú prítomné všetky požadované údaje."
      },
      {
        "@language": "sl",
        "@value": "Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere so prisotni vsi zahtevani podatki."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "cs",
        "@value": "Úplnost (rozměr kvality údajů)"
      },
      {
        "@language": "de",
        "@value": "Vollständigkeit (Datenqualitätsdimension)"
      },
      {
        "@language": "el",
