  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0032",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating arrival of a freight wagon at an intermediate location."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující příjezd nákladního vozu do mezilehlého místa."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das die Ankunft eines Güterwagens an einem Zwischenort angibt."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει την άφιξη ενός εμπορευματικού βαγονιού σε ενδιάμεση τοποθεσία."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica la llegada de un vagón de mercancías a un lugar intermedio."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant l'arrivée d'un wagon de fret à un lieu intermédiaire."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon köztes helyre való érkezését jelzi."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica l'arrivo di un carro merci in un luogo intermedio."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die de aankomst van een goederenwagen op een tussenlocatie aangeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące przyjazd wagonu towarowego do miejsca pośredniego."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica a chegada de um vagão de mercadorias a um local intermédio."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică sosirea unui vagon de marfă la o locație intermediară."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger en godsvagns ankomst till en mellanliggande plats."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda kravas vagona pienākšanu starpvietā."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika l-wasla ta' vagun tal-merkanzija f'post intermedju."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca príchod nákladného vozňa na medziľahlé miesto."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje prihod tovornega vagona na vmesno lokacijo."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver en godsvogns ankomst til et mellemliggende sted."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab kaubavaguni saabumist vahekohta."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee tavaravaunun saapumisen välipaikkaan."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl teacht vaigín lasta chuig áit idirmheánach."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava dolazak teretnog vagona na međulokaciju."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodomas prekinio vagono atvykimas į tarpinę vietą."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава пристигането на товарен вагон на междинно място."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
