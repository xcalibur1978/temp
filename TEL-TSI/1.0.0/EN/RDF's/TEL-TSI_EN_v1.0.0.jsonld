      },
      {
        "@language": "hu",
        "@value": "Kocsi érkezése a rendeltetési helyre"
      },
      {
        "@language": "it",
        "@value": "Arrivo del carro a destinazione"
      },
      {
        "@language": "nl",
        "@value": "Wagenaankomst op bestemming"
      },
      {
        "@language": "pl",
        "@value": "Przyjazd wagonu do miejsca przeznaczenia"
      },
      {
        "@language": "pt",
