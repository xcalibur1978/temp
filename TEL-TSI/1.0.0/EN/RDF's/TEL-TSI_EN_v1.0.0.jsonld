  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0061",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Données établissant les règles régissant l'émission des billets et le contrôle des billets."
      },
      {
        "@language": "en",
        "@value": "Data establishing the rules governing the issuing of tickets and the inspection of tickets."
      },
      {
        "@language": "cs",
        "@value": "Údaje stanovící pravidla upravující vydávání jízdenek a kontrolu jízdenek."
      },
      {
        "@language": "de",
        "@value": "Daten zur Festlegung der Regeln für die Ausstellung von Fahrkarten und die Kontrolle von Fahrkarten."
      },
      {
        "@language": "el",
        "@value": "Δεδομένα που καθορίζουν τους κανόνες που διέπουν την έκδοση εισιτηρίων και τον έλεγχο εισιτηρίων."
      },
      {
        "@language": "es",
        "@value": "Datos que establecen las normas que rigen la emisión de billetes y la inspección de billetes."
      },
      {
        "@language": "hu",
        "@value": "Olyan adatok, amelyek megállapítják a jegyek kiadását és a jegyek ellenőrzését szabályozó szabályokat."
      },
      {
        "@language": "it",
        "@value": "Dati che stabiliscono le regole che disciplinano l'emissione dei biglietti e il controllo dei biglietti."
      },
      {
        "@language": "nl",
        "@value": "Gegevens die de regels vaststellen voor de afgifte van vervoerbewijzen en de controle van vervoerbewijzen."
      },
      {
        "@language": "pl",
        "@value": "Dane określające zasady regulujące wystawianie biletów i kontrolę biletów."
      },
      {
        "@language": "pt",
        "@value": "Dados que estabelecem as regras que regem a emissão de bilhetes e a inspeção de bilhetes."
      },
      {
        "@language": "ro",
        "@value": "Date care stabilesc normele care reglementează emiterea biletelor și controlul biletelor."
      },
      {
        "@language": "sv",
        "@value": "Uppgifter som fastställer reglerna för utfärdande av biljetter och kontroll av biljetter."
      },
      {
        "@language": "bg",
        "@value": "Данни, с които се установяват правилата, уреждащи издаването на билети и контрола на билети."
      },
      {
        "@language": "da",
        "@value": "Data, der fastlægger reglerne for udstedelse af billetter og kontrol af billetter."
      },
      {
        "@language": "et",
        "@value": "Andmed, millega kehtestatakse piletite väljaandmist ja piletite kontrollimist reguleerivad reeglid."
      },
      {
        "@language": "fi",
        "@value": "Tiedot, joilla vahvistetaan lippujen myöntämistä ja lippujen tarkastamista koskevat säännöt."
      },
      {
        "@language": "ga",
        "@value": "Sonraí lena mbunaítear na rialacha lena rialaítear eisiúint ticéad agus iniúchadh ticéad."
      },
      {
        "@language": "hr",
        "@value": "Podaci kojima se utvrđuju pravila kojima se uređuju izdavanje karata i kontrola karata."
      },
      {
        "@language": "lt",
        "@value": "Duomenys, kuriais nustatomos bilietų išdavimą ir bilietų tikrinimą reglamentuojančios taisyklės."
      },
      {
        "@language": "lv",
        "@value": "Dati, ar kuriem nosaka biļešu izsniegšanu un biļešu kontroli reglamentējošos noteikumus."
      },
      {
        "@language": "mt",
        "@value": "Data li tistabbilixxi r-regoli li jirregolaw il-ħruġ tal-biljetti u l-kontroll tal-biljetti."
      },
      {
        "@language": "sk",
        "@value": "Údaje stanovujúce pravidlá upravujúce vydávanie cestovných lístkov a kontrolu cestovných lístkov."
      },
      {
        "@language": "sl",
        "@value": "Podatki, ki določajo pravila, ki urejajo izdajo vozovnic in nadzor vozovnic."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
