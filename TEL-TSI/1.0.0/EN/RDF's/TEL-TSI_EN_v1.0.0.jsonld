  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0039",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating that a freight wagon has been delivered."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že nákladní vůz byl dodán."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass ein Güterwagen abgeliefert wurde."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι ένα εμπορευματικό βαγόνι παραδόθηκε."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que un vagón de mercancías ha sido entregado."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'un wagon de fret a été livré."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy tehervagont leszállítottak."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un carro merci è stato consegnato."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een goederenwagen is afgeleverd."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wagon towarowy został dostarczony."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que um vagão de mercadorias foi entregue."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en godsvagn har levererats."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että tavaravaunu on toimitettu."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl gur seachadadh vaigín lasta."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je teretni vagon isporučen."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad prekinis vagonas buvo pristatytas."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka kravas vagons ir piegādāts."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li vagun tal-merkanzija ġie kkonsenjat."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că un vagon de marfă a fost livrat."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že nákladný vozeň bol dodaný."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je bil tovorni vagon dostavljen."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en godsvogn er blevet leveret."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et kaubavagun on kohale toimetatud."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че товарен вагон е доставен."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
