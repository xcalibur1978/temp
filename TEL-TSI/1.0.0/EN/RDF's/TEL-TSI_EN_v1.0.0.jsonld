      },
      {
        "@language": "el",
        "@value": "Δημόσια ώρα άφιξης"
      },
      {
        "@language": "bg",
        "@value": "Публичен час на пристигане"
      },
      {
        "@language": "da",
        "@value": "Offentlig ankomsttid"
      },
      {
        "@language": "et",
        "@value": "Avalik saabumisaeg"
      },
      {
        "@language": "fi",
        "@value": "Julkinen saapumisaika"
      },
      {
        "@language": "ga",
        "@value": "Am teachta poiblí"
      },
      {
        "@language": "hr",
        "@value": "Javno vrijeme dolaska"
      },
      {
        "@language": "lt",
        "@value": "Vieša atvykimo laikas"
      },
      {
        "@language": "lv",
        "@value": "Publiskais pienākšanas laiks"
      },
      {
        "@language": "mt",
        "@value": "Ħin tal-wasla pubbliku"
      },
      {
        "@language": "sk",
        "@value": "Verejný čas príchodu"
      },
      {
        "@language": "sl",
        "@value": "Javni čas prihoda"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0059",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_44"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Agregované údaje stanovené distributorem, které kombinují použitelné tarify, s cenou železničního produktu, kterou maloobchodník dluží distributorovi."
      },
      {
        "@language": "el",
        "@value": "Συγκεντρωτικά δεδομένα που καταρτίζονται από διανομέα και συνδυάζουν τα ισχύοντα τιμολόγια, με την τιμή του σιδηροδρομικού προϊόντος που οφείλεται από τον λιανοπωλητή στον διανομέα."
      },
      {
        "@language": "en",
        "@value": "Aggregated data established by a distributor combining applicable tariffs, with the rail-product price due by the retailer to the distributor."
      },
      {
        "@language": "sv",
        "@value": "Aggregerade uppgifter som fastställs av en distributör och som kombinerar tillämpliga tariffer, med det pris för järnvägsprodukten som återförsäljaren är skyldig distributören."
      },
      {
        "@language": "de",
        "@value": "Von einem Vertreiber erstellte aggregierte Daten, die anwendbare Tarife kombinieren, mit dem vom Einzelhändler an den Vertreiber zu zahlenden Preis des Bahnprodukts."
      },
      {
        "@language": "es",
        "@value": "Datos agregados establecidos por un distribuidor que combinan las tarifas aplicables, con el precio del producto ferroviario que el minorista debe abonar al distribuidor."
      },
      {
        "@language": "fr",
        "@value": "Données agrégées établies par un distributeur combinant les tarifs applicables, avec le prix du produit ferroviaire dû par le détaillant au distributeur."
      },
      {
        "@language": "hu",
        "@value": "Egy forgalmazó által megállapított összesített adatok, amelyek az alkalmazandó tarifákat kombinálják, a vasúti terméknek a kiskereskedő által a forgalmazónak fizetendő árával."
      },
      {
        "@language": "it",
        "@value": "Dati aggregati stabiliti da un distributore che combinano le tariffe applicabili, con il prezzo del prodotto ferroviario dovuto dal rivenditore al distributore."
      },
      {
        "@language": "nl",
        "@value": "Door een distributeur vastgestelde geaggregeerde gegevens die toepasselijke tarieven combineren, met de door de detailhandelaar aan de distributeur verschuldigde prijs van het spoorproduct."
      },
      {
        "@language": "pl",
        "@value": "Zagregowane dane ustalone przez dystrybutora łączące mające zastosowanie taryfy, wraz z ceną produktu kolejowego należną od sprzedawcy detalicznego dystrybutorowi."
      },
      {
        "@language": "pt",
        "@value": "Dados agregados estabelecidos por um distribuidor que combinam as tarifas aplicáveis, com o preço do produto ferroviário devido pelo retalhista ao distribuidor."
      },
      {
        "@language": "ro",
        "@value": "Date agregate stabilite de un distribuitor care combină tarifele aplicabile, cu prețul produsului feroviar datorat de comerciantul cu amănuntul distribuitorului."
      },
      {
        "@language": "bg",
        "@value": "Агрегирани данни, установени от дистрибутор, които комбинират приложимите тарифи, с цената на железопътния продукт, дължима от търговеца на дребно на дистрибутора."
      },
      {
        "@language": "da",
        "@value": "Aggregerede data, der fastlægges af en distributør, og som kombinerer de gældende tariffer, med den pris for jernbaneproduktet, som detailhandleren skylder distributøren."
      },
      {
        "@language": "et",
        "@value": "Koondatud andmed, mille kehtestab turustaja ja mis ühendavad kohaldatavaid tariife, koos raudteetoote hinnaga, mille jaemüüja võlgneb turustajale."
      },
      {
        "@language": "fi",
        "@value": "Jakelijan vahvistamat koostetut tiedot, joissa yhdistetään sovellettavat tariffit, ja joihin sisältyy rautatietuotteen hinta, jonka vähittäismyyjä on velkaa jakelijalle."
      },
      {
        "@language": "ga",
        "@value": "Sonraí comhiomlánaithe arna mbunú ag dáileoir lena gcomhcheanglaítear na taraifí is infheidhme, le praghas an táirge iarnróid atá dlite ag an miondíoltóir don dáileoir."
      },
      {
        "@language": "hr",
        "@value": "Skupni podaci koje utvrđuje distributer i kojima se kombiniraju primjenjive tarife, s cijenom željezničkog proizvoda koju trgovac na malo duguje distributeru."
      },
      {
        "@language": "lt",
        "@value": "Suvestiniai duomenys, kuriuos nustato platintojas ir kuriuose derinami taikytini tarifai, su geležinkelių produkto kaina, kurią mažmenininkas turi sumokėti platintojui."
      },
      {
        "@language": "mt",
        "@value": "Data aggregata stabbilita minn distributur li tikkombina t-tariffi applikabbli, bil-prezz tal-prodott ferrovjarju dovut min-negozjant bl-imnut lid-distributur."
      },
      {
        "@language": "sk",
        "@value": "Agregované údaje stanovené distribútorom, ktoré kombinujú uplatniteľné tarify, s cenou železničného produktu, ktorú maloobchodník dlhuje distribútorovi."
      },
      {
        "@language": "sl",
        "@value": "Združeni podatki, ki jih določi distributer in združujejo veljavne tarife, s ceno železniškega proizvoda, ki jo trgovec na drobno dolguje distributerju."
      },
      {
        "@language": "lv",
        "@value": "Apkopoti dati, ko nosaka izplatītājs un kas apvieno piemērojamos tarifus, ar dzelzceļa produkta cenu, ko mazumtirgotājs ir parādā izplatītājam."
      }
    ],
