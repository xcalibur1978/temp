    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care raportează o neregulă care afectează un vagon de marfă."
      },
      {
        "@language": "en",
        "@value": "Wagon event reporting an irregularity affecting a freight wagon."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu oznamující nesrovnalost týkající se nákladního vozu."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis zur Meldung einer Unregelmäßigkeit, die einen Güterwagen betrifft."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που αναφέρει παρατυπία η οποία επηρεάζει ένα εμπορευματικό βαγόνι."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que notifica una irregularidad que afecta a un vagón de mercancías."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon signalant une irrégularité affectant un wagon de fret."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagont érintő rendellenességet jelent."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che segnala un'irregolarità riguardante un carro merci."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die een onregelmatigheid meldt die een goederenwagen treft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu zgłaszające nieprawidłowość dotyczącą wagonu towarowego."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que comunica uma irregularidade que afeta um vagão de mercadorias."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som rapporterar en oegentlighet som påverkar en godsvagn."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се докладва за нередност, засягаща товарен вагон."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der indberetter en uregelmæssighed, der påvirker en godsvogn."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, millega teatatakse kaubavagunit mõjutavast rikkumisest."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, jolla ilmoitetaan tavaravaunua koskevasta poikkeamasta."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena dtuairiscítear mírialtacht a dhéanann difear do vaigín lasta."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se prijavljuje nepravilnost koja utječe na teretni vagon."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo pranešama apie pažeidimą, darantį poveikį prekiniam vagonui."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru ziņo par neatbilstību, kas ietekmē kravas vagonu."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jirrapporta irregolarità li taffettwa vagun tal-merkanzija."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa oznamujúca nezrovnalosť týkajúcu sa nákladného vozňa."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki sporoča nepravilnost, ki vpliva na tovorni vagon."
      }
    ],
