      {
        "@language": "lt",
        "@value": "Pasiūlymas"
      },
      {
        "@language": "lv",
        "@value": "Piedāvājums"
      },
      {
        "@language": "bg",
        "@value": "Оферта"
      },
      {
        "@language": "fi",
        "@value": "Tarjous"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0083",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The right to consult the data with or without control over it, distinctively from other rights and obligations relating to its use for non-commercial or commercial purposes."
      },
      {
        "@language": "hu",
        "@value": "Az adatok megtekintésének joga, az azok feletti ellenőrzéssel vagy anélkül, megkülönböztetve az azok nem kereskedelmi vagy kereskedelmi célú felhasználásához kapcsolódó egyéb jogoktól és kötelezettségektől."
      },
      {
        "@language": "cs",
        "@value": "Právo nahlížet do údajů s kontrolou nad nimi nebo bez ní, odlišné od jiných práv a povinností týkajících se jejich využití pro nekomerční nebo komerční účely."
      },
      {
        "@language": "el",
        "@value": "Το δικαίωμα συμβουλευτικής πρόσβασης στα δεδομένα, με ή χωρίς έλεγχο επ' αυτών, διακριτό από άλλα δικαιώματα και υποχρεώσεις σχετικά με τη χρήση τους για μη εμπορικούς ή εμπορικούς σκοπούς."
      },
      {
        "@language": "es",
        "@value": "El derecho a consultar los datos, con o sin control sobre ellos, distinto de otros derechos y obligaciones relativos a su uso con fines no comerciales o comerciales."
      },
      {
        "@language": "it",
        "@value": "Il diritto di consultare i dati, con o senza controllo su di essi, distinto da altri diritti e obblighi relativi al loro uso per scopi non commerciali o commerciali."
      },
      {
        "@language": "fr",
        "@value": "Le droit de consulter les données, avec ou sans contrôle sur celles-ci, distinct des autres droits et obligations relatifs à leur utilisation à des fins non commerciales ou commerciales."
      },
      {
        "@language": "de",
        "@value": "Das Recht, Daten mit oder ohne Kontrolle darüber einzusehen, unterschieden von anderen Rechten und Pflichten in Bezug auf deren Nutzung zu nichtkommerziellen oder kommerziellen Zwecken."
      },
      {
        "@language": "pl",
        "@value": "Prawo do wglądu w dane, z kontrolą nad nimi lub bez niej, odrębne od innych praw i obowiązków związanych z ich wykorzystywaniem do celów niekomercyjnych lub komercyjnych."
      },
      {
        "@language": "pt",
        "@value": "O direito de consultar os dados, com ou sem controlo sobre os mesmos, distinto de outros direitos e obrigações relativos à sua utilização para fins não comerciais ou comerciais."
      },
      {
        "@language": "ro",
        "@value": "Dreptul de a consulta datele, cu sau fără control asupra acestora, distinct de alte drepturi și obligații referitoare la utilizarea lor în scopuri necomerciale sau comerciale."
      },
      {
        "@language": "sv",
        "@value": "Rätten att ta del av data med eller utan kontroll över dem, åtskild från andra rättigheter och skyldigheter avseende deras användning för icke-kommersiella eller kommersiella ändamål."
      },
      {
        "@language": "nl",
        "@value": "Het recht om gegevens te raadplegen met of zonder controle daarover, onderscheiden van andere rechten en verplichtingen in verband met het gebruik ervan voor niet-commerciële of commerciële doeleinden."
      },
      {
        "@language": "bg",
        "@value": "Правото да се преглеждат данните със или без контрол върху тях, различно от други права и задължения, свързани с използването им за нетърговски или търговски цели."
      },
      {
        "@language": "da",
        "@value": "Retten til at se data med eller uden kontrol over dem, adskilt fra andre rettigheder og forpligtelser vedrørende anvendelsen heraf til ikkekommercielle eller kommercielle formål."
      },
      {
        "@language": "et",
        "@value": "Õigus tutvuda andmetega kontrolliga nende üle või ilma selleta, mis erineb muudest õigustest ja kohustustest, mis on seotud nende kasutamisega mitteärilistel või ärilistel eesmärkidel."
      },
      {
        "@language": "fi",
        "@value": "Oikeus tarkastella dataa joko niin, että käyttäjä voi valvoa dataa, tai ilman tätä, erotettuna muista oikeuksista ja velvollisuuksista, jotka liittyvät datan käyttöön ei-kaupallisiin tai kaupallisiin tarkoituksiin."
      },
      {
        "@language": "ga",
        "@value": "An ceart breathnú ar shonraí le rialú orthu nó gan rialú orthu, atá éagsúil ó chearta agus oibleagáidí eile a bhaineann lena n-úsáid chun críoch neamhthráchtála nó tráchtála."
      },
      {
        "@language": "hr",
        "@value": "Pravo na uvid u podatke s kontrolom nad njima ili bez nje, različito od drugih prava i obveza povezanih s njihovom uporabom u nekomercijalne ili komercijalne svrhe."
      },
      {
        "@language": "lt",
        "@value": "Teisė susipažinti su duomenimis juos kontroliuojant arba ne, atskirta nuo kitų teisių ir pareigų, susijusių su jų naudojimu nekomerciniais arba komerciniais tikslais."
      },
      {
        "@language": "lv",
        "@value": "Tiesības aplūkot datus, tos kontrolējot vai nekontrolējot, atšķirībā no citām tiesībām un pienākumiem, kas saistīti ar to izmantošanu nekomerciāliem vai komerciāliem mērķiem."
      },
      {
        "@language": "mt",
        "@value": "Id-dritt li wieħed jikkonsulta d-data bil-kontroll fuqha jew mingħajru, distint minn drittijiet u obbligi oħra relatati mal-użu tagħha għal skopijiet mhux kummerċjali jew kummerċjali."
      },
      {
        "@language": "sl",
        "@value": "Pravica do vpogleda v podatke z nadzorom nad njimi ali brez njega, ki se razlikuje od drugih pravic in obveznosti v zvezi z njihovo uporabo za nekomercialne ali komercialne namene."
      },
      {
        "@language": "sk",
        "@value": "Právo nahliadať do údajov s kontrolou nad nimi alebo bez nej, odlišné od iných práv a povinností týkajúcich sa ich využívania na nekomerčné alebo komerčné účely."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
