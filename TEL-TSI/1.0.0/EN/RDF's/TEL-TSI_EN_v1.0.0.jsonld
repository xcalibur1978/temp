  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0080",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "ro",
        "@value": "Punerea la dispoziție a datelor de către un deținător de date unui destinatar de date în scopul utilizării comune sau individuale a acestor date, în mod direct sau printr-un intermediar, de exemplu în temeiul unor licențe deschise sau comerciale, cu titlu oneros sau gratuit."
      },
      {
        "@language": "en",
        "@value": "The provision of data by a data holder to a data recipient for the purpose of the joint or individual use of such data, directly or through an intermediary, for example under open or commercial licences subject to a fee or free of charge."
      },
      {
        "@language": "cs",
        "@value": "Poskytnutí údajů držitelem údajů příjemci údajů za účelem společného nebo individuálního využití těchto údajů, přímo nebo prostřednictvím zprostředkovatele, například na základě otevřených nebo komerčních licencí za úplatu nebo bezplatně."
      },
      {
        "@language": "de",
        "@value": "Die Bereitstellung von Daten durch einen Dateninhaber an einen Datenempfänger zum Zwecke der gemeinsamen oder individuellen Nutzung dieser Daten, unmittelbar oder über einen Vermittler, beispielsweise im Rahmen offener oder kommerzieller Lizenzen gegen Entgelt oder unentgeltlich."
      },
      {
        "@language": "es",
        "@value": "Puesta a disposición de datos por parte de un titular de datos a un destinatario de datos con el fin de hacer un uso conjunto o individual de dichos datos, directamente o a través de un intermediario, por ejemplo, mediante licencias abiertas o comerciales a título oneroso o gratuito."
      },
      {
        "@language": "fr",
        "@value": "Mise à disposition de données par un détenteur de données à un destinataire de données aux fins de l'utilisation conjointe ou individuelle de ces données, directement ou par l'intermédiaire d'un tiers, par exemple sous licence ouverte ou commerciale, à titre onéreux ou gratuit."
      },
      {
        "@language": "hu",
        "@value": "Adatoknak az adatok birtokosa általi rendelkezésre bocsátása egy adatátvevő számára ezen adatok közös vagy egyéni felhasználása céljából, közvetlenül vagy közvetítőn keresztül, például nyílt vagy kereskedelmi licencek alapján, díjazás ellenében vagy ingyenesen."
      },
      {
        "@language": "it",
        "@value": "Messa a disposizione di dati da parte di un detentore dei dati a un destinatario dei dati ai fini dell'uso congiunto o individuale di tali dati, direttamente o tramite un intermediario, ad esempio con licenze aperte o commerciali a titolo oneroso o gratuito."
      },
      {
        "@language": "nl",
        "@value": "Het verstrekken van gegevens door een gegevenshouder aan een gegevensontvanger met het oog op het gezamenlijke of individuele gebruik van die gegevens, rechtstreeks of via een tussenpersoon, bijvoorbeeld in het kader van open of commerciële licenties tegen vergoeding of kosteloos."
      },
      {
        "@language": "pl",
        "@value": "Udostępnianie danych przez posiadacza danych odbiorcy danych do celów wspólnego lub indywidualnego korzystania z takich danych, bezpośrednio lub za pośrednictwem pośrednika, na przykład na podstawie licencji otwartych lub komercyjnych odpłatnie lub nieodpłatnie."
      },
      {
        "@language": "pt",
        "@value": "Disponibilização de dados por um detentor de dados a um destinatário de dados para efeitos da utilização conjunta ou individual desses dados, diretamente ou através de um intermediário, por exemplo ao abrigo de licenças abertas ou comerciais, a título oneroso ou gratuito."
      },
      {
        "@language": "sv",
        "@value": "Tillhandahållande av data från en datainnehavare till en datamottagare för gemensam eller individuell användning av sådana data, direkt eller via en mellanhand, exempelvis enligt öppna eller kommersiella licenser mot avgift eller kostnadsfritt."
      },
      {
        "@language": "el",
        "@value": "Η παροχή δεδομένων από κάτοχο δεδομένων σε αποδέκτη δεδομένων για τους σκοπούς της από κοινού ή ατομικής χρήσης των εν λόγω δεδομένων, απευθείας ή μέσω ενδιαμέσου, για παράδειγμα βάσει ανοικτών ή εμπορικών αδειών έναντι αμοιβής ή δωρεάν."
      },
      {
        "@language": "da",
        "@value": "En dataindehavers tilrådighedsstillelse af data for en datamodtager med henblik på fælles eller individuel anvendelse af sådanne data, direkte eller gennem en mellemmand, f.eks. i henhold til åbne eller kommercielle licenser mod betaling eller gratis."
      },
      {
        "@language": "et",
        "@value": "Andmevaldaja poolt andmete kättesaadavaks tegemine andmesaajale nende andmete ühiseks või individuaalseks kasutamiseks, otse või vahendaja kaudu, näiteks avatud või kaubanduslike litsentside alusel tasu eest või tasuta."
      },
      {
        "@language": "fi",
        "@value": "Datan asettaminen datan haltijan toimesta datan vastaanottajan saataville kyseisen datan yhteistä tai yksittäistä käyttöä varten suoraan tai välittäjän kautta esimerkiksi avoimilla tai kaupallisilla lisensseillä maksua vastaan tai maksutta."
      },
      {
        "@language": "ga",
        "@value": "Sonraí a chur ar fáil ag sealbhóir sonraí d'fhaighteoir sonraí chun na sonraí sin a úsáid go comhpháirteach nó go haonarach, go díreach nó trí idirghabhálaí, mar shampla faoi cheadúnais oscailte nó tráchtála ar tháille nó saor in aisce."
      },
      {
        "@language": "hr",
        "@value": "Pružanje podataka koje posjednik podataka stavlja na raspolaganje primatelju podataka u svrhu zajedničke ili pojedinačne uporabe tih podataka, izravno ili putem posrednika, primjerice na temelju otvorenih ili komercijalnih licencija uz naknadu ili besplatno."
      },
      {
        "@language": "lt",
        "@value": "Duomenų valdytojo atliekamas duomenų teikimas duomenų gavėjui, kad tais duomenimis būtų bendrai arba atskirai naudojamasi, tiesiogiai arba per tarpininką, pavyzdžiui, pagal atvirąsias arba komercines licencijas už atlygį arba nemokamai."
      },
      {
        "@language": "lv",
        "@value": "Datu sniegšana, ko datu turētājs veic datu saņēmējam šo datu kopīgai vai individuālai izmantošanai, tieši vai ar starpnieka palīdzību, piemēram, saskaņā ar atvērtām vai komerciālām licencēm par maksu vai bez maksas."
      },
      {
        "@language": "mt",
        "@value": "It-tqegħid għad-dispożizzjoni tad-data minn detentur tad-data lil riċevitur tad-data għall-finijiet tal-użu konġunt jew individwali ta' tali data, direttament jew permezz ta' intermedjarju, pereżempju taħt liċenzji miftuħa jew kummerċjali bi ħlas jew mingħajr ħlas."
      },
      {
        "@language": "sl",
        "@value": "Zagotavljanje podatkov s strani imetnika podatkov prejemniku podatkov za skupno ali individualno uporabo teh podatkov, neposredno ali prek posrednika, na primer na podlagi odprtih ali komercialnih licenc proti plačilu ali brezplačno."
      },
      {
        "@language": "bg",
        "@value": "Предоставянето на данни от притежател на данни на получател на данни с цел съвместно или индивидуално използване на тези данни, пряко или чрез посредник, например по силата на отворени или търговски лицензи срещу заплащане или безплатно."
      },
      {
        "@language": "sk",
        "@value": "Poskytnutie údajov držiteľom údajov príjemcovi údajov na účely spoločného alebo individuálneho využívania týchto údajov, priamo alebo prostredníctvom sprostredkovateľa, napríklad na základe otvorených alebo komerčných licencií za odplatu alebo bezodplatne."
      }
    ],
