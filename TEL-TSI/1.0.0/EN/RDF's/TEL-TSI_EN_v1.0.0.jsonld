  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0013",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hu",
        "@value": "Üzenet, amely visszaigazolja egy üzenet átvételét a telematikai érdekelt felek között."
      },
      {
        "@language": "nl",
        "@value": "Bericht ter bevestiging van de ontvangst van een bericht tussen telematicabelanghebbenden."
      },
      {
        "@language": "pl",
        "@value": "Komunikat potwierdzający odbiór komunikatu między zainteresowanymi stronami telematyki."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que confirma a receção de uma mensagem entre as partes interessadas da telemática."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care confirmă primirea unui mesaj între părțile interesate din domeniul telematicii."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som bekräftar mottagandet av ett meddelande mellan berörda parter inom telematik."
      },
      {
        "@language": "cs",
        "@value": "Zpráva potvrzující přijetí zprávy mezi zúčastněnými stranami v oblasti telematiky."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Bestätigung des Empfangs einer Nachricht zwischen Telematikbeteiligten."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που επιβεβαιώνει την παραλαβή ενός μηνύματος μεταξύ των ενδιαφερόμενων μερών της τηλεματικής."
      },
      {
        "@language": "en",
        "@value": "Message confirming receipt of a message between telematics stakeholders."
      },
      {
        "@language": "es",
        "@value": "Mensaje que confirma la recepción de un mensaje entre las partes interesadas de la telemática."
      },
      {
        "@language": "fr",
        "@value": "Message confirmant la réception d'un message entre acteurs de la télématique."
      },
      {
        "@language": "it",
        "@value": "Messaggio che conferma la ricezione di un messaggio tra i soggetti interessati della telematica."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се потвърждава получаването на съобщение между заинтересованите страни в областта на телематиката."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der bekræfter modtagelsen af en meddelelse mellem interessenter inden for telematik."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega kinnitatakse sõnumi kättesaamine telemaatika sidusrühmade vahel."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla vahvistetaan viestin vastaanottaminen telematiikan sidosryhmien välillä."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndeimhnítear go bhfuarthas teachtaireacht idir na páirtithe leasmhara i réimse na teileamaitice."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se potvrđuje primitak poruke među zainteresiranim stranama u području telematike."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo patvirtinamas pranešimo gavimas tarp telematikos suinteresuotųjų subjektų."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru apstiprina ziņojuma saņemšanu starp telemātikas ieinteresētajām personām."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jikkonferma l-wasla ta' messaġġ bejn il-partijiet ikkonċernati fil-qasam tat-telematika."
      },
      {
        "@language": "sk",
        "@value": "Správa potvrdzujúca prijatie správy medzi zainteresovanými stranami v oblasti telematiky."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki potrjuje prejem sporočila med zainteresiranimi stranmi na področju telematike."
      }
    ],
