  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0076",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_46"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An organisation empowered to inspect passenger tickets, including at platform access doors."
      },
      {
        "@language": "cs",
        "@value": "Organizace zmocněná kontrolovat jízdenky cestujících, mimo jiné u přístupových dveří na nástupiště."
      },
      {
        "@language": "de",
        "@value": "Eine Organisation, die befugt ist, Fahrkarten von Fahrgästen zu kontrollieren, auch an den Zugangstüren zum Bahnsteig."
      },
      {
        "@language": "el",
        "@value": "Οργανισμός εξουσιοδοτημένος να ελέγχει τα εισιτήρια των επιβατών, μεταξύ άλλων στις θύρες πρόσβασης στην αποβάθρα."
      },
      {
        "@language": "es",
        "@value": "Organización facultada para inspeccionar los billetes de los viajeros, incluso en las puertas de acceso al andén."
      },
      {
        "@language": "fr",
        "@value": "Organisation habilitée à contrôler les billets des voyageurs, y compris aux portes d'accès aux quais."
      },
      {
        "@language": "hu",
        "@value": "Olyan szervezet, amely jogosult az utasok jegyeinek ellenőrzésére, többek között a peronhoz való hozzáférést biztosító ajtóknál."
      },
      {
        "@language": "it",
        "@value": "Organizzazione abilitata a controllare i biglietti dei passeggeri, anche alle porte di accesso ai marciapiedi."
      },
      {
        "@language": "nl",
        "@value": "Een organisatie die gemachtigd is de vervoerbewijzen van reizigers te controleren, ook bij de toegangsdeuren tot het perron."
      },
      {
        "@language": "pl",
        "@value": "Organizacja uprawniona do kontroli biletów pasażerów, w tym przy drzwiach dostępu do peronu."
      },
      {
        "@language": "pt",
        "@value": "Organização habilitada a inspecionar os bilhetes dos passageiros, inclusive nas portas de acesso à plataforma."
      },
      {
        "@language": "ro",
        "@value": "Organizație abilitată să controleze biletele călătorilor, inclusiv la ușile de acces la peron."
      },
      {
        "@language": "sv",
        "@value": "En organisation som har befogenhet att kontrollera resenärers biljetter, även vid åtkomstdörrarna till plattformen."
      },
      {
        "@language": "bg",
        "@value": "Организация, оправомощена да контролира билетите на пътниците, включително при вратите за достъп до перона."
      },
      {
        "@language": "da",
        "@value": "En organisation, der er bemyndiget til at kontrollere passagerers billetter, herunder ved adgangsdørene til perronen."
      },
      {
        "@language": "et",
        "@value": "Organisatsioon, kellel on õigus kontrollida reisijate pileteid, sealhulgas perroonile juurdepääsu uste juures."
      },
      {
        "@language": "fi",
        "@value": "Organisaatio, jolla on valtuudet tarkastaa matkustajien liput, myös laiturille pääsyn oville."
      },
      {
        "@language": "ga",
        "@value": "Eagraíocht atá údaraithe ticéid na bpaisinéirí a iniúchadh, lena n-áirítear ag na doirse rochtana chuig an ardán."
      },
      {
        "@language": "hr",
        "@value": "Organizacija ovlaštena za kontrolu karata putnika, među ostalim na pristupnim vratima na peron."
      },
      {
        "@language": "lt",
        "@value": "Organizacija, įgaliota tikrinti keleivių bilietus, be kita ko, prie prieigos prie perono durų."
      },
      {
        "@language": "lv",
        "@value": "Organizācija, kas pilnvarota kontrolēt pasažieru biļetes, tostarp pie piekļuves durvīm uz peronu."
      },
      {
        "@language": "mt",
        "@value": "Organizzazzjoni awtorizzata tikkontrolla l-biljetti tal-passiġġieri, inkluż fil-bibien tal-aċċess għall-pjattaforma."
      },
      {
        "@language": "sk",
        "@value": "Organizácia oprávnená kontrolovať cestovné lístky cestujúcich, a to aj pri prístupových dverách na nástupište."
      },
      {
        "@language": "sl",
        "@value": "Organizacija, pooblaščena za nadzor vozovnic potnikov, tudi pri dostopnih vratih na peron."
      }
    ],
