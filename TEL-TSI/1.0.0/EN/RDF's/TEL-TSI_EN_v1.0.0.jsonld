  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0026",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Forecast information for a freight wagon, with accuracy determined by the regulation's accuracy methodology."
      },
      {
        "@language": "cs",
        "@value": "Predikční informace o nákladním voze, jejichž přesnost se určuje metodikou přesnosti uvedenou v nařízení."
      },
      {
        "@language": "de",
        "@value": "Prognoseinformationen für einen Güterwagen, deren Genauigkeit anhand der Genauigkeitsmethodik der Verordnung bestimmt wird."
      },
      {
        "@language": "es",
        "@value": "Información de previsión para un vagón de mercancías, cuya precisión se determina mediante la metodología de precisión del reglamento."
      },
      {
        "@language": "fr",
        "@value": "Informations de prévision pour un wagon de fret, dont la précision est déterminée par la méthodologie de précision du règlement."
      },
      {
        "@language": "hu",
        "@value": "Egy tehervagonra vonatkozó előrejelzési információk, amelyek pontosságát a rendelet pontossági módszertana határozza meg."
      },
      {
        "@language": "it",
        "@value": "Informazioni previsionali per un carro merci, la cui precisione è determinata dalla metodologia di precisione del regolamento."
      },
      {
        "@language": "nl",
        "@value": "Prognose-informatie voor een goederenwagen, waarvan de nauwkeurigheid wordt bepaald door de nauwkeurigheidsmethodiek van de verordening."
      },
      {
        "@language": "pl",
        "@value": "Informacje prognozowe dotyczące wagonu towarowego, których dokładność określa się metodyką dokładności rozporządzenia."
      },
      {
        "@language": "pt",
        "@value": "Informações de previsão para um vagão de mercadorias, cuja precisão é determinada pela metodologia de precisão do regulamento."
      },
      {
        "@language": "ro",
        "@value": "Informații de prognoză pentru un vagon de marfă, a căror precizie este determinată prin metodologia de precizie a regulamentului."
      },
      {
        "@language": "sv",
        "@value": "Prognosinformation för en godsvagn, vars noggrannhet fastställs genom förordningens noggrannhetsmetod."
      },
      {
        "@language": "ga",
        "@value": "Faisnéis réamhaisnéise do vaigín lasta, a gcinntear a cruinneas le modheolaíocht chruinnis an rialacháin."
      },
      {
        "@language": "hr",
        "@value": "Prognostičke informacije za teretni vagon, čija se točnost utvrđuje metodologijom točnosti iz uredbe."
      },
      {
        "@language": "lt",
        "@value": "Prekinio vagono prognozės informacija, kurios tikslumas nustatomas pagal reglamento tikslumo metodiką."
      },
      {
        "@language": "lv",
        "@value": "Prognozes informācija par kravas vagonu, kuras precizitāti nosaka ar regulas precizitātes metodiku."
      },
      {
        "@language": "mt",
        "@value": "Informazzjoni ta' tbassir għal vagun tal-merkanzija, li l-preċiżjoni tagħha tiġi ddeterminata mill-metodoloġija tal-preċiżjoni tar-regolament."
      },
      {
        "@language": "sk",
        "@value": "Predpovedné informácie o nákladnom vozni, ktorých presnosť sa určuje metodikou presnosti uvedenou v nariadení."
      },
      {
        "@language": "sl",
        "@value": "Napovedne informacije za tovorni vagon, katerih natančnost se določi z metodologijo natančnosti iz uredbe."
      },
      {
        "@language": "bg",
        "@value": "Прогнозна информация за товарен вагон, чиято точност се определя по методиката за точност на регламента."
      },
      {
        "@language": "da",
        "@value": "Prognoseoplysninger for en godsvogn, hvis nøjagtighed fastsættes ved forordningens nøjagtighedsmetode."
      },
      {
        "@language": "et",
        "@value": "Kaubavaguni prognoositeave, mille täpsus määratakse kindlaks määruse täpsusmetoodikaga."
      },
      {
        "@language": "fi",
        "@value": "Tavaravaunua koskevat ennustetiedot, joiden tarkkuus määritetään asetuksen tarkkuusmenetelmällä."
      },
      {
        "@language": "el",
        "@value": "Πληροφορίες πρόβλεψης για ένα εμπορευματικό βαγόνι, η ακρίβεια των οποίων καθορίζεται από τη μεθοδολογία ακρίβειας του κανονισμού."
      }
    ],
