  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0040",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Referenční databáze kolejových vozidel, včetně evropského čísla vozidla, držitele, typu a technických parametrů; spravované železničním odvětvím a propojené ze společného centrálního úložiště agentury ERA."
      },
      {
        "@language": "ro",
        "@value": "Baze de date de referință privind materialul rulant, inclusiv numărul european de vehicul, deținătorul, tipul și parametrii tehnici; gestionate de sectorul feroviar și conectate la registrul central comun al AUE."
      },
      {
        "@language": "sv",
        "@value": "Referensdatabaser för rullande materiel, inbegripet det europeiska fordonsnumret, innehavaren, typen och de tekniska parametrarna; förvaltas av järnvägssektorn och länkas från Eras gemensamma centrala lagringsplats."
      },
      {
        "@language": "de",
        "@value": "Referenzdatenbanken für Fahrzeuge, einschließlich der europäischen Fahrzeugnummer, des Halters, des Typs und der technischen Parameter; vom Eisenbahnsektor verwaltet und aus dem gemeinsamen zentralen Verzeichnis der ERA verlinkt."
      },
      {
        "@language": "en",
        "@value": "Reference databases for rolling stock, including the European Vehicle Number, keeper, type and technical parameters; managed by the rail sector and linked from the ERA common central repository."
      },
      {
        "@language": "es",
        "@value": "Bases de datos de referencia del material rodante, incluidos el número europeo de vehículo, el poseedor, el tipo y los parámetros técnicos; gestionadas por el sector ferroviario y vinculadas al registro central común de la ERA."
      },
      {
        "@language": "fr",
        "@value": "Bases de données de référence du matériel roulant, comprenant le numéro européen de véhicule, le détenteur, le type et les paramètres techniques; gérées par le secteur ferroviaire et reliées au registre central commun de l'ERA."
      },
      {
        "@language": "hu",
        "@value": "A gördülőállomány referencia-adatbázisai, beleértve az európai járműszámot, az üzemben tartót, a típust és a műszaki paramétereket; ezeket a vasúti ágazat kezeli, és az ERA közös központi adattárából hivatkoznak rájuk."
      },
      {
        "@language": "it",
        "@value": "Banche dati di riferimento del materiale rotabile, compresi il numero europeo di veicolo, il detentore, il tipo e i parametri tecnici; gestite dal settore ferroviario e collegate al registro centrale comune dell'ERA."
      },
      {
        "@language": "nl",
        "@value": "Referentiedatabanken voor rollend materieel, met inbegrip van het Europees voertuignummer, de houder, het type en de technische parameters; beheerd door de spoorsector en gekoppeld vanuit het gemeenschappelijk centraal register van het ERA."
      },
      {
        "@language": "pl",
        "@value": "Referencyjne bazy danych taboru, w tym europejski numer pojazdu, dysponent, typ i parametry techniczne; zarządzane przez sektor kolejowy i powiązane ze wspólnym repozytorium centralnym ERA."
      },
      {
        "@language": "pt",
        "@value": "Bases de dados de referência do material circulante, incluindo o número europeu de veículo, o detentor, o tipo e os parâmetros técnicos; geridas pelo setor ferroviário e ligadas ao repositório central comum da AFE."
      },
      {
        "@language": "da",
        "@value": "Referencedatabaser for rullende materiel, herunder det europæiske køretøjsnummer, ihændehaveren, typen og de tekniske parametre; forvaltes af jernbanesektoren og linkes fra ERA's fælles centrale register."
      },
      {
        "@language": "el",
        "@value": "Βάσεις δεδομένων αναφοράς τροχαίου υλικού, συμπεριλαμβανομένου του ευρωπαϊκού αριθμού οχήματος, του κατόχου, του τύπου και των τεχνικών παραμέτρων· τις διαχειρίζεται ο σιδηροδρομικός τομέας και συνδέονται με το κοινό κεντρικό αποθετήριο του ΟΣΕΕ."
      },
      {
        "@language": "et",
        "@value": "Veeremi võrdlusandmebaasid, sealhulgas Euroopa sõidukinumber, valdaja, tüüp ja tehnilised parameetrid; neid haldab raudteesektor ja need on lingitud ERA ühisest keskhoidlast."
      },
      {
        "@language": "fi",
        "@value": "Liikkuvan kaluston viitetietokannat, mukaan lukien eurooppalainen kalustoyksikkönumero, haltija, tyyppi ja tekniset parametrit; rautatiealan hallinnoimat ja ERAn yhteisestä keskusrekisteristä linkitetyt."
      },
      {
        "@language": "ga",
        "@value": "Bunachair sonraí tagartha an rothstoic, lena n-áirítear an uimhir feithicle Eorpach, an sealbhóir, an cineál agus na paraiméadair theicniúla; arna mbainistiú ag an earnáil iarnróid agus nasctha ón stór lárnach comhchoiteann de chuid ERA."
      },
      {
        "@language": "hr",
        "@value": "Referentne baze podataka željezničkih vozila, uključujući europski broj vozila, posjednika, vrstu i tehničke parametre; njima upravlja željeznički sektor i povezane su iz zajedničkog središnjeg repozitorija ERA-e."
      },
      {
        "@language": "lt",
        "@value": "Riedmenų etaloninės duomenų bazės, įskaitant Europos transporto priemonės numerį, valdytoją, tipą ir techninius parametrus; jas valdo geležinkelių sektorius ir jos susietos iš ERA bendros centrinės saugyklos."
      },
      {
        "@language": "lv",
        "@value": "Ritošā sastāva atsauces datubāzes, tostarp Eiropas transportlīdzekļa numurs, turētājs, tips un tehniskie parametri; tās pārvalda dzelzceļa nozare un ir saistītas no ERA kopējā centrālā repozitorija."
      },
      {
        "@language": "mt",
        "@value": "Bażijiet tad-data ta' referenza tal-vetturi ferrovjarji, inkluż in-numru Ewropew tal-vettura, id-detentur, it-tip u l-parametri tekniċi; ġestiti mis-settur ferrovjarju u marbuta mir-repożitorju ċentrali komuni tal-ERA."
      },
      {
        "@language": "sk",
        "@value": "Referenčné databázy koľajových vozidiel vrátane európskeho čísla vozidla, držiteľa, typu a technických parametrov; spravované železničným odvetvím a prepojené zo spoločného centrálneho úložiska agentúry ERA."
      },
      {
        "@language": "sl",
        "@value": "Referenčne podatkovne zbirke tirnih vozil, vključno z evropsko številko vozila, imetnikom, vrsto in tehničnimi parametri; upravlja jih železniški sektor in so povezane iz skupnega osrednjega repozitorija agencije ERA."
      },
      {
        "@language": "bg",
        "@value": "Референтни бази данни за подвижния състав, включително европейския номер на превозно средство, ползвателя, типа и техническите параметри; управлявани от железопътния сектор и свързани от общото централно хранилище на ЖПА."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
