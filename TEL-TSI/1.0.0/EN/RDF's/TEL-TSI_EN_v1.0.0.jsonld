  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0010",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim prosilec zavrne podrobnosti vlakovne poti, ki jih je predlagal upravljavec infrastrukture."
      },
      {
        "@language": "en",
        "@value": "Message by which the applicant refuses the path details proposed by the infrastructure manager."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou žadatel odmítá podrobnosti o trase navržené provozovatelem infrastruktury."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der der Antragsteller die vom Infrastrukturbetreiber vorgeschlagenen Trassendetails ablehnt."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ο αιτών απορρίπτει τις λεπτομέρειες της διαδρομής που προτείνει ο διαχειριστής υποδομής."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que el candidato rechaza los detalles del surco propuestos por el administrador de infraestructuras."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel le candidat refuse les détails du sillon proposés par le gestionnaire de l'infrastructure."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel a kérelmező elutasítja a pályahálózat-működtető által javasolt menetvonal-részleteket."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui il richiedente rifiuta i dettagli della traccia proposti dal gestore dell'infrastruttura."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee de aanvrager de door de infrastructuurbeheerder voorgestelde paddetails weigert."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego wnioskodawca odrzuca szczegóły trasy zaproponowane przez zarządcę infrastruktury."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual o requerente recusa os pormenores do canal horário propostos pelo gestor de infraestrutura."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care solicitantul refuză detaliile trasei propuse de administratorul de infrastructură."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket den sökande avvisar de tåglägesuppgifter som infrastrukturförvaltaren föreslagit."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което заявителят отказва предложените от управителя на инфраструктурата подробности за влаковия маршрут."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed ansøgeren afviser de kanaldetaljer, som infrastrukturforvalteren har foreslået."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega taotleja lükkab tagasi taristuettevõtja pakutud rongiliini üksikasjad."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla hakija hylkää rataverkon haltijan ehdottamat reitin yksityiskohdat."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína ndiúltaíonn an t-iarratasóir do na sonraí uaire arna moladh ag an mbainisteoir bonneagair."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom podnositelj zahtjeva odbija pojedinosti o trasi koje je predložio upravitelj infrastrukture."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo pareiškėjas atmeta infrastruktūros valdytojo pasiūlytus trasos duomenis."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pieteikuma iesniedzējs atsaka infrastruktūras pārvaldītāja ierosinātās ceļa detaļas."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih l-applikant jirrifjuta d-dettalji tal-mogħdija proposti mill-maniġer tal-infrastruttura."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou žiadateľ zamieta podrobnosti o trase navrhnuté manažérom infraštruktúry."
      }
    ],
