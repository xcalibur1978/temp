  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0079",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A machine-readable representation of acts, facts or information and any compilation of such acts, facts or information intended to be shared in a harmonised and structured format."
      },
      {
        "@language": "cs",
        "@value": "Strojově čitelné vyjádření úkonů, skutečností nebo informací a jakákoli kompilace takových úkonů, skutečností nebo informací, určená ke sdílení v harmonizovaném a strukturovaném formátu."
      },
      {
        "@language": "de",
        "@value": "Eine maschinenlesbare Darstellung von Handlungen, Tatsachen oder Informationen sowie jede Zusammenstellung solcher Handlungen, Tatsachen oder Informationen, die in einem harmonisierten und strukturierten Format ausgetauscht werden sollen."
      },
      {
        "@language": "fr",
        "@value": "Représentation lisible par machine d'actes, de faits ou d'informations et toute compilation de ces actes, faits ou informations destinée à être partagée dans un format harmonisé et structuré."
      },
      {
        "@language": "es",
        "@value": "Representación legible por máquina de actos, hechos o información, así como cualquier recopilación de tales actos, hechos o información, destinada a compartirse en un formato armonizado y estructurado."
      },
      {
        "@language": "hu",
        "@value": "Cselekmények, tények vagy információk géppel olvasható megjelenítése, valamint az ilyen cselekmények, tények vagy információk bármely olyan összeállítása, amelyet harmonizált és strukturált formátumban kívánnak megosztani."
      },
      {
        "@language": "it",
        "@value": "Rappresentazione leggibile meccanicamente di atti, fatti o informazioni e qualsiasi raccolta di tali atti, fatti o informazioni destinata a essere condivisa in un formato armonizzato e strutturato."
      },
      {
        "@language": "nl",
        "@value": "Een machineleesbare weergave van handelingen, feiten of informatie en elke samenstelling van dergelijke handelingen, feiten of informatie die bestemd is om in een geharmoniseerd en gestructureerd formaat te worden gedeeld."
      },
      {
        "@language": "pl",
        "@value": "Nadające się do odczytu maszynowego przedstawienie czynności, faktów lub informacji oraz wszelkie zestawienie takich czynności, faktów lub informacji przeznaczone do udostępniania w zharmonizowanym i ustrukturyzowanym formacie."
      },
      {
        "@language": "pt",
        "@value": "Representação legível por máquina de atos, factos ou informações e qualquer compilação desses atos, factos ou informações destinada a ser partilhada num formato harmonizado e estruturado."
      },
      {
        "@language": "ro",
        "@value": "Reprezentare prelucrabilă automat a unor acte, fapte sau informații și orice compilare a unor astfel de acte, fapte sau informații, destinată să fie partajată într-un format armonizat și structurat."
      },
      {
        "@language": "sv",
        "@value": "En maskinläsbar återgivning av handlingar, fakta eller information och varje sammanställning av sådana handlingar, fakta eller sådan information som är avsedd att delas i ett harmoniserat och strukturerat format."
      },
      {
        "@language": "lt",
        "@value": "Kompiuteriu nuskaitomas veiksmų, faktų ar informacijos vaizdas ir bet koks tokių veiksmų, faktų ar informacijos rinkinys, skirtas bendrai naudoti suderintu ir struktūrizuotu formatu."
      },
      {
        "@language": "lv",
        "@value": "Mašīnlasāms darbību, faktu vai informācijas atveidojums un jebkāds šādu darbību, faktu vai informācijas apkopojums, kas paredzēts kopīgošanai saskaņotā un strukturētā formātā."
      },
      {
        "@language": "mt",
        "@value": "Rappreżentazzjoni li tinqara minn magna ta' atti, fatti jew informazzjoni u kwalunkwe kompilazzjoni ta' tali atti, fatti jew informazzjoni maħsuba biex tiġi kondiviża f'format armonizzat u strutturat."
      },
      {
        "@language": "sk",
        "@value": "Strojovo čitateľné vyjadrenie úkonov, skutočností alebo informácií a akákoľvek kompilácia takýchto úkonov, skutočností alebo informácií určená na zdieľanie v harmonizovanom a štruktúrovanom formáte."
      },
      {
        "@language": "sl",
        "@value": "Strojno berljiva predstavitev dejanj, dejstev ali informacij in kakršna koli zbirka takih dejanj, dejstev ali informacij, namenjena izmenjavi v harmonizirani in strukturirani obliki."
      },
      {
        "@language": "da",
        "@value": "En maskinlæsbar gengivelse af handlinger, kendsgerninger eller oplysninger og enhver samling af sådanne handlinger, kendsgerninger eller oplysninger, der er bestemt til at blive delt i et harmoniseret og struktureret format."
      },
      {
        "@language": "el",
        "@value": "Μηχανικά αναγνώσιμη αναπαράσταση πράξεων, γεγονότων ή πληροφοριών και κάθε συλλογή τέτοιων πράξεων, γεγονότων ή πληροφοριών που προορίζεται να ανταλλαγεί σε εναρμονισμένο και δομημένο μορφότυπο."
      },
      {
        "@language": "et",
        "@value": "Tegude, faktide või teabe masinloetav esitus ning selliste tegude, faktide või teabe mis tahes kogum, mis on ette nähtud jagamiseks ühtlustatud ja struktureeritud vormingus."
      },
      {
        "@language": "fi",
        "@value": "Toimien, tosiseikkojen tai tietojen koneellisesti luettavissa oleva esitysmuoto sekä kaikki tällaisten toimien, tosiseikkojen tai tietojen kokoaminen, joka on tarkoitettu jaettavaksi yhdenmukaistetussa ja jäsennellyssä muodossa."
      },
      {
        "@language": "ga",
        "@value": "Léiriú meaisín-inléite ar ghníomhartha, ar fhíorais nó ar fhaisnéis agus aon tiomsú de na gníomhartha, na fíorais nó an fhaisnéis sin atá ceaptha le comhroinnt i bhformáid chomhchuibhithe agus struchtúrtha."
      },
      {
        "@language": "hr",
        "@value": "Strojno čitljiv prikaz radnji, činjenica ili informacija i svaka kompilacija takvih radnji, činjenica ili informacija namijenjena dijeljenju u usklađenom i strukturiranom obliku."
      },
      {
        "@language": "bg",
        "@value": "Машинночетимо представяне на действия, факти или информация и всяка съвкупност от такива действия, факти или информация, предназначена да бъде споделена в хармонизиран и структуриран формат."
      }
    ],
