  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0011",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket ett tidigare bekräftat eller ansökt tågläge ställs in."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual um canal horário anteriormente confirmado ou solicitado é cancelado."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care o trasă confirmată sau solicitată anterior este anulată."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou se ruší dříve potvrzená nebo požadovaná trasa."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der eine zuvor bestätigte oder beantragte Trasse storniert wird."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ακυρώνεται μια διαδρομή που είχε επιβεβαιωθεί ή ζητηθεί προηγουμένως."
      },
      {
        "@language": "en",
        "@value": "Message by which a previously confirmed or requested path is cancelled."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que se cancela un surco previamente confirmado o solicitado."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel un sillon précédemment confirmé ou demandé est annulé."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel egy korábban megerősített vagy igényelt menetvonalat törölnek."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui una traccia precedentemente confermata o richiesta viene annullata."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee een eerder bevestigd of aangevraagd pad wordt geannuleerd."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego anulowana zostaje wcześniej potwierdzona lub wnioskowana trasa."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru atceļ iepriekš apstiprinātu vai pieprasītu ceļu."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih titħassar mogħdija konfermata jew mitluba qabel."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou sa ruší predtým potvrdená alebo požadovaná trasa."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim se prekliče predhodno potrjena ali zahtevana vlakovna pot."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed en tidligere bekræftet eller ansøgt kanal annulleres."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega tühistatakse varem kinnitatud või taotletud rongiliin."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla aiemmin vahvistettu tai pyydetty reitti peruutetaan."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína gcuirtear ar ceal uaire a deimhníodh nó a iarradh roimhe sin."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se otkazuje prethodno potvrđena ili zatražena trasa."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo atšaukiama anksčiau patvirtinta arba paprašyta trasa."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се анулира предварително потвърден или поискан влаков маршрут."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
