  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0101",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hu",
        "@value": "Adatminőségi dimenzió, amely azt fejezi ki, hogy az adatok milyen mértékben mentesek az adathalmazok közötti és az időbeli ellentmondásoktól."
      },
      {
        "@language": "en",
        "@value": "Data quality dimension expressing the degree to which data is free of contradiction across datasets and over time."
      },
      {
        "@language": "cs",
        "@value": "Rozměr kvality údajů vyjadřující míru, v jaké jsou údaje prosté rozporů mezi soubory údajů a v čase."
      },
      {
        "@language": "de",
        "@value": "Datenqualitätsdimension, die den Grad ausdrückt, in dem die Daten über Datensätze hinweg und im Zeitverlauf widerspruchsfrei sind."
      },
      {
        "@language": "es",
        "@value": "Dimensión de la calidad de los datos que expresa el grado en que los datos están libres de contradicciones entre conjuntos de datos y a lo largo del tiempo."
      },
      {
        "@language": "fr",
        "@value": "Dimension de qualité des données exprimant le degré auquel les données sont exemptes de contradiction entre les ensembles de données et dans le temps."
      },
      {
        "@language": "it",
        "@value": "Dimensione della qualità dei dati che esprime il grado in cui i dati sono privi di contraddizioni tra i set di dati e nel tempo."
      },
      {
        "@language": "nl",
        "@value": "Gegevenskwaliteitsdimensie die de mate uitdrukt waarin de gegevens vrij zijn van tegenstrijdigheid tussen gegevensverzamelingen en in de tijd."
      },
      {
        "@language": "el",
        "@value": "Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο τα δεδομένα είναι απαλλαγμένα από αντιφάσεις μεταξύ συνόλων δεδομένων και διαχρονικά."
      },
      {
        "@language": "et",
        "@value": "Andmekvaliteedi mõõde, mis väljendab seda, mil määral andmetes ei esine vastuolusid andmekogumite vahel ja aja jooksul."
      },
      {
        "@language": "da",
        "@value": "Datakvalitetsdimension, der udtrykker, i hvilken grad data er fri for modsigelser på tværs af datasæt og over tid."
      },
      {
        "@language": "bg",
        "@value": "Измерение на качеството на данните, изразяващо степента, в която данните са без противоречия между наборите от данни и във времето."
      },
      {
        "@language": "fi",
        "@value": "Datan laadun ulottuvuus, joka ilmaisee, missä määrin data on vapaa ristiriidoista datajoukkojen välillä ja ajan kuluessa."
      },
      {
        "@language": "hr",
        "@value": "Dimenzija kvalitete podataka kojom se izražava stupanj u kojem su podaci bez proturječja među skupovima podataka i tijekom vremena."
      },
      {
        "@language": "lt",
        "@value": "Duomenų kokybės aspektas, išreiškiantis, kokiu mastu duomenyse nėra prieštaravimų tarp duomenų rinkinių ir laikui bėgant."
      },
      {
        "@language": "mt",
        "@value": "Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn id-data hija ħielsa minn kontradizzjonijiet bejn is-settijiet tad-data u maż-żmien."
      },
      {
        "@language": "pl",
        "@value": "Wymiar jakości danych wyrażający stopień, w jakim dane są wolne od sprzeczności między zbiorami danych i w czasie."
      },
      {
        "@language": "pt",
        "@value": "Dimensão da qualidade dos dados que exprime o grau em que os dados estão isentos de contradições entre conjuntos de dados e ao longo do tempo."
      },
      {
        "@language": "ga",
        "@value": "Gné de cháilíocht sonraí lena léirítear an méid atá na sonraí saor ó chontrárthacht idir tacair shonraí agus le himeacht ama."
      },
      {
        "@language": "lv",
        "@value": "Datu kvalitātes dimensija, kas izsaka pakāpi, kādā datos nav pretrunu starp datu kopām un laika gaitā."
      },
      {
        "@language": "ro",
        "@value": "Dimensiune a calității datelor care exprimă gradul în care datele nu prezintă contradicții între seturile de date și în timp."
      },
      {
        "@language": "sk",
        "@value": "Rozmer kvality údajov vyjadrujúci mieru, v akej sú údaje bez rozporov medzi súbormi údajov a v čase."
      },
      {
        "@language": "sl",
        "@value": "Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere podatki nimajo protislovij med nabori podatkov in skozi čas."
      },
      {
        "@language": "sv",
        "@value": "Datakvalitetsdimension som uttrycker i vilken grad data är fria från motsägelser mellan datamängder och över tid."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
