  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0004",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Objekt (PlannedTransportIdentifier, typ PA) identifikující přidělenou trasu vlaku, který stanoví provozovatel infrastruktury."
      },
      {
        "@language": "de",
        "@value": "Objekt (PlannedTransportIdentifier, Typ PA) zur Identifizierung einer zugewiesenen Zugtrasse, das vom Infrastrukturbetreiber festgelegt wird."
      },
      {
        "@language": "es",
        "@value": "Objeto (PlannedTransportIdentifier, tipo PA) que identifica un surco ferroviario adjudicado, definido por el administrador de infraestructuras."
      },
      {
        "@language": "fr",
        "@value": "Objet (PlannedTransportIdentifier, type PA) identifiant un sillon attribué, défini par le gestionnaire de l'infrastructure."
      },
      {
        "@language": "hu",
        "@value": "Kiosztott vasúti menetvonalat azonosító objektum (PlannedTransportIdentifier, PA típus), amelyet a pályahálózat-működtető határoz meg."
      },
      {
        "@language": "pl",
        "@value": "Obiekt (PlannedTransportIdentifier, typ PA) identyfikujący przydzieloną trasę pociągu, określony przez zarządcę infrastruktury."
      },
      {
        "@language": "pt",
        "@value": "Objeto (PlannedTransportIdentifier, tipo PA) que identifica um canal horário atribuído, definido pelo gestor de infraestrutura."
      },
      {
        "@language": "ro",
        "@value": "Obiect (PlannedTransportIdentifier, tip PA) care identifică o trasă alocată, stabilit de administratorul de infrastructură."
      },
      {
        "@language": "mt",
        "@value": "Oġġett (PlannedTransportIdentifier, tip PA) li jidentifika mogħdija tal-ferrovija allokata, stabbilit mill-maniġer tal-infrastruttura."
      },
      {
        "@language": "sk",
        "@value": "Objekt (PlannedTransportIdentifier, typ PA) identifikujúci pridelenú trasu vlaku, ktorý stanovuje manažér infraštruktúry."
      },
      {
        "@language": "sl",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta PA), ki identificira dodeljeno vlakovno pot, določi ga upravljavec infrastrukture."
      },
      {
        "@language": "et",
        "@value": "Objekt (PlannedTransportIdentifier, tüüp PA), mis identifitseerib eraldatud rongiliini, mille määrab taristuettevõtja."
      },
      {
        "@language": "fi",
        "@value": "Objekti (PlannedTransportIdentifier, tyyppi PA), joka yksilöi myönnetyn junareitin, jonka rataverkon haltija vahvistaa."
      },
      {
        "@language": "ga",
        "@value": "Réad (PlannedTransportIdentifier, cineál PA) lena sainaithnítear uaire traenach leithdháilte, arna shocrú ag an mbainisteoir bonneagair."
      },
      {
        "@language": "hr",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta PA) koji identificira dodijeljenu trasu vlaka, koji utvrđuje upravitelj infrastrukture."
      },
      {
        "@language": "lt",
        "@value": "Objektas (PlannedTransportIdentifier, PA tipas), identifikuojantis paskirtą traukinio trasą, kurį nustato infrastruktūros valdytojas."
      },
      {
        "@language": "it",
        "@value": "Oggetto (PlannedTransportIdentifier, tipo PA) che identifica una traccia ferroviaria assegnata, definito dal gestore dell'infrastruttura."
      },
      {
        "@language": "en",
        "@value": "Object (PlannedTransportIdentifier, type PA) identifying an allocated train path, specified by the infrastructure manager."
      },
      {
        "@language": "el",
        "@value": "Αντικείμενο (PlannedTransportIdentifier, τύπος PA) που προσδιορίζει μια κατανεμημένη σιδηροδρομική διαδρομή, το οποίο καθορίζεται από τον διαχειριστή υποδομής."
      },
      {
        "@language": "nl",
        "@value": "Object (PlannedTransportIdentifier, type PA) dat een toegewezen treinpad identificeert, vastgesteld door de infrastructuurbeheerder."
      },
      {
        "@language": "sv",
        "@value": "Objekt (PlannedTransportIdentifier, typ PA) som identifierar ett tilldelat tågläge, fastställt av infrastrukturförvaltaren."
      },
      {
        "@language": "lv",
        "@value": "Objekts (PlannedTransportIdentifier, PA tips), kas identificē piešķirtu vilciena ceļu, kuru nosaka infrastruktūras pārvaldītājs."
      },
      {
        "@language": "da",
        "@value": "Objekt (PlannedTransportIdentifier, type PA), der identificerer en tildelt togkanal, fastlagt af infrastrukturforvalteren."
      },
      {
        "@language": "bg",
        "@value": "Обект (PlannedTransportIdentifier, тип PA), който идентифицира разпределен влаков маршрут, определен от управителя на инфраструктурата."
      }
    ],
