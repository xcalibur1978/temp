    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Data on train departures for display at stations."
      },
      {
        "@language": "cs",
        "@value": "Údaje o odjezdech vlaků k zobrazení na stanicích."
      },
      {
        "@language": "de",
        "@value": "Daten über Zugabfahrten zur Anzeige in Bahnhöfen."
      },
      {
        "@language": "el",
        "@value": "Δεδομένα σχετικά με τις αναχωρήσεις τρένων προς εμφάνιση στους σταθμούς."
      },
      {
        "@language": "es",
        "@value": "Datos sobre las salidas de trenes para su visualización en las estaciones."
      },
      {
        "@language": "fr",
        "@value": "Données sur les départs des trains destinées à l'affichage dans les gares."
      },
