  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0107",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The canonical European identifier used by data holders when feeding the national access points."
      },
      {
        "@language": "cs",
        "@value": "Kanonický evropský identifikátor používaný držiteli údajů při zadávání údajů do národních přístupových míst."
      },
      {
        "@language": "de",
        "@value": "Die kanonische europäische Kennung, die von Dateninhabern bei der Einspeisung in die nationalen Zugangspunkte verwendet wird."
      },
      {
        "@language": "el",
        "@value": "Το κανονικό ευρωπαϊκό αναγνωριστικό που χρησιμοποιείται από τους κατόχους δεδομένων κατά την τροφοδότηση των εθνικών σημείων πρόσβασης."
      },
      {
        "@language": "es",
        "@value": "Identificador europeo canónico utilizado por los titulares de los datos al alimentar los puntos de acceso nacionales."
      },
      {
        "@language": "fr",
        "@value": "Identifiant européen canonique utilisé par les détenteurs de données lorsqu'ils alimentent les points d'accès nationaux."
      },
      {
        "@language": "hu",
        "@value": "A kanonikus európai azonosító, amelyet az adatok birtokosai a nemzeti hozzáférési pontok feltöltésekor használnak."
      },
      {
        "@language": "it",
        "@value": "Identificatore europeo canonico utilizzato dai detentori dei dati quando alimentano i punti di accesso nazionali."
      },
      {
        "@language": "nl",
        "@value": "De canonieke Europese identificatie die door gegevenshouders wordt gebruikt bij het aanleveren aan de nationale toegangspunten."
      },
      {
        "@language": "pl",
        "@value": "Kanoniczny europejski identyfikator stosowany przez posiadaczy danych przy zasilaniu krajowych punktów dostępu."
      },
      {
        "@language": "pt",
        "@value": "Identificador europeu canónico utilizado pelos detentores de dados ao alimentarem os pontos de acesso nacionais."
      },
      {
        "@language": "ro",
        "@value": "Identificatorul european canonic utilizat de deținătorii de date la alimentarea punctelor de acces naționale."
      },
      {
        "@language": "sv",
        "@value": "Den kanoniska europeiska identifierare som datainnehavare använder vid inmatning till de nationella åtkomstpunkterna."
      },
      {
        "@language": "bg",
        "@value": "Каноничният европейски идентификатор, използван от притежателите на данни при подаването им към националните точки за достъп."
      },
      {
        "@language": "da",
        "@value": "Den kanoniske europæiske identifikator, som dataindehavere anvender ved indlæsning til de nationale adgangspunkter."
      },
      {
        "@language": "et",
        "@value": "Kanooniline Euroopa identifikaator, mida andmevaldajad kasutavad andmete sisestamisel riiklikesse juurdepääsupunktidesse."
      },
      {
        "@language": "fi",
        "@value": "Kanoninen eurooppalainen tunniste, jota datan haltijat käyttävät syöttäessään tietoja kansallisiin yhteyspisteisiin."
      },
      {
        "@language": "ga",
        "@value": "An t-aitheantóir Eorpach canónach a úsáideann sealbhóirí sonraí agus iad ag cur isteach sonraí chuig na pointí rochtana náisiúnta."
      },
      {
        "@language": "hr",
        "@value": "Kanonski europski identifikator koji posjednici podataka upotrebljavaju pri unosu podataka u nacionalne pristupne točke."
      },
      {
        "@language": "lt",
        "@value": "Kanoninis Europos identifikatorius, kurį duomenų valdytojai naudoja teikdami duomenis į nacionalines prieigos vietas."
      },
      {
        "@language": "lv",
        "@value": "Kanoniskais Eiropas identifikators, ko datu turētāji izmanto, ievadot datus valstu piekļuves punktos."
      },
      {
        "@language": "mt",
        "@value": "L-identifikatur Ewropew kanoniku użat mid-detenturi tad-data meta jdaħħlu d-data fil-punti ta' aċċess nazzjonali."
      },
      {
        "@language": "sk",
        "@value": "Kanonický európsky identifikátor používaný držiteľmi údajov pri zadávaní údajov do národných prístupových miest."
      },
      {
        "@language": "sl",
        "@value": "Kanonični evropski identifikator, ki ga imetniki podatkov uporabljajo pri vnašanju podatkov v nacionalne dostopne točke."
      }
    ],
