      },
      {
        "@language": "hu",
        "@value": "Gépjárműszállítás rendelkezésre állása és foglalása"
      },
      {
        "@language": "it",
        "@value": "Disponibilità e prenotazione del trasporto di auto"
      },
      {
        "@language": "nl",
