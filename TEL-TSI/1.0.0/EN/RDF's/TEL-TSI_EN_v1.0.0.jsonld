  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0035",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating that a freight wagon has been taken over by a responsible party."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že nákladní vůz byl převzat odpovědnou stranou."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass ein Güterwagen von einer verantwortlichen Partei übernommen wurde."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι ένα εμπορευματικό βαγόνι παραλήφθηκε από υπεύθυνο μέρος."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que un vagón de mercancías ha sido asumido por una parte responsable."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'un wagon de fret a été pris en charge par une partie responsable."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy tehervagont átvett egy felelős fél."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un carro merci è stato preso in carico da una parte responsabile."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een goederenwagen door een verantwoordelijke partij is overgenomen."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wagon towarowy został przejęty przez odpowiedzialną stronę."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que um vagão de mercadorias foi assumido por uma parte responsável."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că un vagon de marfă a fost preluat de o parte responsabilă."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en godsvagn har övertagits av en ansvarig part."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че товарен вагон е поет от отговорна страна."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en godsvogn er blevet overtaget af en ansvarlig part."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et vastutav pool on kaubavaguni üle võtnud."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl gur ghlac páirtí freagrach vaigín lasta ar láimh."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je odgovorna strana preuzela teretni vagon."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad atsakingoji šalis perėmė prekinį vagoną."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka atbildīgā persona ir pārņēmusi kravas vagonu."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že nákladný vozeň bol prevzatý zodpovednou stranou."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je odgovorna stran prevzela tovorni vagon."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li vagun tal-merkanzija ttieħed f'idejn parti responsabbli."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että vastuussa oleva osapuoli on ottanut tavaravaunun vastaan."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Wagon taken over"
      },
      {
        "@language": "cs",
        "@value": "Vůz převzat"
      },
      {
        "@language": "de",
        "@value": "Wagen übernommen"
      },
      {
        "@language": "el",
        "@value": "Βαγόνι που παραλήφθηκε"
      },
      {
        "@language": "es",
        "@value": "Vagón recibido (asunción)"
      },
      {
        "@language": "fr",
        "@value": "Wagon pris en charge"
      },
      {
        "@language": "hu",
        "@value": "Kocsi átvéve"
      },
      {
        "@language": "it",
        "@value": "Carro preso in carico"
      },
      {
        "@language": "nl",
        "@value": "Wagen overgenomen"
      },
      {
        "@language": "pl",
        "@value": "Wagon przejęty"
      },
      {
        "@language": "pt",
        "@value": "Vagão recebido (assunção)"
      },
      {
        "@language": "ro",
        "@value": "Vagon preluat"
      },
      {
        "@language": "sv",
        "@value": "Vagn övertagen"
      },
      {
        "@language": "bg",
        "@value": "Вагон, поет"
      },
      {
        "@language": "da",
        "@value": "Vogn overtaget"
      },
      {
        "@language": "et",
        "@value": "Vagun üle võetud"
      },
      {
        "@language": "fi",
        "@value": "Vaunu vastaanotettu"
      },
      {
        "@language": "ga",
        "@value": "Vaigín arna ghlacadh ar láimh"
      },
      {
        "@language": "hr",
        "@value": "Vagon preuzet"
      },
      {
        "@language": "lt",
        "@value": "Vagonas perimtas"
      },
      {
        "@language": "lv",
        "@value": "Vagons pārņemts"
      },
      {
        "@language": "mt",
        "@value": "Vagun meħud f'idejh"
      },
      {
        "@language": "sk",
        "@value": "Vozeň prevzatý"
      },
      {
        "@language": "sl",
        "@value": "Vagon prevzet"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0099",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Rozměr kvality údajů vyjadřující míru, v jaké údaje správně představují skutečnou hodnotu, kterou mají představovat."
      },
      {
        "@language": "en",
        "@value": "Data quality dimension expressing the degree to which data correctly represents the real-world value it is intended to represent."
      },
      {
        "@language": "pt",
        "@value": "Dimensão da qualidade dos dados que exprime o grau em que os dados representam corretamente o valor real que se destinam a representar."
      },
      {
        "@language": "ro",
        "@value": "Dimensiune a calității datelor care exprimă gradul în care datele reprezintă corect valoarea reală pe care sunt destinate să o reprezinte."
      },
      {
        "@language": "sv",
        "@value": "Datakvalitetsdimension som uttrycker i vilken grad data korrekt återger det verkliga värde som de är avsedda att återge."
      },
      {
        "@language": "de",
        "@value": "Datenqualitätsdimension, die den Grad ausdrückt, in dem die Daten den realen Wert, den sie darstellen sollen, korrekt wiedergeben."
      },
      {
        "@language": "el",
        "@value": "Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο τα δεδομένα αναπαριστούν ορθά την πραγματική τιμή που προορίζονται να αναπαραστήσουν."
      },
      {
        "@language": "es",
        "@value": "Dimensión de la calidad de los datos que expresa el grado en que los datos representan correctamente el valor real que pretenden representar."
      },
      {
        "@language": "fr",
        "@value": "Dimension de qualité des données exprimant le degré auquel les données représentent correctement la valeur du monde réel qu'elles sont censées représenter."
      },
      {
        "@language": "hu",
        "@value": "Adatminőségi dimenzió, amely azt fejezi ki, hogy az adatok milyen mértékben jelenítik meg helyesen azt a valós értéket, amelynek megjelenítésére szolgálnak."
      },
      {
        "@language": "it",
        "@value": "Dimensione della qualità dei dati che esprime il grado in cui i dati rappresentano correttamente il valore reale che sono destinati a rappresentare."
      },
      {
        "@language": "nl",
        "@value": "Gegevenskwaliteitsdimensie die de mate uitdrukt waarin de gegevens de reële waarde die zij moeten weergeven, correct weergeven."
      },
      {
        "@language": "pl",
        "@value": "Wymiar jakości danych wyrażający stopień, w jakim dane prawidłowo odwzorowują rzeczywistą wartość, którą mają przedstawiać."
      },
      {
        "@language": "et",
        "@value": "Andmekvaliteedi mõõde, mis väljendab seda, mil määral andmed õigesti esitavad reaalse väärtuse, mida nendega kavatsetakse esitada."
      },
      {
        "@language": "fi",
        "@value": "Datan laadun ulottuvuus, joka ilmaisee, missä määrin data esittää oikein sen reaalimaailman arvon, jota sen on tarkoitus esittää."
      },
      {
        "@language": "ga",
        "@value": "Gné de cháilíocht sonraí lena léirítear an méid a léiríonn na sonraí go cruinn an luach fíor atá ceaptha acu a léiriú."
      },
      {
        "@language": "hr",
        "@value": "Dimenzija kvalitete podataka kojom se izražava stupanj u kojem podaci pravilno predstavljaju stvarnu vrijednost koju trebaju predstavljati."
      },
      {
        "@language": "lt",
        "@value": "Duomenų kokybės aspektas, išreiškiantis, kokiu mastu duomenys teisingai atspindi realią vertę, kurią jais ketinama atspindėti."
      },
      {
        "@language": "lv",
        "@value": "Datu kvalitātes dimensija, kas izsaka pakāpi, kādā dati pareizi atspoguļo reālo vērtību, ko ar tiem paredzēts atspoguļot."
      },
      {
        "@language": "mt",
        "@value": "Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn id-data tirrappreżenta b'mod korrett il-valur reali li hija maħsuba li tirrappreżenta."
      },
      {
        "@language": "sk",
        "@value": "Rozmer kvality údajov vyjadrujúci mieru, v akej údaje správne predstavujú skutočnú hodnotu, ktorú majú predstavovať."
      },
      {
        "@language": "sl",
        "@value": "Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere podatki pravilno predstavljajo dejansko vrednost, ki naj bi jo predstavljali."
      },
      {
        "@language": "bg",
        "@value": "Измерение на качеството на данните, изразяващо степента, в която данните правилно представят реалната стойност, която се предполага да представят."
      },
      {
        "@language": "da",
        "@value": "Datakvalitetsdimension, der udtrykker, i hvilken grad data korrekt gengiver den virkelige værdi, som de er bestemt til at gengive."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Accuracy (data quality dimension)"
      },
      {
        "@language": "el",
        "@value": "Ακρίβεια (διάσταση ποιότητας δεδομένων)"
      },
      {
        "@language": "cs",
        "@value": "Přesnost (rozměr kvality údajů)"
      },
      {
        "@language": "de",
        "@value": "Genauigkeit (Datenqualitätsdimension)"
      },
      {
        "@language": "es",
        "@value": "Exactitud (dimensión de la calidad de los datos)"
      },
      {
        "@language": "fr",
        "@value": "Exactitude (dimension de qualité des données)"
      },
      {
        "@language": "hu",
        "@value": "Pontosság (adatminőségi dimenzió)"
      },
      {
        "@language": "it",
        "@value": "Accuratezza (dimensione della qualità dei dati)"
      },
      {
        "@language": "nl",
        "@value": "Nauwkeurigheid (gegevenskwaliteitsdimensie)"
      },
      {
        "@language": "pl",
        "@value": "Dokładność (wymiar jakości danych)"
      },
      {
        "@language": "pt",
        "@value": "Exatidão (dimensão da qualidade dos dados)"
      },
      {
        "@language": "ro",
        "@value": "Exactitate (dimensiune a calității datelor)"
      },
      {
        "@language": "sv",
        "@value": "Riktighet (datakvalitetsdimension)"
      },
      {
        "@language": "da",
        "@value": "Nøjagtighed (datakvalitetsdimension)"
      },
      {
        "@language": "et",
        "@value": "Täpsus (andmekvaliteedi mõõde)"
      },
      {
        "@language": "fi",
        "@value": "Tarkkuus (datan laadun ulottuvuus)"
      },
      {
        "@language": "ga",
        "@value": "Cruinneas (gné de cháilíocht sonraí)"
      },
      {
        "@language": "hr",
        "@value": "Točnost (dimenzija kvalitete podataka)"
      },
      {
        "@language": "lt",
        "@value": "Tikslumas (duomenų kokybės aspektas)"
      },
      {
        "@language": "lv",
        "@value": "Precizitāte (datu kvalitātes dimensija)"
      },
      {
        "@language": "mt",
        "@value": "Eżattezza (dimensjoni tal-kwalità tad-data)"
      },
      {
        "@language": "sk",
        "@value": "Presnosť (rozmer kvality údajov)"
      },
      {
        "@language": "sl",
        "@value": "Točnost (razsežnost kakovosti podatkov)"
      },
      {
        "@language": "bg",
        "@value": "Точност (измерение на качеството на данните)"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0047",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hu",
        "@value": "Működési állapot, amely azt jelzi, hogy egy üres tehervagon flottakezelési ellenőrzés alatt áll."
      },
      {
        "@language": "en",
        "@value": "Operational state indicating that an empty freight wagon is under fleet management control."
      },
      {
        "@language": "cs",
        "@value": "Provozní stav označující, že prázdný nákladní vůz je pod kontrolou správy vozového parku."
      },
      {
        "@language": "de",
        "@value": "Betriebszustand, der angibt, dass ein leerer Güterwagen der Flottenmanagementkontrolle unterliegt."
      },
      {
        "@language": "el",
        "@value": "Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα κενό εμπορευματικό βαγόνι βρίσκεται υπό τον έλεγχο διαχείρισης στόλου."
      },
      {
        "@language": "es",
        "@value": "Estado operativo que indica que un vagón de mercancías vacío está bajo el control de la gestión de flota."
      },
      {
        "@language": "fr",
        "@value": "État opérationnel indiquant qu'un wagon de fret vide est sous le contrôle de la gestion de flotte."
      },
      {
        "@language": "it",
        "@value": "Stato operativo che indica che un carro merci vuoto è sotto il controllo della gestione della flotta."
      },
      {
        "@language": "nl",
        "@value": "Operationele toestand die aangeeft dat een lege goederenwagen onder vlootbeheercontrole valt."
      },
      {
        "@language": "pl",
        "@value": "Stan operacyjny wskazujący, że pusty wagon towarowy znajduje się pod kontrolą zarządzania flotą."
      },
      {
        "@language": "pt",
        "@value": "Estado operacional que indica que um vagão de mercadorias vazio está sob o controlo da gestão de frota."
      },
      {
        "@language": "ro",
        "@value": "Stare operațională care indică faptul că un vagon de marfă gol se află sub controlul gestionării parcului."
      },
      {
        "@language": "sv",
        "@value": "Operativt tillstånd som anger att en tom godsvagn är under flottförvaltningskontroll."
      },
      {
        "@language": "da",
        "@value": "Operationel tilstand, der angiver, at en tom godsvogn er under flådestyringskontrol."
      },
      {
        "@language": "et",
        "@value": "Operatiivseisund, mis näitab, et tühi kaubavagun on pargihalduse kontrolli all."
      },
      {
        "@language": "fi",
        "@value": "Operatiivinen tila, joka ilmaisee, että tyhjä tavaravaunu on kalustonhallinnan valvonnassa."
      },
      {
        "@language": "mt",
        "@value": "Stat operazzjonali li jindika li vagun tal-merkanzija vojt jinsab taħt il-kontroll tal-ġestjoni tal-flotta."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkový stav označujúci, že prázdny nákladný vozeň je pod kontrolou správy vozového parku."
      },
      {
        "@language": "ga",
        "@value": "Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta folamh faoi rialú bainistithe an chabhlaigh."
      },
      {
        "@language": "hr",
        "@value": "Operativno stanje kojim se označava da je prazni teretni vagon pod kontrolom upravljanja voznim parkom."
      },
      {
        "@language": "lt",
        "@value": "Veiklos būsena, kuria nurodoma, kad tuščias prekinis vagonas yra kontroliuojamas parko valdymo."
      },
      {
        "@language": "lv",
        "@value": "Operatīvais stāvoklis, ar kuru norāda, ka tukšs kravas vagons ir parka pārvaldības kontrolē."
      },
      {
        "@language": "bg",
        "@value": "Оперативно състояние, с което се обозначава, че празен товарен вагон е под контрола на управлението на парка."
      },
      {
        "@language": "sl",
        "@value": "Operativno stanje, ki označuje, da je prazni tovorni vagon pod nadzorom upravljanja voznega parka."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
