  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0089",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_28"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Čas výstupu pro cestující, tj. okamžik, kdy se otevírají dveře vlaku na cílovém nástupišti nebo terminálu."
      },
      {
        "@language": "de",
        "@value": "Die Aussteigezeit für Fahrgäste, d. h. der Zeitpunkt, zu dem die Türen des Zuges am Zielbahnsteig oder -terminal geöffnet werden."
      },
      {
        "@language": "es",
        "@value": "La hora de desembarque para los viajeros, es decir, el momento en que se abren las puertas del tren en el andén o la terminal de destino."
      },
      {
        "@language": "fr",
        "@value": "L'heure de débarquement pour les voyageurs, à savoir le moment où les portes du train s'ouvrent sur le quai ou au terminal de destination."
      },
      {
        "@language": "hu",
        "@value": "Az utasok leszállási ideje, azaz az az időpont, amikor a vonat ajtói kinyílnak a célállomás peronján vagy terminálján."
      },
      {
        "@language": "it",
        "@value": "L'orario di sbarco per i passeggeri, vale a dire il momento in cui le porte del treno si aprono sul marciapiede o al terminal di destinazione."
      },
      {
        "@language": "nl",
        "@value": "De uitstaptijd voor reizigers, d.w.z. het tijdstip waarop de deuren van de trein op het bestemmingsperron of de eindterminal worden geopend."
      },
      {
        "@language": "pl",
        "@value": "Godzina wysiadania dla pasażerów, czyli moment, w którym otwierają się drzwi pociągu na peronie lub w terminalu docelowym."
      },
      {
        "@language": "pt",
        "@value": "A hora de desembarque para os passageiros, ou seja, o momento em que as portas do comboio são abertas na plataforma ou no terminal de destino."
      },
      {
        "@language": "ro",
        "@value": "Ora de coborâre pentru călători, și anume momentul în care ușile trenului sunt deschise pe peronul sau în terminalul de destinație."
      },
      {
        "@language": "sv",
        "@value": "Avstigningstiden för resenärer, dvs. den tidpunkt då tågets dörrar öppnas på destinationsplattformen eller -terminalen."
      },
      {
        "@language": "el",
        "@value": "Η ώρα αποβίβασης για τους επιβάτες, δηλαδή η χρονική στιγμή κατά την οποία ανοίγουν οι θύρες του τρένου στην αποβάθρα ή στον τερματικό σταθμό προορισμού."
      },
      {
        "@language": "en",
        "@value": "The alighting time for passengers, that is the point in time when the doors of the train are opened at the destination platform or terminal."
      },
      {
        "@language": "bg",
        "@value": "Часът на слизане за пътниците, т.е. моментът, в който вратите на влака се отварят на перона или терминала на местоназначението."
      },
      {
        "@language": "da",
        "@value": "Udstigningstidspunktet for passagerer, dvs. det tidspunkt, hvor togets døre åbnes på bestemmelsesperronen eller -terminalen."
      },
      {
        "@language": "et",
        "@value": "Reisijate väljumisaeg, st hetk, mil rongi uksed avatakse sihtperroonil või -terminalis."
      },
      {
        "@language": "fi",
        "@value": "Matkustajien poistumisaika eli ajankohta, jona junan ovet avataan määränpääasemalla tai -terminaalissa."
      },
      {
        "@language": "ga",
        "@value": "An t-am tuirlingthe do phaisinéirí, eadhon an nóiméad a osclaítear doirse na traenach ar an ardán nó ag an gcríochfort ceann scríbe."
      },
      {
        "@language": "hr",
        "@value": "Vrijeme iskrcaja za putnike, tj. trenutak u kojem se vrata vlaka otvaraju na odredišnom peronu ili terminalu."
      },
      {
        "@language": "lt",
        "@value": "Keleivių išlaipinimo laikas, t. y. momentas, kai traukinio durys atidaromos paskirties perone ar terminale."
      },
      {
        "@language": "lv",
        "@value": "Pasažieru izkāpšanas laiks, proti, brīdis, kad vilciena durvis tiek atvērtas galamērķa peronā vai terminālī."
      },
      {
        "@language": "mt",
        "@value": "Il-ħin tal-iżbark għall-passiġġieri, jiġifieri l-mument meta l-bibien tal-ferrovija jinfetħu fuq il-pjattaforma jew fit-terminal tad-destinazzjoni."
      },
      {
        "@language": "sk",
        "@value": "Čas výstupu pre cestujúcich, t. j. okamih, keď sa otvárajú dvere vlaku na cieľovom nástupišti alebo termináli."
      },
      {
        "@language": "sl",
        "@value": "Čas izstopa za potnike, tj. trenutek, ko se vrata vlaka odprejo na namembnem peronu ali terminalu."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
