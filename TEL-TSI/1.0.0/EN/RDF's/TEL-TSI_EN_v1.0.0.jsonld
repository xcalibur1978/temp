  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0034",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι ένα εμπορευματικό βαγόνι παραδόθηκε μεταξύ υπεύθυνων μερών."
      },
      {
        "@language": "en",
        "@value": "Wagon event indicating that a freight wagon has been handed over between responsible parties."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că un vagon de marfă a fost predat între părțile responsabile."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en godsvagn har överlämnats mellan ansvariga parter."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že nákladní vůz byl předán mezi odpovědnými stranami."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass ein Güterwagen zwischen verantwortlichen Parteien übergeben wurde."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que un vagón de mercancías ha sido traspasado entre partes responsables."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'un wagon de fret a été remis entre parties responsables."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy tehervagont átadtak a felelős felek között."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un carro merci è stato consegnato tra parti responsabili."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een goederenwagen tussen verantwoordelijke partijen is overgedragen."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wagon towarowy został przekazany między odpowiedzialnymi stronami."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que um vagão de mercadorias foi transferido entre partes responsáveis."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en godsvogn er blevet overdraget mellem ansvarlige parter."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et kaubavagun on vastutavate poolte vahel üle antud."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että tavaravaunu on luovutettu vastuussa olevien osapuolten välillä."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl gur seachadadh vaigín lasta ar láimh idir páirtithe freagracha."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je teretni vagon predan među odgovornim stranama."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad prekinis vagonas buvo perduotas tarp atsakingųjų šalių."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka kravas vagons ir nodots starp atbildīgajām personām."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li vagun tal-merkanzija ngħadda bejn il-partijiet responsabbli."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že nákladný vozeň bol odovzdaný medzi zodpovednými stranami."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je bil tovorni vagon predan med odgovornimi stranmi."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че товарен вагон е предаден между отговорните страни."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Wagon handed over"
      },
      {
        "@language": "cs",
        "@value": "Vůz předán"
      },
      {
        "@language": "de",
        "@value": "Wagen übergeben"
      },
      {
        "@language": "el",
        "@value": "Βαγόνι που παραδόθηκε"
      },
      {
        "@language": "es",
        "@value": "Vagón entregado (traspaso)"
      },
      {
        "@language": "fr",
        "@value": "Wagon remis"
      },
      {
        "@language": "hu",
        "@value": "Kocsi átadva"
      },
      {
        "@language": "nl",
        "@value": "Wagen overgedragen"
      },
      {
        "@language": "pl",
        "@value": "Wagon przekazany"
      },
      {
        "@language": "pt",
        "@value": "Vagão entregue (transferência)"
      },
      {
        "@language": "ro",
        "@value": "Vagon predat"
      },
      {
        "@language": "sv",
        "@value": "Vagn överlämnad"
      },
      {
        "@language": "it",
        "@value": "Carro consegnato (passaggio di consegne)"
      },
      {
        "@language": "et",
        "@value": "Vagun üle antud"
      },
      {
        "@language": "fi",
        "@value": "Vaunu luovutettu"
      },
      {
        "@language": "ga",
        "@value": "Vaigín arna sheachadadh ar láimh"
      },
      {
        "@language": "hr",
        "@value": "Vagon predan"
      },
      {
        "@language": "lt",
        "@value": "Vagonas perduotas"
      },
      {
        "@language": "lv",
        "@value": "Vagons nodots"
      },
      {
        "@language": "mt",
        "@value": "Vagun mgħoddi"
      },
      {
        "@language": "sk",
        "@value": "Vozeň odovzdaný"
      },
      {
        "@language": "sl",
        "@value": "Vagon predan"
      },
      {
        "@language": "bg",
        "@value": "Вагон, предаден"
      },
      {
        "@language": "da",
        "@value": "Vogn overdraget"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0065",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "Codelijsten voor ticketing die door het Agentschap worden beheerd en toegewezen, gebruikt als basis voor gegevensdeling op het gebied van spoorticketing."
      },
      {
        "@language": "cs",
        "@value": "Seznamy kódů pro odbavení spravované a přidělované agenturou, používané jako základ pro sdílení údajů v oblasti odbavení v železniční dopravě."
      },
      {
        "@language": "de",
        "@value": "Von der Agentur verwaltete und zugewiesene Codelisten für das Ticketing, die als Grundlage für den Datenaustausch im Bereich des Bahnticketings dienen."
      },
      {
        "@language": "el",
        "@value": "Κατάλογοι κωδικών για την έκδοση εισιτηρίων που τους διαχειρίζεται και τους εκχωρεί ο Οργανισμός, οι οποίοι χρησιμοποιούνται ως βάση για την ανταλλαγή δεδομένων στον τομέα της έκδοσης σιδηροδρομικών εισιτηρίων."
      },
      {
        "@language": "es",
        "@value": "Listas de códigos para la venta de billetes gestionadas y asignadas por la Agencia, utilizadas como base para el intercambio de datos en el ámbito de la venta de billetes ferroviarios."
      },
      {
        "@language": "fr",
        "@value": "Listes de codes pour la billettique gérées et attribuées par l'Agence, utilisées comme base pour le partage de données dans le domaine de la billettique ferroviaire."
      },
      {
        "@language": "hu",
        "@value": "Az ügynökség által kezelt és kiosztott jegykezelési kódlisták, amelyeket a vasúti jegykezelés területén az adatmegosztás alapjául használnak."
      },
      {
        "@language": "it",
        "@value": "Elenchi di codici per la biglietteria gestiti e assegnati dall'Agenzia, utilizzati come base per la condivisione dei dati nel settore della biglietteria ferroviaria."
      },
      {
        "@language": "pl",
        "@value": "Wykazy kodów dla sprzedaży biletów zarządzane i przydzielane przez Agencję, wykorzystywane jako podstawa wymiany danych w dziedzinie sprzedaży biletów kolejowych."
      },
      {
        "@language": "pt",
        "@value": "Listas de códigos para a bilhética geridas e atribuídas pela Agência, utilizadas como base para a partilha de dados no domínio da bilhética ferroviária."
      },
      {
        "@language": "ro",
        "@value": "Liste de coduri pentru emiterea biletelor gestionate și atribuite de agenție, utilizate ca bază pentru schimbul de date în domeniul emiterii biletelor feroviare."
      },
      {
        "@language": "sv",
        "@value": "Kodlistor för biljettförsäljning som förvaltas och tilldelas av byrån och som används som grund för datadelning på området järnvägsbiljettförsäljning."
      },
      {
        "@language": "en",
        "@value": "Code lists for ticketing managed and assigned by the Agency, used as a basis for data sharing in the rail ticketing domain."
      },
      {
        "@language": "ga",
        "@value": "Liostaí cód le haghaidh eisiúint ticéad arna mbainistiú agus arna leithdháileadh ag an nGníomhaireacht, a úsáidtear mar bhonn le haghaidh comhroinnt sonraí i réimse eisiúint ticéad iarnróid."
      },
      {
        "@language": "hr",
        "@value": "Popisi kodova za izdavanje karata kojima upravlja i koje dodjeljuje Agencija, a koji se upotrebljavaju kao osnova za razmjenu podataka u području izdavanja željezničkih karata."
      },
      {
        "@language": "lt",
        "@value": "Bilietų pardavimo kodų sąrašai, kuriuos valdo ir priskiria agentūra ir kurie naudojami kaip duomenų dalijimosi pagrindas geležinkelių bilietų pardavimo srityje."
      },
      {
        "@language": "lv",
        "@value": "Biļešu pārdošanas kodu saraksti, ko pārvalda un piešķir aģentūra un ko izmanto kā pamatu datu kopīgošanai dzelzceļa biļešu pārdošanas jomā."
      },
      {
        "@language": "mt",
        "@value": "Listi ta' kodiċijiet għall-ħruġ tal-biljetti ġestiti u allokati mill-Aġenzija, użati bħala bażi għall-kondiviżjoni tad-data fil-qasam tal-ħruġ tal-biljetti ferrovjarji."
      },
      {
        "@language": "sk",
        "@value": "Zoznamy kódov pre predaj cestovných lístkov spravované a prideľované agentúrou, ktoré sa používajú ako základ pre spoločné využívanie údajov v oblasti predaja železničných cestovných lístkov."
      },
      {
        "@language": "sl",
        "@value": "Seznami kod za izdajo vozovnic, ki jih upravlja in dodeljuje agencija ter se uporabljajo kot podlaga za izmenjavo podatkov na področju izdaje železniških vozovnic."
      },
      {
        "@language": "bg",
        "@value": "Списъци с кодове за издаване на билети, управлявани и разпределяни от агенцията, използвани като основа за обмена на данни в областта на издаването на железопътни билети."
      },
      {
        "@language": "da",
        "@value": "Kodelister for billettering, der forvaltes og tildeles af agenturet, og som anvendes som grundlag for datadeling på området jernbanebilletter."
      },
      {
        "@language": "et",
        "@value": "Piletimüügi koodiloendid, mida haldab ja eraldab amet ning mida kasutatakse andmete jagamise alusena raudteepiletimüügi valdkonnas."
      },
      {
