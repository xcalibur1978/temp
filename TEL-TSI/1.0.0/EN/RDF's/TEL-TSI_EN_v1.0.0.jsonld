      {
        "@language": "lv",
        "@value": "Vagons gatavs kustībai"
      },
      {
        "@language": "mt",
        "@value": "Vagun lest għall-moviment"
      },
      {
        "@language": "sk",
        "@value": "Vozeň pripravený na pohyb"
      },
      {
        "@language": "sl",
        "@value": "Vagon pripravljen za premik"
      },
      {
        "@language": "da",
        "@value": "Vogn klar til bevægelse"
      },
      {
        "@language": "et",
        "@value": "Vagun liikumiseks valmis"
      },
      {
        "@language": "fi",
        "@value": "Vaunu valmis liikkumaan"
      },
      {
        "@language": "ga",
        "@value": "Vaigín réidh le gluaiseacht"
      },
      {
        "@language": "hr",
        "@value": "Vagon spreman za kretanje"
      },
      {
        "@language": "lt",
        "@value": "Vagonas parengtas judėti"
      },
      {
        "@language": "bg",
