  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0055",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pl",
        "@value": "Komunikat posprzedażny wnioskujący o zwrot kosztów lub odszkodowanie w odniesieniu do biletu."
      },
      {
        "@language": "en",
        "@value": "After-sale message requesting reimbursement or compensation in respect of a ticket."
      },
      {
        "@language": "cs",
        "@value": "Poprodejní zpráva žádající o náhradu nebo odškodnění v souvislosti s jízdenkou."
      },
      {
        "@language": "de",
        "@value": "Nachverkaufsnachricht zur Beantragung einer Erstattung oder Entschädigung in Bezug auf eine Fahrkarte."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα μετά την πώληση με το οποίο ζητείται επιστροφή χρημάτων ή αποζημίωση σχετικά με ένα εισιτήριο."
      },
      {
        "@language": "es",
        "@value": "Mensaje posventa que solicita un reembolso o una indemnización respecto de un billete."
      },
      {
        "@language": "fr",
        "@value": "Message après-vente demandant un remboursement ou une indemnisation au titre d'un billet."
      },
      {
        "@language": "hu",
        "@value": "Értékesítés utáni üzenet, amellyel egy jeggyel kapcsolatban visszatérítést vagy kártérítést kérnek."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pós-venda que solicita um reembolso ou uma indemnização relativamente a um bilhete."
      },
      {
        "@language": "ro",
        "@value": "Mesaj post-vânzare prin care se solicită o rambursare sau o despăgubire în legătură cu un bilet."
      },
      {
        "@language": "sv",
        "@value": "Meddelande efter försäljning som begär återbetalning eller ersättning avseende en biljett."
      },
      {
        "@language": "bg",
        "@value": "Следпродажбено съобщение, с което се иска възстановяване или обезщетение във връзка с билет."
      },
      {
        "@language": "da",
        "@value": "Meddelelse efter salget, hvormed der anmodes om refusion eller kompensation i forbindelse med en billet."
      },
      {
        "@language": "et",
        "@value": "Müügijärgne sõnum, millega taotletakse piletiga seoses hüvitamist või kompenseerimist."
      },
      {
        "@language": "fi",
        "@value": "Myynnin jälkeinen viesti, jolla vaaditaan korvausta tai hyvitystä lipun osalta."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht iardhíola lena n-iarrtar aisíocaíocht nó cúiteamh maidir le ticéad."
      },
      {
        "@language": "hr",
        "@value": "Poslijeprodajna poruka kojom se zahtijeva povrat ili naknada u vezi s kartom."
      },
      {
        "@language": "it",
        "@value": "Messaggio post-vendita che richiede un rimborso o un indennizzo in relazione a un biglietto."
      },
      {
        "@language": "lt",
        "@value": "Poprekybinis pranešimas, kuriuo prašoma grąžinti pinigus arba kompensuoti dėl bilieto."
      },
      {
        "@language": "lv",
        "@value": "Pēcpārdošanas ziņojums, ar kuru pieprasa atlīdzināšanu vai kompensāciju saistībā ar biļeti."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ ta' wara l-bejgħ li jitlob rimborż jew kumpens fir-rigward ta' biljett."
      },
      {
        "@language": "nl",
        "@value": "Naverkoopbericht waarmee terugbetaling of compensatie met betrekking tot een vervoerbewijs wordt verzocht."
      },
      {
        "@language": "sk",
        "@value": "Popredajná správa žiadajúca o náhradu alebo odškodnenie v súvislosti s cestovným lístkom."
      },
      {
        "@language": "sl",
        "@value": "Poprodajno sporočilo, s katerim se zahteva povračilo ali nadomestilo v zvezi z vozovnico."
      }
    ],
