  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0006",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sv",
        "@value": "Objekt (PlannedTransportIdentifier, typ CR) som identifierar en ärendereferens, fastställt av datainnehavaren."
      },
      {
        "@language": "sk",
        "@value": "Objekt (PlannedTransportIdentifier, typ CR) identifikujúci referenčné číslo prípadu, ktorý stanovuje držiteľ údajov."
      },
      {
        "@language": "cs",
        "@value": "Objekt (PlannedTransportIdentifier, typ CR) identifikující referenční číslo případu, který stanoví držitel údajů."
      },
      {
        "@language": "de",
        "@value": "Objekt (PlannedTransportIdentifier, Typ CR) zur Identifizierung einer Vorgangsreferenz, das vom Dateninhaber festgelegt wird."
      },
      {
        "@language": "en",
        "@value": "Object (PlannedTransportIdentifier, type CR) identifying a case reference, specified by the holder of the data."
      },
      {
        "@language": "es",
        "@value": "Objeto (PlannedTransportIdentifier, tipo CR) que identifica una referencia de caso, definido por el titular de los datos."
      },
      {
        "@language": "fr",
        "@value": "Objet (PlannedTransportIdentifier, type CR) identifiant une référence de dossier, défini par le détenteur des données."
      },
      {
        "@language": "hu",
        "@value": "Ügyhivatkozást azonosító objektum (PlannedTransportIdentifier, CR típus), amelyet az adatok birtokosa határoz meg."
      },
      {
        "@language": "it",
        "@value": "Oggetto (PlannedTransportIdentifier, tipo CR) che identifica un riferimento di caso, definito dal detentore dei dati."
      },
      {
        "@language": "nl",
        "@value": "Object (PlannedTransportIdentifier, type CR) dat een zaakreferentie identificeert, vastgesteld door de houder van de gegevens."
      },
      {
        "@language": "pl",
        "@value": "Obiekt (PlannedTransportIdentifier, typ CR) identyfikujący odniesienie sprawy, określony przez posiadacza danych."
      },
      {
        "@language": "pt",
        "@value": "Objeto (PlannedTransportIdentifier, tipo CR) que identifica uma referência de processo, definido pelo detentor dos dados."
      },
      {
        "@language": "ro",
        "@value": "Obiect (PlannedTransportIdentifier, tip CR) care identifică o referință a unui caz, stabilit de deținătorul datelor."
      },
      {
        "@language": "bg",
        "@value": "Обект (PlannedTransportIdentifier, тип CR), който идентифицира референция на случай, определен от притежателя на данните."
      },
      {
        "@language": "da",
        "@value": "Objekt (PlannedTransportIdentifier, type CR), der identificerer en sagsreference, fastlagt af indehaveren af dataene."
      },
      {
        "@language": "et",
        "@value": "Objekt (PlannedTransportIdentifier, tüüp CR), mis identifitseerib juhtumiviite, mille määrab andmevaldaja."
      },
      {
        "@language": "fi",
        "@value": "Objekti (PlannedTransportIdentifier, tyyppi CR), joka yksilöi asiaviitteen, jonka tietojen haltija vahvistaa."
      },
      {
        "@language": "ga",
        "@value": "Réad (PlannedTransportIdentifier, cineál CR) lena sainaithnítear tagairt cáis, arna shocrú ag sealbhóir na sonraí."
      },
      {
        "@language": "hr",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta CR) koji identificira referentnu oznaku predmeta, koji utvrđuje posjednik podataka."
      },
      {
        "@language": "lt",
        "@value": "Objektas (PlannedTransportIdentifier, CR tipas), identifikuojantis bylos nuorodą, kurią nustato duomenų valdytojas."
      },
      {
        "@language": "lv",
        "@value": "Objekts (PlannedTransportIdentifier, CR tips), kas identificē lietas atsauci, kuru nosaka datu turētājs."
      },
      {
        "@language": "el",
        "@value": "Αντικείμενο (PlannedTransportIdentifier, τύπος CR) που προσδιορίζει μια αναφορά υπόθεσης, το οποίο καθορίζεται από τον κάτοχο των δεδομένων."
      },
      {
        "@language": "mt",
        "@value": "Oġġett (PlannedTransportIdentifier, tip CR) li jidentifika referenza tal-każ, stabbilit mid-detentur tad-data."
      },
      {
        "@language": "sl",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta CR), ki identificira sklicno oznako primera, določi ga imetnik podatkov."
      }
    ],
