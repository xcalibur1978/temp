  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0075",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_39"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μηχανή αναζήτησης που χρησιμοποιείται για την εξεύρεση βέλτιστου ταξιδιού βάσει κριτηρίων που ορίζει ο χρήστης της."
      },
      {
        "@language": "en",
        "@value": "A search engine used to find an optimal journey based on defined criteria set out by its user."
      },
      {
        "@language": "cs",
        "@value": "Vyhledávač používaný k nalezení optimální cesty na základě kritérií stanovených jeho uživatelem."
      },
      {
        "@language": "de",
        "@value": "Eine Suchmaschine, die zur Ermittlung einer optimalen Reise anhand der von ihrem Nutzer festgelegten Kriterien verwendet wird."
      },
      {
        "@language": "es",
        "@value": "Motor de búsqueda utilizado para encontrar un viaje óptimo sobre la base de criterios definidos por su usuario."
      },
      {
        "@language": "fr",
        "@value": "Moteur de recherche utilisé pour trouver un voyage optimal sur la base de critères définis par son utilisateur."
      },
      {
        "@language": "hu",
        "@value": "Keresőmotor, amelyet az optimális utazás megtalálására használnak a felhasználója által meghatározott kritériumok alapján."
      },
      {
        "@language": "it",
        "@value": "Motore di ricerca utilizzato per trovare un viaggio ottimale sulla base di criteri definiti dal suo utente."
      },
      {
        "@language": "nl",
        "@value": "Een zoekmachine die wordt gebruikt om een optimale reis te vinden op basis van door de gebruiker vastgestelde criteria."
      },
      {
        "@language": "pl",
        "@value": "Wyszukiwarka wykorzystywana do znalezienia optymalnej podróży na podstawie kryteriów określonych przez jej użytkownika."
      },
      {
        "@language": "pt",
        "@value": "Motor de busca utilizado para encontrar uma viagem ótima com base em critérios definidos pelo seu utilizador."
      },
      {
        "@language": "ro",
        "@value": "Motor de căutare utilizat pentru a găsi o călătorie optimă pe baza unor criterii definite de utilizatorul său."
      },
      {
        "@language": "sv",
        "@value": "En sökmotor som används för att hitta en optimal resa utifrån kriterier som fastställs av användaren."
      },
      {
        "@language": "et",
        "@value": "Otsingumootor, mida kasutatakse optimaalse reisi leidmiseks selle kasutaja määratud kriteeriumide alusel."
      },
      {
        "@language": "fi",
        "@value": "Hakukone, jota käytetään optimaalisen matkan löytämiseen käyttäjänsä määrittämien kriteerien perusteella."
      },
      {
        "@language": "ga",
        "@value": "Inneall cuardaigh a úsáidtear chun aistear optamach a aimsiú ar bhonn critéar arna shocrú ag a úsáideoir."
      },
      {
        "@language": "hr",
        "@value": "Tražilica koja se upotrebljava za pronalaženje optimalnog putovanja na temelju kriterija koje utvrđuje njezin korisnik."
      },
      {
        "@language": "lt",
        "@value": "Paieškos sistema, naudojama optimaliai kelionei rasti pagal jos naudotojo nustatytus kriterijus."
      },
      {
        "@language": "lv",
        "@value": "Meklētājprogramma, ko izmanto optimāla ceļojuma atrašanai, pamatojoties uz tās lietotāja noteiktiem kritērijiem."
      },
      {
        "@language": "mt",
        "@value": "Magna tat-tiftix użata biex jinstab vjaġġ ottimali abbażi ta' kriterji stabbiliti mill-utent tagħha."
      },
      {
        "@language": "sk",
        "@value": "Vyhľadávač používaný na nájdenie optimálnej cesty na základe kritérií stanovených jeho používateľom."
      },
      {
        "@language": "sl",
        "@value": "Iskalnik, ki se uporablja za iskanje optimalnega potovanja na podlagi meril, ki jih določi njegov uporabnik."
      },
      {
        "@language": "bg",
        "@value": "Търсачка, използвана за намиране на оптимално пътуване въз основа на критерии, определени от нейния потребител."
      },
      {
        "@language": "da",
        "@value": "En søgemaskine, der anvendes til at finde en optimal rejse på grundlag af kriterier fastsat af brugeren."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
