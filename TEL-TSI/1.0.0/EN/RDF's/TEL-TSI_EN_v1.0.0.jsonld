  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0045",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα κενό εμπορευματικό βαγόνι βρίσκεται σε κυκλοφορία."
      },
      {
        "@language": "en",
        "@value": "Operational state indicating that an empty freight wagon is on its journey."
      },
      {
        "@language": "fr",
        "@value": "État opérationnel indiquant qu'un wagon de fret vide est en circulation."
      },
      {
        "@language": "hu",
        "@value": "Működési állapot, amely azt jelzi, hogy egy üres tehervagon úton van."
      },
      {
        "@language": "it",
        "@value": "Stato operativo che indica che un carro merci vuoto è in viaggio."
      },
      {
        "@language": "nl",
        "@value": "Operationele toestand die aangeeft dat een lege goederenwagen onderweg is."
      },
      {
        "@language": "pl",
        "@value": "Stan operacyjny wskazujący, że pusty wagon towarowy jest w trasie."
      },
      {
        "@language": "pt",
        "@value": "Estado operacional que indica que um vagão de mercadorias vazio está em circulação."
      },
      {
        "@language": "ro",
        "@value": "Stare operațională care indică faptul că un vagon de marfă gol este în circulație."
      },
      {
        "@language": "sv",
        "@value": "Operativt tillstånd som anger att en tom godsvagn är under färd."
      },
      {
        "@language": "cs",
        "@value": "Provozní stav označující, že prázdný nákladní vůz je na cestě."
      },
      {
        "@language": "de",
        "@value": "Betriebszustand, der angibt, dass sich ein leerer Güterwagen auf der Fahrt befindet."
      },
      {
        "@language": "es",
        "@value": "Estado operativo que indica que un vagón de mercancías vacío está en circulación."
      },
      {
        "@language": "da",
        "@value": "Operationel tilstand, der angiver, at en tom godsvogn er under transport."
      },
      {
        "@language": "fi",
        "@value": "Operatiivinen tila, joka ilmaisee, että tyhjä tavaravaunu on matkalla."
      },
      {
        "@language": "ga",
        "@value": "Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta folamh ar a aistear."
      },
      {
        "@language": "hr",
        "@value": "Operativno stanje kojim se označava da je prazni teretni vagon u vožnji."
      },
      {
        "@language": "lt",
        "@value": "Veiklos būsena, kuria nurodoma, kad tuščias prekinis vagonas yra kelyje."
      },
      {
        "@language": "lv",
        "@value": "Operatīvais stāvoklis, ar kuru norāda, ka tukšs kravas vagons ir ceļā."
      },
      {
        "@language": "mt",
        "@value": "Stat operazzjonali li jindika li vagun tal-merkanzija vojt qiegħed fil-vjaġġ."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkový stav označujúci, že prázdny nákladný vozeň je na ceste."
      },
      {
        "@language": "sl",
        "@value": "Operativno stanje, ki označuje, da je prazni tovorni vagon na poti."
      },
      {
        "@language": "bg",
        "@value": "Оперативно състояние, с което се обозначава, че празен товарен вагон е в движение."
      },
      {
        "@language": "et",
        "@value": "Operatiivseisund, mis näitab, et tühi kaubavagun on teel."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
