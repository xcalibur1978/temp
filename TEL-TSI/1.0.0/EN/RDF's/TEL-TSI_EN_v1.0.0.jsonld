      },
      {
        "@language": "hr",
        "@value": "TrainRunningInformationMessage (poruka o informacijama o vožnji vlaka)"
      },
      {
        "@language": "lt",
        "@value": "TrainRunningInformationMessage (traukinio eismo informacijos pranešimas)"
      },
      {
        "@language": "bg",
