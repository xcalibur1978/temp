      },
      {
        "@language": "sl",
        "@value": "Naloženi tovorni vagon na poti"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0018",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message conveying forecast train running information, with expected accuracy as set out in the regulation's accuracy methodology."
      },
      {
        "@language": "cs",
        "@value": "Zpráva předávající predikci jízdy vlaku s očekávanou přesností stanovenou metodikou přesnosti uvedenou v nařízení."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der Prognose des Zuglaufs mit der in der Genauigkeitsmethodik der Verordnung festgelegten erwarteten Genauigkeit."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει την πρόβλεψη κυκλοφορίας του τρένου, με την αναμενόμενη ακρίβεια που καθορίζεται από τη μεθοδολογία ακρίβειας του κανονισμού."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant la prévision de circulation du train, avec la précision attendue définie par la méthodologie de précision du règlement."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely továbbítja a vonatközlekedés előrejelzését, a rendelet pontossági módszertanában meghatározott várható pontossággal."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette la previsione di circolazione del treno, con la precisione attesa definita dalla metodologia di precisione del regolamento."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat de prognose van de treinloop doorgeeft, met de verwachte nauwkeurigheid zoals bepaald in de nauwkeurigheidsmethodiek van de verordening."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący prognozę jazdy pociągu, z oczekiwaną dokładnością określoną metodyką dokładności rozporządzenia."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite a previsão da circulação do comboio, com a precisão esperada definida pela metodologia de precisão do regulamento."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite prognoza circulației trenului, cu precizia preconizată stabilită prin metodologia de precizie a regulamentului."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför prognosen för tågföringen, med den förväntade noggrannhet som fastställs i förordningens noggrannhetsmetod."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodama traukinio eismo prognozė su numatomu tikslumu, nustatytu reglamento tikslumo metodikoje."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod vilciena kustības prognozi ar paredzamo precizitāti, kas noteikta regulas precizitātes metodikā."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti t-tbassir tal-moviment tal-ferrovija bil-preċiżjoni mistennija stabbilita fil-metodoloġija tal-preċiżjoni tar-regolament."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca predpoveď jazdy vlaku s očakávanou presnosťou stanovenou metodikou presnosti uvedenou v nariadení."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje napoved vožnje vlaka s pričakovano natančnostjo, določeno z metodologijo natančnosti iz uredbe."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører prognosen for togdriften med den forventede nøjagtighed, der er fastsat i forordningens nøjagtighedsmetode."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la previsión de circulación del tren, con la precisión esperada definida por la metodología de precisión del reglamento."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse rongiliikluse prognoos määruse täpsusmetoodikas sätestatud eeldatava täpsusega."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään junan liikennöinnin ennuste asetuksen tarkkuusmenetelmässä määritetyllä odotetulla tarkkuudella."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar réamhaisnéis faoi ghluaiseacht na traenach a tharchur leis an gcruinneas a bhfuiltear ag súil leis arna shocrú i modheolaíocht chruinnis an rialacháin."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenosi prognoza vožnje vlaka s očekivanom točnošću utvrđenom metodologijom točnosti iz uredbe."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава прогнозата за движението на влака с очакваната точност, определена в методиката за точност на регламента."
      }
    ],
