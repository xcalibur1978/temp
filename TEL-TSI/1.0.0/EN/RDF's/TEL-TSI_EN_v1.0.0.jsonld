  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0096",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_18"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A data set of standardised and interoperable single identifiers to be used as a basis for data sharing in a specific domain."
      },
      {
        "@language": "ro",
        "@value": "Set de date de identificatori unici standardizați și interoperabili, care urmează să fie utilizat ca bază pentru partajarea datelor într-un domeniu specific."
      },
      {
        "@language": "sv",
        "@value": "En datamängd av standardiserade och interoperabla enhetliga identifierare som ska användas som grund för datadelning inom ett visst område."
      },
      {
        "@language": "cs",
        "@value": "Soubor údajů standardizovaných a interoperabilních jednotných identifikátorů, který se použije jako základ pro sdílení údajů v určité oblasti."
      },
      {
        "@language": "de",
        "@value": "Ein Datensatz standardisierter und interoperabler einheitlicher Kennungen, der als Grundlage für den Datenaustausch in einem bestimmten Bereich dient."
      },
      {
        "@language": "el",
        "@value": "Σύνολο δεδομένων τυποποιημένων και διαλειτουργικών μοναδικών αναγνωριστικών που χρησιμοποιείται ως βάση για την ανταλλαγή δεδομένων σε συγκεκριμένο τομέα."
      },
      {
        "@language": "es",
        "@value": "Conjunto de datos de identificadores únicos normalizados e interoperables que sirven de base para el intercambio de datos en un ámbito específico."
      },
      {
        "@language": "fr",
        "@value": "Ensemble de données d'identifiants uniques normalisés et interopérables servant de base au partage de données dans un domaine spécifique."
      },
      {
        "@language": "hu",
        "@value": "Szabványosított és interoperábilis egyedi azonosítók adathalmaza, amelyet egy adott területen az adatmegosztás alapjául kell használni."
      },
      {
        "@language": "it",
        "@value": "Insieme di dati di identificatori unici standardizzati e interoperabili da utilizzare come base per la condivisione dei dati in un settore specifico."
      },
      {
        "@language": "nl",
        "@value": "Een gegevensverzameling van gestandaardiseerde en interoperabele unieke identificatoren die als basis dient voor gegevensdeling in een specifiek domein."
      },
      {
        "@language": "pl",
        "@value": "Zbiór danych znormalizowanych i interoperacyjnych pojedynczych identyfikatorów, które mają służyć jako podstawa udostępniania danych w określonej dziedzinie."
      },
      {
        "@language": "pt",
        "@value": "Conjunto de dados de identificadores únicos normalizados e interoperáveis a utilizar como base para a partilha de dados num domínio específico."
      },
      {
        "@language": "bg",
        "@value": "Набор от данни от стандартизирани и оперативно съвместими единни идентификатори, който се използва като основа за споделяне на данни в определена област."
      },
      {
        "@language": "lv",
        "@value": "Standartizētu un sadarbspējīgu vienoto identifikatoru datu kopums, ko izmanto kā pamatu datu kopīgošanai konkrētā jomā."
      },
      {
        "@language": "mt",
        "@value": "Sett ta' data ta' identifikaturi uniċi standardizzati u interoperabbli li jintuża bħala bażi għall-kondiviżjoni tad-data f'qasam speċifiku."
      },
      {
        "@language": "sk",
        "@value": "Súbor údajov štandardizovaných a interoperabilných jednotných identifikátorov, ktorý sa použije ako základ pre zdieľanie údajov v určitej oblasti."
      },
      {
        "@language": "sl",
        "@value": "Niz podatkov standardiziranih in interoperabilnih enotnih identifikatorjev, ki se uporabi kot podlaga za izmenjavo podatkov na določenem področju."
      },
      {
        "@language": "et",
        "@value": "Standarditud ja koostalitlusvõimeliste ühtsete identifikaatorite andmekogum, mida kasutatakse andmete jagamise alusena teataval alal."
      },
      {
        "@language": "fi",
        "@value": "Standardoitujen ja yhteentoimivien yksittäisten tunnisteiden datajoukko, jota käytetään datan jakamisen perustana tietyllä alalla."
      },
      {
        "@language": "ga",
        "@value": "Tacar sonraí d'aitheantóirí uathúla caighdeánaithe agus idir-inoibritheacha a úsáidtear mar bhonn le haghaidh comhroinnt sonraí i réimse sonrach."
      },
      {
        "@language": "hr",
        "@value": "Skup podataka standardiziranih i interoperabilnih jedinstvenih identifikatora koji se upotrebljava kao osnova za dijeljenje podataka u određenom području."
      },
      {
        "@language": "lt",
        "@value": "Standartizuotų ir sąveikių pavienių identifikatorių duomenų rinkinys, naudotinas kaip dalijimosi duomenimis tam tikroje srityje pagrindas."
      },
      {
        "@language": "da",
        "@value": "Et datasæt af standardiserede og interoperable entydige identifikatorer, der skal anvendes som grundlag for datadeling inden for et bestemt område."
      }
    ],
