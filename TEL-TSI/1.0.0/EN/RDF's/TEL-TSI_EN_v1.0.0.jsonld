  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0005",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Object (PlannedTransportIdentifier, type RO) identifying a route, specified by the lead railway undertaking."
      },
      {
        "@language": "fr",
        "@value": "Objet (PlannedTransportIdentifier, type RO) identifiant un itinéraire, défini par l'entreprise ferroviaire chef de file."
      },
      {
        "@language": "hu",
        "@value": "Útvonalat azonosító objektum (PlannedTransportIdentifier, RO típus), amelyet a vezető vasúti társaság határoz meg."
      },
      {
        "@language": "it",
        "@value": "Oggetto (PlannedTransportIdentifier, tipo RO) che identifica un itinerario, definito dall'impresa ferroviaria capofila."
      },
      {
        "@language": "nl",
        "@value": "Object (PlannedTransportIdentifier, type RO) dat een route identificeert, vastgesteld door de hoofdspoorwegonderneming."
      },
      {
        "@language": "pl",
        "@value": "Obiekt (PlannedTransportIdentifier, typ RO) identyfikujący trasę przejazdu, określony przez wiodące przedsiębiorstwo kolejowe."
      },
      {
        "@language": "pt",
        "@value": "Objeto (PlannedTransportIdentifier, tipo RO) que identifica um itinerário, definido pela empresa ferroviária principal."
      },
      {
        "@language": "ro",
        "@value": "Obiect (PlannedTransportIdentifier, tip RO) care identifică un itinerar, stabilit de întreprinderea feroviară principală."
      },
      {
        "@language": "sv",
        "@value": "Objekt (PlannedTransportIdentifier, typ RO) som identifierar en rutt, fastställt av det ledande järnvägsföretaget."
      },
      {
        "@language": "cs",
        "@value": "Objekt (PlannedTransportIdentifier, typ RO) identifikující cestu, který stanoví vedoucí železniční podnik."
      },
      {
        "@language": "de",
        "@value": "Objekt (PlannedTransportIdentifier, Typ RO) zur Identifizierung einer Route, das vom federführenden Eisenbahnunternehmen festgelegt wird."
      },
      {
        "@language": "el",
        "@value": "Αντικείμενο (PlannedTransportIdentifier, τύπος RO) που προσδιορίζει ένα δρομολόγιο, το οποίο καθορίζεται από την επικεφαλής σιδηροδρομική επιχείρηση."
      },
      {
        "@language": "es",
        "@value": "Objeto (PlannedTransportIdentifier, tipo RO) que identifica un itinerario, definido por la empresa ferroviaria principal."
      },
      {
        "@language": "et",
        "@value": "Objekt (PlannedTransportIdentifier, tüüp RO), mis identifitseerib marsruudi, mille määrab juhtiv raudteeveo-ettevõtja."
      },
      {
        "@language": "bg",
        "@value": "Обект (PlannedTransportIdentifier, тип RO), който идентифицира маршрут, определен от водещото железопътно предприятие."
      },
      {
        "@language": "da",
        "@value": "Objekt (PlannedTransportIdentifier, type RO), der identificerer en rute, fastlagt af den ledende jernbanevirksomhed."
      },
      {
        "@language": "fi",
        "@value": "Objekti (PlannedTransportIdentifier, tyyppi RO), joka yksilöi kulkureitin, jonka johtava rautatieyritys vahvistaa."
      },
      {
        "@language": "ga",
        "@value": "Réad (PlannedTransportIdentifier, cineál RO) lena sainaithnítear bealach, arna shocrú ag an ngnóthas iarnróid ceannais."
      },
      {
        "@language": "hr",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta RO) koji identificira rutu, koji utvrđuje vodeći željeznički prijevoznik."
      },
      {
        "@language": "lt",
        "@value": "Objektas (PlannedTransportIdentifier, RO tipas), identifikuojantis maršrutą, kurį nustato vadovaujančioji geležinkelio įmonė."
      },
      {
        "@language": "lv",
        "@value": "Objekts (PlannedTransportIdentifier, RO tips), kas identificē maršrutu, kuru nosaka vadošais dzelzceļa pārvadājumu uzņēmums."
      },
      {
        "@language": "mt",
        "@value": "Oġġett (PlannedTransportIdentifier, tip RO) li jidentifika rotta, stabbilit mill-impriża ferrovjarja ewlenija."
      },
      {
        "@language": "sk",
        "@value": "Objekt (PlannedTransportIdentifier, typ RO) identifikujúci cestu, ktorý stanovuje vedúci železničný podnik."
      },
      {
        "@language": "sl",
        "@value": "Objekt (PlannedTransportIdentifier, vrsta RO), ki identificira pot, določi ga vodilni prevoznik v železniškem prometu."
      }
    ],
