      },
      {
        "@language": "fi",
        "@value": "Johdonmukaisuus (datan laadun ulottuvuus)"
      },
      {
        "@language": "ga",
        "@value": "Comhsheasmhacht (gné de cháilíocht sonraí)"
      },
      {
        "@language": "hr",
        "@value": "Dosljednost (dimenzija kvalitete podataka)"
      },
      {
        "@language": "lt",
        "@value": "Nuoseklumas (duomenų kokybės aspektas)"
      },
      {
        "@language": "lv",
        "@value": "Konsekvence (datu kvalitātes dimensija)"
      },
      {
        "@language": "mt",
        "@value": "Konsistenza (dimensjoni tal-kwalità tad-data)"
      },
      {
        "@language": "sk",
        "@value": "Konzistentnosť (rozmer kvality údajov)"
      },
      {
        "@language": "sl",
        "@value": "Doslednost (razsežnost kakovosti podatkov)"
      },
      {
        "@language": "bg",
