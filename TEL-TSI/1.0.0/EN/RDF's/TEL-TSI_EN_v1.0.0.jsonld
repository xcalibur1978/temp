    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Mensagem para verificar a disponibilidade e reservar um lugar para bicicleta."
      },
      {
        "@language": "en",
        "@value": "Message for checking availability of and reserving a bicycle place."
      },
      {
        "@language": "cs",
        "@value": "Zpráva pro ověření dostupnosti a rezervaci místa pro jízdní kolo."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Prüfung der Verfügbarkeit und zur Reservierung eines Fahrradstellplatzes."
      },
      {
        "@language": "hu",
        "@value": "Üzenet egy kerékpárhely rendelkezésre állásának ellenőrzésére és foglalására."
      },
      {
        "@language": "it",
        "@value": "Messaggio per verificare la disponibilità e prenotare un posto per bicicletta."
      },
      {
        "@language": "nl",
        "@value": "Bericht om de beschikbaarheid te controleren van en een fietsplaats te reserveren."
      },
      {
        "@language": "pl",
        "@value": "Komunikat służący do sprawdzenia dostępności i rezerwacji miejsca na rower."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα για τον έλεγχο της διαθεσιμότητας και την κράτηση θέσης ποδηλάτου."
      },
      {
        "@language": "es",
        "@value": "Mensaje para comprobar la disponibilidad y reservar una plaza para bicicleta."
      },
      {
        "@language": "fr",
        "@value": "Message permettant de vérifier la disponibilité et de réserver un emplacement pour vélo."
      },
      {
        "@language": "ro",
        "@value": "Mesaj pentru verificarea disponibilității și rezervarea unui loc pentru bicicletă."
      },
      {
        "@language": "sv",
        "@value": "Meddelande för att kontrollera tillgängligheten av och boka en cykelplats."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pārbauda pieejamību un rezervē velosipēda vietu."
      },
      {
        "@language": "bg",
        "@value": "Съобщение за проверка на наличността и резервация на място за велосипед."
      },
      {
        "@language": "da",
        "@value": "Meddelelse til kontrol af tilgængeligheden af og reservation af en cykelplads."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega kontrollitakse jalgrattakoha saadavust ja broneeritakse see."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla tarkistetaan polkupyöräpaikan saatavuus ja varataan se."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, skirtas patikrinti prieinamumą ir rezervuoti vietą dviračiui."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ biex tiġi vverifikata d-disponibbiltà u jiġi rriżervat post għar-rota."
      },
      {
        "@language": "sk",
        "@value": "Správa na overenie dostupnosti a rezerváciu miesta pre bicykel."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht chun an infhaighteacht a sheiceáil agus áit do rothar a áirithiú."
      },
      {
        "@language": "hr",
        "@value": "Poruka za provjeru dostupnosti i rezervaciju mjesta za bicikl."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo za preverjanje razpoložljivosti in rezervacijo mesta za kolo."
      }
    ],
