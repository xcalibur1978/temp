  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0017",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message conveying actual train running information at reporting points."
      },
      {
        "@language": "cs",
        "@value": "Zpráva předávající skutečné informace o jízdě vlaku v hlásných bodech."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der tatsächlichen Zuglaufinformationen an Meldepunkten."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει τις πραγματικές πληροφορίες κυκλοφορίας του τρένου στα σημεία αναφοράς."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la información real de circulación del tren en los puntos de notificación."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant les informations réelles sur la circulation du train aux points de signalement."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely továbbítja a tényleges vonatközlekedési információkat a jelentési pontokon."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette le informazioni effettive sulla circolazione del treno nei punti di segnalazione."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat de feitelijke treinloopinformatie op meldpunten doorgeeft."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący rzeczywiste informacje o jeździe pociągu w punktach raportowania."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite as informações reais sobre a circulação do comboio nos pontos de notificação."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite informațiile reale privind circulația trenului în punctele de raportare."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför den faktiska tågföringsinformationen vid rapporteringspunkter."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje dejanske informacije o vožnji vlaka na točkah poročanja."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава действителната информация за движението на влака в точките за докладване."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører de faktiske togdriftsoplysninger ved rapporteringspunkter."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse aruandluspunktides tegelik rongiliikluse teave."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään junan tosiasialliset liikennöintitiedot raportointipisteissä."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar an fhaisnéis iarbhír faoi ghluaiseacht na traenach a tharchur ag na pointí tuairiscithe."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenose stvarne informacije o vožnji vlaka na točkama izvješćivanja."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo ataskaitų teikimo taškuose perduodama faktinė traukinio eismo informacija."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru ziņošanas punktos nodod faktisko vilciena kustības informāciju."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti l-informazzjoni reali dwar il-moviment tal-ferrovija fil-punti ta' rappurtar."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca skutočné informácie o jazde vlaku v ohlasovacích bodoch."
      }
    ],
