  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0072",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_40"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Entity with the legal and technical capacity to issue, for a retailer, a ticket on which the parties to the contract of carriage are indicated."
      },
      {
        "@language": "hu",
        "@value": "Olyan szervezet, amely jogi és műszaki képességgel rendelkezik arra, hogy egy kiskereskedő számára olyan jegyet bocsásson ki, amelyen feltüntetik a fuvarozási szerződésben részt vevő feleket."
      },
      {
        "@language": "it",
        "@value": "Soggetto avente la capacità giuridica e tecnica di emettere, per un rivenditore, un biglietto sul quale sono indicate le parti del contratto di trasporto."
      },
      {
        "@language": "nl",
        "@value": "Entiteit met de juridische en technische capaciteit om voor een detailhandelaar een vervoerbewijs uit te geven waarop de partijen bij de vervoersovereenkomst worden vermeld."
      },
      {
        "@language": "pl",
        "@value": "Podmiot mający prawną i techniczną zdolność wystawienia, na rzecz sprzedawcy detalicznego, biletu, na którym wskazane są strony umowy przewozu."
      },
      {
        "@language": "pt",
        "@value": "Entidade com a capacidade jurídica e técnica de emitir, para um retalhista, um bilhete no qual são indicadas as partes no contrato de transporte."
      },
      {
        "@language": "ro",
        "@value": "Entitate cu capacitatea juridică și tehnică de a emite, pentru un comerciant cu amănuntul, un bilet pe care sunt indicate părțile la contractul de transport."
      },
      {
        "@language": "sv",
        "@value": "Enhet med rättslig och teknisk förmåga att för en återförsäljare utfärda en biljett på vilken parterna i transportavtalet anges."
      },
      {
        "@language": "cs",
        "@value": "Subjekt s právní a technickou způsobilostí vydávat pro maloobchodníka jízdenku, na níž jsou uvedeny strany přepravní smlouvy."
      },
      {
        "@language": "de",
        "@value": "Stelle mit der rechtlichen und technischen Fähigkeit, für einen Einzelhändler eine Fahrkarte auszustellen, auf der die Parteien des Beförderungsvertrags angegeben sind."
      },
      {
        "@language": "el",
        "@value": "Οντότητα με τη νομική και τεχνική ικανότητα να εκδίδει, για λιανοπωλητή, εισιτήριο στο οποίο αναγράφονται τα συμβαλλόμενα μέρη της σύμβασης μεταφοράς."
      },
      {
        "@language": "es",
        "@value": "Entidad con la capacidad jurídica y técnica de emitir, para un minorista, un billete en el que se indican las partes del contrato de transporte."
      },
      {
        "@language": "fr",
        "@value": "Entité ayant la capacité juridique et technique d'émettre, pour un détaillant, un billet sur lequel sont indiquées les parties au contrat de transport."
      },
      {
        "@language": "bg",
        "@value": "Субект с правната и техническата способност да издава за търговец на дребно билет, върху който са посочени страните по договора за превоз."
      },
      {
        "@language": "da",
        "@value": "Enhed med den juridiske og tekniske kapacitet til for en detailhandler at udstede en billet, hvorpå parterne i befordringsaftalen er angivet."
      },
      {
        "@language": "et",
        "@value": "Üksus, kellel on õiguslik ja tehniline võimekus anda jaemüüja jaoks välja pilet, millel on märgitud veolepingu pooled."
      },
      {
        "@language": "fi",
        "@value": "Yhteisö, jolla on oikeudellinen ja tekninen valmius myöntää vähittäismyyjälle lippu, johon on merkitty kuljetussopimuksen osapuolet."
      },
      {
        "@language": "ga",
        "@value": "Eintiteas a bhfuil an cumas dlíthiúil agus teicniúil aige ticéad a eisiúint do mhiondíoltóir, ticéad ar a léirítear na páirtithe sa chonradh iompair."
      },
      {
        "@language": "hr",
        "@value": "Subjekt s pravnom i tehničkom sposobnošću da za trgovca na malo izda kartu na kojoj su navedene strane ugovora o prijevozu."
      },
      {
        "@language": "lv",
        "@value": "Subjekts ar juridisko un tehnisko spēju mazumtirgotājam izdot biļeti, uz kuras norādītas pārvadājuma līguma puses."
      },
      {
        "@language": "mt",
        "@value": "Entità bil-kapaċità legali u teknika li toħroġ, għal negozjant bl-imnut, biljett li fuqu jiġu indikati l-partijiet fil-kuntratt tat-trasport."
      },
      {
        "@language": "sk",
        "@value": "Subjekt s právnou a technickou spôsobilosťou vydávať pre maloobchodníka cestovný lístok, na ktorom sú uvedené strany prepravnej zmluvy."
      },
      {
        "@language": "sl",
        "@value": "Subjekt s pravno in tehnično zmožnostjo, da za trgovca na drobno izda vozovnico, na kateri so navedene stranke prevozne pogodbe."
      },
      {
        "@language": "lt",
        "@value": "Subjektas, turintis teisinių ir techninių pajėgumų mažmenininkui išduoti bilietą, kuriame nurodytos vežimo sutarties šalys."
      }
    ],
