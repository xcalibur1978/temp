      },
      {
        "@language": "et",
        "@value": "Vaguni prognoositeave"
      },
      {
        "@language": "fi",
        "@value": "Vaunua koskevat ennustetiedot"
      },
      {
        "@language": "ga",
        "@value": "Faisnéis réamhaisnéise faoin vaigín"
      },
      {
        "@language": "hr",
        "@value": "Informacije o prognozi za vagon"
      },
      {
        "@language": "lt",
        "@value": "Prognozės informacija apie vagoną"
      },
      {
        "@language": "lv",
        "@value": "Prognozes informācija par vagonu"
      },
      {
        "@language": "mt",
        "@value": "Informazzjoni ta' tbassir dwar il-vagun"
      },
      {
        "@language": "sk",
        "@value": "Informácie o predpovedi týkajúce sa vozňa"
      },
      {
        "@language": "sl",
        "@value": "Napovedne informacije o vagonu"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0044",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hu",
        "@value": "Működési állapot, amely azt jelzi, hogy egy megrakott tehervagon úton van."
      },
      {
        "@language": "en",
        "@value": "Operational state indicating that a loaded freight wagon is on its journey."
      },
      {
        "@language": "cs",
        "@value": "Provozní stav označující, že naložený nákladní vůz je na cestě."
      },
      {
        "@language": "fr",
        "@value": "État opérationnel indiquant qu'un wagon de fret chargé est en circulation."
      },
      {
        "@language": "it",
        "@value": "Stato operativo che indica che un carro merci carico è in viaggio."
      },
      {
        "@language": "nl",
        "@value": "Operationele toestand die aangeeft dat een beladen goederenwagen onderweg is."
      },
      {
        "@language": "pl",
        "@value": "Stan operacyjny wskazujący, że załadowany wagon towarowy jest w trasie."
      },
      {
        "@language": "pt",
        "@value": "Estado operacional que indica que um vagão de mercadorias carregado está em circulação."
      },
      {
        "@language": "ro",
        "@value": "Stare operațională care indică faptul că un vagon de marfă încărcat este în circulație."
      },
      {
        "@language": "sv",
        "@value": "Operativt tillstånd som anger att en lastad godsvagn är under färd."
      },
      {
        "@language": "da",
        "@value": "Operationel tilstand, der angiver, at en læsset godsvogn er under transport."
      },
      {
        "@language": "ga",
        "@value": "Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta lódáilte ar a aistear."
      },
      {
        "@language": "hr",
        "@value": "Operativno stanje kojim se označava da je natovareni teretni vagon u vožnji."
      },
      {
        "@language": "lt",
        "@value": "Veiklos būsena, kuria nurodoma, kad pakrautas prekinis vagonas yra kelyje."
      },
      {
        "@language": "lv",
        "@value": "Operatīvais stāvoklis, ar kuru norāda, ka iekrauts kravas vagons ir ceļā."
      },
      {
        "@language": "mt",
        "@value": "Stat operazzjonali li jindika li vagun tal-merkanzija mgħobbi qiegħed fil-vjaġġ."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkový stav označujúci, že naložený nákladný vozeň je na ceste."
      },
      {
        "@language": "sl",
        "@value": "Operativno stanje, ki označuje, da je naloženi tovorni vagon na poti."
      },
      {
        "@language": "de",
        "@value": "Betriebszustand, der angibt, dass sich ein beladener Güterwagen auf der Fahrt befindet."
      },
      {
        "@language": "el",
        "@value": "Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα φορτωμένο εμπορευματικό βαγόνι βρίσκεται σε κυκλοφορία."
      },
      {
        "@language": "es",
        "@value": "Estado operativo que indica que un vagón de mercancías cargado está en circulación."
      },
      {
        "@language": "et",
        "@value": "Operatiivseisund, mis näitab, et laaditud kaubavagun on teel."
      },
      {
        "@language": "fi",
        "@value": "Operatiivinen tila, joka ilmaisee, että lastattu tavaravaunu on matkalla."
      },
      {
        "@language": "bg",
        "@value": "Оперативно състояние, с което се обозначава, че натоварен товарен вагон е в движение."
      }
    ],
