  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0102",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Data quality dimension expressing the degree to which data is available within the required time."
      },
      {
        "@language": "hu",
        "@value": "Adatminőségi dimenzió, amely azt fejezi ki, hogy az adatok milyen mértékben állnak rendelkezésre a szükséges időn belül."
      },
      {
        "@language": "pt",
        "@value": "Dimensão da qualidade dos dados que exprime o grau em que os dados estão disponíveis dentro do prazo exigido."
      },
      {
        "@language": "cs",
        "@value": "Rozměr kvality údajů vyjadřující míru, v jaké jsou údaje k dispozici v požadovaném čase."
      },
      {
        "@language": "de",
        "@value": "Datenqualitätsdimension, die den Grad ausdrückt, in dem die Daten innerhalb der erforderlichen Zeit verfügbar sind."
      },
      {
        "@language": "es",
        "@value": "Dimensión de la calidad de los datos que expresa el grado en que los datos están disponibles dentro del plazo requerido."
      },
      {
        "@language": "fr",
        "@value": "Dimension de qualité des données exprimant le degré auquel les données sont disponibles dans le délai requis."
      },
      {
        "@language": "it",
        "@value": "Dimensione della qualità dei dati che esprime il grado in cui i dati sono disponibili entro il tempo richiesto."
      },
      {
        "@language": "nl",
        "@value": "Gegevenskwaliteitsdimensie die de mate uitdrukt waarin de gegevens binnen de vereiste tijd beschikbaar zijn."
      },
      {
        "@language": "pl",
        "@value": "Wymiar jakości danych wyrażający stopień, w jakim dane są dostępne w wymaganym czasie."
      },
      {
        "@language": "ro",
        "@value": "Dimensiune a calității datelor care exprimă gradul în care datele sunt disponibile în termenul necesar."
      },
      {
        "@language": "sv",
        "@value": "Datakvalitetsdimension som uttrycker i vilken grad data är tillgängliga inom den tid som krävs."
      },
      {
        "@language": "el",
        "@value": "Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο τα δεδομένα είναι διαθέσιμα εντός του απαιτούμενου χρόνου."
      },
      {
        "@language": "bg",
        "@value": "Измерение на качеството на данните, изразяващо степента, в която данните са налични в рамките на изисквания срок."
      },
      {
        "@language": "da",
        "@value": "Datakvalitetsdimension, der udtrykker, i hvilken grad data er tilgængelige inden for den krævede tid."
      },
      {
        "@language": "et",
        "@value": "Andmekvaliteedi mõõde, mis väljendab seda, mil määral andmed on kättesaadavad nõutava aja jooksul."
      },
      {
        "@language": "fi",
        "@value": "Datan laadun ulottuvuus, joka ilmaisee, missä määrin data on saatavilla vaaditussa ajassa."
      },
      {
        "@language": "lt",
        "@value": "Duomenų kokybės aspektas, išreiškiantis, kokiu mastu duomenys prieinami per reikiamą laiką."
      },
      {
        "@language": "lv",
        "@value": "Datu kvalitātes dimensija, kas izsaka pakāpi, kādā dati ir pieejami prasītajā laikā."
      },
      {
        "@language": "mt",
        "@value": "Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn id-data hija disponibbli fiż-żmien meħtieġ."
      },
      {
        "@language": "sk",
        "@value": "Rozmer kvality údajov vyjadrujúci mieru, v akej sú údaje k dispozícii v požadovanom čase."
      },
      {
        "@language": "sl",
        "@value": "Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere so podatki na voljo v zahtevanem času."
      },
      {
        "@language": "ga",
        "@value": "Gné de cháilíocht sonraí lena léirítear an méid atá na sonraí ar fáil laistigh den am riachtanach."
      },
      {
        "@language": "hr",
        "@value": "Dimenzija kvalitete podataka kojom se izražava stupanj u kojem su podaci dostupni u potrebnom vremenu."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
