    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating that a freight wagon has been pulled."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een goederenwagen is getrokken."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wagon towarowy został pociągnięty."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que um vagão de mercadorias foi tracionado."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că un vagon de marfă a fost tras."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en godsvagn har dragits."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že nákladní vůz byl odtažen."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass ein Güterwagen abgezogen wurde."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι ένα εμπορευματικό βαγόνι έχει ελκυσθεί."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que un vagón de mercancías ha sido remolcado."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'un wagon de fret a été tracté."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy tehervagont elhúztak."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un carro merci è stato trainato."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че товарен вагон е изтеглен."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en godsvogn er blevet trukket."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et kaubavagun on ära veetud."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että tavaravaunu on vedetty."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl gur tarraingíodh vaigín lasta."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je teretni vagon povučen."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad prekinis vagonas buvo patrauktas."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka kravas vagons ir aizvilkts."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li vagun tal-merkanzija nġibed."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že nákladný vozeň bol odtiahnutý."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je bil tovorni vagon povlečen."
      }
    ],
