  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0031",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating departure of a freight wagon from its origin."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger en godsvagns avgång från dess ursprungsplats."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das die Abfahrt eines Güterwagens von seinem Ursprungsort angibt."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica la salida de un vagón de mercancías desde su lugar de origen."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant le départ d'un wagon de fret de son lieu d'origine."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon kiindulási helyéről való indulását jelzi."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica la partenza di un carro merci dal suo luogo di origine."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die het vertrek van een goederenwagen vanaf zijn herkomst aangeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące odjazd wagonu towarowego z miejsca jego pochodzenia."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica a partida de um vagão de mercadorias do seu local de origem."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică plecarea unui vagon de marfă de la locul său de origine."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující odjezd nákladního vozu z místa jeho původu."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver en godsvogns afgang fra dens oprindelsessted."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει την αναχώρηση ενός εμπορευματικού βαγονιού από τον τόπο προέλευσής του."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab kaubavaguni väljumist selle lähtekohast."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee tavaravaunun lähdön sen lähtöpaikasta."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl imeacht vaigín lasta óna áit thionscnaimh."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava polazak teretnog vagona iz njegova ishodišta."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodomas prekinio vagono išvykimas iš jo kilmės vietos."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda kravas vagona atiešanu no tā izcelsmes vietas."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika t-tluq ta' vagun tal-merkanzija mill-post tal-oriġini tiegħu."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca odchod nákladného vozňa z miesta jeho pôvodu."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje odhod tovornega vagona z mesta njegovega izvora."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава заминаването на товарен вагон от неговото място на произход."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Wagon departure from origin"
      },
      {
        "@language": "de",
        "@value": "Wagenabfahrt vom Ursprungsort"
      },
      {
        "@language": "el",
        "@value": "Αναχώρηση βαγονιού από την αφετηρία"
      },
      {
        "@language": "es",
        "@value": "Salida del vagón desde el origen"
      },
      {
        "@language": "fr",
        "@value": "Départ du wagon de l'origine"
      },
      {
        "@language": "hu",
        "@value": "Kocsi indulása a kiindulási helyről"
      },
      {
        "@language": "it",
        "@value": "Partenza del carro dall'origine"
      },
      {
        "@language": "nl",
        "@value": "Wagenvertrek vanaf herkomst"
      },
      {
        "@language": "pl",
        "@value": "Odjazd wagonu z miejsca pochodzenia"
      },
      {
        "@language": "pt",
        "@value": "Partida do vagão da origem"
      },
      {
        "@language": "ro",
        "@value": "Plecarea vagonului de la origine"
      },
      {
        "@language": "sv",
        "@value": "Vagnavgång från ursprung"
      },
      {
        "@language": "cs",
        "@value": "Odjezd vozu z místa původu"
      },
      {
        "@language": "bg",
        "@value": "Заминаване на вагона от мястото на произход"
      },
      {
        "@language": "da",
        "@value": "Vognafgang fra oprindelse"
      },
      {
        "@language": "et",
        "@value": "Vaguni väljumine lähtekohast"
      },
      {
        "@language": "fi",
        "@value": "Vaunun lähtö lähtöpaikasta"
      },
      {
        "@language": "ga",
        "@value": "Imeacht an vaigín ón mbunáit"
      },
      {
        "@language": "hr",
        "@value": "Polazak vagona iz ishodišta"
      },
      {
        "@language": "lt",
        "@value": "Vagono išvykimas iš kilmės vietos"
      },
      {
        "@language": "lv",
        "@value": "Vagona atiešana no izcelsmes vietas"
      },
      {
        "@language": "mt",
        "@value": "Tluq tal-vagun mill-oriġini"
      },
      {
        "@language": "sk",
        "@value": "Odchod vozňa z miesta pôvodu"
      },
      {
        "@language": "sl",
        "@value": "Odhod vagona z izvora"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0048",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Στοιχείο αναφοράς που προσδιορίζει έναν φάκελο έκδοσης εισιτηρίων, το οποίο χρησιμοποιείται για τη σύνδεση εισιτηρίων, κρατήσεων και διαδικασιών μετά την πώληση."
      },
      {
        "@language": "en",
        "@value": "Reference identifying a ticketing dossier, used to link tickets, reservations and after-sale processes."
      },
      {
        "@language": "es",
        "@value": "Referencia que identifica un expediente de venta de billetes, utilizada para vincular billetes, reservas y procesos posventa."
      },
      {
        "@language": "sv",
        "@value": "Referens som identifierar ett biljettärende, använd för att koppla samman biljetter, bokningar och processer efter försäljning."
      },
      {
        "@language": "cs",
        "@value": "Reference identifikující dokumentaci k odbavení, používaná k propojení jízdenek, rezervací a poprodejních procesů."
      },
      {
        "@language": "de",
        "@value": "Referenz zur Identifizierung eines Ticketing-Dossiers, die zur Verknüpfung von Fahrkarten, Reservierungen und Nachverkaufsprozessen dient."
      },
      {
        "@language": "sl",
        "@value": "Sklic, ki identificira dokumentacijo o izdaji vozovnic in se uporablja za povezovanje vozovnic, rezervacij in poprodajnih postopkov."
      },
      {
        "@language": "bg",
        "@value": "Референция, която идентифицира досие за издаване на билети и се използва за свързване на билети, резервации и следпродажбени процеси."
      },
      {
        "@language": "da",
        "@value": "Reference, der identificerer en billetteringssag, og som anvendes til at sammenkæde billetter, reservationer og processer efter salget."
      },
      {
        "@language": "et",
        "@value": "Viide, mis identifitseerib piletimüügitoimiku ja mida kasutatakse piletite, broneeringute ja müügijärgsete protsesside sidumiseks."
      },
      {
        "@language": "fi",
        "@value": "Viite, joka yksilöi lipunmyyntiasiakirja-aineiston ja jota käytetään lippujen, varausten ja myynnin jälkeisten prosessien yhdistämiseen."
      },
      {
        "@language": "mt",
        "@value": "Referenza li tidentifika fajl ta' ħruġ tal-biljetti, użata biex torbot il-biljetti, ir-riżervazzjonijiet u l-proċessi ta' wara l-bejgħ."
      },
      {
        "@language": "nl",
        "@value": "Referentie die een ticketingdossier identificeert, gebruikt om vervoerbewijzen, reserveringen en naverkoopprocessen te koppelen."
      },
      {
        "@language": "pl",
        "@value": "Numer referencyjny identyfikujący dokumentację biletową, służący do powiązania biletów, rezerwacji i procesów posprzedażnych."
      },
      {
        "@language": "pt",
        "@value": "Referência que identifica um processo de bilhética, utilizada para associar bilhetes, reservas e processos pós-venda."
      },
      {
        "@language": "ro",
        "@value": "Referință care identifică un dosar de emitere a biletelor, utilizată pentru a corela biletele, rezervările și procesele post-vânzare."
      },
      {
        "@language": "sk",
        "@value": "Referencia identifikujúca dokumentáciu k predaju cestovných lístkov, ktorá sa používa na prepojenie cestovných lístkov, rezervácií a popredajných procesov."
      },
      {
        "@language": "fr",
        "@value": "Référence identifiant un dossier de billettique, utilisée pour relier les billets, les réservations et les processus après-vente."
      },
      {
        "@language": "ga",
        "@value": "Tagairt lena sainaithnítear comhad eisiúna ticéad, a úsáidtear chun ticéid, áirithintí agus próisis iardhíola a nascadh."
      },
      {
        "@language": "hu",
        "@value": "Egy jegykezelési ügyiratot azonosító hivatkozás, amelyet a jegyek, a foglalások és az értékesítés utáni folyamatok összekapcsolására használnak."
      },
      {
        "@language": "it",
        "@value": "Riferimento che identifica un fascicolo di biglietteria, utilizzato per collegare biglietti, prenotazioni e processi post-vendita."
      },
      {
        "@language": "lt",
        "@value": "Nuoroda, identifikuojanti bilietų pardavimo bylą, naudojama bilietams, rezervacijoms ir poprekybiniams procesams susieti."
      },
      {
        "@language": "lv",
        "@value": "Atsauce, kas identificē biļešu pārdošanas lietu un ko izmanto, lai sasaistītu biļetes, rezervācijas un pēcpārdošanas procesus."
      },
      {
        "@language": "hr",
        "@value": "Referenca koja identificira dokumentaciju za izdavanje karata, koja se upotrebljava za povezivanje karata, rezervacija i poslijeprodajnih postupaka."
      }
    ],
