      },
      {
        "@language": "cs",
        "@value": "Minimální přestupní doba"
      },
      {
        "@language": "de",
        "@value": "Mindestumsteigezeit"
      },
      {
        "@language": "el",
        "@value": "Ελάχιστος χρόνος ανταπόκρισης"
      },
      {
        "@language": "pl",
        "@value": "Minimalny czas na przesiadkę"
      },
      {
        "@language": "pt",
        "@value": "Tempo mínimo de correspondência"
      },
      {
        "@language": "sv",
        "@value": "Minsta anslutningstid"
      },
      {
        "@language": "nl",
        "@value": "Minimale overstaptijd"
      },
      {
        "@language": "es",
        "@value": "Tiempo mínimo de conexión"
      },
      {
        "@language": "fr",
        "@value": "Temps de correspondance minimal"
      },
