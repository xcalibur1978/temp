  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0043",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Operational state indicating that a freight wagon is being loaded."
      },
      {
        "@language": "pl",
        "@value": "Stan operacyjny wskazujący, że wagon towarowy jest załadowywany."
      },
      {
        "@language": "pt",
        "@value": "Estado operacional que indica que um vagão de mercadorias está a ser carregado."
      },
      {
        "@language": "ro",
        "@value": "Stare operațională care indică faptul că un vagon de marfă este în curs de încărcare."
      },
      {
        "@language": "cs",
        "@value": "Provozní stav označující, že nákladní vůz je nakládán."
      },
      {
        "@language": "de",
        "@value": "Betriebszustand, der angibt, dass ein Güterwagen beladen wird."
      },
      {
        "@language": "el",
        "@value": "Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα εμπορευματικό βαγόνι φορτώνεται."
      },
      {
        "@language": "es",
        "@value": "Estado operativo que indica que un vagón de mercancías está siendo cargado."
      },
      {
        "@language": "fr",
        "@value": "État opérationnel indiquant qu'un wagon de fret est en cours de chargement."
      },
      {
        "@language": "hu",
        "@value": "Működési állapot, amely azt jelzi, hogy egy tehervagont megraknak."
      },
      {
        "@language": "it",
        "@value": "Stato operativo che indica che un carro merci è in fase di carico."
      },
      {
        "@language": "sv",
        "@value": "Operativt tillstånd som anger att en godsvagn lastas."
      },
      {
        "@language": "nl",
        "@value": "Operationele toestand die aangeeft dat een goederenwagen wordt beladen."
      },
      {
        "@language": "hr",
        "@value": "Operativno stanje kojim se označava da se teretni vagon utovaruje."
      },
      {
        "@language": "bg",
        "@value": "Оперативно състояние, с което се обозначава, че товарен вагон се натоварва."
      },
      {
        "@language": "da",
        "@value": "Operationel tilstand, der angiver, at en godsvogn er ved at blive læsset."
      },
      {
        "@language": "et",
        "@value": "Operatiivseisund, mis näitab, et kaubavagunit laaditakse."
      },
      {
        "@language": "fi",
        "@value": "Operatiivinen tila, joka ilmaisee, että tavaravaunua lastataan."
      },
      {
        "@language": "ga",
        "@value": "Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta á lódáil."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkový stav označujúci, že nákladný vozeň sa nakladá."
      },
      {
        "@language": "sl",
        "@value": "Operativno stanje, ki označuje, da se tovorni vagon nalaga."
      },
      {
        "@language": "lt",
        "@value": "Veiklos būsena, kuria nurodoma, kad prekinis vagonas pakraunamas."
      },
      {
        "@language": "lv",
        "@value": "Operatīvais stāvoklis, ar kuru norāda, ka kravas vagonu iekrauj."
      },
      {
        "@language": "mt",
        "@value": "Stat operazzjonali li jindika li vagun tal-merkanzija qiegħed jiġi mgħobbi."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
