  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0062",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Δεδομένα που περιγράφουν τους διαδικτυακούς διαύλους πώλησης μέσω των οποίων προσφέρονται σιδηροδρομικά προϊόντα."
      },
      {
        "@language": "en",
        "@value": "Data describing the online sales channels through which rail products are offered."
      },
      {
        "@language": "es",
        "@value": "Datos que describen los canales de venta en línea a través de los cuales se ofrecen los productos ferroviarios."
      },
      {
        "@language": "fr",
        "@value": "Données décrivant les canaux de vente en ligne par lesquels les produits ferroviaires sont proposés."
      },
      {
        "@language": "hu",
        "@value": "Olyan adatok, amelyek leírják azokat az online értékesítési csatornákat, amelyeken keresztül a vasúti termékeket kínálják."
      },
      {
        "@language": "it",
        "@value": "Dati che descrivono i canali di vendita online attraverso i quali sono offerti i prodotti ferroviari."
      },
      {
        "@language": "nl",
        "@value": "Gegevens die de onlineverkoopkanalen beschrijven waarlangs spoorproducten worden aangeboden."
      },
      {
        "@language": "pl",
        "@value": "Dane opisujące internetowe kanały sprzedaży, za pośrednictwem których oferowane są produkty kolejowe."
      },
      {
        "@language": "pt",
        "@value": "Dados que descrevem os canais de venda em linha através dos quais os produtos ferroviários são oferecidos."
      },
      {
        "@language": "ro",
        "@value": "Date care descriu canalele de vânzare online prin care sunt oferite produsele feroviare."
      },
      {
        "@language": "sv",
        "@value": "Uppgifter som beskriver de kanaler för onlineförsäljning genom vilka järnvägsprodukter erbjuds."
      },
      {
        "@language": "cs",
        "@value": "Údaje popisující online prodejní kanály, jejichž prostřednictvím jsou nabízeny železniční produkty."
      },
      {
        "@language": "de",
        "@value": "Daten zur Beschreibung der Online-Vertriebskanäle, über die Bahnprodukte angeboten werden."
      },
      {
        "@language": "bg",
        "@value": "Данни, с които се описват каналите за онлайн продажби, чрез които се предлагат железопътни продукти."
      },
      {
        "@language": "da",
        "@value": "Data, der beskriver de onlinesalgskanaler, hvorigennem jernbaneprodukter udbydes."
      },
      {
        "@language": "et",
        "@value": "Andmed, milles kirjeldatakse internetimüügikanaleid, mille kaudu raudteetooteid pakutakse."
      },
      {
        "@language": "fi",
        "@value": "Tiedot, joissa kuvataan verkkomyyntikanavat, joiden kautta rautatietuotteita tarjotaan."
      },
      {
        "@language": "ga",
        "@value": "Sonraí lena ndéantar cur síos ar na bealaí díola ar líne trína dtairgtear táirgí iarnróid."
      },
      {
        "@language": "hr",
        "@value": "Podaci kojima se opisuju internetski prodajni kanali putem kojih se nude željeznički proizvodi."
      },
      {
        "@language": "lv",
        "@value": "Dati, ar kuriem apraksta tiešsaistes pārdošanas kanālus, ar kuru starpniecību piedāvā dzelzceļa produktus."
      },
      {
        "@language": "mt",
        "@value": "Data li tiddeskrivi l-kanali tal-bejgħ online li permezz tagħhom jiġu offruti l-prodotti ferrovjarji."
      },
      {
        "@language": "sk",
        "@value": "Údaje opisujúce online predajné kanály, prostredníctvom ktorých sa ponúkajú železničné produkty."
      },
      {
        "@language": "sl",
        "@value": "Podatki, ki opisujejo spletne prodajne kanale, prek katerih se ponujajo železniški proizvodi."
      },
      {
        "@language": "lt",
        "@value": "Duomenys, kuriais apibūdinami internetiniai pardavimo kanalai, per kuriuos siūlomi geležinkelių produktai."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
