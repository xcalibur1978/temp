  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0060",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_45"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Price associated with a tariff resulting from an algorithm based on variables, referred to as the yielding rule."
      },
      {
        "@language": "cs",
        "@value": "Cena spojená s tarifem, která vyplývá z algoritmu založeného na proměnných, označovaného jako „pravidlo výnosnosti“."
      },
      {
        "@language": "de",
        "@value": "Mit einem Tarif verbundener Preis, der sich aus einem auf Variablen basierenden Algorithmus ergibt, der als 'Yielding-Regel' bezeichnet wird."
      },
      {
        "@language": "el",
        "@value": "Τιμή που συνδέεται με τιμολόγιο και προκύπτει από αλγόριθμο βασισμένο σε μεταβλητές, ο οποίος αποκαλείται «κανόνας απόδοσης»."
      },
      {
        "@language": "es",
        "@value": "Precio asociado a una tarifa resultante de un algoritmo basado en variables, denominado «regla de yield»."
      },
      {
        "@language": "fr",
        "@value": "Prix associé à un tarif résultant d'un algorithme fondé sur des variables, appelé «règle de yield»."
      },
      {
        "@language": "hu",
        "@value": "Egy tarifához kapcsolódó ár, amely változókon alapuló algoritmusból ered, amelyet „hozamszabálynak” neveznek."
      },
      {
        "@language": "it",
        "@value": "Prezzo associato a una tariffa risultante da un algoritmo basato su variabili, denominato «regola di yield»."
      },
      {
        "@language": "nl",
        "@value": "Prijs die met een tarief verbonden is en voortvloeit uit een op variabelen gebaseerd algoritme, de 'yieldregel' genoemd."
      },
      {
        "@language": "pl",
        "@value": "Cena powiązana z taryfą wynikająca z algorytmu opartego na zmiennych, zwanego „regułą yield”."
      },
      {
        "@language": "pt",
        "@value": "Preço associado a uma tarifa resultante de um algoritmo baseado em variáveis, designado «regra de yield»."
      },
      {
        "@language": "ro",
        "@value": "Preț asociat unui tarif care rezultă dintr-un algoritm bazat pe variabile, denumit «regulă de yield»."
      },
      {
        "@language": "sv",
        "@value": "Pris som är kopplat till en tariff och som följer av en algoritm baserad på variabler, kallad ”avkastningsregel”."
      },
      {
        "@language": "ga",
        "@value": "Praghas a bhaineann le taraif a eascraíonn as algartam atá bunaithe ar athróga, dá ngairtear \"riail toraidh\"."
      },
      {
        "@language": "hr",
        "@value": "Cijena povezana s tarifom koja proizlazi iz algoritma utemeljenog na varijablama, koji se naziva „pravilom prinosa”."
      },
      {
        "@language": "lt",
        "@value": "Su tarifu susieta kaina, gaunama pagal kintamaisiais grindžiamą algoritmą, vadinamą „pelningumo taisykle“."
      },
      {
        "@language": "lv",
        "@value": "Cena, kas saistīta ar tarifu un izriet no algoritma, kura pamatā ir mainīgie lielumi un kuru sauc par “ienesīguma noteikumu”."
      },
      {
        "@language": "mt",
        "@value": "Prezz assoċjat ma' tariffa li jirriżulta minn algoritmu bbażat fuq il-varjabbli, imsejjaħ \"regola tar-rendiment\"."
      },
      {
        "@language": "sk",
        "@value": "Cena spojená s tarifou, ktorá vyplýva z algoritmu založeného na premenných, označovaného ako „pravidlo výnosnosti“."
      },
      {
        "@language": "sl",
        "@value": "Cena, povezana s tarifo, ki izhaja iz algoritma, temelječega na spremenljivkah, imenovanega „pravilo donosa“."
      },
      {
        "@language": "da",
        "@value": "Pris, der er knyttet til en tarif, og som følger af en algoritme baseret på variabler, benævnt »yield-regel«."
      },
      {
        "@language": "et",
        "@value": "Tariifiga seotud hind, mis tuleneb muutujatel põhinevast algoritmist, mida nimetatakse „tulususe reegliks“."
      },
      {
        "@language": "fi",
        "@value": "Tariffiin liittyvä hinta, joka perustuu muuttujiin pohjautuvaan algoritmiin, jota kutsutaan ”tuottosäännöksi”."
      },
      {
        "@language": "bg",
        "@value": "Цена, свързана с тарифа, която произтича от алгоритъм, основан на променливи, наричан „правило за доходност“."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Yielded price"
      },
      {
        "@language": "el",
        "@value": "Τιμή απόδοσης (yield)"
      },
      {
        "@language": "es",
        "@value": "Precio dinámico (yield)"
      },
      {
        "@language": "fr",
        "@value": "Prix ajusté (yield)"
      },
      {
        "@language": "hu",
        "@value": "Hozamár (yield)"
      },
      {
        "@language": "it",
        "@value": "Prezzo a resa variabile (yield)"
      },
      {
        "@language": "nl",
        "@value": "Yieldprijs"
      },
      {
        "@language": "pl",
        "@value": "Cena dynamiczna (yield)"
      },
      {
        "@language": "pt",
        "@value": "Preço dinâmico (yield)"
      },
      {
        "@language": "ro",
        "@value": "Preț dinamic (yield)"
      },
      {
        "@language": "sv",
        "@value": "Avkastningspris (yield)"
      },
      {
        "@language": "cs",
        "@value": "Výnosová cena (yield)"
      },
      {
        "@language": "de",
        "@value": "Yield-Preis"
      },
      {
        "@language": "bg",
        "@value": "Доходна цена (yield)"
      },
      {
        "@language": "da",
        "@value": "Yield-pris"
      },
      {
        "@language": "et",
        "@value": "Tulususe hind (yield)"
      },
      {
        "@language": "fi",
        "@value": "Tuottohinta (yield)"
      },
      {
        "@language": "ga",
        "@value": "Praghas toraidh (yield)"
      },
      {
        "@language": "hr",
        "@value": "Prinosna cijena (yield)"
      },
      {
        "@language": "lt",
        "@value": "Pelningumo kaina (yield)"
      },
      {
        "@language": "lv",
        "@value": "Ienesīguma cena (yield)"
      },
      {
        "@language": "mt",
        "@value": "Prezz tar-rendiment (yield)"
      },
      {
        "@language": "sk",
        "@value": "Výnosová cena (yield)"
      },
      {
        "@language": "sl",
        "@value": "Donosna cena (yield)"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0057",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_24"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The minimum amount of time that is sufficient for a passenger to connect between the access nodes of two consecutive passenger transport services included in a journey."
      },
      {
        "@language": "cs",
        "@value": "Minimální doba dostatečná k tomu, aby cestující stihl přestup mezi přístupovými uzly dvou po sobě následujících služeb přepravy cestujících zahrnutých v cestě."
      },
      {
        "@language": "de",
        "@value": "Die Mindestzeit, die für einen Fahrgast ausreicht, um zwischen den Zugangsknoten zweier aufeinanderfolgender, in einer Reise enthaltener Personenverkehrsdienste umzusteigen."
      },
      {
        "@language": "el",
        "@value": "Ο ελάχιστος χρόνος που επαρκεί ώστε ένας επιβάτης να πραγματοποιήσει ανταπόκριση μεταξύ των κόμβων πρόσβασης δύο διαδοχικών υπηρεσιών μεταφοράς επιβατών που περιλαμβάνονται σε ένα ταξίδι."
      },
      {
        "@language": "es",
        "@value": "El tiempo mínimo suficiente para que un viajero realice la conexión entre los nodos de acceso de dos servicios de transporte de viajeros consecutivos incluidos en un viaje."
      },
      {
        "@language": "hu",
        "@value": "Az a minimális idő, amely elegendő ahhoz, hogy egy utas átszálljon egy utazásban szereplő két egymást követő személyszállítási szolgáltatás hozzáférési csomópontjai között."
      },
      {
        "@language": "it",
        "@value": "Il tempo minimo sufficiente affinché un passeggero effettui la coincidenza tra i nodi di accesso di due servizi di trasporto passeggeri consecutivi inclusi in un viaggio."
      },
      {
        "@language": "nl",
        "@value": "De minimale tijd die voldoende is voor een reiziger om over te stappen tussen de toegangsknooppunten van twee opeenvolgende, in een reis opgenomen reizigersvervoersdiensten."
      },
      {
        "@language": "pl",
        "@value": "Minimalny czas wystarczający, aby pasażer mógł przesiąść się między węzłami dostępu dwóch następujących po sobie przewozów pasażerskich objętych podróżą."
      },
      {
        "@language": "pt",
        "@value": "O tempo mínimo suficiente para que um passageiro efetue a correspondência entre os nós de acesso de dois serviços de transporte de passageiros consecutivos incluídos numa viagem."
      },
      {
        "@language": "ro",
        "@value": "Timpul minim suficient pentru ca un călător să facă legătura între nodurile de acces ale a două servicii de transport de călători consecutive incluse într-o călătorie."
      },
      {
        "@language": "sv",
        "@value": "Den minsta tid som är tillräcklig för att en resenär ska kunna byta mellan åtkomstnoderna för två på varandra följande persontrafiktjänster som ingår i en resa."
      },
      {
        "@language": "fr",
        "@value": "Durée minimale suffisante pour qu'un voyageur effectue une correspondance entre les nœuds d'accès de deux services de transport de voyageurs consécutifs inclus dans un voyage."
      },
      {
        "@language": "lv",
        "@value": "Minimālais laiks, kas ir pietiekams, lai pasažieris veiktu pārsēšanos starp divu secīgu ceļojumā iekļautu pasažieru pārvadājumu pakalpojumu piekļuves mezgliem."
      },
      {
        "@language": "fi",
        "@value": "Vähimmäisaika, joka riittää siihen, että matkustaja ehtii vaihtaa matkaan sisältyvien kahden peräkkäisen henkilöliikennepalvelun liityntäsolmukohtien välillä."
      },
      {
        "@language": "ga",
        "@value": "An t-íosam atá leordhóthanach do phaisinéir chun aistriú a dhéanamh idir nóid rochtana dhá sheirbhís iompair phaisinéirí as a chéile atá san áireamh in aistear."
      },
      {
        "@language": "bg",
        "@value": "Минималното време, достатъчно за пътник да направи прехвърляне между възлите за достъп на две последователни услуги за превоз на пътници, включени в пътуване."
      },
      {
        "@language": "da",
        "@value": "Den mindste tid, der er tilstrækkelig til, at en passager kan skifte mellem adgangsknudepunkterne for to på hinanden følgende passagertransporttjenester, der indgår i en rejse."
      },
      {
        "@language": "hr",
        "@value": "Najkraće vrijeme dostatno da putnik obavi presjedanje između pristupnih čvorišta dviju uzastopnih usluga prijevoza putnika uključenih u putovanje."
      },
      {
        "@language": "lt",
        "@value": "Mažiausias laikas, kurio pakanka keleiviui persėsti tarp dviejų į kelionę įtrauktų paeiliui einančių keleivių vežimo paslaugų prieigos mazgų."
      },
      {
        "@language": "et",
        "@value": "Minimaalne aeg, mis on piisav, et reisija saaks teha ümberistumise reisi kuuluva kahe järjestikuse reisijateveoteenuse juurdepääsusõlmede vahel."
      },
      {
        "@language": "sk",
        "@value": "Minimálny čas postačujúci na to, aby cestujúci stihol prestup medzi prístupovými uzlami dvoch po sebe nasledujúcich služieb osobnej dopravy zahrnutých v ceste."
      },
      {
        "@language": "sl",
        "@value": "Najkrajši čas, ki zadostuje, da potnik opravi prestop med dostopnimi vozlišči dveh zaporednih storitev potniškega prevoza, vključenih v potovanje."
      },
      {
        "@language": "mt",
        "@value": "Il-ħin minimu suffiċjenti biex passiġġier jagħmel il-konnessjoni bejn in-nodi ta' aċċess ta' żewġ servizzi tat-trasport tal-passiġġieri konsekuttivi inklużi fi vjaġġ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Minimum connection time"
      },
      {
        "@language": "ro",
