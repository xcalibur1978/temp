  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0086",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_22"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A set of functions, procedures, definitions and protocols for interoperable data sharing between telematics applications."
      },
      {
        "@language": "el",
        "@value": "Σύνολο λειτουργιών, διαδικασιών, ορισμών και πρωτοκόλλων για τη διαλειτουργική ανταλλαγή δεδομένων μεταξύ τηλεματικών εφαρμογών."
      },
      {
        "@language": "es",
        "@value": "Conjunto de funciones, procedimientos, definiciones y protocolos para el intercambio interoperable de datos entre aplicaciones telemáticas."
      },
      {
        "@language": "fr",
        "@value": "Ensemble de fonctions, de procédures, de définitions et de protocoles permettant le partage interopérable de données entre applications télématiques."
      },
      {
        "@language": "hu",
        "@value": "Funkciók, eljárások, definíciók és protokollok összessége a telematikai alkalmazások közötti interoperábilis adatmegosztáshoz."
      },
      {
        "@language": "it",
        "@value": "Insieme di funzioni, procedure, definizioni e protocolli per la condivisione interoperabile dei dati tra applicazioni telematiche."
      },
      {
        "@language": "nl",
        "@value": "Een geheel van functies, procedures, definities en protocollen voor interoperabele gegevensdeling tussen telematicatoepassingen."
      },
      {
        "@language": "pl",
        "@value": "Zbiór funkcji, procedur, definicji i protokołów umożliwiających interoperacyjną wymianę danych między aplikacjami telematycznymi."
      },
      {
        "@language": "pt",
        "@value": "Conjunto de funções, procedimentos, definições e protocolos para a partilha interoperável de dados entre aplicações telemáticas."
      },
      {
        "@language": "ro",
        "@value": "Set de funcții, proceduri, definiții și protocoale pentru partajarea interoperabilă a datelor între aplicațiile telematice."
      },
      {
        "@language": "sv",
        "@value": "En uppsättning funktioner, förfaranden, definitioner och protokoll för interoperabel datadelning mellan telematikapplikationer."
      },
      {
        "@language": "cs",
        "@value": "Soubor funkcí, postupů, definic a protokolů pro interoperabilní sdílení údajů mezi telematickými aplikacemi."
      },
      {
        "@language": "de",
        "@value": "Eine Reihe von Funktionen, Verfahren, Definitionen und Protokollen für den interoperablen Datenaustausch zwischen Telematikanwendungen."
      },
      {
        "@language": "fi",
        "@value": "Joukko toimintoja, menettelyjä, määritelmiä ja protokollia telematiikkasovellusten väliseen yhteentoimivaan datan jakamiseen."
      },
      {
        "@language": "ga",
        "@value": "Sraith feidhmeanna, nósanna imeachta, sainmhínithe agus prótacal le haghaidh comhroinnt sonraí idir-inoibritheach idir feidhmchláir theileamaitice."
      },
      {
        "@language": "hr",
        "@value": "Skup funkcija, postupaka, definicija i protokola za interoperabilnu razmjenu podataka među telematičkim aplikacijama."
      },
      {
        "@language": "lt",
        "@value": "Funkcijų, procedūrų, apibrėžčių ir protokolų rinkinys, skirtas sąveikiajam dalijimuisi duomenimis tarp telematikos taikomųjų programų."
      },
      {
        "@language": "lv",
        "@value": "Funkciju, procedūru, definīciju un protokolu kopums sadarbspējīgai datu kopīgošanai starp telemātikas lietojumprogrammām."
      },
      {
        "@language": "mt",
        "@value": "Sett ta' funzjonijiet, proċeduri, definizzjonijiet u protokolli għall-kondiviżjoni interoperabbli tad-data bejn l-applikazzjonijiet telematiċi."
      },
      {
        "@language": "sk",
        "@value": "Súbor funkcií, postupov, definícií a protokolov na interoperabilné zdieľanie údajov medzi telematickými aplikáciami."
      },
      {
        "@language": "sl",
        "@value": "Niz funkcij, postopkov, opredelitev in protokolov za interoperabilno izmenjavo podatkov med telematskimi aplikacijami."
      },
      {
        "@language": "bg",
        "@value": "Набор от функции, процедури, дефиниции и протоколи за оперативно съвместимо споделяне на данни между телематичните приложения."
      },
      {
        "@language": "da",
        "@value": "Et sæt funktioner, procedurer, definitioner og protokoller til interoperabel datadeling mellem telematikapplikationer."
      },
      {
        "@language": "et",
        "@value": "Funktsioonide, protseduuride, määratluste ja protokollide kogum koostalitlusvõimeliseks andmete jagamiseks telemaatikarakenduste vahel."
      }
    ],
