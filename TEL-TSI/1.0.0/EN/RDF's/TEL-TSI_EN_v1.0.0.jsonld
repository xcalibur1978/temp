  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0041",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "ro",
        "@value": "Baze de date de referință privind unitățile de încărcare intermodală, inclusiv codul ILU, tipul, dimensiunile și proprietarul."
      },
      {
        "@language": "en",
        "@value": "Reference databases for intermodal loading units, including ILU code, type, dimensions and owner."
      },
      {
        "@language": "cs",
        "@value": "Referenční databáze intermodálních nákladových jednotek, včetně kódu ILU, typu, rozměrů a vlastníka."
      },
      {
        "@language": "el",
        "@value": "Βάσεις δεδομένων αναφοράς μονάδων διατροπικής φόρτωσης, συμπεριλαμβανομένου του κωδικού ILU, του τύπου, των διαστάσεων και του ιδιοκτήτη."
      },
      {
        "@language": "es",
        "@value": "Bases de datos de referencia de las unidades de carga intermodal, incluidos el código ILU, el tipo, las dimensiones y el propietario."
      },
      {
        "@language": "nl",
        "@value": "Referentiedatabanken voor intermodale laadeenheden, met inbegrip van de ILU-code, het type, de afmetingen en de eigenaar."
      },
      {
        "@language": "pt",
        "@value": "Bases de dados de referência das unidades de carga intermodal, incluindo o código ILU, o tipo, as dimensões e o proprietário."
      },
      {
        "@language": "de",
        "@value": "Referenzdatenbanken für intermodale Ladeeinheiten, einschließlich ILU-Code, Typ, Abmessungen und Eigentümer."
      },
      {
        "@language": "fr",
        "@value": "Bases de données de référence des unités de chargement intermodal, comprenant le code ILU, le type, les dimensions et le propriétaire."
      },
      {
        "@language": "hu",
        "@value": "Az intermodális rakományegységek referencia-adatbázisai, beleértve az ILU-kódot, a típust, a méreteket és a tulajdonost."
      },
      {
        "@language": "it",
        "@value": "Banche dati di riferimento delle unità di carico intermodale, compresi il codice ILU, il tipo, le dimensioni e il proprietario."
      },
      {
        "@language": "pl",
        "@value": "Referencyjne bazy danych intermodalnych jednostek ładunkowych, w tym kod ILU, typ, wymiary i właściciel."
      },
      {
        "@language": "sv",
        "@value": "Referensdatabaser för intermodala lastenheter, inbegripet ILU-kod, typ, dimensioner och ägare."
      },
      {
        "@language": "fi",
        "@value": "Intermodaalisten kuormausyksiköiden viitetietokannat, mukaan lukien ILU-koodi, tyyppi, mitat ja omistaja."
      },
      {
        "@language": "ga",
        "@value": "Bunachair sonraí tagartha na n-aonad lódála idirmhódúil, lena n-áirítear an cód ILU, an cineál, na toisí agus an t-úinéir."
      },
      {
        "@language": "hr",
        "@value": "Referentne baze podataka intermodalnih utovarnih jedinica, uključujući kod ILU, vrstu, dimenzije i vlasnika."
      },
      {
        "@language": "lt",
        "@value": "Įvairiarūšio krovimo vienetų etaloninės duomenų bazės, įskaitant ILU kodą, tipą, matmenis ir savininką."
      },
      {
        "@language": "lv",
        "@value": "Intermodālo kravas vienību atsauces datubāzes, tostarp ILU kods, tips, izmēri un īpašnieks."
      },
      {
        "@language": "mt",
        "@value": "Bażijiet tad-data ta' referenza tal-unitajiet tat-tagħbija intermodali, inkluż il-kodiċi ILU, it-tip, id-dimensjonijiet u s-sid."
      },
      {
        "@language": "sk",
        "@value": "Referenčné databázy intermodálnych nákladových jednotiek vrátane kódu ILU, typu, rozmerov a vlastníka."
      },
      {
        "@language": "sl",
        "@value": "Referenčne podatkovne zbirke intermodalnih nakladalnih enot, vključno s kodo ILU, vrsto, dimenzijami in lastnikom."
      },
      {
        "@language": "bg",
        "@value": "Референтни бази данни за интермодалните товарни единици, включително код ILU, тип, размери и собственик."
      },
      {
        "@language": "da",
        "@value": "Referencedatabaser for intermodale lastenheder, herunder ILU-kode, type, dimensioner og ejer."
      },
      {
        "@language": "et",
        "@value": "Intermodaalsete laadimisüksuste võrdlusandmebaasid, sealhulgas ILU-kood, tüüp, mõõtmed ja omanik."
      }
    ],
