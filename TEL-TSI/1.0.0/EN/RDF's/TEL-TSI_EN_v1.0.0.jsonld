  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0053",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "de",
        "@value": "Nachricht zur Prüfung der Verfügbarkeit und zur Reservierung der Beförderung von Autos, Motorrädern oder Booten."
      },
      {
        "@language": "en",
        "@value": "Message for checking availability of and reserving the carriage of cars, motorcycles or boats."
      },
      {
        "@language": "pl",
        "@value": "Komunikat służący do sprawdzenia dostępności i rezerwacji przewozu samochodów, motocykli lub łodzi."
      },
      {
        "@language": "pt",
        "@value": "Mensagem para verificar a disponibilidade e reservar o transporte de automóveis, motociclos ou embarcações."
      },
      {
        "@language": "ro",
        "@value": "Mesaj pentru verificarea disponibilității și rezervarea transportului de autoturisme, motociclete sau ambarcațiuni."
      },
      {
        "@language": "sv",
        "@value": "Meddelande för att kontrollera tillgängligheten av och boka transport av bilar, motorcyklar eller båtar."
      },
      {
        "@language": "cs",
        "@value": "Zpráva pro ověření dostupnosti a rezervaci přepravy automobilů, motocyklů nebo plavidel."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα για τον έλεγχο της διαθεσιμότητας και την κράτηση της μεταφοράς αυτοκινήτων, μοτοσικλετών ή σκαφών."
      },
      {
        "@language": "es",
        "@value": "Mensaje para comprobar la disponibilidad y reservar el transporte de automóviles, motocicletas o embarcaciones."
      },
      {
        "@language": "fr",
        "@value": "Message permettant de vérifier la disponibilité et de réserver le transport de voitures, de motos ou de bateaux."
      },
      {
        "@language": "hu",
        "@value": "Üzenet a gépjárművek, motorkerékpárok vagy hajók szállítása rendelkezésre állásának ellenőrzésére és foglalására."
      },
      {
        "@language": "it",
        "@value": "Messaggio per verificare la disponibilità e prenotare il trasporto di automobili, motocicli o imbarcazioni."
      },
      {
        "@language": "nl",
        "@value": "Bericht om de beschikbaarheid te controleren van en het vervoer van auto's, motorfietsen of boten te reserveren."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ biex tiġi vverifikata d-disponibbiltà u jiġi rriżervat it-trasport tal-karozzi, il-muturi jew id-dgħajjes."
      },
      {
        "@language": "sk",
        "@value": "Správa na overenie dostupnosti a rezerváciu prepravy automobilov, motocyklov alebo plavidiel."
      },
      {
        "@language": "da",
        "@value": "Meddelelse til kontrol af tilgængeligheden af og reservation af transport af biler, motorcykler eller både."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega kontrollitakse autode, mootorrataste või paatide veo saadavust ja broneeritakse see."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla tarkistetaan autojen, moottoripyörien tai veneiden kuljetuksen saatavuus ja varataan se."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht chun an infhaighteacht a sheiceáil agus iompar carranna, gluaisrothar nó bád a áirithiú."
      },
      {
        "@language": "hr",
        "@value": "Poruka za provjeru dostupnosti i rezervaciju prijevoza automobila, motocikala ili plovila."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, skirtas patikrinti prieinamumą ir rezervuoti automobilių, motociklų ar laivų vežimą."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pārbauda pieejamību un rezervē automobiļu, motociklu vai laivu pārvadāšanu."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo za preverjanje razpoložljivosti in rezervacijo prevoza avtomobilov, motornih koles ali plovil."
      },
      {
        "@language": "bg",
        "@value": "Съобщение за проверка на наличността и резервация на превоз на автомобили, мотоциклети или плавателни съдове."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
