      },
      {
        "@language": "pl",
        "@value": "Dostępność i rezerwacja przewozu samochodów"
      },
      {
        "@language": "pt",
        "@value": "Disponibilidade e reserva de transporte de automóveis"
      },
      {
        "@language": "ro",
        "@value": "Disponibilitatea și rezervarea transportului de autoturisme"
      },
      {
        "@language": "sv",
        "@value": "Tillgänglighet och bokning av biltransport"
      },
      {
        "@language": "da",
        "@value": "Tilgængelighed og reservation af biltransport"
      },
      {
        "@language": "et",
        "@value": "Autoveo saadavus ja broneerimine"
      },
      {
        "@language": "fi",
        "@value": "Autonkuljetuksen saatavuus ja varaus"
      },
      {
        "@language": "ga",
        "@value": "Infhaighteacht agus áirithint iompair carranna"
      },
      {
        "@language": "hr",
        "@value": "Dostupnost i rezervacija prijevoza automobila"
      },
      {
        "@language": "lt",
        "@value": "Automobilių vežimo prieinamumas ir rezervacija"
      },
      {
        "@language": "lv",
        "@value": "Automobiļu pārvadāšanas pieejamība un rezervācija"
      },
      {
        "@language": "mt",
        "@value": "Disponibbiltà u riżervazzjoni tat-trasport tal-karozzi"
      },
      {
        "@language": "sk",
        "@value": "Dostupnosť a rezervácia prepravy automobilov"
      },
      {
        "@language": "sl",
        "@value": "Razpoložljivost in rezervacija prevoza avtomobilov"
      },
      {
        "@language": "bg",
        "@value": "Наличност и резервация на превоз на автомобили"
