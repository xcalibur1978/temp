  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0051",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Μήνυμα για τον έλεγχο της διαθεσιμότητας και την κράτηση συνδρομής για άτομα με αναπηρία ή μειωμένη κινητικότητα."
      },
      {
        "@language": "en",
        "@value": "Message for checking availability of and reserving assistance for persons with disabilities or reduced mobility."
      },
      {
        "@language": "sv",
        "@value": "Meddelande för att kontrollera tillgängligheten av och boka assistans för personer med funktionsnedsättning eller nedsatt rörlighet."
      },
      {
        "@language": "hu",
        "@value": "Üzenet a fogyatékossággal élő vagy csökkent mozgásképességű személyeknek nyújtott segítség rendelkezésre állásának ellenőrzésére és foglalására."
      },
      {
        "@language": "it",
        "@value": "Messaggio per verificare la disponibilità e prenotare l'assistenza per le persone con disabilità o a mobilità ridotta."
      },
      {
        "@language": "nl",
        "@value": "Bericht om de beschikbaarheid te controleren van en assistentie te reserveren voor personen met een handicap of beperkte mobiliteit."
      },
      {
        "@language": "pl",
        "@value": "Komunikat służący do sprawdzenia dostępności i rezerwacji pomocy dla osób z niepełnosprawnościami lub o ograniczonej możliwości poruszania się."
      },
      {
        "@language": "pt",
        "@value": "Mensagem para verificar a disponibilidade e reservar assistência a pessoas com deficiência ou com mobilidade reduzida."
      },
      {
        "@language": "ro",
        "@value": "Mesaj pentru verificarea disponibilității și rezervarea asistenței pentru persoanele cu handicap sau cu mobilitate redusă."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, skirtas patikrinti prieinamumą ir rezervuoti pagalbą neįgaliesiems arba riboto judumo asmenims."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pārbauda pieejamību un rezervē palīdzību personām ar invaliditāti vai ierobežotām pārvietošanās spējām."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ biex tiġi vverifikata d-disponibbiltà u tiġi rriżervata assistenza għal persuni b'diżabbiltà jew b'mobbiltà mnaqqsa."
      },
      {
        "@language": "bg",
        "@value": "Съобщение за проверка на наличността и резервация на съдействие за лица с увреждания или с намалена подвижност."
      },
      {
        "@language": "sk",
        "@value": "Správa na overenie dostupnosti a rezerváciu pomoci pre osoby so zdravotným postihnutím alebo so zníženou pohyblivosťou."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo za preverjanje razpoložljivosti in rezervacijo pomoči za invalide ali osebe z zmanjšano mobilnostjo."
      },
      {
        "@language": "hr",
        "@value": "Poruka za provjeru dostupnosti i rezervaciju pomoći osobama s invaliditetom ili smanjene pokretljivosti."
      },
      {
        "@language": "cs",
        "@value": "Zpráva pro ověření dostupnosti a rezervaci asistence pro osoby se zdravotním postižením nebo se sníženou pohyblivostí."
      },
      {
        "@language": "da",
        "@value": "Meddelelse til kontrol af tilgængeligheden af og reservation af assistance til personer med handicap eller nedsat mobilitet."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Prüfung der Verfügbarkeit und zur Reservierung von Hilfeleistung für Personen mit Behinderungen oder eingeschränkter Mobilität."
      },
      {
        "@language": "es",
        "@value": "Mensaje para comprobar la disponibilidad y reservar asistencia para personas con discapacidad o movilidad reducida."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega kontrollitakse puuetega või piiratud liikumisvõimega isikute abistamise saadavust ja broneeritakse see."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla tarkistetaan vammaisille tai liikuntarajoitteisille henkilöille tarkoitetun avustamisen saatavuus ja varataan se."
      },
      {
        "@language": "fr",
        "@value": "Message permettant de vérifier la disponibilité et de réserver une assistance pour les personnes handicapées ou à mobilité réduite."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht chun an infhaighteacht a sheiceáil agus cúnamh a áirithiú do dhaoine faoi mhíchumas nó a bhfuil a soghluaisteacht laghdaithe."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "PRM-assistance availability and reservation"
      },
      {
        "@language": "cs",
        "@value": "Dostupnost a rezervace asistence pro osoby se sníženou pohyblivostí"
      },
      {
        "@language": "de",
        "@value": "Verfügbarkeit und Reservierung von PRM-Hilfeleistung"
      },
      {
        "@language": "el",
        "@value": "Διαθεσιμότητα και κράτηση συνδρομής για ΑμΕΑ"
      },
      {
        "@language": "es",
        "@value": "Disponibilidad y reserva de asistencia PMR"
      },
      {
        "@language": "it",
        "@value": "Disponibilità e prenotazione dell'assistenza PMR"
      },
      {
        "@language": "nl",
        "@value": "Beschikbaarheid en reservering van PRM-assistentie"
      },
      {
        "@language": "pl",
        "@value": "Dostępność i rezerwacja pomocy dla osób o ograniczonej możliwości poruszania się"
      },
      {
        "@language": "pt",
        "@value": "Disponibilidade e reserva de assistência PMR"
      },
      {
        "@language": "ro",
        "@value": "Disponibilitatea și rezervarea asistenței pentru PMR"
      },
      {
        "@language": "sv",
        "@value": "Tillgänglighet och bokning av assistans för personer med nedsatt rörlighet"
      },
      {
        "@language": "fr",
        "@value": "Disponibilité et réservation de l'assistance PMR"
      },
      {
        "@language": "hu",
        "@value": "A csökkent mozgásképességű személyeknek nyújtott segítség rendelkezésre állása és foglalása"
      },
      {
        "@language": "da",
        "@value": "Tilgængelighed og reservation af assistance til personer med nedsat mobilitet"
      },
      {
        "@language": "et",
        "@value": "Piiratud liikumisvõimega isikute abistamise saadavus ja broneerimine"
      },
      {
        "@language": "fi",
        "@value": "Liikuntarajoitteisten avustamisen saatavuus ja varaus"
      },
      {
        "@language": "ga",
        "@value": "Infhaighteacht agus áirithint cúnaimh do dhaoine a bhfuil a soghluaisteacht laghdaithe"
      },
      {
        "@language": "hr",
        "@value": "Dostupnost i rezervacija pomoći osobama smanjene pokretljivosti"
      },
      {
        "@language": "lt",
        "@value": "Pagalbos riboto judumo asmenims prieinamumas ir rezervacija"
      },
      {
        "@language": "lv",
        "@value": "Palīdzības personām ar ierobežotām pārvietošanās spējām pieejamība un rezervācija"
      },
      {
        "@language": "mt",
        "@value": "Disponibbiltà u riżervazzjoni ta' assistenza għal persuni b'mobbiltà mnaqqsa"
      },
      {
        "@language": "sk",
        "@value": "Dostupnosť a rezervácia pomoci pre osoby so zníženou pohyblivosťou"
      },
      {
        "@language": "sl",
        "@value": "Razpoložljivost in rezervacija pomoči za osebe z zmanjšano mobilnostjo"
      },
      {
        "@language": "bg",
        "@value": "Наличност и резервация на съдействие за лица с намалена подвижност"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0073",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_42"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Entité qui combine et/ou vend des produits ferroviaires d'un ou plusieurs distributeurs, en obtenant l'accès au moyen d'une demande initiale; elle peut appliquer des frais ou des réductions mais ne peut pas modifier le contenu du produit ferroviaire."
      },
      {
        "@language": "en",
        "@value": "Entity that combines and/or sells rail products from one or more distributors, obtaining access via an initial request; it may apply fees or reductions but cannot amend rail-product content."
      },
      {
        "@language": "cs",
        "@value": "Subjekt, který kombinuje a/nebo prodává železniční produkty jednoho nebo více distributorů a získává přístup prostřednictvím počáteční žádosti; může uplatňovat poplatky nebo slevy, nesmí však měnit obsah železničního produktu."
      },
      {
        "@language": "de",
        "@value": "Stelle, die Bahnprodukte eines oder mehrerer Vertreiber kombiniert und/oder verkauft und über eine anfängliche Anfrage Zugang erhält; sie kann Gebühren oder Ermäßigungen anwenden, darf jedoch den Inhalt des Bahnprodukts nicht ändern."
      },
      {
        "@language": "el",
        "@value": "Οντότητα που συνδυάζει και/ή πωλεί σιδηροδρομικά προϊόντα ενός ή περισσότερων διανομέων, αποκτώντας πρόσβαση μέσω αρχικού αιτήματος· μπορεί να εφαρμόζει τέλη ή εκπτώσεις, αλλά δεν μπορεί να τροποποιεί το περιεχόμενο του σιδηροδρομικού προϊόντος."
      },
      {
        "@language": "es",
        "@value": "Entidad que combina y/o vende productos ferroviarios de uno o varios distribuidores, obteniendo el acceso mediante una solicitud inicial; puede aplicar tarifas o reducciones, pero no puede modificar el contenido del producto ferroviario."
      },
      {
        "@language": "hu",
        "@value": "Olyan szervezet, amely egy vagy több forgalmazó vasúti termékeit kombinálja és/vagy értékesíti, és kezdeti kérelem útján szerez hozzáférést; díjakat vagy kedvezményeket alkalmazhat, de nem módosíthatja a vasúti termék tartalmát."
      },
      {
        "@language": "it",
        "@value": "Soggetto che combina e/o vende prodotti ferroviari di uno o più distributori, ottenendo l'accesso tramite una richiesta iniziale; può applicare commissioni o riduzioni ma non può modificare il contenuto del prodotto ferroviario."
      },
      {
        "@language": "nl",
        "@value": "Entiteit die spoorproducten van een of meer distributeurs combineert en/of verkoopt en via een initieel verzoek toegang verkrijgt; zij kan vergoedingen of kortingen toepassen maar mag de inhoud van het spoorproduct niet wijzigen."
      },
      {
        "@language": "pl",
        "@value": "Podmiot, który łączy lub sprzedaje produkty kolejowe jednego lub większej liczby dystrybutorów, uzyskując dostęp w drodze wstępnego zapytania; może stosować opłaty lub zniżki, lecz nie może zmieniać treści produktu kolejowego."
      },
      {
        "@language": "pt",
        "@value": "Entidade que combina e/ou vende produtos ferroviários de um ou mais distribuidores, obtendo o acesso mediante um pedido inicial; pode aplicar taxas ou reduções, mas não pode alterar o conteúdo do produto ferroviário."
      },
      {
        "@language": "ro",
        "@value": "Entitate care combină și/sau vinde produse feroviare de la unul sau mai mulți distribuitori, obținând accesul printr-o cerere inițială; aceasta poate aplica taxe sau reduceri, dar nu poate modifica conținutul produsului feroviar."
      },
      {
        "@language": "sv",
        "@value": "Enhet som kombinerar och/eller säljer järnvägsprodukter från en eller flera distributörer och får åtkomst genom en inledande begäran; den får tillämpa avgifter eller rabatter men får inte ändra järnvägsproduktens innehåll."
      },
      {
        "@language": "fi",
        "@value": "Yhteisö, joka yhdistää ja/tai myy yhden tai useamman jakelijan rautatietuotteita ja saa pääsyn aloituspyynnön kautta; se voi soveltaa maksuja tai alennuksia mutta ei voi muuttaa rautatietuotteen sisältöä."
      },
      {
        "@language": "ga",
        "@value": "Eintiteas a chomhcheanglaíonn agus/nó a dhíolann táirgí iarnróid de chuid dáileora amháin nó níos mó, agus a fhaigheann rochtain trí iarraidh tosaigh; féadfaidh sé táillí nó lascainí a chur i bhfeidhm ach ní féidir leis inneachar an táirge iarnróid a athrú."
      },
      {
        "@language": "hr",
        "@value": "Subjekt koji kombinira i/ili prodaje željezničke proizvode jednog ili više distributera te dobiva pristup putem početnog zahtjeva; može primjenjivati naknade ili popuste, ali ne može mijenjati sadržaj željezničkog proizvoda."
      },
      {
        "@language": "lt",
        "@value": "Subjektas, derinantis ir (arba) parduodantis vieno ar kelių platintojų geležinkelių produktus ir gaunantis prieigą pateikus pradinę užklausą; jis gali taikyti mokesčius ar nuolaidas, tačiau negali keisti geležinkelių produkto turinio."
      },
      {
        "@language": "lv",
        "@value": "Subjekts, kas apvieno un/vai pārdod viena vai vairāku izplatītāju dzelzceļa produktus un iegūst piekļuvi ar sākotnēju pieprasījumu; tas var piemērot maksu vai atlaides, bet nevar mainīt dzelzceļa produkta saturu."
      },
      {
        "@language": "mt",
        "@value": "Entità li tikkombina u/jew tbigħ prodotti ferrovjarji ta' distributur wieħed jew aktar, li tikseb l-aċċess permezz ta' talba inizjali; tista' tapplika tariffi jew tnaqqis iżda ma tistax tibdel il-kontenut tal-prodott ferrovjarju."
      },
      {
        "@language": "sk",
        "@value": "Subjekt, ktorý kombinuje a/alebo predáva železničné produkty jedného alebo viacerých distribútorov a získava prístup prostredníctvom počiatočnej žiadosti; môže uplatňovať poplatky alebo zľavy, nesmie však meniť obsah železničného produktu."
      },
      {
        "@language": "sl",
        "@value": "Subjekt, ki združuje in/ali prodaja železniške proizvode enega ali več distributerjev ter pridobi dostop z začetnim zahtevkom; lahko uporablja pristojbine ali popuste, vendar ne more spreminjati vsebine železniškega proizvoda."
      },
      {
        "@language": "da",
        "@value": "Enhed, der kombinerer og/eller sælger jernbaneprodukter fra en eller flere distributører og opnår adgang via en indledende anmodning; den kan anvende gebyrer eller nedslag, men kan ikke ændre jernbaneproduktets indhold."
      },
      {
        "@language": "et",
        "@value": "Üksus, kes ühendab ja/või müüb ühe või mitme turustaja raudteetooteid ning saab juurdepääsu esmase taotluse kaudu; ta võib kohaldada tasusid või soodustusi, kuid ei tohi muuta raudteetoote sisu."
      },
      {
        "@language": "bg",
        "@value": "Субект, който комбинира и/или продава железопътни продукти на един или повече дистрибутори и получава достъп чрез първоначално искане; той може да прилага такси или намаления, но не може да променя съдържанието на железопътния продукт."
      }
    ],
