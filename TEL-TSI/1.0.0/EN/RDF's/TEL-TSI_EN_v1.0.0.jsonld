  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0064",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The catalogue of ticket types and formats, including secured-paper, blank-paper and mobile/flexible-size ticket layouts with their associated security models."
      },
      {
        "@language": "nl",
        "@value": "De catalogus van soorten en formaten van vervoerbewijzen, met inbegrip van de lay-outs voor beveiligd papier, blanco papier en mobiele/flexibel geformatteerde vervoerbewijzen met de bijbehorende beveiligingsmodellen."
      },
      {
        "@language": "pl",
        "@value": "Katalog rodzajów i formatów biletów, w tym układy na papierze zabezpieczonym, na papierze niezadrukowanym oraz biletu mobilnego/o elastycznym formacie, wraz z powiązanymi modelami bezpieczeństwa."
      },
      {
        "@language": "pt",
        "@value": "O catálogo dos tipos e formatos de bilhetes, incluindo as apresentações em papel seguro, em papel branco e de bilhete móvel/de formato flexível, com os respetivos modelos de segurança."
      },
      {
        "@language": "ro",
        "@value": "Catalogul tipurilor și formatelor de bilete, inclusiv prezentările pe hârtie securizată, pe hârtie albă și de bilet mobil/cu format flexibil, cu modelele de securitate asociate."
      },
      {
        "@language": "sv",
        "@value": "Katalogen över biljettyper och biljettformat, inbegripet utformningar på säkerhetspapper, på blankt papper och för mobila/flexibelt formaterade biljetter med tillhörande säkerhetsmodeller."
      },
      {
        "@language": "cs",
        "@value": "Katalog druhů a formátů jízdenek, včetně grafických úprav na zabezpečeném papíře, na nepotištěném papíře a mobilní/flexibilní jízdenky s příslušnými bezpečnostními modely."
      },
      {
        "@language": "de",
        "@value": "Der Katalog der Fahrkartenarten und -formate, einschließlich der Layouts für gesicherte Vordrucke, Blankovordrucke und mobile/flexibel formatierte Fahrkarten mit den zugehörigen Sicherheitsmodellen."
      },
      {
        "@language": "es",
        "@value": "El catálogo de los tipos y formatos de billetes, incluidas las presentaciones en papel seguro, en papel en blanco y de billete móvil/de formato flexible, con sus modelos de seguridad asociados."
      },
      {
        "@language": "fr",
        "@value": "Le catalogue des types et formats de billets, y compris les présentations sur papier sécurisé, sur papier vierge et de billet mobile/de format flexible, avec leurs modèles de sécurité associés."
      },
      {
        "@language": "hu",
        "@value": "A jegytípusok és jegyformátumok katalógusa, beleértve a biztonsági papíron, az üres papíron és a mobil/rugalmas formátumú jegyen alkalmazott elrendezéseket a kapcsolódó biztonsági modellekkel együtt."
      },
      {
        "@language": "it",
        "@value": "Il catalogo dei tipi e formati di biglietti, comprese le presentazioni su carta protetta, su carta bianca e di biglietto mobile/di formato flessibile, con i relativi modelli di sicurezza."
      },
      {
        "@language": "el",
        "@value": "Ο κατάλογος των ειδών και μορφοτύπων εισιτηρίων, συμπεριλαμβανομένων των διατάξεων σε ασφαλές χαρτί, σε λευκό χαρτί και κινητού/ευέλικτου μορφότυπου εισιτηρίου, με τα σχετικά μοντέλα ασφάλειας."
      },
      {
        "@language": "bg",
        "@value": "Каталогът на видовете и форматите на билети, включително оформленията върху защитена хартия, върху празна хартия и на мобилен/гъвкаво форматиран билет със свързаните с тях модели за сигурност."
      },
      {
        "@language": "da",
        "@value": "Kataloget over billettyper og -formater, herunder layout på sikret papir, på blankt papir og for mobile/fleksibelt formaterede billetter med tilhørende sikkerhedsmodeller."
      },
      {
        "@language": "et",
        "@value": "Piletite liikide ja vormingute kataloog, sealhulgas turvapaberil, tühjal paberil ja mobiili-/paindlikus vormingus pileti küljendused koos seonduvate turvamudelitega."
      },
      {
        "@language": "fi",
        "@value": "Luettelo lippujen tyypeistä ja muodoista, mukaan lukien suojatulle paperille, tyhjälle paperille ja mobiililipulle/joustavasti muotoillulle lipulle tarkoitetut asettelut niihin liittyvine turvamalleineen."
      },
      {
        "@language": "ga",
        "@value": "An chatalóg de chineálacha agus formáidí ticéad, lena n-áirítear na leagain amach ar pháipéar slán, ar pháipéar bán agus do thicéad soghluaiste/formáidithe go solúbtha lena samhlacha slándála gaolmhara."
      },
      {
        "@language": "hr",
        "@value": "Katalog vrsta i formata karata, uključujući izglede na zaštićenom papiru, na praznom papiru i za mobilnu/fleksibilno oblikovanu kartu s povezanim sigurnosnim modelima."
      },
      {
        "@language": "lt",
        "@value": "Bilietų rūšių ir formatų katalogas, įskaitant išdėstymą apsaugotame popieriuje, neužpildytame popieriuje ir mobiliajame/lankstaus formato biliete su susijusiais saugumo modeliais."
      },
      {
        "@language": "mt",
        "@value": "Il-katalgu tat-tipi u tal-formati tal-biljetti, inkluż il-preżentazzjonijiet fuq karta sigura, fuq karta vojta u ta' biljett mobbli/b'format flessibbli bil-mudelli tas-sigurtà assoċjati tagħhom."
      },
      {
        "@language": "sl",
        "@value": "Katalog vrst in oblik vozovnic, vključno s postavitvami na zaščitenem papirju, na praznem papirju in za mobilno/prožno oblikovano vozovnico s povezanimi varnostnimi modeli."
      },
      {
        "@language": "lv",
        "@value": "Biļešu veidu un formātu katalogs, tostarp izkārtojumi uz aizsargāta papīra, uz neaizpildīta papīra un mobilās/elastīgi formatētas biļetes ar saistītajiem drošības modeļiem."
      },
      {
        "@language": "sk",
        "@value": "Katalóg druhov a formátov cestovných lístkov vrátane grafických úprav na zabezpečenom papieri, na nepotlačenom papieri a mobilného/flexibilného cestovného lístka s príslušnými bezpečnostnými modelmi."
      }
    ],
