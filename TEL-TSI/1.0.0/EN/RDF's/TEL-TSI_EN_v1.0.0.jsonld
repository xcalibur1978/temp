  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0021",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_29"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Údaje jízdního řádu ve smyslu čl. 3 bodu 28 směrnice 2012/34/EU, zveřejňované jako otevřená data na základě licence Creative Commons BY-ND 4.0."
      },
      {
        "@language": "en",
        "@value": "The working timetable data as defined in Article 3(28) of Directive 2012/34/EU, published as open data under a Creative Commons BY-ND 4.0 licence."
      },
      {
        "@language": "de",
        "@value": "Netzfahrplandaten im Sinne des Artikels 3 Nummer 28 der Richtlinie 2012/34/EU, die als offene Daten unter einer Creative-Commons-Lizenz BY-ND 4.0 veröffentlicht werden."
      },
      {
        "@language": "fr",
        "@value": "Données de l'horaire de service au sens de l'article 3, point 28, de la directive 2012/34/UE, publiées en tant que données ouvertes sous une licence Creative Commons BY-ND 4.0."
      },
      {
        "@language": "hu",
        "@value": "A 2012/34/EU irányelv 3. cikkének 28. pontja értelmében vett hálózatimenetrend-adatok, amelyeket nyílt adatként, Creative Commons BY-ND 4.0 licenc alapján tesznek közzé."
      },
      {
        "@language": "it",
        "@value": "Dati dell'orario di servizio ai sensi dell'articolo 3, punto 28, della direttiva 2012/34/UE, pubblicati come dati aperti con licenza Creative Commons BY-ND 4.0."
      },
      {
        "@language": "nl",
        "@value": "Dienstregelingsgegevens in de zin van artikel 3, punt 28, van Richtlijn 2012/34/EU, gepubliceerd als open data onder een Creative Commons BY-ND 4.0-licentie."
      },
      {
        "@language": "pl",
        "@value": "Dane obowiązującego rozkładu jazdy w rozumieniu art. 3 pkt 28 dyrektywy 2012/34/UE, publikowane jako dane otwarte na licencji Creative Commons BY-ND 4.0."
      },
      {
        "@language": "pt",
        "@value": "Dados do horário de serviço na aceção do artigo 3.º, ponto 28, da Diretiva 2012/34/UE, publicados como dados abertos ao abrigo de uma licença Creative Commons BY-ND 4.0."
      },
      {
        "@language": "ro",
        "@value": "Datele privind mersul trenurilor în sensul articolului 3 punctul 28 din Directiva 2012/34/UE, publicate ca date deschise în temeiul unei licențe Creative Commons BY-ND 4.0."
      },
      {
        "@language": "sv",
        "@value": "Tågplaneuppgifter i den mening som avses i artikel 3.28 i direktiv 2012/34/EU, offentliggjorda som öppna data enligt en Creative Commons BY-ND 4.0-licens."
      },
      {
        "@language": "es",
        "@value": "Datos del horario de servicio en el sentido del artículo 3, punto 28, de la Directiva 2012/34/UE, publicados como datos abiertos bajo una licencia Creative Commons BY-ND 4.0."
      },
      {
        "@language": "mt",
        "@value": "Data tal-iskeda tas-servizz fis-sens tal-Artikolu 3, punt 28, tad-Direttiva 2012/34/UE, ippubblikata bħala data miftuħa b'liċenzja Creative Commons BY-ND 4.0."
      },
      {
        "@language": "sk",
        "@value": "Údaje cestovného poriadku v zmysle článku 3 bodu 28 smernice 2012/34/EÚ, zverejňované ako otvorené dáta na základe licencie Creative Commons BY-ND 4.0."
      },
      {
        "@language": "sl",
        "@value": "Podatki voznega reda v smislu člena 3, točka 28, Direktive 2012/34/EU, objavljeni kot odprti podatki na podlagi licence Creative Commons BY-ND 4.0."
      },
      {
        "@language": "et",
        "@value": "Sõidugraafiku andmed direktiivi 2012/34/EL artikli 3 punkti 28 tähenduses, mis avaldatakse avaandmetena Creative Commons BY-ND 4.0 litsentsi alusel."
      },
      {
        "@language": "fi",
        "@value": "Direktiivin 2012/34/EU 3 artiklan 28 alakohdassa tarkoitetut aikataulutiedot, jotka julkaistaan avoimena datana Creative Commons BY-ND 4.0 -lisenssillä."
      },
      {
        "@language": "ga",
        "@value": "Sonraí an amchláir seirbhíse de réir bhrí Airteagal 3, pointe 28, de Threoir 2012/34/AE, arna bhfoilsiú mar shonraí oscailte faoi cheadúnas Creative Commons BY-ND 4.0."
      },
      {
        "@language": "hr",
        "@value": "Podaci voznog reda u smislu članka 3. točke 28. Direktive 2012/34/EU, objavljeni kao otvoreni podaci na temelju licencije Creative Commons BY-ND 4.0."
      },
      {
        "@language": "lt",
        "@value": "Tarnybinio tvarkaraščio duomenys, kaip apibrėžta Direktyvos 2012/34/ES 3 straipsnio 28 punkte, skelbiami kaip atvirieji duomenys pagal Creative Commons BY-ND 4.0 licenciją."
      },
      {
        "@language": "lv",
        "@value": "Kustības grafika dati Direktīvas 2012/34/ES 3. panta 28. punkta nozīmē, kas publicēti kā atvērtie dati saskaņā ar Creative Commons BY-ND 4.0 licenci."
      },
      {
        "@language": "bg",
        "@value": "Данни от работния график по смисъла на член 3, точка 28 от Директива 2012/34/ЕС, публикувани като свободно достъпни данни по лиценз Creative Commons BY-ND 4.0."
      },
      {
        "@language": "da",
        "@value": "Køreplansdata som omhandlet i artikel 3, nr. 28), i direktiv 2012/34/EU, offentliggjort som åbne data i henhold til en Creative Commons BY-ND 4.0-licens."
      },
      {
        "@language": "el",
        "@value": "Δεδομένα του πίνακα δρομολογίων λειτουργίας κατά την έννοια του άρθρου 3 σημείο 28 της οδηγίας 2012/34/ΕΕ, που δημοσιεύονται ως ανοικτά δεδομένα βάσει άδειας Creative Commons BY-ND 4.0."
      }
    ],
