  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0088",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_27"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "nl",
        "@value": "De instaplimiet voor reizigers, d.w.z. het tijdstip waarop de toegang tot de trein, het perron of het station wordt gesloten ter voorbereiding van het vertrek."
      },
      {
        "@language": "pl",
        "@value": "Termin wsiadania dla pasażerów, czyli moment, w którym dostęp do pociągu, peronu lub stacji zostaje zamknięty w ramach przygotowania do odjazdu."
      },
      {
        "@language": "pt",
        "@value": "O limite de embarque para os passageiros, ou seja, o momento em que o acesso ao comboio, à plataforma ou à estação é encerrado em preparação da partida."
      },
      {
        "@language": "ro",
        "@value": "Limita de îmbarcare pentru călători, și anume momentul în care accesul la tren, la peron sau în stație este închis în vederea pregătirii plecării."
      },
      {
        "@language": "sv",
        "@value": "Påstigningsgränsen för resenärer, dvs. den tidpunkt då åtkomsten till tåget, plattformen eller stationen stängs som förberedelse inför avgång."
      },
      {
        "@language": "cs",
        "@value": "Časová hranice pro nástup cestujících, tj. okamžik, kdy se přístup k vlaku, na nástupiště nebo do stanice uzavírá v rámci přípravy na odjezd."
      },
      {
        "@language": "de",
        "@value": "Die Einsteigefrist für Fahrgäste, d. h. der Zeitpunkt, zu dem der Zugang zum Zug, zum Bahnsteig oder zum Bahnhof in Vorbereitung der Abfahrt geschlossen wird."
      },
      {
        "@language": "el",
        "@value": "Το όριο επιβίβασης για τους επιβάτες, δηλαδή η χρονική στιγμή κατά την οποία κλείνει η πρόσβαση στο τρένο, στην αποβάθρα ή στον σταθμό για την προετοιμασία της αναχώρησης."
      },
      {
        "@language": "en",
        "@value": "The boarding time limit for passengers, that is the point in time when access to the train, platform or station is closed in preparation for departure."
      },
      {
        "@language": "es",
        "@value": "El límite de embarque para los viajeros, es decir, el momento en que se cierra el acceso al tren, al andén o a la estación en preparación de la salida."
      },
      {
        "@language": "fr",
        "@value": "La limite d'embarquement pour les voyageurs, à savoir le moment où l'accès au train, au quai ou à la gare est fermé en préparation du départ."
      },
      {
        "@language": "hu",
        "@value": "Az utasok beszállási határideje, azaz az az időpont, amikor a vonathoz, a peronhoz vagy az állomáshoz való hozzáférést az indulásra való felkészülés érdekében lezárják."
      },
      {
        "@language": "it",
        "@value": "Il termine di imbarco per i passeggeri, vale a dire il momento in cui l'accesso al treno, al marciapiede o alla stazione è chiuso in preparazione della partenza."
      },
      {
        "@language": "bg",
        "@value": "Крайният срок за качване на пътниците, т.е. моментът, в който достъпът до влака, перона или гарата се затваря в подготовка за заминаването."
      },
      {
        "@language": "da",
        "@value": "Ombordstigningsfristen for passagerer, dvs. det tidspunkt, hvor adgangen til toget, perronen eller stationen lukkes som forberedelse til afgang."
      },
      {
        "@language": "et",
        "@value": "Reisijate pardaleminekupiir, st hetk, mil juurdepääs rongile, perroonile või jaamale suletakse väljumiseks valmistumisel."
      },
      {
        "@language": "ga",
        "@value": "An teorainn bhordála do phaisinéirí, eadhon an nóiméad a ndúntar an rochtain ar an traein, ar an ardán nó ar an stáisiún mar ullmhúchán don imeacht."
      },
      {
        "@language": "hr",
        "@value": "Rok za ukrcaj putnika, tj. trenutak u kojem se pristup vlaku, peronu ili kolodvoru zatvara u sklopu pripreme za polazak."
      },
      {
        "@language": "lt",
        "@value": "Keleivių įlaipinimo riba, t. y. momentas, kai prieiga prie traukinio, perono ar stoties uždaroma rengiantis išvykti."
      },
      {
        "@language": "lv",
        "@value": "Pasažieru iekāpšanas robeža, proti, brīdis, kad piekļuve vilcienam, peronam vai stacijai tiek slēgta, gatavojoties atiešanai."
      },
      {
        "@language": "sk",
        "@value": "Časová hranica pre nástup cestujúcich, t. j. okamih, keď sa prístup k vlaku, na nástupište alebo do stanice uzatvára v rámci prípravy na odchod."
      },
      {
        "@language": "sl",
        "@value": "Rok za vstop potnikov, tj. trenutek, ko se dostop do vlaka, perona ali postaje zapre v okviru priprave na odhod."
      },
      {
        "@language": "fi",
        "@value": "Matkustajien nousun takaraja eli ajankohta, jona pääsy junaan, laiturille tai asemalle suljetaan lähtöön valmistautumista varten."
      },
      {
        "@language": "mt",
        "@value": "Il-limitu tal-imbark għall-passiġġieri, jiġifieri l-mument meta l-aċċess għall-ferrovija, għall-pjattaforma jew għall-istazzjon jingħalaq bħala preparazzjoni għat-tluq."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
