  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0104",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Jednotný identifikátor jakékoli organizace nebo role zapojené do sdílení železničních údajů, přidělovaný agenturou."
      },
      {
        "@language": "en",
        "@value": "Single identifier of any organisation or role involved in rail data sharing, assigned by the Agency."
      },
      {
        "@language": "sv",
        "@value": "Enhetlig identifierare för varje organisation eller roll som deltar i delning av järnvägsdata, tilldelad av byrån."
      },
      {
        "@language": "pt",
        "@value": "Identificador único de qualquer organização ou função envolvida na partilha de dados ferroviários, atribuído pela Agência."
      },
      {
        "@language": "ro",
        "@value": "Identificator unic al oricărei organizații sau al oricărui rol implicat în partajarea datelor feroviare, atribuit de agenție."
      },
      {
        "@language": "de",
        "@value": "Einheitliche Kennung jeder an der Eisenbahndatenfreigabe beteiligten Organisation oder Rolle, die von der Agentur zugewiesen wird."
      },
      {
        "@language": "el",
        "@value": "Μοναδικό αναγνωριστικό κάθε οργανισμού ή ρόλου που συμμετέχει στην ανταλλαγή σιδηροδρομικών δεδομένων, το οποίο εκχωρείται από τον Οργανισμό."
      },
      {
        "@language": "es",
        "@value": "Identificador único de cualquier organización o función que participe en el intercambio de datos ferroviarios, asignado por la Agencia."
      },
      {
        "@language": "fr",
        "@value": "Identifiant unique de toute organisation ou de tout rôle intervenant dans le partage de données ferroviaires, attribué par l'Agence."
      },
      {
        "@language": "hu",
        "@value": "A vasúti adatmegosztásban részt vevő bármely szervezet vagy szerep egyedi azonosítója, amelyet az ügynökség oszt ki."
      },
      {
        "@language": "it",
        "@value": "Identificatore unico di qualsiasi organizzazione o ruolo coinvolto nella condivisione dei dati ferroviari, assegnato dall'Agenzia."
      },
      {
        "@language": "nl",
        "@value": "Unieke identificatie van elke bij de spoorgegevensdeling betrokken organisatie of rol, toegewezen door het Agentschap."
      },
      {
        "@language": "pl",
        "@value": "Pojedynczy identyfikator każdej organizacji lub roli uczestniczącej w udostępnianiu danych kolejowych, przydzielany przez Agencję."
      },
      {
        "@language": "lt",
        "@value": "Bet kurios geležinkelių duomenų dalijimosi procese dalyvaujančios organizacijos ar funkcijos pavienis identifikatorius, kurį priskiria agentūra."
      },
      {
        "@language": "lv",
        "@value": "Jebkuras dzelzceļa datu kopīgošanā iesaistītas organizācijas vai funkcijas vienots identifikators, ko piešķir aģentūra."
      },
      {
        "@language": "mt",
        "@value": "Identifikatur uniku ta' kwalunkwe organizzazzjoni jew rwol involut fil-kondiviżjoni tad-data ferrovjarja, allokat mill-Aġenzija."
      },
      {
        "@language": "sk",
        "@value": "Jednotný identifikátor akejkoľvek organizácie alebo úlohy zapojenej do zdieľania železničných údajov, prideľovaný agentúrou."
      },
      {
        "@language": "sl",
        "@value": "Enotni identifikator katere koli organizacije ali vloge, ki sodeluje pri izmenjavi železniških podatkov, ki ga dodeli agencija."
      },
      {
        "@language": "da",
        "@value": "Entydig identifikator for enhver organisation eller rolle, der er involveret i deling af jernbanedata, tildelt af agenturet."
      },
      {
        "@language": "et",
        "@value": "Raudteeandmete jagamises osaleva mis tahes organisatsiooni või rolli ühtne identifikaator, mille eraldab amet."
      },
      {
        "@language": "fi",
        "@value": "Rautatiedatan jakamiseen osallistuvan minkä tahansa organisaation tai roolin yksilöllinen tunniste, jonka virasto antaa."
      },
      {
        "@language": "ga",
        "@value": "Aitheantóir uathúil aon eagraíochta nó róil atá páirteach i gcomhroinnt sonraí iarnróid, arna leithdháileadh ag an nGníomhaireacht."
      },
      {
        "@language": "hr",
        "@value": "Jedinstveni identifikator svake organizacije ili uloge uključene u dijeljenje željezničkih podataka, koji dodjeljuje Agencija."
      },
      {
        "@language": "bg",
        "@value": "Единен идентификатор на всяка организация или роля, участваща в споделянето на железопътни данни, разпределян от агенцията."
      }
    ],
