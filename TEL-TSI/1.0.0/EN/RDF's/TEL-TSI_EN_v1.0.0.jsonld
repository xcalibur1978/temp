  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0046",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Operational state indicating that a freight wagon is being unloaded."
      },
      {
        "@language": "cs",
        "@value": "Provozní stav označující, že nákladní vůz je vykládán."
      },
      {
        "@language": "de",
        "@value": "Betriebszustand, der angibt, dass ein Güterwagen entladen wird."
      },
      {
        "@language": "el",
        "@value": "Επιχειρησιακή κατάσταση που υποδεικνύει ότι ένα εμπορευματικό βαγόνι εκφορτώνεται."
      },
      {
        "@language": "es",
        "@value": "Estado operativo que indica que un vagón de mercancías está siendo descargado."
      },
      {
        "@language": "fr",
        "@value": "État opérationnel indiquant qu'un wagon de fret est en cours de déchargement."
      },
      {
        "@language": "hu",
        "@value": "Működési állapot, amely azt jelzi, hogy egy tehervagont kiraknak."
      },
      {
        "@language": "it",
        "@value": "Stato operativo che indica che un carro merci è in fase di scarico."
      },
      {
        "@language": "nl",
        "@value": "Operationele toestand die aangeeft dat een goederenwagen wordt gelost."
      },
      {
        "@language": "pl",
        "@value": "Stan operacyjny wskazujący, że wagon towarowy jest rozładowywany."
      },
      {
        "@language": "pt",
        "@value": "Estado operacional que indica que um vagão de mercadorias está a ser descarregado."
      },
      {
        "@language": "ro",
        "@value": "Stare operațională care indică faptul că un vagon de marfă este în curs de descărcare."
      },
      {
        "@language": "sv",
        "@value": "Operativt tillstånd som anger att en godsvagn lossas."
      },
      {
        "@language": "bg",
        "@value": "Оперативно състояние, с което се обозначава, че товарен вагон се разтоварва."
      },
      {
        "@language": "da",
        "@value": "Operationel tilstand, der angiver, at en godsvogn er ved at blive aflæsset."
      },
      {
        "@language": "et",
        "@value": "Operatiivseisund, mis näitab, et kaubavagunit laaditakse maha."
      },
      {
        "@language": "fi",
        "@value": "Operatiivinen tila, joka ilmaisee, että tavaravaunua puretaan."
      },
      {
        "@language": "ga",
        "@value": "Staid oibríochtúil lena gcuirtear in iúl go bhfuil vaigín lasta á dhílódáil."
      },
      {
        "@language": "hr",
        "@value": "Operativno stanje kojim se označava da se teretni vagon istovaruje."
      },
      {
        "@language": "lt",
        "@value": "Veiklos būsena, kuria nurodoma, kad prekinis vagonas iškraunamas."
      },
      {
        "@language": "lv",
        "@value": "Operatīvais stāvoklis, ar kuru norāda, ka kravas vagonu izkrauj."
      },
      {
        "@language": "mt",
        "@value": "Stat operazzjonali li jindika li vagun tal-merkanzija qiegħed jinħatt."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkový stav označujúci, že nákladný vozeň sa vykladá."
      },
      {
        "@language": "sl",
        "@value": "Operativno stanje, ki označuje, da se tovorni vagon razklada."
      }
    ],
