  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0097",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_19"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "de",
        "@value": "Metadaten im Sinne des Artikels 2 Nummer 2 der Verordnung (EU) 2023/2854 (Datengesetz)."
      },
      {
        "@language": "en",
        "@value": "Metadata within the meaning of Article 2(2) of Regulation (EU) 2023/2854 (Data Act)."
      },
      {
        "@language": "cs",
        "@value": "Metadata ve smyslu čl. 2 bodu 2) nařízení (EU) 2023/2854 (akt o datech)."
      },
      {
        "@language": "es",
        "@value": "Metadatos en el sentido del artículo 2, punto 2, del Reglamento (UE) 2023/2854 (Reglamento de Datos)."
      },
      {
        "@language": "hu",
        "@value": "Az (EU) 2023/2854 rendelet (adatmegosztási rendelet) 2. cikkének 2. pontja értelmében vett metaadatok."
      },
      {
        "@language": "nl",
        "@value": "Metagegevens in de zin van artikel 2, punt 2, van Verordening (EU) 2023/2854 (Datawet)."
      },
      {
        "@language": "pl",
        "@value": "Metadane w rozumieniu art. 2 pkt 2 rozporządzenia (UE) 2023/2854 (akt w sprawie danych)."
      },
      {
        "@language": "pt",
        "@value": "Metadados na aceção do artigo 2.º, ponto 2), do Regulamento (UE) 2023/2854 (Regulamento Dados)."
      },
      {
        "@language": "ro",
        "@value": "Metadate în sensul articolului 2 punctul 2) din Regulamentul (UE) 2023/2854 (Regulamentul privind datele)."
      },
      {
        "@language": "sv",
        "@value": "Metadata i den mening som avses i artikel 2.2 i förordning (EU) 2023/2854 (dataförordningen)."
      },
      {
        "@language": "fr",
        "@value": "Métadonnées au sens de l'article 2, point 2), du règlement (UE) 2023/2854 (règlement sur les données)."
      },
      {
        "@language": "it",
        "@value": "Metadati ai sensi dell'articolo 2, punto 2), del regolamento (UE) 2023/2854 (regolamento sui dati)."
      },
      {
        "@language": "el",
        "@value": "Μεταδεδομένα κατά την έννοια του άρθρου 2 σημείο 2) του κανονισμού (ΕΕ) 2023/2854 (πράξη για τα δεδομένα)."
      },
      {
        "@language": "bg",
        "@value": "Метаданни по смисъла на член 2, точка 2) от Регламент (ЕС) 2023/2854 (Акт за данните)."
      },
      {
        "@language": "da",
        "@value": "Metadata som omhandlet i artikel 2, nr. 2), i forordning (EU) 2023/2854 (dataforordningen)."
      },
      {
        "@language": "et",
        "@value": "Metaandmed määruse (EL) 2023/2854 (andmemäärus) artikli 2 punkti 2 tähenduses."
      },
      {
        "@language": "fi",
