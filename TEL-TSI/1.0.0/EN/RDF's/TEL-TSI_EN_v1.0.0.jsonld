  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0042",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Operational databases recording the operational states of freight wagons and intermodal loading units across their movement."
      },
      {
        "@language": "es",
        "@value": "Bases de datos operativas que registran los estados operativos de los vagones de mercancías y las unidades de carga intermodal a lo largo de su movimiento."
      },
      {
        "@language": "it",
        "@value": "Banche dati operative che registrano gli stati operativi dei carri merci e delle unità di carico intermodale lungo il loro movimento."
      },
      {
        "@language": "pt",
        "@value": "Bases de dados operacionais que registam os estados operacionais dos vagões de mercadorias e das unidades de carga intermodal ao longo do seu movimento."
      },
      {
        "@language": "ro",
        "@value": "Baze de date operaționale care înregistrează stările operaționale ale vagoanelor de marfă și ale unităților de încărcare intermodală pe parcursul mișcării lor."
      },
      {
        "@language": "sv",
        "@value": "Operativa databaser som registrerar de operativa tillstånden för godsvagnar och intermodala lastenheter under hela deras förflyttning."
      },
      {
        "@language": "cs",
        "@value": "Provozní databáze zaznamenávající provozní stavy nákladních vozů a intermodálních nákladových jednotek v průběhu jejich pohybu."
      },
      {
        "@language": "nl",
        "@value": "Operationele databanken die de operationele toestanden van goederenwagens en intermodale laadeenheden gedurende hun beweging registreren."
      },
      {
        "@language": "pl",
        "@value": "Operacyjne bazy danych rejestrujące stany operacyjne wagonów towarowych i intermodalnych jednostek ładunkowych w trakcie ich ruchu."
      },
      {
        "@language": "de",
        "@value": "Betriebsdatenbanken zur Erfassung der Betriebszustände von Güterwagen und intermodalen Ladeeinheiten während ihrer Bewegung."
      },
      {
        "@language": "sk",
        "@value": "Prevádzkové databázy zaznamenávajúce prevádzkové stavy nákladných vozňov a intermodálnych nákladových jednotiek počas ich pohybu."
      },
      {
        "@language": "sl",
        "@value": "Operativne podatkovne zbirke, ki beležijo operativna stanja tovornih vagonov in intermodalnih nakladalnih enot med njihovim gibanjem."
      },
      {
        "@language": "bg",
        "@value": "Оперативни бази данни, в които се записват оперативните състояния на товарните вагони и интермодалните товарни единици през цялото им движение."
      },
      {
        "@language": "lt",
        "@value": "Veiklos duomenų bazės, kuriose registruojamos prekinių vagonų ir įvairiarūšio krovimo vienetų veiklos būsenos per visą jų judėjimą."
      },
      {
        "@language": "lv",
        "@value": "Operatīvās datubāzes, kurās reģistrē kravas vagonu un intermodālo kravas vienību operatīvos stāvokļus visā to kustības laikā."
      },
      {
        "@language": "mt",
        "@value": "Bażijiet tad-data operazzjonali li jirreġistraw l-istati operazzjonali tal-vaguni tal-merkanzija u tal-unitajiet tat-tagħbija intermodali matul il-moviment tagħhom."
      },
      {
        "@language": "el",
        "@value": "Επιχειρησιακές βάσεις δεδομένων που καταγράφουν τις επιχειρησιακές καταστάσεις των εμπορευματικών βαγονιών και των μονάδων διατροπικής φόρτωσης καθ' όλη τη διάρκεια της κίνησής τους."
      },
      {
        "@language": "da",
        "@value": "Operationelle databaser, der registrerer de operationelle tilstande for godsvogne og intermodale lastenheder i hele deres bevægelse."
      },
      {
        "@language": "fi",
        "@value": "Operatiiviset tietokannat, joihin kirjataan tavaravaunujen ja intermodaalisten kuormausyksiköiden operatiiviset tilat niiden koko liikkumisen ajan."
      },
      {
        "@language": "fr",
        "@value": "Bases de données opérationnelles enregistrant les états opérationnels des wagons de fret et des unités de chargement intermodal tout au long de leur mouvement."
      },
      {
        "@language": "ga",
        "@value": "Bunachair sonraí oibríochtúla lena dtaifeadtar staideanna oibríochtúla na vaigíní lasta agus na n-aonad lódála idirmhódúil le linn a ngluaiseachta."
      },
      {
        "@language": "hr",
        "@value": "Operativne baze podataka u kojima se bilježe operativna stanja teretnih vagona i intermodalnih utovarnih jedinica tijekom njihova kretanja."
      },
      {
        "@language": "et",
        "@value": "Operatiivandmebaasid, milles registreeritakse kaubavagunite ja intermodaalsete laadimisüksuste operatiivseisundid kogu nende liikumise jooksul."
      },
      {
        "@language": "hu",
        "@value": "Működési adatbázisok, amelyek a tehervagonok és az intermodális rakományegységek működési állapotait rögzítik mozgásuk során."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
