  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0024",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący informacje o jeździe wagonu towarowego w całym cyklu jego ruchu; rozłożony na poszczególne zdarzenia wagonu określone w załączniku."
      },
      {
        "@language": "en",
        "@value": "Message conveying running information about a freight wagon across its movement life cycle; decomposed into the individual wagon events specified in the Annex."
      },
      {
        "@language": "cs",
        "@value": "Zpráva předávající informace o jízdě nákladního vozu v průběhu jeho pohybového cyklu; rozčleněná na jednotlivé události vozu stanovené v příloze."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung von Lauf­informationen über einen Güterwagen während seines Bewegungslebenszyklus; aufgegliedert in die einzelnen im Anhang festgelegten Wagenereignisse."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει πληροφορίες κυκλοφορίας σχετικά με ένα εμπορευματικό βαγόνι καθ' όλη τη διάρκεια του κύκλου κίνησής του· αναλύεται στα επιμέρους συμβάντα βαγονιού που καθορίζονται στο παράρτημα."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la información de circulación de un vagón de mercancías a lo largo de su ciclo de movimiento; desglosado en los distintos eventos del vagón definidos en el anexo."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant les informations sur la circulation d'un wagon de fret tout au long de son cycle de mouvement; décomposé en événements de wagon distincts définis à l'annexe."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely egy tehervagon közlekedési információit továbbítja annak mozgási életciklusa során; a mellékletben meghatározott egyedi kocsieseményekre bontva."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette le informazioni sulla circolazione di un carro merci lungo il suo ciclo di movimento; scomposto nei singoli eventi del carro definiti nell'allegato."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat loopinformatie over een goederenwagen doorgeeft gedurende zijn bewegingslevenscyclus; uitgesplitst in de afzonderlijke in de bijlage vastgestelde wagengebeurtenissen."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite as informações sobre a circulação de um vagão de mercadorias ao longo do seu ciclo de movimento; decomposta nos eventos de vagão individuais definidos no anexo."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite informațiile privind circulația unui vagon de marfă pe parcursul ciclului său de mișcare; descompus în evenimentele de vagon individuale definite în anexă."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför föringsinformation om en godsvagn under hela dess rörelsecykel; uppdelat i de enskilda vagnhändelser som fastställs i bilagan."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава информацията за движението на товарен вагон през целия му цикъл на движение; разбито на отделните събития на вагона, определени в приложението."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører driftsoplysninger om en godsvogn i hele dens bevægelsescyklus; opdelt i de enkelte vognhændelser, der er fastsat i bilaget."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse kaubavaguni liiklusteave kogu selle liikumistsükli jooksul; jaotatud lisas sätestatud üksikuteks vagunisündmusteks."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään tavaravaunun liikennöintitiedot sen koko liikkumissyklin ajan; eritelty liitteessä vahvistettuihin yksittäisiin vaunutapahtumiin."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar faisnéis faoi ghluaiseacht vaigín lasta a tharchur le linn a thimthrialla gluaiseachta; arna mhiondealú sna teagmhais aonair vaigín a shocraítear san Iarscríbhinn."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenose informacije o vožnji teretnog vagona tijekom njegova ciklusa kretanja; razrađena na pojedinačne događaje vagona utvrđene u Prilogu."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodama prekinio vagono eismo informacija per visą jo judėjimo ciklą; suskaidytas į atskirus priede nustatytus vagono įvykius."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod kravas vagona kustības informāciju visā tā kustības ciklā; sadalīts atsevišķos vagona notikumos, kas noteikti pielikumā."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti l-informazzjoni dwar il-moviment ta' vagun tal-merkanzija matul iċ-ċiklu tal-moviment tiegħu; maqsum fl-avvenimenti individwali tal-vagun stabbiliti fl-Anness."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca informácie o jazde nákladného vozňa počas jeho pohybového cyklu; rozčlenená na jednotlivé udalosti vozňa stanovené v prílohe."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje informacije o vožnji tovornega vagona med njegovim celotnim ciklom gibanja; razčlenjeno na posamezne dogodke vagona, določene v Prilogi."
      }
    ],
