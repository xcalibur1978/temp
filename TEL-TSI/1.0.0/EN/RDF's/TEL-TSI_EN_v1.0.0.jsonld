  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0022",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sv",
        "@value": "Bevarad registrering (minst 12 månader) av tåguppgifter, innehållande tågplanen, identifieraren för referenståget, det kommersiella tågnumret, rapporteringsplatserna, de faktiska tiderna, förseningen och dess orsak samt tågsammansättningen."
      },
      {
        "@language": "el",
        "@value": "Διατηρούμενο αρχείο (τουλάχιστον 12 μηνών) δεδομένων τρένου, που περιέχει τον πίνακα δρομολογίων λειτουργίας, το αναγνωριστικό τρένου αναφοράς, τον εμπορικό αριθμό τρένου, τις τοποθεσίες αναφοράς, τις πραγματικές ώρες, την καθυστέρηση και την αιτία της, καθώς και τη σύνθεση του τρένου."
      },
      {
        "@language": "en",
        "@value": "Retained record (at least 12 months) of train data, containing the working timetable, reference train identifier, commercial train number, reporting locations, actual times, delay and delay cause, and train composition."
      },
      {
        "@language": "cs",
        "@value": "Uchovávaný záznam (nejméně 12 měsíců) údajů o vlaku, obsahující jízdní řád, identifikátor referenčního vlaku, komerční číslo vlaku, místa hlášení, skutečné časy, zpoždění a jeho příčinu, jakož i řazení vlaku."
      },
      {
        "@language": "de",
        "@value": "Aufbewahrte Aufzeichnung (mindestens 12 Monate) von Zugdaten, die den Netzfahrplan, die Referenzzugkennung, die kommerzielle Zugnummer, die Meldeorte, die Ist-Zeiten, die Verspätung und die Verspätungsursache sowie die Zugbildung enthält."
      },
      {
        "@language": "es",
        "@value": "Registro conservado (al menos 12 meses) de los datos del tren, que contiene el horario de servicio, el identificador de tren de referencia, el número de tren comercial, los lugares de notificación, las horas reales, el retraso y su causa, así como la composición del tren."
      },
      {
        "@language": "fr",
        "@value": "Enregistrement conservé (au moins 12 mois) des données de train, contenant l'horaire de service, l'identifiant de train de référence, le numéro de train commercial, les lieux de signalement, les heures réelles, le retard et sa cause ainsi que la composition du train."
      },
      {
        "@language": "hu",
        "@value": "A vonatadatok megőrzött nyilvántartása (legalább 12 hónap), amely tartalmazza a hálózati menetrendet, a referenciavonat-azonosítót, a kereskedelmi vonatszámot, a jelentési helyeket, a tényleges időpontokat, a késést és annak okát, valamint a vonatösszeállítást."
      },
      {
        "@language": "it",
        "@value": "Registrazione conservata (almeno 12 mesi) dei dati del treno, contenente l'orario di servizio, l'identificativo del treno di riferimento, il numero di treno commerciale, i luoghi di segnalazione, gli orari effettivi, il ritardo e la sua causa nonché la composizione del treno."
      },
      {
        "@language": "nl",
        "@value": "Bewaarde registratie (ten minste 12 maanden) van treingegevens, met de dienstregeling, de referentietreinidentificatie, het commerciële treinnummer, de meldlocaties, de werkelijke tijden, de vertraging en de vertragingsoorzaak alsmede de treinsamenstelling."
      },
      {
        "@language": "pl",
        "@value": "Przechowywany zapis (co najmniej 12 miesięcy) danych pociągu, zawierający obowiązujący rozkład jazdy, identyfikator pociągu referencyjnego, handlowy numer pociągu, miejsca raportowania, rzeczywiste czasy, opóźnienie i jego przyczynę oraz zestawienie pociągu."
      },
      {
        "@language": "pt",
        "@value": "Registo conservado (pelo menos 12 meses) dos dados do comboio, contendo o horário de serviço, o identificador do comboio de referência, o número comercial do comboio, os locais de notificação, as horas reais, o atraso e a sua causa, bem como a composição do comboio."
      },
      {
        "@language": "ro",
        "@value": "Înregistrare păstrată (cel puțin 12 luni) a datelor privind trenul, care conține mersul trenurilor, identificatorul trenului de referință, numărul comercial al trenului, locurile de raportare, orele reale, întârzierea și cauza acesteia, precum și compunerea trenului."
      },
      {
        "@language": "bg",
        "@value": "Съхраняван запис (най-малко 12 месеца) на данните за влака, съдържащ работния график, идентификатора на референтния влак, търговския номер на влака, местата за докладване, действителните часове, закъснението и неговата причина, както и състава на влака."
      },
      {
        "@language": "da",
        "@value": "Opbevaret registrering (mindst 12 måneder) af togdata, der indeholder køreplanen, identifikatoren for referencetoget, det kommercielle tognummer, rapporteringsstederne, de faktiske tidspunkter, forsinkelsen og dens årsag samt togsammensætningen."
      },
      {
        "@language": "et",
        "@value": "Säilitatud registreering (vähemalt 12 kuud) rongiandmetest, mis sisaldab sõidugraafikut, võrdlusrongi identifikaatorit, kommertsrongi numbrit, aruandluskohti, tegelikke aegu, hilinemist ja selle põhjust ning rongi koosseisu."
      },
      {
        "@language": "fi",
        "@value": "Säilytetty tallenne (vähintään 12 kuukautta) junatiedoista, joka sisältää aikataulun, viitejunan tunnisteen, kaupallisen junanumeron, raportointipaikat, todelliset ajat, myöhästymisen ja sen syyn sekä junan kokoonpanon."
      },
      {
        "@language": "ga",
        "@value": "Taifead arna choinneáil (12 mhí ar a laghad) ar shonraí na traenach, lena n-áirítear an t-amchlár seirbhíse, an t-aitheantóir traenach tagartha, uimhir thráchtála na traenach, na háiteanna tuairiscithe, na hamanna iarbhír, an mhoill agus a cúis, chomh maith le comhdhéanamh na traenach."
      },
      {
        "@language": "hr",
        "@value": "Pohranjena evidencija (najmanje 12 mjeseci) podataka o vlaku, koja sadržava vozni red, identifikator referentnog vlaka, komercijalni broj vlaka, mjesta izvješćivanja, stvarna vremena, kašnjenje i njegov uzrok te sastav vlaka."
      },
      {
        "@language": "lt",
        "@value": "Saugomas traukinio duomenų įrašas (ne trumpiau kaip 12 mėnesių), kuriame pateikiamas tarnybinis tvarkaraštis, etaloninio traukinio identifikatorius, komercinis traukinio numeris, ataskaitų teikimo vietos, faktinis laikas, vėlavimas ir jo priežastis bei traukinio sąstatas."
      },
      {
        "@language": "lv",
        "@value": "Saglabāts vilciena datu ieraksts (vismaz 12 mēneši), kas ietver kustības grafiku, atsauces vilciena identifikatoru, vilciena komerciālo numuru, ziņošanas vietas, faktiskos laikus, kavējumu un tā cēloni, kā arī vilciena sastāvu."
      },
      {
        "@language": "mt",
        "@value": "Reġistru miżmum (mill-inqas 12-il xahar) tad-data tal-ferrovija, li jkun fih l-iskeda tas-servizz, l-identifikatur tal-ferrovija ta' referenza, in-numru kummerċjali tal-ferrovija, il-postijiet ta' rappurtar, il-ħinijiet reali, id-dewmien u l-kawża tiegħu, kif ukoll il-kompożizzjoni tal-ferrovija."
      },
      {
        "@language": "sk",
        "@value": "Uchovávaný záznam (najmenej 12 mesiacov) údajov o vlaku, obsahujúci cestovný poriadok, identifikátor referenčného vlaku, komerčné číslo vlaku, miesta ohlasovania, skutočné časy, meškanie a jeho príčinu, ako aj radenie vlaku."
      },
      {
        "@language": "sl",
        "@value": "Hranjeni zapis (najmanj 12 mesecev) podatkov o vlaku, ki vsebuje vozni red, identifikator referenčnega vlaka, komercialno številko vlaka, mesta poročanja, dejanske čase, zamudo in njen vzrok ter sestavo vlaka."
      }
    ],
