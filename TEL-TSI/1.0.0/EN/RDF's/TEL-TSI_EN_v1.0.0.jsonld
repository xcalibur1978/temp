  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0033",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger en godsvagns avgång från en mellanliggande plats."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující odjezd nákladního vozu z mezilehlého místa."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das die Abfahrt eines Güterwagens von einem Zwischenort angibt."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει την αναχώρηση ενός εμπορευματικού βαγονιού από ενδιάμεση τοποθεσία."
      },
      {
        "@language": "en",
        "@value": "Wagon event indicating departure of a freight wagon from an intermediate location."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica la salida de un vagón de mercancías desde un lugar intermedio."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant le départ d'un wagon de fret d'un lieu intermédiaire."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon köztes helyről való indulását jelzi."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica la partenza di un carro merci da un luogo intermedio."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die het vertrek van een goederenwagen vanaf een tussenlocatie aangeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące odjazd wagonu towarowego z miejsca pośredniego."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica a partida de um vagão de mercadorias de um local intermédio."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică plecarea unui vagon de marfă de la o locație intermediară."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава заминаването на товарен вагон от междинно място."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver en godsvogns afgang fra et mellemliggende sted."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab kaubavaguni väljumist vahekohast."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee tavaravaunun lähdön välipaikasta."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl imeacht vaigín lasta ó áit idirmheánach."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava polazak teretnog vagona s međulokacije."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodomas prekinio vagono išvykimas iš tarpinės vietos."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda kravas vagona atiešanu no starpvietas."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika t-tluq ta' vagun tal-merkanzija minn post intermedju."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca odchod nákladného vozňa z medziľahlého miesta."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje odhod tovornega vagona z vmesne lokacije."
      }
    ],
