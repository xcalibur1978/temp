  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0090",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_12"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A natural or legal person that has the right to use or an obligation to produce and make available data."
      },
      {
        "@language": "sv",
        "@value": "En fysisk eller juridisk person som har rätt att använda eller skyldighet att framställa och tillgängliggöra data."
      },
      {
        "@language": "de",
        "@value": "Eine natürliche oder juristische Person, die das Recht hat, Daten zu nutzen, oder die Pflicht hat, Daten zu erzeugen und bereitzustellen."
      },
      {
        "@language": "es",
        "@value": "Persona física o jurídica que tiene el derecho de utilizar o la obligación de producir y poner a disposición datos."
      },
      {
        "@language": "fr",
        "@value": "Personne physique ou morale qui a le droit d'utiliser ou l'obligation de produire et de mettre à disposition des données."
      },
      {
        "@language": "hu",
        "@value": "Olyan természetes vagy jogi személy, amely jogosult az adatok felhasználására, vagy köteles az adatok előállítására és rendelkezésre bocsátására."
      },
      {
        "@language": "it",
        "@value": "Persona fisica o giuridica che ha il diritto di utilizzare o l'obbligo di produrre e mettere a disposizione i dati."
      },
      {
        "@language": "nl",
        "@value": "Een natuurlijke of rechtspersoon die het recht heeft gegevens te gebruiken of de verplichting heeft gegevens te produceren en beschikbaar te stellen."
      },
      {
        "@language": "pl",
        "@value": "Osoba fizyczna lub prawna, która ma prawo do wykorzystywania danych lub obowiązek ich wytwarzania i udostępniania."
      },
      {
        "@language": "pt",
        "@value": "Pessoa singular ou coletiva que tem o direito de utilizar ou a obrigação de produzir e disponibilizar dados."
      },
      {
        "@language": "ro",
        "@value": "Persoană fizică sau juridică care are dreptul de a utiliza sau obligația de a produce și de a pune la dispoziție date."
      },
      {
        "@language": "bg",
        "@value": "Физическо или юридическо лице, което има право да използва или задължение да създава и предоставя данни."
      },
      {
        "@language": "cs",
        "@value": "Fyzická nebo právnická osoba, která má právo údaje využívat nebo povinnost údaje vytvářet a zpřístupňovat."
      },
      {
        "@language": "da",
        "@value": "En fysisk eller juridisk person, der har ret til at anvende eller pligt til at producere og stille data til rådighed."
      },
      {
        "@language": "el",
        "@value": "Φυσικό ή νομικό πρόσωπο που έχει το δικαίωμα να χρησιμοποιεί ή την υποχρέωση να παράγει και να καθιστά διαθέσιμα δεδομένα."
      },
      {
        "@language": "et",
        "@value": "Füüsiline või juriidiline isik, kellel on õigus kasutada andmeid või kohustus andmeid luua ja kättesaadavaks teha."
      },
      {
        "@language": "fi",
        "@value": "Luonnollinen henkilö tai oikeushenkilö, jolla on oikeus käyttää dataa tai velvollisuus tuottaa ja asettaa saataville dataa."
      },
      {
        "@language": "ga",
        "@value": "Duine nádúrtha nó dlítheanach a bhfuil an ceart aige sonraí a úsáid nó an oibleagáid air sonraí a tháirgeadh agus a chur ar fáil."
      },
      {
        "@language": "hr",
        "@value": "Fizička ili pravna osoba koja ima pravo upotrebljavati podatke ili obvezu izrađivati i stavljati na raspolaganje podatke."
      },
      {
        "@language": "lt",
        "@value": "Fizinis arba juridinis asmuo, turintis teisę naudoti duomenis arba pareigą juos rengti ir teikti."
      },
      {
        "@language": "lv",
        "@value": "Fiziska vai juridiska persona, kurai ir tiesības izmantot datus vai pienākums tos sagatavot un darīt pieejamus."
      },
      {
        "@language": "mt",
        "@value": "Persuna fiżika jew ġuridika li jkollha d-dritt li tuża jew l-obbligu li tipproduċi u tqiegħed għad-dispożizzjoni d-data."
      },
      {
        "@language": "sl",
        "@value": "Fizična ali pravna oseba, ki ima pravico do uporabe ali obveznost ustvarjanja in dajanja na voljo podatkov."
      },
      {
        "@language": "sk",
        "@value": "Fyzická alebo právnická osoba, ktorá má právo údaje využívať alebo povinnosť údaje vytvárať a sprístupňovať."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
