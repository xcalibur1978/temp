  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0019",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message conveying the cause of a train delay."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der Ursache einer Zugverspätung."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει την αιτία μιας καθυστέρησης τρένου."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la causa de un retraso del tren."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant la cause d'un retard de train."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely továbbítja egy vonatkésés okát."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette la causa di un ritardo del treno."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat de oorzaak van een treinvertraging doorgeeft."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący przyczynę opóźnienia pociągu."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite a causa de um atraso do comboio."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite cauza unei întârzieri a trenului."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför orsaken till en tågförsening."
      },
      {
        "@language": "cs",
        "@value": "Zpráva předávající příčinu zpoždění vlaku."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава причината за закъснение на влак."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører årsagen til en togforsinkelse."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse rongi hilinemise põhjus."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään junan myöhästymisen syy."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar cúis mhoill traenach a tharchur."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenosi uzrok kašnjenja vlaka."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodama traukinio vėlavimo priežastis."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod vilciena kavējuma cēloni."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti l-kawża ta' dewmien tal-ferrovija."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca príčinu meškania vlaku."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje vzrok zamude vlaka."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
