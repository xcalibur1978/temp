[
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0027",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event conveying the geographic position of a freight wagon."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che trasmette la posizione geografica di un carro merci."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon transmettant la position géographique d'un wagon de fret."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que transmite la posición geográfica de un vagón de mercancías."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon földrajzi helyzetét továbbítja."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu předávající zeměpisnou polohu nákladního vozu."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis zur Übermittlung der geografischen Position eines Güterwagens."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που διαβιβάζει τη γεωγραφική θέση ενός εμπορευματικού βαγονιού."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die de geografische positie van een goederenwagen doorgeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu przekazujące położenie geograficzne wagonu towarowego."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que transmite a posição geográfica de um vagão de mercadorias."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care transmite poziția geografică a unui vagon de marfă."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som överför en godsvagns geografiska position."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се предава географското положение на товарен вагон."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der overfører en godsvogns geografiske position."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, millega edastatakse kaubavaguni geograafiline asukoht."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, jolla välitetään tavaravaunun maantieteellinen sijainti."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena ndéantar suíomh geografach vaigín lasta a tharchur."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se prenosi zemljopisni položaj teretnog vagona."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo perduodama prekinio vagono geografinė padėtis."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru nodod kravas vagona ģeogrāfisko atrašanās vietu."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jittrażmetti l-pożizzjoni ġeografika ta' vagun tal-merkanzija."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa prenášajúca geografickú polohu nákladného vozňa."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki posreduje geografski položaj tovornega vagona."
      }
    ],
