  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0085",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_21"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "fr",
        "@value": "Service de transport ferroviaire pouvant comporter des arrêts commerciaux intermédiaires entre son origine et sa destination, mais n'impliquant aucun transbordement de voyageurs ou de marchandises entre trains."
      },
      {
        "@language": "en",
        "@value": "A rail transport service that may include intermediate commercial stops between its origin and destination but does not involve any transfer of passengers or freight between trains."
      },
      {
        "@language": "cs",
        "@value": "Služba železniční dopravy, která může mezi svým výchozím a cílovým bodem zahrnovat mezilehlé komerční zastávky, avšak nezahrnuje žádné přestupování cestujících ani překládku zboží mezi vlaky."
      },
      {
        "@language": "de",
        "@value": "Ein Schienenverkehrsdienst, der zwischen seinem Ursprung und seinem Bestimmungsort kommerzielle Zwischenhalte umfassen kann, jedoch keinen Umstieg von Fahrgästen oder Umschlag von Gütern zwischen Zügen beinhaltet."
      },
      {
        "@language": "el",
        "@value": "Υπηρεσία σιδηροδρομικής μεταφοράς που μπορεί να περιλαμβάνει ενδιάμεσες εμπορικές στάσεις μεταξύ της αφετηρίας και του προορισμού της, αλλά δεν συνεπάγεται καμία μετεπιβίβαση επιβατών ή μεταφόρτωση εμπορευμάτων μεταξύ τρένων."
      },
      {
        "@language": "es",
        "@value": "Servicio de transporte ferroviario que puede incluir paradas comerciales intermedias entre su origen y su destino, pero que no implica ningún transbordo de viajeros o mercancías entre trenes."
      },
      {
        "@language": "it",
        "@value": "Servizio di trasporto ferroviario che può comprendere fermate commerciali intermedie tra l'origine e la destinazione, ma che non comporta alcun trasbordo di passeggeri o merci tra treni."
      },
      {
        "@language": "nl",
        "@value": "Een spoorvervoersdienst die tussen herkomst en bestemming commerciële tussenstops kan omvatten, maar geen overstap van reizigers of overslag van goederen tussen treinen inhoudt."
      },
      {
        "@language": "pl",
        "@value": "Przewóz kolejowy, który może obejmować pośrednie postoje handlowe między miejscem początkowym a miejscem docelowym, lecz nie wiąże się z żadnym przeniesieniem pasażerów lub towarów między pociągami."
      },
      {
        "@language": "pt",
        "@value": "Serviço de transporte ferroviário que pode incluir paragens comerciais intermédias entre a origem e o destino, mas que não implica qualquer transbordo de passageiros ou mercadorias entre comboios."
      },
      {
        "@language": "ro",
        "@value": "Serviciu de transport feroviar care poate include opriri comerciale intermediare între originea și destinația sa, dar care nu implică niciun transbordare de călători sau mărfuri între trenuri."
      },
      {
        "@language": "sv",
        "@value": "En järnvägstransporttjänst som mellan sitt ursprung och sin destination kan omfatta mellanliggande kommersiella stopp men som inte innebär någon omstigning av resenärer eller omlastning av gods mellan tåg."
      },
      {
        "@language": "hu",
        "@value": "Olyan vasúti szállítási szolgáltatás, amely a kiindulási és a célállomása között közbenső kereskedelmi megállókat foglalhat magában, de nem jár az utasok átszállásával vagy az áruk vonatok közötti átrakodásával."
      },
      {
        "@language": "bg",
        "@value": "Услуга за железопътен превоз, която между своя пункт на произход и своето местоназначение може да включва междинни търговски спирки, но която не включва прехвърляне на пътници или претоварване на товари между влакове."
      },
      {
        "@language": "da",
        "@value": "En jernbanetransporttjeneste, der mellem sin oprindelse og sit bestemmelsessted kan omfatte mellemliggende kommercielle stop, men som ikke indebærer omstigning af passagerer eller omladning af gods mellem tog."
      },
      {
        "@language": "et",
        "@value": "Raudteeveoteenus, mis võib oma lähte- ja sihtkoha vahel hõlmata vahepealseid kommertspeatusi, kuid mis ei hõlma reisijate ümberistumist ega kaupade ümberlaadimist rongide vahel."
      },
      {
        "@language": "fi",
        "@value": "Rautatiekuljetuspalvelu, johon voi sisältyä kaupallisia välipysähdyksiä sen lähtö- ja määräpaikan välillä mutta johon ei liity matkustajien vaihtoa tai tavaroiden uudelleenlastausta junien välillä."
      },
      {
        "@language": "ga",
        "@value": "Seirbhís iompair iarnróid a fhéadfaidh stadanna tráchtála idirmheánacha a áireamh idir a tionscnamh agus a ceann scríbe, ach nach mbaineann aon aistriú paisinéirí nó athlódáil earraí idir traenacha léi."
      },
      {
        "@language": "hr",
        "@value": "Usluga željezničkog prijevoza koja između svojeg polazišta i odredišta može uključivati međustanične komercijalne stajališta, ali koja ne uključuje nikakvo presjedanje putnika ni pretovar robe između vlakova."
      },
      {
        "@language": "lt",
        "@value": "Geležinkelių vežimo paslauga, kuri tarp savo kilmės ir paskirties vietos gali apimti tarpinius komercinius sustojimus, bet kuri neapima keleivių persėdimo ar krovinių perkrovimo iš vieno traukinio į kitą."
      },
      {
        "@language": "mt",
        "@value": "Servizz tat-trasport ferrovjarju li bejn l-oriġini u d-destinazzjoni tiegħu jista' jinkludi waqfiet kummerċjali intermedji, iżda li ma jinvolvix trasferiment ta' passiġġieri jew tagħbija mill-ġdid ta' merkanzija bejn il-ferroviji."
      },
      {
        "@language": "sk",
        "@value": "Služba železničnej dopravy, ktorá môže medzi svojím východiskovým a cieľovým bodom zahŕňať medziľahlé komerčné zastávky, ale ktorá nezahŕňa žiadne prestupovanie cestujúcich ani prekládku tovaru medzi vlakmi."
      },
      {
        "@language": "sl",
        "@value": "Storitev železniškega prevoza, ki lahko med svojim izhodiščem in namembnim krajem vključuje vmesne komercialne postanke, vendar ne vključuje nobenega prestopa potnikov ali pretovarjanja blaga med vlaki."
      },
      {
        "@language": "lv",
        "@value": "Dzelzceļa pārvadājuma pakalpojums, kas starp tā izcelsmi un galamērķi var ietvert starpposma komerciālas pieturas, bet kas neietver pasažieru pārsēšanos vai kravu pārkraušanu starp vilcieniem."
      }
    ],
