  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0049",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message by which availability is checked and a reservation is requested for a rail product."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui si verifica la disponibilità e si richiede una prenotazione per un prodotto ferroviario."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou se ověřuje dostupnost a žádá o rezervaci železničního produktu."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der die Verfügbarkeit geprüft und eine Reservierung für ein Bahnprodukt angefragt wird."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ελέγχεται η διαθεσιμότητα και ζητείται κράτηση για ένα σιδηροδρομικό προϊόν."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee de beschikbaarheid wordt gecontroleerd en een reservering voor een spoorproduct wordt aangevraagd."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego sprawdza się dostępność i wnioskuje o rezerwację produktu kolejowego."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual se verifica a disponibilidade e se solicita uma reserva para um produto ferroviário."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care se verifică disponibilitatea și se solicită o rezervare pentru un produs feroviar."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket tillgängligheten kontrolleras och en bokning begärs för en järnvägsprodukt."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que se comprueba la disponibilidad y se solicita una reserva para un producto ferroviario."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel la disponibilité est vérifiée et une réservation est demandée pour un produit ferroviaire."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel ellenőrzik a rendelkezésre állást, és foglalást kérnek egy vasúti termékre."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се проверява наличността и се иска резервация на железопътен продукт."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo tikrinamas prieinamumas ir prašoma rezervuoti geležinkelių produktą."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pārbauda pieejamību un pieprasa dzelzceļa produkta rezervāciju."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih tiġi vverifikata d-disponibbiltà u tintalab riżervazzjoni ta' prodott ferrovjarju."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed tilgængeligheden kontrolleres, og der anmodes om en reservation af et jernbaneprodukt."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega kontrollitakse saadavust ja taotletakse raudteetoote broneerimist."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla tarkistetaan saatavuus ja pyydetään rautatietuotteen varausta."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína seiceáiltear an infhaighteacht agus trína n-iarrtar áirithint táirge iarnróid."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se provjerava dostupnost i zahtijeva rezervacija željezničkog proizvoda."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim se preveri razpoložljivost in zahteva rezervacija železniškega proizvoda."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou sa overuje dostupnosť a žiada o rezerváciu železničného produktu."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Availability and reservation request message"
      },
      {
        "@language": "cs",
        "@value": "Zpráva o žádosti o dostupnost a rezervaci"
      },
      {
        "@language": "el",
        "@value": "Μήνυμα αίτησης διαθεσιμότητας και κράτησης"
      },
      {
        "@language": "es",
        "@value": "Mensaje de solicitud de disponibilidad y reserva"
      },
      {
        "@language": "fr",
        "@value": "Message de demande de disponibilité et de réservation"
      },
      {
        "@language": "hu",
        "@value": "Rendelkezésre állási és foglalási kérelemüzenet"
      },
      {
        "@language": "it",
        "@value": "Messaggio di richiesta di disponibilità e prenotazione"
      },
      {
        "@language": "nl",
        "@value": "Bericht voor beschikbaarheids- en reserveringsaanvraag"
      },
      {
        "@language": "pl",
        "@value": "Komunikat zapytania o dostępność i rezerwację"
      },
      {
        "@language": "pt",
        "@value": "Mensagem de pedido de disponibilidade e reserva"
      },
      {
        "@language": "ro",
        "@value": "Mesaj de cerere de disponibilitate și rezervare"
      },
      {
        "@language": "sv",
        "@value": "Meddelande om begäran om tillgänglighet och bokning"
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Verfügbarkeits- und Reservierungsanfrage"
      },
      {
        "@language": "da",
        "@value": "Meddelelse om anmodning om tilgængelighed og reservation"
      },
      {
        "@language": "et",
        "@value": "Saadavuse ja broneerimise taotluse sõnum"
      },
      {
        "@language": "fi",
        "@value": "Saatavuus- ja varauspyyntöviesti"
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht iarrata ar infhaighteacht agus áirithint"
      },
      {
        "@language": "hr",
        "@value": "Poruka sa zahtjevom za dostupnost i rezervaciju"
      },
      {
        "@language": "lt",
        "@value": "Prieinamumo ir rezervacijos prašymo pranešimas"
      },
      {
        "@language": "lv",
        "@value": "Pieejamības un rezervācijas pieprasījuma ziņojums"
      },
      {
        "@language": "mt",
        "@value": "Messaġġ ta' talba għad-disponibbiltà u r-riżervazzjoni"
      },
      {
        "@language": "sk",
        "@value": "Správa o žiadosti o dostupnosť a rezerváciu"
      },
      {
        "@language": "sl",
        "@value": "Sporočilo z zahtevkom za razpoložljivost in rezervacijo"
      },
      {
        "@language": "bg",
        "@value": "Съобщение за искане на наличност и резервация"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0038",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wagon event indicating arrival of a freight wagon at its destination."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující příjezd nákladního vozu do místa jeho určení."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das die Ankunft eines Güterwagens an seinem Bestimmungsort angibt."
      },
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει την άφιξη ενός εμπορευματικού βαγονιού στον προορισμό του."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica la llegada de un vagón de mercancías a su destino."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant l'arrivée d'un wagon de fret à sa destination."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely egy tehervagon rendeltetési helyére való érkezését jelzi."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica l'arrivo di un carro merci a destinazione."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die de aankomst van een goederenwagen op zijn bestemming aangeeft."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące przyjazd wagonu towarowego do miejsca przeznaczenia."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica a chegada de um vagão de mercadorias ao seu destino."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică sosirea unui vagon de marfă la destinația sa."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger en godsvagns ankomst till dess destination."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава пристигането на товарен вагон на неговото местоназначение."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver en godsvogns ankomst til dens bestemmelsessted."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab kaubavaguni saabumist selle sihtkohta."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee tavaravaunun saapumisen sen määräpaikkaan."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl teacht vaigín lasta chuig a cheann scríbe."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava dolazak teretnog vagona na njegovo odredište."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda kravas vagona pienākšanu tā galamērķī."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika l-wasla ta' vagun tal-merkanzija fid-destinazzjoni tiegħu."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca príchod nákladného vozňa do miesta jeho určenia."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje prihod tovornega vagona na njegov namembni kraj."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodomas prekinio vagono atvykimas į jo paskirties vietą."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
