  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0037",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "el",
        "@value": "Συμβάν βαγονιού που υποδεικνύει ότι μια παρατυπία βαγονιού που είχε αναφερθεί προηγουμένως διορθώθηκε."
      },
      {
        "@language": "en",
        "@value": "Wagon event indicating that a previously reported wagon irregularity has been rectified."
      },
      {
        "@language": "pt",
        "@value": "Evento de vagão que indica que uma irregularidade do vagão anteriormente comunicada foi corrigida."
      },
      {
        "@language": "ro",
        "@value": "Eveniment de vagon care indică faptul că o neregulă a vagonului raportată anterior a fost remediată."
      },
      {
        "@language": "sv",
        "@value": "Vagnhändelse som anger att en tidigare rapporterad vagnoegentlighet har åtgärdats."
      },
      {
        "@language": "cs",
        "@value": "Událost vozu označující, že dříve oznámená nesrovnalost vozu byla odstraněna."
      },
      {
        "@language": "de",
        "@value": "Wagenereignis, das angibt, dass eine zuvor gemeldete Wagenunregelmäßigkeit behoben wurde."
      },
      {
        "@language": "es",
        "@value": "Evento del vagón que indica que una irregularidad del vagón previamente notificada ha sido subsanada."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon indiquant qu'une irrégularité de wagon précédemment signalée a été corrigée."
      },
      {
        "@language": "hu",
        "@value": "Kocsiesemény, amely azt jelzi, hogy egy korábban jelentett kocsi-rendellenességet elhárítottak."
      },
      {
        "@language": "it",
        "@value": "Evento del carro che indica che un'irregolarità del carro precedentemente segnalata è stata risolta."
      },
      {
        "@language": "nl",
        "@value": "Wagengebeurtenis die aangeeft dat een eerder gemelde wagenonregelmatigheid is verholpen."
      },
      {
        "@language": "pl",
        "@value": "Zdarzenie wagonu wskazujące, że wcześniej zgłoszona nieprawidłowość wagonu została usunięta."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der angiver, at en tidligere indberettet vognuregelmæssighed er blevet udbedret."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, mis näitab, et varem teatatud vaguni rikkumine on kõrvaldatud."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, joka ilmaisee, että aiemmin ilmoitettu vaunun poikkeama on korjattu."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena gcuirtear in iúl gur ceartaíodh mírialtacht vaigín a tuairiscíodh roimhe sin."
      },
      {
        "@language": "hr",
        "@value": "Događaj vagona kojim se označava da je prethodno prijavljena nepravilnost vagona ispravljena."
      },
      {
        "@language": "lt",
        "@value": "Vagono įvykis, kuriuo nurodoma, kad anksčiau praneštas vagono pažeidimas buvo pašalintas."
      },
      {
        "@language": "lv",
        "@value": "Vagona notikums, ar kuru norāda, ka iepriekš paziņotā vagona neatbilstība ir novērsta."
      },
      {
        "@language": "mt",
        "@value": "Avveniment tal-vagun li jindika li irregolarità tal-vagun irrapportata qabel ġiet irrettifikata."
      },
      {
        "@language": "sk",
        "@value": "Udalosť vozňa označujúca, že predtým oznámená nezrovnalosť vozňa bola odstránená."
      },
      {
        "@language": "sl",
        "@value": "Dogodek vagona, ki označuje, da je bila predhodno sporočena nepravilnost vagona odpravljena."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се обозначава, че предварително докладвана нередност на вагона е отстранена."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
