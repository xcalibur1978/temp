      {
        "@language": "el",
        "@value": "Άφιξη βαγονιού στον προορισμό"
      },
      {
        "@language": "bg",
        "@value": "Пристигане на вагона на местоназначението"
      },
      {
        "@language": "da",
        "@value": "Vognankomst til bestemmelsessted"
      },
      {
        "@language": "sk",
        "@value": "Príchod vozňa do miesta určenia"
      },
      {
        "@language": "sl",
        "@value": "Prihod vagona na namembni kraj"
      },
      {
        "@language": "fi",
        "@value": "Vaunun saapuminen määräpaikkaan"
      },
      {
        "@language": "ga",
        "@value": "Teacht an vaigín chuig an gceann scríbe"
      },
      {
        "@language": "hr",
        "@value": "Dolazak vagona na odredište"
      },
      {
        "@language": "lt",
        "@value": "Vagono atvykimas į paskirties vietą"
      },
      {
        "@language": "lv",
        "@value": "Vagona pienākšana galamērķī"
      },
      {
        "@language": "mt",
        "@value": "Wasla tal-vagun fid-destinazzjoni"
      },
      {
        "@language": "et",
        "@value": "Vaguni saabumine sihtkohta"
      }
