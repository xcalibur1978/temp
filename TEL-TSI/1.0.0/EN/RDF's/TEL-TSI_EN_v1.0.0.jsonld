      },
      {
        "@language": "da",
        "@value": "Data om togafgange til visning på stationer."
      },
      {
        "@language": "et",
        "@value": "Andmed rongide väljumiste kohta jaamades kuvamiseks."
      },
      {
        "@language": "fi",
        "@value": "Junien lähtöjä koskevat tiedot asemilla näytettäviksi."
      },
      {
        "@language": "hr",
        "@value": "Podaci o polascima vlakova za prikaz na kolodvorima."
      },
      {
        "@language": "lt",
        "@value": "Duomenys apie traukinių išvykimą, skirti rodyti stotyse."
      },
      {
        "@language": "lv",
        "@value": "Dati par vilcienu atiešanu rādīšanai stacijās."
      },
      {
        "@language": "mt",
        "@value": "Data dwar it-tluq tal-ferroviji għall-wiri fl-istazzjonijiet."
      },
      {
        "@language": "sk",
        "@value": "Údaje o odchodoch vlakov na zobrazenie na staniciach."
      },
      {
        "@language": "sl",
        "@value": "Podatki o odhodih vlakov za prikaz na postajah."
      },
      {
        "@language": "ga",
        "@value": "Sonraí faoi imeachtaí na dtraenacha lena dtaispeáint ag stáisiúin."
      }
    ],
