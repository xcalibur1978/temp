  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0105",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Single identifier of every geographical point relevant to rail data sharing, assigned by the Agency."
      },
      {
        "@language": "cs",
        "@value": "Jednotný identifikátor každého zeměpisného bodu relevantního pro sdílení železničních údajů, přidělovaný agenturou."
      },
      {
        "@language": "de",
        "@value": "Einheitliche Kennung jedes für die Eisenbahndatenfreigabe relevanten geografischen Punkts, die von der Agentur zugewiesen wird."
      },
      {
        "@language": "el",
        "@value": "Μοναδικό αναγνωριστικό κάθε γεωγραφικού σημείου που είναι σχετικό με την ανταλλαγή σιδηροδρομικών δεδομένων, το οποίο εκχωρείται από τον Οργανισμό."
      },
      {
        "@language": "es",
        "@value": "Identificador único de cada punto geográfico pertinente para el intercambio de datos ferroviarios, asignado por la Agencia."
      },
      {
        "@language": "fr",
        "@value": "Identifiant unique de tout point géographique pertinent pour le partage de données ferroviaires, attribué par l'Agence."
      },
      {
        "@language": "hu",
        "@value": "A vasúti adatmegosztás szempontjából releváns minden egyes földrajzi pont egyedi azonosítója, amelyet az ügynökség oszt ki."
      },
      {
        "@language": "it",
        "@value": "Identificatore unico di ogni punto geografico rilevante per la condivisione dei dati ferroviari, assegnato dall'Agenzia."
      },
      {
        "@language": "nl",
        "@value": "Unieke identificatie van elk voor de spoorgegevensdeling relevant geografisch punt, toegewezen door het Agentschap."
      },
      {
        "@language": "pl",
        "@value": "Pojedynczy identyfikator każdego punktu geograficznego istotnego dla udostępniania danych kolejowych, przydzielany przez Agencję."
      },
      {
        "@language": "pt",
        "@value": "Identificador único de cada ponto geográfico pertinente para a partilha de dados ferroviários, atribuído pela Agência."
      },
      {
        "@language": "ro",
        "@value": "Identificator unic al fiecărui punct geografic relevant pentru partajarea datelor feroviare, atribuit de agenție."
      },
      {
        "@language": "sv",
        "@value": "Enhetlig identifierare för varje geografisk punkt som är relevant för delning av järnvägsdata, tilldelad av byrån."
      },
      {
        "@language": "da",
        "@value": "Entydig identifikator for ethvert geografisk punkt, der er relevant for deling af jernbanedata, tildelt af agenturet."
      },
      {
        "@language": "et",
        "@value": "Raudteeandmete jagamise seisukohast asjakohase iga geograafilise punkti ühtne identifikaator, mille eraldab amet."
      },
      {
        "@language": "fi",
        "@value": "Jokaisen rautatiedatan jakamisen kannalta merkityksellisen maantieteellisen pisteen yksilöllinen tunniste, jonka virasto antaa."
      },
      {
        "@language": "ga",
        "@value": "Aitheantóir uathúil gach pointe geografach atá ábhartha do chomhroinnt sonraí iarnróid, arna leithdháileadh ag an nGníomhaireacht."
      },
      {
        "@language": "hr",
        "@value": "Jedinstveni identifikator svake zemljopisne točke relevantne za dijeljenje željezničkih podataka, koji dodjeljuje Agencija."
      },
      {
        "@language": "lt",
        "@value": "Kiekvieno geležinkelių duomenų dalijimuisi svarbaus geografinio taško pavienis identifikatorius, kurį priskiria agentūra."
      },
      {
        "@language": "lv",
        "@value": "Katra dzelzceļa datu kopīgošanai nozīmīga ģeogrāfiskā punkta vienots identifikators, ko piešķir aģentūra."
      },
      {
        "@language": "mt",
        "@value": "Identifikatur uniku ta' kull punt ġeografiku rilevanti għall-kondiviżjoni tad-data ferrovjarja, allokat mill-Aġenzija."
      },
      {
        "@language": "sk",
        "@value": "Jednotný identifikátor každého geografického bodu relevantného pre zdieľanie železničných údajov, prideľovaný agentúrou."
      },
      {
        "@language": "sl",
        "@value": "Enotni identifikator vsake geografske točke, ki je pomembna za izmenjavo železniških podatkov, ki ga dodeli agencija."
      },
      {
        "@language": "bg",
        "@value": "Единен идентификатор на всяка географска точка, релевантна за споделянето на железопътни данни, разпределян от агенцията."
      }
    ],
