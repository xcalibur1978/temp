      {
        "@language": "es",
        "@value": "Evento del vagón que transmite el estado actual de un vagón de mercancías."
      },
      {
        "@language": "fr",
        "@value": "Événement de wagon transmettant le statut actuel d'un wagon de fret."
      },
      {
        "@language": "bg",
        "@value": "Събитие на вагона, с което се предава текущото състояние на товарен вагон."
      },
      {
        "@language": "da",
        "@value": "Vognhændelse, der overfører en godsvogns aktuelle status."
      },
      {
        "@language": "et",
        "@value": "Vagunisündmus, millega edastatakse kaubavaguni praegune staatus."
      },
      {
        "@language": "fi",
        "@value": "Vaunutapahtuma, jolla välitetään tavaravaunun nykyinen tila."
      },
      {
        "@language": "ga",
        "@value": "Teagmhas vaigín lena ndéantar stádas reatha vaigín lasta a tharchur."
