    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Intermodal loading unit movement"
      },
      {
        "@language": "cs",
        "@value": "Pohyb intermodální nákladové jednotky"
      },
      {
        "@language": "de",
        "@value": "Bewegung der intermodalen Ladeeinheit"
      },
