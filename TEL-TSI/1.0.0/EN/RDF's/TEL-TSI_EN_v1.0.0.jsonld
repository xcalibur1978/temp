  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0003",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hu",
        "@value": "Az infrastruktúra-kapacitásra vonatkozó igénylést azonosító objektum (PathRequestID), amelyet a vezető vasúti társaság határoz meg; attribútumként tartalmazza a működési és a kereskedelmi vonatszámot."
      },
      {
        "@language": "it",
        "@value": "Oggetto (PathRequestID) che identifica una richiesta di capacità di infrastruttura, definito dall'impresa ferroviaria capofila; reca come attributi il numero di treno operativo e il numero di treno commerciale."
      },
      {
        "@language": "nl",
        "@value": "Object (PathRequestID) dat een aanvraag voor infrastructuurcapaciteit identificeert, vastgesteld door de hoofdspoorwegonderneming; bevat het operationele en het commerciële treinnummer als attributen."
      },
      {
        "@language": "pl",
        "@value": "Obiekt (PathRequestID) identyfikujący wniosek o zdolność przepustową infrastruktury, określony przez wiodące przedsiębiorstwo kolejowe; zawiera jako atrybuty operacyjny i handlowy numer pociągu."
      },
      {
        "@language": "pt",
        "@value": "Objeto (PathRequestID) que identifica um pedido de capacidade de infraestrutura, definido pela empresa ferroviária principal; contém como atributos o número operacional e o número comercial do comboio."
      },
      {
        "@language": "ro",
        "@value": "Obiect (PathRequestID) care identifică o cerere de capacitate de infrastructură, stabilit de întreprinderea feroviară principală; conține ca atribute numărul operațional și numărul comercial al trenului."
      },
      {
        "@language": "sv",
        "@value": "Objekt (PathRequestID) som identifierar en ansökan om infrastrukturkapacitet, fastställt av det ledande järnvägsföretaget; innehåller det operativa och det kommersiella tågnumret som attribut."
      },
      {
        "@language": "cs",
        "@value": "Objekt (PathRequestID) identifikující žádost o kapacitu infrastruktury, který stanoví vedoucí železniční podnik; jako atributy obsahuje provozní a komerční číslo vlaku."
      },
      {
        "@language": "de",
        "@value": "Objekt (PathRequestID) zur Identifizierung eines Antrags auf Fahrwegkapazität, das vom federführenden Eisenbahnunternehmen festgelegt wird; enthält die betriebliche und die kommerzielle Zugnummer als Attribute."
      },
      {
        "@language": "en",
        "@value": "Object (PathRequestID) identifying a request for infrastructure capacity, specified by the lead railway undertaking; carries the operational train number and commercial train number as attributes."
      },
      {
        "@language": "es",
        "@value": "Objeto (PathRequestID) que identifica una solicitud de capacidad de infraestructura, definido por la empresa ferroviaria principal; lleva como atributos el número de tren operativo y el número de tren comercial."
      },
      {
        "@language": "fr",
        "@value": "Objet (PathRequestID) identifiant une demande de capacité d'infrastructure, défini par l'entreprise ferroviaire chef de file; il porte comme attributs le numéro de train opérationnel et le numéro de train commercial."
      },
      {
        "@language": "bg",
        "@value": "Обект (PathRequestID), който идентифицира искане за инфраструктурен капацитет, определен от водещото железопътно предприятие; като атрибути съдържа оперативния и търговския номер на влака."
      },
      {
        "@language": "da",
        "@value": "Objekt (PathRequestID), der identificerer en ansøgning om infrastrukturkapacitet, fastlagt af den ledende jernbanevirksomhed; indeholder det operationelle og det kommercielle tognummer som attributter."
      },
      {
        "@language": "et",
        "@value": "Objekt (PathRequestID), mis identifitseerib taristu läbilaskevõime taotluse, mille määrab juhtiv raudteeveo-ettevõtja; selle atribuutideks on operatiivne ja kommertsrongi number."
      },
      {
        "@language": "fi",
        "@value": "Objekti (PathRequestID), joka yksilöi infrastruktuurikapasiteettia koskevan pyynnön, jonka johtava rautatieyritys vahvistaa; sisältää attribuutteina operatiivisen ja kaupallisen junanumeron."
      },
      {
        "@language": "ga",
        "@value": "Réad (PathRequestID) lena sainaithnítear iarraidh ar acmhainn bonneagair, arna shocrú ag an ngnóthas iarnróid ceannais; áirítear ann mar thréithe uimhir oibríochtúil agus uimhir tráchtála na traenach."
      },
      {
        "@language": "hr",
        "@value": "Objekt (PathRequestID) koji identificira zahtjev za infrastrukturnim kapacitetom, koji utvrđuje vodeći željeznički prijevoznik; kao atribute sadržava operativni i komercijalni broj vlaka."
      },
      {
        "@language": "lt",
        "@value": "Objektas (PathRequestID), identifikuojantis prašymą dėl infrastruktūros pajėgumo, kurį nustato vadovaujančioji geležinkelio įmonė; kaip atributus jis apima veiklos ir komercinį traukinio numerį."
      },
      {
        "@language": "lv",
        "@value": "Objekts (PathRequestID), kas identificē pieprasījumu pēc infrastruktūras jaudas, kuru nosaka vadošais dzelzceļa pārvadājumu uzņēmums; kā atribūtus tas ietver vilciena operatīvo un komerciālo numuru."
      },
      {
        "@language": "mt",
        "@value": "Oġġett (PathRequestID) li jidentifika talba għal kapaċità tal-infrastruttura, stabbilit mill-impriża ferrovjarja ewlenija; bħala attributi jkun fih in-numru operazzjonali u dak kummerċjali tal-ferrovija."
      },
      {
        "@language": "sk",
        "@value": "Objekt (PathRequestID) identifikujúci žiadosť o kapacitu infraštruktúry, ktorý stanovuje vedúci železničný podnik; ako atribúty obsahuje prevádzkové a komerčné číslo vlaku."
      },
      {
        "@language": "sl",
        "@value": "Objekt (PathRequestID), ki identificira zahtevek za infrastrukturno zmogljivost, določi ga vodilni prevoznik v železniškem prometu; kot atributa vsebuje operativno in komercialno številko vlaka."
      },
      {
        "@language": "el",
        "@value": "Αντικείμενο (PathRequestID) που προσδιορίζει μια αίτηση χωρητικότητας υποδομής, το οποίο καθορίζεται από την επικεφαλής σιδηροδρομική επιχείρηση· περιέχει ως χαρακτηριστικά τον λειτουργικό και τον εμπορικό αριθμό τρένου."
      }
    ],
