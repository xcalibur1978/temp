  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0014",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Zpráva předávající řazení vlaku, včetně informací na úrovni vozidla, celkové hmotnosti vlaku, evropského čísla vozidla hnacích vozidel a ukazatelů pro nebezpečné věci, intermodální nákladové jednotky, ozbrojené síly a tišší trasy."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der Zusammensetzung eines Zuges, einschließlich fahrzeugbezogener Angaben, Gesamtzugmasse, europäischer Fahrzeugnummer der Triebfahrzeuge sowie Kennzeichnungen für Gefahrgut, intermodale Ladeeinheiten, Streitkräfte und leisere Strecken."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant la composition d'un train, y compris les informations au niveau du véhicule, la masse totale du train, le numéro européen de véhicule des engins de traction, ainsi que les indicateurs pour les marchandises dangereuses, les unités de chargement intermodal, les forces armées et les itinéraires plus silencieux."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely továbbítja egy vonat összeállítását, beleértve a járműszintű információkat, a vonat teljes tömegét, a vontatójárművek európai járműszámát, valamint a veszélyes árukra, az intermodális rakományegységekre, a fegyveres erőkre és a csendesebb útvonalakra vonatkozó jelzéseket."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette la composizione di un treno, comprese le informazioni a livello di veicolo, la massa totale del treno, il numero europeo di veicolo dei mezzi di trazione, nonché gli indicatori per le merci pericolose, le unità di carico intermodale, le forze armate e gli itinerari più silenziosi."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat de samenstelling van een trein doorgeeft, met inbegrip van informatie op voertuigniveau, de totale treinmassa, het Europees voertuignummer van de tractievoertuigen en aanduidingen voor gevaarlijke goederen, intermodale laadeenheden, strijdkrachten en stillere routes."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący zestawienie pociągu, w tym informacje na poziomie pojazdu, całkowitą masę pociągu, europejski numer pojazdu jednostek trakcyjnych oraz oznaczenia dotyczące towarów niebezpiecznych, intermodalnych jednostek ładunkowych, sił zbrojnych i tras cichszych."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite a composição de um comboio, incluindo informações ao nível do veículo, a massa total do comboio, o número europeu de veículo dos veículos de tração, bem como os indicadores de mercadorias perigosas, unidades de carga intermodal, forças armadas e itinerários mais silenciosos."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite compunerea unui tren, inclusiv informații la nivel de vehicul, masa totală a trenului, numărul european de vehicul al vehiculelor de tracțiune, precum și indicatorii pentru mărfuri periculoase, unități de încărcare intermodală, forțe armate și rute mai silențioase."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför ett tågs sammansättning, inbegripet uppgifter på fordonsnivå, tågets totala massa, det europeiska fordonsnumret för dragfordonen samt indikatorer för farligt gods, intermodala lastenheter, väpnade styrkor och tystare rutter."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la composición de un tren, incluida la información a nivel de vehículo, la masa total del tren, el número europeo de vehículo de las unidades de tracción, así como los indicadores de mercancías peligrosas, unidades de carga intermodal, fuerzas armadas e itinerarios más silenciosos."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører et togs sammensætning, herunder oplysninger på køretøjsniveau, togets samlede masse, det europæiske køretøjsnummer for trækkraftenhederne samt indikatorer for farligt gods, intermodale lastenheder, væbnede styrker og mere støjsvage ruter."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse rongi koosseis, sealhulgas sõidukitasandi teave, rongi kogumass, veovahendite Euroopa sõidukinumber ning ohtlike kaupade, intermodaalsete laadimisüksuste, relvajõudude ja vaiksemate marsruutide näitajad."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään junan kokoonpano, mukaan lukien kalustoyksikkötason tiedot, junan kokonaismassa, vetokaluston eurooppalainen kalustoyksikkönumero sekä vaarallisia aineita, intermodaalisia kuormausyksiköitä, asevoimia ja hiljaisempia reittejä koskevat ilmaisimet."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar comhdhéanamh traenach a tharchur, lena n-áirítear faisnéis ar leibhéal na feithicle, mais iomlán na traenach, uimhir feithicle Eorpach na bhfeithiclí tarraingthe, chomh maith leis na táscairí maidir le hearraí contúirteacha, aonaid lódála idirmhódúla, fórsaí armtha agus bealaí níos ciúine."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenosi sastav vlaka, uključujući informacije na razini vozila, ukupnu masu vlaka, europski broj vozila vučnih vozila te pokazatelje za opasnu robu, intermodalne utovarne jedinice, oružane snage i tiše rute."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodamas traukinio sąstatas, įskaitant transporto priemonės lygmens informaciją, bendrą traukinio masę, traukos transporto priemonių Europos transporto priemonės numerį ir pavojingų krovinių, įvairiarūšio krovimo vienetų, ginkluotųjų pajėgų ir tylesnių maršrutų rodiklius."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod vilciena sastāvu, tostarp informāciju transportlīdzekļa līmenī, vilciena kopējo masu, vilces transportlīdzekļu Eiropas transportlīdzekļa numuru, kā arī rādītājus attiecībā uz bīstamajām kravām, intermodālajām kravas vienībām, bruņotajiem spēkiem un klusākiem maršrutiem."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti l-kompożizzjoni ta' ferrovija, inkluż informazzjoni fil-livell tal-vettura, il-massa totali tal-ferrovija, in-numru Ewropew tal-vettura tal-vetturi tat-trazzjoni, kif ukoll l-indikaturi għall-merkanzija perikoluża, l-unitajiet tat-tagħbija intermodali, il-forzi armati u r-rotot iktar siekta."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca radenie vlaku vrátane informácií na úrovni vozidla, celkovej hmotnosti vlaku, európskeho čísla vozidla hnacích vozidiel a ukazovateľov pre nebezpečný tovar, intermodálne nákladové jednotky, ozbrojené sily a tichšie trasy."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje sestavo vlaka, vključno z informacijami na ravni vozila, skupno maso vlaka, evropsko številko vozila vlečnih vozil ter kazalniki za nevarno blago, intermodalne nakladalne enote, oborožene sile in tišje poti."
      },
      {
        "@language": "en",
        "@value": "Message conveying the composition of a train, including vehicle-level information, total train mass, European Vehicle Number of traction units, and flags for dangerous goods, intermodal loading units, armed forces and quieter routes."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава съставът на влак, включително информация на ниво превозно средство, общата маса на влака, европейския номер на превозно средство на тяговите превозни средства, както и показателите за опасни товари, интермодални товарни единици, въоръжени сили и по-тихи маршрути."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει τη σύνθεση ενός τρένου, συμπεριλαμβανομένων πληροφοριών σε επίπεδο οχήματος, της συνολικής μάζας του τρένου, του ευρωπαϊκού αριθμού οχήματος των οχημάτων έλξης, καθώς και των ενδείξεων για επικίνδυνα εμπορεύματα, μονάδες διατροπικής φόρτωσης, ένοπλες δυνάμεις και πιο αθόρυβες διαδρομές."
      }
    ],
