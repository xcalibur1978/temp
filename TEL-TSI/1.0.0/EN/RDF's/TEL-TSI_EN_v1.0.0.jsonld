  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0015",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message conveying the composition of a passenger train, including seating maps, classes, coaches for persons with reduced mobility and bicycle spaces."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der Zusammensetzung eines Reisezuges, einschließlich Sitzplänen, Klassen, Wagen für Personen mit eingeschränkter Mobilität und Fahrradstellplätzen."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει τη σύνθεση ενός επιβατικού τρένου, συμπεριλαμβανομένων των διαγραμμάτων θέσεων, των κατηγοριών, των οχημάτων για άτομα με μειωμένη κινητικότητα και των χώρων για ποδήλατα."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la composición de un tren de viajeros, incluidos los planos de asientos, las clases, los coches para personas con movilidad reducida y las plazas para bicicletas."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant la composition d'un train de voyageurs, y compris les plans de places assises, les classes, les voitures pour les personnes à mobilité réduite et les emplacements pour vélos."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely továbbítja egy személyszállító vonat összeállítását, beleértve az ülőhelytérképeket, az osztályokat, a csökkent mozgásképességű személyek számára fenntartott kocsikat és a kerékpárhelyeket."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette la composizione di un treno passeggeri, compresi i piani dei posti a sedere, le classi, le carrozze per persone a mobilità ridotta e gli spazi per biciclette."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat de samenstelling van een reizigerstrein doorgeeft, met inbegrip van stoelplattegronden, klassen, rijtuigen voor personen met beperkte mobiliteit en fietsplaatsen."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący zestawienie pociągu pasażerskiego, w tym plany miejsc siedzących, klasy, wagony dla osób o ograniczonej możliwości poruszania się oraz miejsca na rowery."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite a composição de um comboio de passageiros, incluindo plantas de lugares, classes, carruagens para pessoas com mobilidade reduzida e espaços para bicicletas."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care transmite compunerea unui tren de călători, inclusiv planurile locurilor, clasele, vagoanele pentru persoane cu mobilitate redusă și spațiile pentru biciclete."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som överför ett persontågs sammansättning, inbegripet sittplatskartor, klasser, vagnar för personer med nedsatt rörlighet och cykelplatser."
      },
      {
        "@language": "cs",
        "@value": "Zpráva předávající řazení osobního vlaku, včetně plánů sedadel, tříd, vozů pro osoby se sníženou pohyblivostí a míst pro jízdní kola."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod pasažieru vilciena sastāvu, tostarp sēdvietu plānus, klases, vagonus personām ar ierobežotām pārvietošanās spējām un velosipēdu vietas."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører et passagertogs sammensætning, herunder siddepladskort, klasser, vogne til personer med nedsat mobilitet og cykelpladser."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse reisirongi koosseis, sealhulgas istekohtade plaanid, klassid, piiratud liikumisvõimega isikutele mõeldud vagunid ja jalgrattakohad."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään matkustajajunan kokoonpano, mukaan lukien istumapaikkakartat, luokat, liikuntarajoitteisille henkilöille tarkoitetut vaunut ja polkupyöräpaikat."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar comhdhéanamh traenach paisinéirí a tharchur, lena n-áirítear pleananna suíocháin, ranganna, carráistí do dhaoine a bhfuil a soghluaisteacht laghdaithe agus áiteanna do rothair."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenosi sastav putničkog vlaka, uključujući rasporede sjedala, razrede, vagone za osobe smanjene pokretljivosti i mjesta za bicikle."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodamas keleivinio traukinio sąstatas, įskaitant sėdimų vietų planus, klases, riboto judumo asmenims skirtus vagonus ir vietas dviračiams."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава съставът на пътнически влак, включително схеми на местата, класове, вагони за лица с намалена подвижност и места за велосипеди."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca radenie osobného vlaku vrátane plánov sedadiel, tried, vozňov pre osoby so zníženou pohyblivosťou a miest pre bicykle."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje sestavo potniškega vlaka, vključno z razporedi sedežev, razredi, vagoni za osebe z zmanjšano mobilnostjo in mesti za kolesa."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti l-kompożizzjoni ta' ferrovija tal-passiġġieri, inkluż il-pjanti tal-postijiet bilqiegħda, il-klassijiet, il-vaguni għal persuni b'mobbiltà mnaqqsa u l-postijiet għar-roti."
      }
    ],
