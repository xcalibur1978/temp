  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0106",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Code assigned to non-rail-network locations used by rail-replacement transport services, services sold as rail but not operated on rail, and meta stations."
      },
      {
        "@language": "cs",
        "@value": "Kód přidělovaný lokalitám mimo železniční síť, které využívají služby náhradní železniční dopravy, služby prodávané jako železniční, avšak neprovozované na železnici, jakož i meta-stanice."
      },
      {
        "@language": "de",
        "@value": "Code, der Standorten außerhalb des Schienennetzes zugewiesen wird, die von Schienenersatzverkehrsdiensten, als Schiene verkauften, aber nicht auf der Schiene betriebenen Diensten sowie Metabahnhöfen genutzt werden."
      },
      {
        "@language": "sv",
        "@value": "Kod som tilldelas platser utanför järnvägsnätet vilka används av ersättningstrafiktjänster för järnväg, tjänster som säljs som järnväg men inte bedrivs på järnväg samt metastationer."
      },
      {
        "@language": "es",
        "@value": "Código asignado a las localizaciones ajenas a la red ferroviaria utilizadas por los servicios de transporte sustitutivo ferroviario, los servicios vendidos como ferroviarios pero no explotados sobre raíles, así como las metaestaciones."
      },
      {
        "@language": "fr",
        "@value": "Code attribué aux localisations hors réseau ferroviaire utilisées par les services de transport de substitution ferroviaire, les services vendus comme ferroviaires mais non exploités sur rail, ainsi que les méta-gares."
      },
      {
        "@language": "hu",
        "@value": "A vasúthálózaton kívüli helyekhez rendelt kód, amelyeket a vasútpótló közlekedési szolgáltatások, a vasútiként értékesített, de nem síneken üzemeltetett szolgáltatások, valamint a metaállomások használnak."
      },
      {
        "@language": "it",
        "@value": "Codice assegnato alle localizzazioni esterne alla rete ferroviaria utilizzate dai servizi di trasporto sostitutivo ferroviario, dai servizi venduti come ferroviari ma non esercitati su rotaia, nonché dalle meta-stazioni."
      },
      {
        "@language": "ro",
        "@value": "Cod atribuit locațiilor din afara rețelei feroviare utilizate de serviciile de transport de substituție feroviară, de serviciile vândute ca feroviare, dar neexploatate pe șine, precum și de meta-stații."
      },
      {
        "@language": "pl",
        "@value": "Kod przydzielany lokalizacjom spoza sieci kolejowej wykorzystywanym przez zastępcze usługi transportu kolejowego, usługi sprzedawane jako kolejowe, lecz nieświadczone na torach, oraz metastacje."
      },
      {
        "@language": "pt",
        "@value": "Código atribuído a localizações fora da rede ferroviária utilizadas por serviços de transporte de substituição ferroviária, serviços vendidos como ferroviários mas não explorados sobre carris, bem como meta-estações."
      },
      {
        "@language": "nl",
        "@value": "Code die wordt toegewezen aan locaties buiten het spoornet die worden gebruikt door vervangende spoorvervoersdiensten, als spoor verkochte maar niet op het spoor geëxploiteerde diensten en metastations."
      },
      {
        "@language": "el",
        "@value": "Κωδικός που εκχωρείται σε τοποθεσίες εκτός σιδηροδρομικού δικτύου οι οποίες χρησιμοποιούνται από υπηρεσίες αντικατάστασης σιδηροδρομικών μεταφορών, από υπηρεσίες που πωλούνται ως σιδηροδρομικές αλλά δεν εκτελούνται επί σιδηροτροχιών, καθώς και από μετα-σταθμούς."
      },
      {
        "@language": "bg",
        "@value": "Код, разпределян на местоположения извън железопътната мрежа, използвани от заместващите услуги за железопътен превоз, услугите, продавани като железопътни, но неизвършвани по релси, както и метагарите."
      },
      {
        "@language": "da",
        "@value": "Kode, der tildeles lokaliteter uden for jernbanenettet, som anvendes af jernbaneerstatningstjenester, tjenester, der sælges som jernbane, men ikke drives på skinner, samt metastationer."
      },
      {
        "@language": "et",
        "@value": "Kood, mis eraldatakse väljaspool raudteevõrgustikku asuvatele asukohtadele, mida kasutavad asendusraudteeveoteenused, raudteena müüdavad, kuid mitte rööbastel osutatavad teenused, samuti metajaamad."
      },
      {
        "@language": "fi",
        "@value": "Koodi, joka annetaan rautatieverkon ulkopuolisille sijainneille, joita käyttävät korvaavat rautatieliikennepalvelut, rautatiepalveluina myydyt mutta ei raiteilla liikennöidyt palvelut sekä meta-asemat."
      },
      {
        "@language": "ga",
        "@value": "Cód arna leithdháileadh ar shuíomhanna lasmuigh den líonra iarnróid a úsáideann seirbhísí iompair iarnróid ionaid, seirbhísí a dhíoltar mar iarnród ach nach n-oibrítear ar ráillí, chomh maith le meiteastáisiúin."
      },
      {
        "@language": "lt",
        "@value": "Kodas, priskiriamas ne geležinkelių tinklo vietoms, kuriomis naudojasi pakaitinio geležinkelių transporto paslaugos, kaip geležinkelių parduodamos, bet ne bėgiais teikiamos paslaugos, taip pat metastotys."
      },
      {
        "@language": "lv",
        "@value": "Kods, ko piešķir ārpus dzelzceļa tīkla esošām atrašanās vietām, kuras izmanto dzelzceļa aizstājējpārvadājumu pakalpojumi, pakalpojumi, ko pārdod kā dzelzceļa pakalpojumus, bet kas netiek sniegti pa sliedēm, kā arī metastacijas."
      },
      {
        "@language": "mt",
        "@value": "Kodiċi allokat lil lokalitajiet barra min-netwerk ferrovjarju li jintużaw mis-servizzi tat-trasport ferrovjarju sostituttiv, mis-servizzi mibjugħa bħala ferrovjarji iżda mhux operati fuq il-binarji, kif ukoll mill-meta-stazzjonijiet."
      },
      {
        "@language": "sk",
        "@value": "Kód prideľovaný lokalitám mimo železničnej siete, ktoré využívajú služby náhradnej železničnej dopravy, služby predávané ako železničné, ale neprevádzkované na koľajach, ako aj meta-stanice."
      },
      {
        "@language": "sl",
        "@value": "Koda, dodeljena lokacijam zunaj železniškega omrežja, ki jih uporabljajo nadomestne železniške prevozne storitve, storitve, ki se prodajajo kot železniške, vendar se ne izvajajo po tirih, ter metapostaje."
      },
      {
        "@language": "hr",
        "@value": "Kod koji se dodjeljuje lokacijama izvan željezničke mreže koje upotrebljavaju usluge zamjenskog željezničkog prijevoza, usluge koje se prodaju kao željezničke, ali se ne obavljaju na tračnicama, te metakolodvori."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
