  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0074",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_41"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The railway undertaking's digital system hosting the online catalogue of individual rail transport services and enabling distributors to check availability and make reservations."
      },
      {
        "@language": "es",
        "@value": "Sistema digital de la empresa ferroviaria que aloja el catálogo en línea de los distintos servicios de transporte ferroviario y permite a los distribuidores comprobar la disponibilidad y realizar reservas."
      },
      {
        "@language": "fr",
        "@value": "Système numérique de l'entreprise ferroviaire hébergeant le catalogue en ligne des services de transport ferroviaire individuels et permettant aux distributeurs de vérifier la disponibilité et d'effectuer des réservations."
      },
      {
        "@language": "hu",
        "@value": "A vasúti társaság digitális rendszere, amely az egyes vasúti szállítási szolgáltatások online katalógusát tárolja, és lehetővé teszi a forgalmazók számára a rendelkezésre állás ellenőrzését és a foglalások végrehajtását."
      },
      {
        "@language": "it",
        "@value": "Sistema digitale dell'impresa ferroviaria che ospita il catalogo online dei singoli servizi di trasporto ferroviario e consente ai distributori di verificare la disponibilità ed effettuare prenotazioni."
      },
      {
        "@language": "nl",
        "@value": "Het digitale systeem van de spoorwegonderneming dat de onlinecatalogus van de afzonderlijke spoorvervoersdiensten bevat en distributeurs in staat stelt de beschikbaarheid te controleren en reserveringen te maken."
      },
      {
        "@language": "pl",
        "@value": "Cyfrowy system przedsiębiorstwa kolejowego, w którym znajduje się internetowy katalog poszczególnych przewozów kolejowych i który umożliwia dystrybutorom sprawdzanie dostępności oraz dokonywanie rezerwacji."
      },
      {
        "@language": "pt",
        "@value": "Sistema digital da empresa ferroviária que aloja o catálogo em linha dos serviços de transporte ferroviário individuais e que permite aos distribuidores verificar a disponibilidade e efetuar reservas."
      },
      {
        "@language": "ro",
        "@value": "Sistemul digital al întreprinderii feroviare care găzduiește catalogul online al serviciilor individuale de transport feroviar și care permite distribuitorilor să verifice disponibilitatea și să efectueze rezervări."
      },
      {
        "@language": "sv",
        "@value": "Järnvägsföretagets digitala system som hyser onlinekatalogen över de enskilda järnvägstransporttjänsterna och gör det möjligt för distributörer att kontrollera tillgänglighet och göra bokningar."
      },
      {
        "@language": "cs",
        "@value": "Digitální systém železničního podniku, který hostí online katalog jednotlivých služeb železniční dopravy a umožňuje distributorům ověřovat dostupnost a provádět rezervace."
      },
      {
        "@language": "de",
        "@value": "Digitales System des Eisenbahnunternehmens, das den Online-Katalog der einzelnen Schienenverkehrsdienste beherbergt und es Vertreibern ermöglicht, die Verfügbarkeit zu prüfen und Reservierungen vorzunehmen."
      },
      {
        "@language": "el",
        "@value": "Το ψηφιακό σύστημα της σιδηροδρομικής επιχείρησης που φιλοξενεί τον διαδικτυακό κατάλογο των επιμέρους υπηρεσιών σιδηροδρομικής μεταφοράς και επιτρέπει στους διανομείς να ελέγχουν τη διαθεσιμότητα και να πραγματοποιούν κρατήσεις."
      },
      {
        "@language": "bg",
        "@value": "Цифровата система на железопътното предприятие, в която се намира онлайн каталогът на отделните услуги за железопътен превоз и която позволява на дистрибуторите да проверяват наличността и да правят резервации."
      },
      {
        "@language": "da",
        "@value": "Jernbanevirksomhedens digitale system, der huser onlinekataloget over de enkelte jernbanetransporttjenester og giver distributører mulighed for at kontrollere tilgængeligheden og foretage reservationer."
      },
      {
        "@language": "et",
        "@value": "Raudteeveo-ettevõtja digisüsteem, milles paikneb üksikute raudteeveoteenuste internetikataloog ja mis võimaldab turustajatel kontrollida saadavust ja teha broneeringuid."
      },
      {
        "@language": "fi",
        "@value": "Rautatieyrityksen digitaalinen järjestelmä, johon yksittäisten rautatiekuljetuspalvelujen verkkoluettelo on tallennettu ja jonka avulla jakelijat voivat tarkistaa saatavuuden ja tehdä varauksia."
      },
      {
        "@language": "ga",
        "@value": "Córas digiteach an ghnóthais iarnróid ina bhfuil catalóg ar líne na seirbhísí iompair iarnróid aonair agus a chuireann ar chumas dáileoirí an infhaighteacht a sheiceáil agus áirithintí a dhéanamh."
      },
      {
        "@language": "hr",
        "@value": "Digitalni sustav željezničkog prijevoznika u kojem se nalazi internetski katalog pojedinačnih usluga željezničkog prijevoza i koji distributerima omogućuje provjeru dostupnosti i obavljanje rezervacija."
      },
      {
        "@language": "lv",
        "@value": "Dzelzceļa pārvadājumu uzņēmuma digitālā sistēma, kurā izvietots atsevišķo dzelzceļa pārvadājumu pakalpojumu tiešsaistes katalogs un kura izplatītājiem ļauj pārbaudīt pieejamību un veikt rezervācijas."
      },
      {
        "@language": "mt",
        "@value": "Is-sistema diġitali tal-impriża ferrovjarja li tospita l-katalgu online tas-servizzi individwali tat-trasport ferrovjarju u li tippermetti lid-distributuri jivverifikaw id-disponibbiltà u jagħmlu riżervazzjonijiet."
      },
      {
        "@language": "sk",
        "@value": "Digitálny systém železničného podniku, ktorý hosťuje online katalóg jednotlivých služieb železničnej dopravy a umožňuje distribútorom overovať dostupnosť a vykonávať rezervácie."
      },
      {
        "@language": "sl",
        "@value": "Digitalni sistem prevoznika v železniškem prometu, ki gosti spletni katalog posameznih storitev železniškega prevoza in distributerjem omogoča preverjanje razpoložljivosti in opravljanje rezervacij."
      },
      {
        "@language": "lt",
        "@value": "Geležinkelio įmonės skaitmeninė sistema, kurioje saugomas internetinis atskirų geležinkelių vežimo paslaugų katalogas ir kuri leidžia platintojams tikrinti prieinamumą ir atlikti rezervacijas."
      }
    ],
