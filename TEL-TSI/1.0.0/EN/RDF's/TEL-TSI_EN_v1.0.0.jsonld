  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0091",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A natural or legal person that has the right to access the data produced and made available by the data holder under specified access conditions for use."
      },
      {
        "@language": "cs",
        "@value": "Fyzická nebo právnická osoba, která má právo na přístup k údajům vytvořeným a zpřístupněným držitelem údajů za stanovených podmínek přístupu za účelem jejich využití."
      },
      {
        "@language": "de",
        "@value": "Eine natürliche oder juristische Person, die das Recht hat, auf die vom Dateninhaber erzeugten und bereitgestellten Daten unter festgelegten Zugangsbedingungen zur Nutzung zuzugreifen."
      },
      {
        "@language": "el",
        "@value": "Φυσικό ή νομικό πρόσωπο που έχει το δικαίωμα πρόσβασης στα δεδομένα που παράγονται και καθίστανται διαθέσιμα από τον κάτοχο δεδομένων υπό καθορισμένους όρους πρόσβασης για χρήση."
      },
      {
        "@language": "es",
        "@value": "Persona física o jurídica que tiene el derecho de acceder a los datos producidos y puestos a disposición por el titular de los datos en condiciones de acceso especificadas para su uso."
      },
      {
        "@language": "fr",
        "@value": "Personne physique ou morale qui a le droit d'accéder aux données produites et mises à disposition par le détenteur de données dans des conditions d'accès spécifiées en vue de leur utilisation."
      },
      {
        "@language": "hu",
        "@value": "Olyan természetes vagy jogi személy, amely jogosult az adatok birtokosa által előállított és rendelkezésre bocsátott adatokhoz meghatározott hozzáférési feltételek mellett, felhasználás céljából hozzáférni."
      },
      {
        "@language": "it",
        "@value": "Persona fisica o giuridica che ha il diritto di accedere ai dati prodotti e messi a disposizione dal detentore dei dati a determinate condizioni di accesso ai fini del loro uso."
      },
      {
        "@language": "nl",
        "@value": "Een natuurlijke of rechtspersoon die het recht heeft toegang te krijgen tot de door de gegevenshouder geproduceerde en beschikbaar gestelde gegevens onder gespecificeerde toegangsvoorwaarden voor gebruik."
      },
      {
        "@language": "pl",
        "@value": "Osoba fizyczna lub prawna, która ma prawo dostępu do danych wytworzonych i udostępnionych przez posiadacza danych na określonych warunkach dostępu w celu ich wykorzystania."
      },
      {
        "@language": "pt",
        "@value": "Pessoa singular ou coletiva que tem o direito de aceder aos dados produzidos e disponibilizados pelo detentor dos dados em condições de acesso especificadas, para utilização."
      },
      {
        "@language": "ro",
        "@value": "Persoană fizică sau juridică care are dreptul de a accesa datele produse și puse la dispoziție de deținătorul de date în condiții de acces specificate, în vederea utilizării."
      },
      {
        "@language": "sv",
        "@value": "En fysisk eller juridisk person som har rätt att få åtkomst till de data som framställs och tillgängliggörs av datainnehavaren enligt angivna åtkomstvillkor för användning."
      },
      {
        "@language": "lt",
        "@value": "Fizinis arba juridinis asmuo, turintis teisę naudojimo tikslais susipažinti su duomenimis, kuriuos duomenų valdytojas parengia ir pateikia nustatytomis prieigos sąlygomis."
      },
      {
        "@language": "lv",
        "@value": "Fiziska vai juridiska persona, kurai ir tiesības izmantošanas nolūkā piekļūt datiem, ko datu turētājs sagatavojis un darījis pieejamus ar konkrētiem piekļuves nosacījumiem."
      },
      {
        "@language": "mt",
        "@value": "Persuna fiżika jew ġuridika li jkollha d-dritt li taċċessa d-data prodotta u mqiegħda għad-dispożizzjoni mid-detentur tad-data taħt kundizzjonijiet ta' aċċess speċifikati għall-użu."
      },
      {
        "@language": "sk",
        "@value": "Fyzická alebo právnická osoba, ktorá má právo na prístup k údajom vytvoreným a sprístupneným držiteľom údajov za stanovených podmienok prístupu na účely ich využívania."
      },
      {
        "@language": "sl",
        "@value": "Fizična ali pravna oseba, ki ima pravico do dostopa do podatkov, ki jih ustvari in da na voljo imetnik podatkov pod določenimi pogoji dostopa za uporabo."
      },
      {
        "@language": "da",
        "@value": "En fysisk eller juridisk person, der har ret til at få adgang til de data, der produceres og stilles til rådighed af dataindehaveren på nærmere angivne adgangsbetingelser med henblik på anvendelse."
      },
      {
        "@language": "et",
        "@value": "Füüsiline või juriidiline isik, kellel on õigus pääseda kasutamiseks juurde andmetele, mille andmevaldaja on loonud ja kindlaksmääratud juurdepääsutingimustel kättesaadavaks teinud."
      },
      {
        "@language": "fi",
        "@value": "Luonnollinen henkilö tai oikeushenkilö, jolla on oikeus saada pääsy datan haltijan tuottamaan ja saataville asettamaan dataan määritellyin käyttöoikeusehdoin käyttöä varten."
      },
      {
        "@language": "ga",
        "@value": "Duine nádúrtha nó dlítheanach a bhfuil an ceart aige rochtain a fháil ar na sonraí arna dtáirgeadh agus arna gcur ar fáil ag an sealbhóir sonraí faoi choinníollacha rochtana sonraithe lena n-úsáid."
      },
      {
        "@language": "hr",
        "@value": "Fizička ili pravna osoba koja ima pravo pristupa podacima koje posjednik podataka izrađuje i stavlja na raspolaganje pod određenim uvjetima pristupa radi uporabe."
      },
      {
        "@language": "bg",
        "@value": "Физическо или юридическо лице, което има право на достъп до данните, създадени и предоставени от притежателя на данни при определени условия за достъп с цел използване."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Data recipient"
      },
      {
