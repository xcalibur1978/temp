      },
      {
        "@language": "da",
        "@value": "Regler for udstedelse og kontrol af billetter"
      },
      {
        "@language": "et",
        "@value": "Piletite väljaandmise ja kontrollimise reeglid"
      },
      {
        "@language": "fi",
        "@value": "Lippujen myöntämistä ja tarkastamista koskevat säännöt"
      },
      {
        "@language": "ga",
        "@value": "Rialacha maidir le heisiúint agus iniúchadh ticéad"
      },
      {
        "@language": "hr",
        "@value": "Pravila o izdavanju i kontroli karata"
      },
      {
        "@language": "lt",
        "@value": "Bilietų išdavimo ir tikrinimo taisyklės"
      },
      {
        "@language": "lv",
        "@value": "Biļešu izsniegšanas un kontroles noteikumi"
      },
      {
        "@language": "mt",
        "@value": "Regoli għall-ħruġ u l-kontroll tal-biljetti"
      },
      {
        "@language": "sk",
        "@value": "Pravidlá pre vydávanie a kontrolu cestovných lístkov"
      },
      {
        "@language": "sl",
        "@value": "Pravila za izdajo in nadzor vozovnic"
      },
      {
        "@language": "bg",
        "@value": "Правила за издаване и контрол на билети"
      }
