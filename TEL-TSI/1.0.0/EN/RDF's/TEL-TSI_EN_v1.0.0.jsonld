  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0084",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_20"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A process that is affected by the operation of a rail transport service across two or more networks managed by different infrastructure managers or operators of rail freight service facilities."
      },
      {
        "@language": "it",
        "@value": "Processo influenzato dall'esercizio di un servizio di trasporto ferroviario su due o più reti gestite da diversi gestori dell'infrastruttura o operatori di impianti di servizio per il trasporto ferroviario di merci."
      },
      {
        "@language": "nl",
        "@value": "Een proces dat wordt beïnvloed door de exploitatie van een spoorvervoersdienst over twee of meer netten die door verschillende infrastructuurbeheerders of exploitanten van spoorgoederenvervoersfaciliteiten worden beheerd."
      },
      {
        "@language": "pl",
        "@value": "Proces, na który ma wpływ wykonywanie przewozu kolejowego w obrębie dwóch lub większej liczby sieci zarządzanych przez różnych zarządców infrastruktury lub operatorów obiektów infrastruktury usługowej transportu towarowego."
      },
      {
        "@language": "pt",
        "@value": "Processo que é afetado pela exploração de um serviço de transporte ferroviário através de duas ou mais redes geridas por diferentes gestores de infraestrutura ou operadores de instalações de serviço de transporte ferroviário de mercadorias."
      },
      {
        "@language": "ro",
        "@value": "Proces care este afectat de exploatarea unui serviciu de transport feroviar pe două sau mai multe rețele gestionate de diferiți administratori de infrastructură sau operatori de instalații de servicii pentru transportul feroviar de marfă."
      },
      {
        "@language": "sv",
        "@value": "En process som påverkas av driften av en järnvägstransporttjänst över två eller flera nät som förvaltas av olika infrastrukturförvaltare eller verksamhetsutövare vid anläggningar för tjänster inom järnvägsgodstransport."
      },
      {
        "@language": "cs",
        "@value": "Proces, který je ovlivněn provozem služby železniční dopravy přes dvě nebo více sítí spravovaných různými provozovateli infrastruktury nebo provozovateli zařízení služeb v oblasti železniční nákladní dopravy."
      },
      {
        "@language": "de",
        "@value": "Ein Prozess, der durch den Betrieb eines Schienenverkehrsdienstes über zwei oder mehr Netze hinweg beeinflusst wird, die von verschiedenen Infrastrukturbetreibern oder Betreibern von Schienengüterverkehrsanlagen verwaltet werden."
      },
      {
        "@language": "es",
        "@value": "Proceso que se ve afectado por la explotación de un servicio de transporte ferroviario a través de dos o más redes gestionadas por diferentes administradores de infraestructuras u operadores de instalaciones de servicio de transporte ferroviario de mercancías."
      },
      {
        "@language": "fr",
        "@value": "Processus qui est affecté par l'exploitation d'un service de transport ferroviaire sur deux réseaux ou plus gérés par différents gestionnaires de l'infrastructure ou exploitants d'installations de service de fret ferroviaire."
      },
      {
        "@language": "hu",
        "@value": "Olyan folyamat, amelyet egy vasúti szállítási szolgáltatás két vagy több, különböző pályahálózat-működtetők vagy a vasúti árufuvarozási szolgáltatóhelyek üzemeltetői által kezelt hálózaton átívelő működése befolyásol."
      },
      {
        "@language": "hr",
        "@value": "Postupak na koji utječe obavljanje usluge željezničkog prijevoza na dvjema mrežama ili više njih kojima upravljaju različiti upravitelji infrastrukture ili operateri uslužnih objekata za željeznički prijevoz tereta."
      },
      {
        "@language": "lt",
        "@value": "Procesas, kuriam įtaką daro geležinkelių vežimo paslaugos teikimas dviejuose ar daugiau tinklų, kuriuos valdo skirtingi infrastruktūros valdytojai arba geležinkelių krovinių vežimo paslaugų įrenginių operatoriai."
      },
      {
        "@language": "lv",
        "@value": "Process, ko ietekmē dzelzceļa pārvadājuma pakalpojuma sniegšana divos vai vairākos tīklos, kurus pārvalda dažādi infrastruktūras pārvaldītāji vai dzelzceļa kravu pārvadājumu apkalpes vietu operatori."
      },
      {
        "@language": "mt",
        "@value": "Proċess li jiġi affettwat mit-tħaddim ta' servizz tat-trasport ferrovjarju fuq żewġ netwerks jew aktar ġestiti minn maniġers tal-infrastruttura jew operaturi tal-faċilitajiet tas-servizz għat-trasport ferrovjarju tal-merkanzija differenti."
      },
      {
        "@language": "sk",
        "@value": "Proces, ktorý je ovplyvnený prevádzkou služby železničnej dopravy cez dve alebo viaceré siete spravované rôznymi manažérmi infraštruktúry alebo prevádzkovateľmi zariadení služieb v oblasti železničnej nákladnej dopravy."
      },
      {
        "@language": "sl",
        "@value": "Postopek, na katerega vpliva izvajanje storitve železniškega prevoza po dveh ali več omrežjih, ki jih upravljajo različni upravljavci infrastrukture ali upravljavci objektov za izvajanje storitev v železniškem tovornem prometu."
      },
      {
        "@language": "da",
        "@value": "En proces, der påvirkes af driften af en jernbanetransporttjeneste på tværs af to eller flere net, der forvaltes af forskellige infrastrukturforvaltere eller operatører af jernbanegodsfaciliteter."
      },
      {
        "@language": "el",
        "@value": "Διαδικασία που επηρεάζεται από την εκτέλεση υπηρεσίας σιδηροδρομικής μεταφοράς σε δύο ή περισσότερα δίκτυα που τα διαχειρίζονται διαφορετικοί διαχειριστές υποδομής ή φορείς εκμετάλλευσης εγκαταστάσεων εξυπηρέτησης σιδηροδρομικών εμπορευμάτων."
      },
      {
        "@language": "et",
        "@value": "Protsess, mida mõjutab raudteeveoteenuse osutamine kahes või enamas võrgustikus, mida haldavad eri taristuettevõtjad või raudtee-kaubaveo teenindusrajatiste käitajad."
      },
      {
        "@language": "fi",
        "@value": "Prosessi, johon vaikuttaa rautatiekuljetuspalvelun liikennöinti kahdessa tai useammassa verkossa, joita hallinnoivat eri rataverkon haltijat tai rautateiden tavaraliikenteen palvelupaikkojen ylläpitäjät."
      },
      {
        "@language": "ga",
        "@value": "Próiseas a ndéanann oibriú seirbhíse iompair iarnróid difear dó thar dhá líonra nó níos mó arna mbainistiú ag bainisteoirí bonneagair éagsúla nó ag oibreoirí saoráidí seirbhíse le haghaidh iompar lasta iarnróid."
      },
      {
        "@language": "bg",
        "@value": "Процес, който е засегнат от извършването на услуга за железопътен превоз през две или повече мрежи, управлявани от различни управители на инфраструктура или оператори на обслужващи съоръжения за железопътен превоз на товари."
      }
    ],
