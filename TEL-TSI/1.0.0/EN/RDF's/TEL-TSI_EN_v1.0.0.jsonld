  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0103",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Data quality dimension expressing the degree to which there is no unwanted duplication of data."
      },
      {
        "@language": "el",
        "@value": "Διάσταση ποιότητας δεδομένων που εκφράζει τον βαθμό στον οποίο δεν υπάρχει ανεπιθύμητη επανάληψη δεδομένων."
      },
      {
        "@language": "it",
        "@value": "Dimensione della qualità dei dati che esprime il grado in cui non vi è duplicazione indesiderata di dati."
      },
      {
        "@language": "sv",
        "@value": "Datakvalitetsdimension som uttrycker i vilken grad det inte förekommer någon oönskad duplicering av data."
      },
      {
        "@language": "cs",
        "@value": "Rozměr kvality údajů vyjadřující míru, v jaké nedochází k nežádoucí duplicitě údajů."
      },
      {
        "@language": "es",
        "@value": "Dimensión de la calidad de los datos que expresa el grado en que no existe duplicación no deseada de datos."
      },
      {
        "@language": "fr",
        "@value": "Dimension de qualité des données exprimant le degré auquel il n'y a pas de duplication indésirable de données."
      },
      {
        "@language": "hu",
        "@value": "Adatminőségi dimenzió, amely azt fejezi ki, hogy milyen mértékben nincs nemkívánatos adatduplikáció."
      },
      {
        "@language": "nl",
        "@value": "Gegevenskwaliteitsdimensie die de mate uitdrukt waarin er geen ongewenste duplicatie van gegevens is."
      },
      {
        "@language": "pl",
        "@value": "Wymiar jakości danych wyrażający stopień, w jakim nie występuje niepożądane powielanie danych."
      },
      {
        "@language": "pt",
        "@value": "Dimensão da qualidade dos dados que exprime o grau em que não existe duplicação indesejada de dados."
      },
      {
        "@language": "ro",
        "@value": "Dimensiune a calității datelor care exprimă gradul în care nu există o duplicare nedorită a datelor."
      },
      {
        "@language": "de",
        "@value": "Datenqualitätsdimension, die den Grad ausdrückt, in dem keine unerwünschte Dopplung von Daten besteht."
      },
      {
        "@language": "sl",
        "@value": "Razsežnost kakovosti podatkov, ki izraža stopnjo, do katere ni neželenega podvajanja podatkov."
      },
      {
        "@language": "sk",
        "@value": "Rozmer kvality údajov vyjadrujúci mieru, v akej nedochádza k nežiaducej duplicite údajov."
      },
      {
        "@language": "bg",
        "@value": "Измерение на качеството на данните, изразяващо степента, в която няма нежелано дублиране на данни."
      },
      {
        "@language": "et",
        "@value": "Andmekvaliteedi mõõde, mis väljendab seda, mil määral ei esine soovimatut andmete dubleerimist."
      },
      {
        "@language": "fi",
        "@value": "Datan laadun ulottuvuus, joka ilmaisee, missä määrin datan ei-toivottua päällekkäisyyttä ei esiinny."
      },
      {
        "@language": "ga",
        "@value": "Gné de cháilíocht sonraí lena léirítear an méid nach bhfuil aon dúbailt neamh-inmhianaithe sonraí ann."
      },
      {
        "@language": "hr",
        "@value": "Dimenzija kvalitete podataka kojom se izražava stupanj u kojem nema neželjenog udvostručivanja podataka."
      },
      {
        "@language": "lt",
        "@value": "Duomenų kokybės aspektas, išreiškiantis, kokiu mastu nėra nepageidaujamo duomenų dubliavimo."
      },
      {
        "@language": "lv",
        "@value": "Datu kvalitātes dimensija, kas izsaka pakāpi, kādā nav nevēlamas datu dublēšanās."
      },
      {
        "@language": "mt",
        "@value": "Dimensjoni tal-kwalità tad-data li tesprimi l-grad sa fejn ma hemmx duplikazzjoni mhux mixtieqa tad-data."
      },
      {
        "@language": "da",
        "@value": "Datakvalitetsdimension, der udtrykker, i hvilken grad der ikke er uønsket dataduplikering."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Uniqueness (data quality dimension)"
      },
      {
        "@language": "cs",
        "@value": "Jedinečnost (rozměr kvality údajů)"
      },
      {
        "@language": "de",
        "@value": "Eindeutigkeit (Datenqualitätsdimension)"
      },
      {
        "@language": "el",
        "@value": "Μοναδικότητα (διάσταση ποιότητας δεδομένων)"
      },
      {
        "@language": "es",
        "@value": "Unicidad (dimensión de la calidad de los datos)"
      },
      {
        "@language": "fr",
        "@value": "Unicité (dimension de qualité des données)"
      },
      {
        "@language": "hu",
        "@value": "Egyediség (adatminőségi dimenzió)"
      },
      {
        "@language": "it",
        "@value": "Unicità (dimensione della qualità dei dati)"
      },
      {
        "@language": "nl",
        "@value": "Uniciteit (gegevenskwaliteitsdimensie)"
      },
      {
        "@language": "pl",
        "@value": "Niepowtarzalność (wymiar jakości danych)"
      },
      {
        "@language": "pt",
        "@value": "Unicidade (dimensão da qualidade dos dados)"
      },
      {
        "@language": "ro",
        "@value": "Unicitate (dimensiune a calității datelor)"
      },
      {
        "@language": "sv",
        "@value": "Unikhet (datakvalitetsdimension)"
      },
      {
        "@language": "da",
        "@value": "Entydighed (datakvalitetsdimension)"
      },
      {
        "@language": "et",
        "@value": "Unikaalsus (andmekvaliteedi mõõde)"
      },
      {
        "@language": "fi",
        "@value": "Ainutkertaisuus (datan laadun ulottuvuus)"
      },
      {
        "@language": "ga",
        "@value": "Uathúlacht (gné de cháilíocht sonraí)"
      },
      {
        "@language": "hr",
        "@value": "Jedinstvenost (dimenzija kvalitete podataka)"
      },
      {
        "@language": "lt",
        "@value": "Unikalumas (duomenų kokybės aspektas)"
      },
      {
        "@language": "lv",
        "@value": "Unikalitāte (datu kvalitātes dimensija)"
      },
      {
        "@language": "mt",
        "@value": "Uniċità (dimensjoni tal-kwalità tad-data)"
      },
      {
        "@language": "sk",
        "@value": "Jedinečnosť (rozmer kvality údajov)"
      },
      {
        "@language": "sl",
        "@value": "Enkratnost (razsežnost kakovosti podatkov)"
      },
      {
        "@language": "bg",
        "@value": "Уникалност (измерение на качеството на данните)"
      }
    ]
  },
  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0050",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "cs",
        "@value": "Zpráva předávající odpověď na žádost o dostupnost a rezervaci."
      },
      {
        "@language": "en",
        "@value": "Message conveying the response to an availability and reservation request."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Übermittlung der Antwort auf eine Verfügbarkeits- und Reservierungsanfrage."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που διαβιβάζει την απάντηση σε αίτηση διαθεσιμότητας και κράτησης."
      },
      {
        "@language": "es",
        "@value": "Mensaje que transmite la respuesta a una solicitud de disponibilidad y reserva."
      },
      {
        "@language": "fr",
        "@value": "Message transmettant la réponse à une demande de disponibilité et de réservation."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely egy rendelkezésre állási és foglalási kérelemre adott választ továbbít."
      },
      {
        "@language": "it",
        "@value": "Messaggio che trasmette la risposta a una richiesta di disponibilità e prenotazione."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat het antwoord op een beschikbaarheids- en reserveringsaanvraag doorgeeft."
      },
      {
        "@language": "pl",
        "@value": "Komunikat przekazujący odpowiedź na zapytanie o dostępność i rezerwację."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que transmite a resposta a um pedido de disponibilidade e reserva."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der overfører svaret på en anmodning om tilgængelighed og reservation."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega edastatakse vastus saadavuse ja broneerimise taotlusele."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla välitetään vastaus saatavuus- ja varauspyyntöön."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se prenosi odgovor na zahtjev za dostupnost i rezervaciju."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo perduodamas atsakymas į prieinamumo ir rezervacijos prašymą."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru nodod atbildi uz pieejamības un rezervācijas pieprasījumu."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jittrażmetti t-tweġiba għal talba għad-disponibbiltà u r-riżervazzjoni."
      },
      {
        "@language": "sk",
        "@value": "Správa prenášajúca odpoveď na žiadosť o dostupnosť a rezerváciu."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki posreduje odgovor na zahtevek za razpoložljivost in rezervacijo."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се предава отговорът на искане за наличност и резервация."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena ndéantar an freagra ar iarraidh ar infhaighteacht agus áirithint a tharchur."
      },
      {
        "@language": "ro",
