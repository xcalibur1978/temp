      },
      {
        "@language": "el",
        "@value": "Πληροφορίες σχετικά με τους διαδικτυακούς διαύλους πώλησης"
      },
      {
        "@language": "bg",
        "@value": "Информация за каналите за онлайн продажби"
      },
      {
        "@language": "da",
