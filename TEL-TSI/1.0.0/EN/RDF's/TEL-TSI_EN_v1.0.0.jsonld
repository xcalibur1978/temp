    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "hr",
        "@value": "Poruka kojom podnositelj zahtjeva od upravitelja infrastrukture zahtijeva infrastrukturni kapacitet (trasu vlaka), u skladu s ontologijom ERA-e."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo pareiškėjas prašo infrastruktūros valdytojo skirti infrastruktūros pajėgumą (traukinio trasą), laikantis ERA ontologijos."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih applikant jitlob kapaċità tal-infrastruttura (mogħdija tal-ferrovija) mingħand il-maniġer tal-infrastruttura, f'konformità mal-ontoloġija tal-ERA."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou žiadateľ žiada manažéra infraštruktúry o kapacitu infraštruktúry (trasu vlaku), v súlade s ontológiou agentúry ERA."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim prosilec pri upravljavcu infrastrukture zahteva infrastrukturno zmogljivost (vlakovno pot), v skladu z ontologijo agencije ERA."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla hakija pyytää infrastruktuurikapasiteettia (junareittiä) rataverkon haltijalta ERAn ontologian mukaisesti."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega taotleja taotleb taristuettevõtjalt taristu läbilaskevõimet (rongiliini) kooskõlas ERA ontoloogiaga."
      },
      {
        "@language": "en",
        "@value": "Message by which an applicant requests infrastructure capacity (a train path) from the infrastructure manager, in accordance with the ERA Ontology."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ένας αιτών ζητεί χωρητικότητα υποδομής (μια σιδηροδρομική διαδρομή) από τον διαχειριστή υποδομής, σύμφωνα με την οντολογία του ΟΣΕΕ."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care un solicitant cere capacitate de infrastructură (o trasă) administratorului de infrastructură, în conformitate cu ontologia AUE."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket en sökande ansöker om infrastrukturkapacitet (ett tågläge) hos infrastrukturförvaltaren, i enlighet med Eras ontologi."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou žadatel žádá provozovatele infrastruktury o kapacitu infrastruktury (trasu vlaku), v souladu s ontologií agentury ERA."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der ein Antragsteller Fahrwegkapazität (eine Zugtrasse) beim Infrastrukturbetreiber beantragt, im Einklang mit der ERA-Ontologie."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que un candidato solicita capacidad de infraestructura (un surco) al administrador de infraestructuras, de conformidad con la ontología de la ERA."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel un candidat demande une capacité d'infrastructure (un sillon) au gestionnaire de l'infrastructure, conformément à l'ontologie de l'ERA."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel egy kérelmező infrastruktúra-kapacitást (menetvonalat) igényel a pályahálózat-működtetőtől, az ERA ontológiájával összhangban."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui un richiedente chiede capacità di infrastruttura (una traccia) al gestore dell'infrastruttura, conformemente all'ontologia dell'ERA."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee een aanvrager infrastructuurcapaciteit (een treinpad) aanvraagt bij de infrastructuurbeheerder, in overeenstemming met de ERA-ontologie."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego wnioskodawca wnioskuje o zdolność przepustową infrastruktury (trasę) do zarządcy infrastruktury, zgodnie z ontologią ERA."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual um requerente solicita capacidade de infraestrutura (um canal horário) ao gestor de infraestrutura, em conformidade com a ontologia da AFE."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína n-iarrann iarratasóir acmhainn bonneagair (uaire traenach) ar an mbainisteoir bonneagair, i gcomhréir le honteolaíocht ERA."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed en ansøger ansøger om infrastrukturkapacitet (en togkanal) hos infrastrukturforvalteren, i overensstemmelse med ERA-ontologien."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru pieteikuma iesniedzējs pieprasa infrastruktūras pārvaldītājam infrastruktūras jaudu (vilciena ceļu) saskaņā ar ERA ontoloģiju."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което заявителят иска инфраструктурен капацитет (влаков маршрут) от управителя на инфраструктурата в съответствие с онтологията на ЖПА."
      }
    ],
