  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0020",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_11"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Message notifying an interruption to the running of a train."
      },
      {
        "@language": "cs",
        "@value": "Zpráva oznamující přerušení jízdy vlaku."
      },
      {
        "@language": "de",
        "@value": "Nachricht zur Meldung einer Unterbrechung des Zuglaufs."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα που γνωστοποιεί διακοπή της κυκλοφορίας ενός τρένου."
      },
      {
        "@language": "es",
        "@value": "Mensaje que notifica una interrupción de la circulación de un tren."
      },
      {
        "@language": "fr",
        "@value": "Message notifiant une interruption de la circulation d'un train."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amely értesítést küld egy vonat közlekedésének megszakításáról."
      },
      {
        "@language": "it",
        "@value": "Messaggio che notifica un'interruzione della circolazione di un treno."
      },
      {
        "@language": "nl",
        "@value": "Bericht dat een onderbreking van de treinloop meldt."
      },
      {
        "@language": "pl",
        "@value": "Komunikat powiadamiający o przerwaniu jazdy pociągu."
      },
      {
        "@language": "pt",
        "@value": "Mensagem que notifica uma interrupção da circulação de um comboio."
      },
      {
        "@language": "ro",
        "@value": "Mesaj care notifică o întrerupere a circulației unui tren."
      },
      {
        "@language": "sv",
        "@value": "Meddelande som anmäler ett avbrott i ett tågs föring."
      },
      {
        "@language": "bg",
        "@value": "Съобщение, с което се уведомява за прекъсване на движението на влак."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, der anmelder en afbrydelse af et togs drift."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega teatatakse rongiliikluse katkestamisest."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla ilmoitetaan junan liikennöinnin keskeytyksestä."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht lena gcuirtear cur isteach ar ghluaiseacht traenach in iúl."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom se obavješćuje o prekidu vožnje vlaka."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo pranešama apie traukinio eismo nutraukimą."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru paziņo par vilciena kustības pārtraukumu."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li jinnotifika interruzzjoni tal-moviment ta' ferrovija."
      },
      {
        "@language": "sk",
        "@value": "Správa oznamujúca prerušenie jazdy vlaku."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, ki obvešča o prekinitvi vožnje vlaka."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://github.com/NAPCORE/its-data-dictionary/tel-tsi"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
