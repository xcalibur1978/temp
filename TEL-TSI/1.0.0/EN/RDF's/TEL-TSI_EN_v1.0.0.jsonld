  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0008",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "bg",
        "@value": "Съобщение, с което управителят на инфраструктурата предоставя подробностите за влаков маршрут в отговор на искане в съответствие с онтологията на ЖПА."
      },
      {
        "@language": "cs",
        "@value": "Zpráva, kterou provozovatel infrastruktury poskytuje podrobnosti o trase v reakci na žádost, v souladu s ontologií agentury ERA."
      },
      {
        "@language": "de",
        "@value": "Nachricht, mit der der Infrastrukturbetreiber als Antwort auf eine Trassenanmeldung die Einzelheiten einer Trasse bereitstellt, im Einklang mit der ERA-Ontologie."
      },
      {
        "@language": "el",
        "@value": "Μήνυμα με το οποίο ο διαχειριστής υποδομής παρέχει τις λεπτομέρειες μιας διαδρομής σε απάντηση αίτησης, σύμφωνα με την οντολογία του ΟΣΕΕ."
      },
      {
        "@language": "es",
        "@value": "Mensaje por el que el administrador de infraestructuras facilita los detalles de un surco en respuesta a una solicitud, de conformidad con la ontología de la ERA."
      },
      {
        "@language": "fr",
        "@value": "Message par lequel le gestionnaire de l'infrastructure fournit les détails d'un sillon en réponse à une demande, conformément à l'ontologie de l'ERA."
      },
      {
        "@language": "hu",
        "@value": "Üzenet, amellyel a pályahálózat-működtető egy igénylésre válaszul megadja egy menetvonal részleteit, az ERA ontológiájával összhangban."
      },
      {
        "@language": "it",
        "@value": "Messaggio con cui il gestore dell'infrastruttura fornisce i dettagli di una traccia in risposta a una richiesta, conformemente all'ontologia dell'ERA."
      },
      {
        "@language": "nl",
        "@value": "Bericht waarmee de infrastructuurbeheerder de details van een pad verstrekt in antwoord op een padaanvraag, in overeenstemming met de ERA-ontologie."
      },
      {
        "@language": "pl",
        "@value": "Komunikat, za pomocą którego zarządca infrastruktury podaje szczegóły trasy w odpowiedzi na wniosek, zgodnie z ontologią ERA."
      },
      {
        "@language": "pt",
        "@value": "Mensagem pela qual o gestor de infraestrutura fornece os pormenores de um canal horário em resposta a um pedido, em conformidade com a ontologia da AFE."
      },
      {
        "@language": "ro",
        "@value": "Mesaj prin care administratorul de infrastructură furnizează detaliile unei trase ca răspuns la o cerere, în conformitate cu ontologia AUE."
      },
      {
        "@language": "sv",
        "@value": "Meddelande genom vilket infrastrukturförvaltaren lämnar uppgifterna om ett tågläge som svar på en ansökan, i enlighet med Eras ontologi."
      },
      {
        "@language": "lv",
        "@value": "Ziņojums, ar kuru infrastruktūras pārvaldītājs, atbildot uz pieprasījumu, sniedz ceļa detaļas saskaņā ar ERA ontoloģiju."
      },
      {
        "@language": "mt",
        "@value": "Messaġġ li bih il-maniġer tal-infrastruttura jipprovdi d-dettalji ta' mogħdija b'reazzjoni għal talba, f'konformità mal-ontoloġija tal-ERA."
      },
      {
        "@language": "sk",
        "@value": "Správa, ktorou manažér infraštruktúry poskytuje podrobnosti o trase ako odpoveď na žiadosť, v súlade s ontológiou agentúry ERA."
      },
      {
        "@language": "sl",
        "@value": "Sporočilo, s katerim upravljavec infrastrukture zagotovi podrobnosti vlakovne poti kot odgovor na zahtevek, v skladu z ontologijo agencije ERA."
      },
      {
        "@language": "en",
        "@value": "Message by which the infrastructure manager provides the details of a path in response to a path request, in accordance with the ERA Ontology."
      },
      {
        "@language": "et",
        "@value": "Sõnum, millega taristuettevõtja esitab taotlusele vastates rongiliini üksikasjad kooskõlas ERA ontoloogiaga."
      },
      {
        "@language": "fi",
        "@value": "Viesti, jolla rataverkon haltija toimittaa reitin yksityiskohdat vastauksena pyyntöön ERAn ontologian mukaisesti."
      },
      {
        "@language": "ga",
        "@value": "Teachtaireacht trína soláthraíonn an bainisteoir bonneagair sonraí uaire mar fhreagra ar iarraidh, i gcomhréir le honteolaíocht ERA."
      },
      {
        "@language": "hr",
        "@value": "Poruka kojom upravitelj infrastrukture dostavlja pojedinosti o trasi kao odgovor na zahtjev, u skladu s ontologijom ERA-e."
      },
      {
        "@language": "lt",
        "@value": "Pranešimas, kuriuo infrastruktūros valdytojas, atsakydamas į prašymą, pateikia trasos duomenis, laikantis ERA ontologijos."
      },
      {
        "@language": "da",
        "@value": "Meddelelse, hvormed infrastrukturforvalteren leverer detaljerne om en kanal som svar på en ansøgning, i overensstemmelse med ERA-ontologien."
      }
    ],
