  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0063",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_17"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Data establishing the conditions of carriage, decomposed for passengers, persons with reduced mobility (with rolling-stock and station accessibility), luggage, bicycles, and cars/motorcycles/boats."
      },
      {
        "@language": "cs",
        "@value": "Údaje stanovící přepravní podmínky, rozčleněné pro cestující, osoby se sníženou pohyblivostí (s přístupností kolejových vozidel a stanic), zavazadla, jízdní kola a automobily/motocykly/plavidla."
      },
      {
        "@language": "de",
        "@value": "Daten zur Festlegung der Beförderungsbedingungen, aufgegliedert für Fahrgäste, Personen mit eingeschränkter Mobilität (mit Zugänglichkeit von Fahrzeugen und Bahnhöfen), Gepäck, Fahrräder sowie Autos/Motorräder/Boote."
      },
      {
        "@language": "el",
        "@value": "Δεδομένα που καθορίζουν τους όρους μεταφοράς, αναλυμένα για τους επιβάτες, τα άτομα με μειωμένη κινητικότητα (με την προσβασιμότητα του τροχαίου υλικού και των σταθμών), τις αποσκευές, τα ποδήλατα και τα αυτοκίνητα/μοτοσικλέτες/σκάφη."
      },
      {
        "@language": "es",
        "@value": "Datos que establecen las condiciones de transporte, desglosadas para los viajeros, las personas con movilidad reducida (con la accesibilidad del material rodante y de las estaciones), el equipaje, las bicicletas y los automóviles/motocicletas/embarcaciones."
      },
      {
        "@language": "fr",
        "@value": "Données établissant les conditions de transport, décomposées pour les voyageurs, les personnes à mobilité réduite (avec l'accessibilité du matériel roulant et des gares), les bagages, les vélos et les voitures/motos/bateaux."
      },
      {
        "@language": "hu",
        "@value": "Olyan adatok, amelyek megállapítják a fuvarozási feltételeket, az utasokra, a csökkent mozgásképességű személyekre (a gördülőállomány és az állomások akadálymentességével), a poggyászra, a kerékpárokra, valamint a gépjárművekre/motorkerékpárokra/hajókra bontva."
      },
      {
        "@language": "it",
        "@value": "Dati che stabiliscono le condizioni di trasporto, scomposte per passeggeri, persone a mobilità ridotta (con l'accessibilità del materiale rotabile e delle stazioni), bagagli, biciclette e automobili/motocicli/imbarcazioni."
      },
      {
        "@language": "nl",
        "@value": "Gegevens die de vervoersvoorwaarden vaststellen, uitgesplitst voor reizigers, personen met beperkte mobiliteit (met toegankelijkheid van rollend materieel en stations), bagage, fietsen en auto's/motorfietsen/boten."
      },
      {
        "@language": "pt",
        "@value": "Dados que estabelecem as condições de transporte, decompostas para os passageiros, as pessoas com mobilidade reduzida (com a acessibilidade do material circulante e das estações), a bagagem, as bicicletas e os automóveis/motociclos/embarcações."
      },
      {
        "@language": "ro",
        "@value": "Date care stabilesc condițiile de transport, descompuse pentru călători, persoane cu mobilitate redusă (cu accesibilitatea materialului rulant și a stațiilor), bagaje, biciclete și autoturisme/motociclete/ambarcațiuni."
      },
      {
        "@language": "sv",
        "@value": "Uppgifter som fastställer befordringsvillkoren, uppdelade för resenärer, personer med nedsatt rörlighet (med tillgänglighet till rullande materiel och stationer), bagage, cyklar och bilar/motorcyklar/båtar."
      },
      {
        "@language": "fi",
        "@value": "Tiedot, joilla vahvistetaan kuljetusehdot eriteltyinä matkustajien, liikuntarajoitteisten henkilöiden (mukaan lukien liikkuvan kaluston ja asemien esteettömyys), matkatavaroiden, polkupyörien sekä autojen/moottoripyörien/veneiden osalta."
      },
      {
        "@language": "ga",
        "@value": "Sonraí lena mbunaítear na coinníollacha iompair, arna miondealú do phaisinéirí, do dhaoine a bhfuil a soghluaisteacht laghdaithe (le hinrochtaineacht an rothstoic agus na stáisiún), do bhagáiste, do rothair agus do charranna/ghluaisrothair/bháid."
      },
      {
        "@language": "hr",
        "@value": "Podaci kojima se utvrđuju uvjeti prijevoza, razrađeni za putnike, osobe smanjene pokretljivosti (s pristupačnošću željezničkih vozila i kolodvora), prtljagu, bicikle te automobile/motocikle/plovila."
      },
      {
        "@language": "lt",
        "@value": "Duomenys, kuriais nustatomos vežimo sąlygos, suskirstytos pagal keleivius, riboto judumo asmenis (su riedmenų ir stočių prieinamumu), bagažą, dviračius ir automobilius/motociklus/laivus."
      },
      {
        "@language": "lv",
        "@value": "Dati, ar kuriem nosaka pārvadāšanas noteikumus, sadalīti attiecībā uz pasažieriem, personām ar ierobežotām pārvietošanās spējām (ar ritošā sastāva un staciju piekļūstamību), bagāžu, velosipēdiem un automobiļiem/motocikliem/laivām."
      },
      {
        "@language": "mt",
        "@value": "Data li tistabbilixxi l-kundizzjonijiet tat-trasport, maqsuma għall-passiġġieri, il-persuni b'mobbiltà mnaqqsa (bl-aċċessibbiltà tal-vetturi ferrovjarji u tal-istazzjonijiet), il-bagalji, ir-roti u l-karozzi/muturi/dgħajjes."
      },
      {
        "@language": "pl",
        "@value": "Dane określające warunki przewozu, rozłożone na pasażerów, osoby o ograniczonej możliwości poruszania się (z dostępnością taboru i stacji), bagaż, rowery oraz samochody/motocykle/łodzie."
      },
      {
        "@language": "sk",
        "@value": "Údaje stanovujúce prepravné podmienky, rozčlenené pre cestujúcich, osoby so zníženou pohyblivosťou (s prístupnosťou koľajových vozidiel a staníc), batožinu, bicykle a automobily/motocykle/plavidlá."
      },
      {
        "@language": "sl",
        "@value": "Podatki, ki določajo prevozne pogoje, razčlenjeni za potnike, osebe z zmanjšano mobilnostjo (z dostopnostjo tirnih vozil in postaj), prtljago, kolesa ter avtomobile/motorna kolesa/plovila."
      },
      {
        "@language": "da",
        "@value": "Data, der fastlægger befordringsbetingelserne, opdelt for passagerer, personer med nedsat mobilitet (med tilgængelighed af rullende materiel og stationer), bagage, cykler og biler/motorcykler/både."
      },
      {
        "@language": "et",
        "@value": "Andmed, millega kehtestatakse veotingimused, mis on jaotatud reisijate, piiratud liikumisvõimega isikute (koos veeremi ja jaamade juurdepääsetavusega), pagasi, jalgrataste ning autode/mootorrataste/paatide kaupa."
      },
      {
        "@language": "bg",
        "@value": "Данни, с които се установяват условията за превоз, разбити за пътници, лица с намалена подвижност (с достъпността на подвижния състав и гарите), багаж, велосипеди и автомобили/мотоциклети/плавателни съдове."
      }
    ],
