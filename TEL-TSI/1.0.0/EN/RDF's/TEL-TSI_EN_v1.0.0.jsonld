  {
    "@id": "https://gegevenscatalogus.gov/tel-tsi/concept-0077",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "http://data.europa.eu/eli/reg_impl/2026/253/oj#art_3.pnt_4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "pt",
        "@value": "Serviço personalizado relativo a um serviço de transporte ferroviário de passageiros, associado a uma tarifa."
      },
      {
        "@language": "sv",
        "@value": "En skräddarsydd tjänst som avser en persontrafiktjänst på järnväg och som är kopplad till en tariff."
      },
      {
        "@language": "en",
        "@value": "A tailored service in relation to a passenger rail transport service linked to a tariff."
      },
      {
        "@language": "cs",
        "@value": "Služba na míru týkající se služby železniční přepravy cestujících, spojená s tarifem."
      },
      {
        "@language": "de",
        "@value": "Eine maßgeschneiderte Dienstleistung in Bezug auf einen Schienenpersonenverkehrsdienst, die mit einem Tarif verknüpft ist."
      },
      {
        "@language": "el",
        "@value": "Εξατομικευμένη υπηρεσία σχετική με υπηρεσία σιδηροδρομικής μεταφοράς επιβατών, συνδεδεμένη με τιμολόγιο."
      },
      {
        "@language": "es",
        "@value": "Servicio a medida relacionado con un servicio de transporte ferroviario de viajeros, vinculado a una tarifa."
      },
      {
        "@language": "fr",
        "@value": "Service sur mesure lié à un service de transport ferroviaire de voyageurs, associé à un tarif."
      },
      {
        "@language": "hu",
        "@value": "Vasúti személyszállítási szolgáltatáshoz kapcsolódó, tarifához kötött, személyre szabott szolgáltatás."
      },
      {
        "@language": "it",
        "@value": "Servizio su misura relativo a un servizio di trasporto ferroviario di passeggeri, collegato a una tariffa."
      },
      {
        "@language": "nl",
        "@value": "Een op maat gemaakte dienst met betrekking tot een spoorvervoersdienst voor reizigers, gekoppeld aan een tarief."
      },
      {
        "@language": "pl",
        "@value": "Dostosowana usługa związana z kolejowym przewozem pasażerskim, powiązana z taryfą."
      },
      {
        "@language": "ro",
        "@value": "Serviciu personalizat referitor la un serviciu de transport feroviar de călători, asociat unui tarif."
      },
      {
        "@language": "et",
        "@value": "Kohandatud teenus, mis on seotud raudteereisijateveoteenusega ja seotud tariifiga."
      },
      {
        "@language": "da",
        "@value": "En skræddersyet tjeneste i forbindelse med en jernbanepassagertransporttjeneste, der er knyttet til en tarif."
      },
      {
        "@language": "sl",
        "@value": "Prilagojena storitev v zvezi s storitvijo železniškega potniškega prevoza, povezana s tarifo."
      },
      {
        "@language": "ga",
        "@value": "Seirbhís shaincheaptha a bhaineann le seirbhís iompair iarnróid do phaisinéirí, a bhfuil baint aici le taraif."
      },
      {
        "@language": "hr",
        "@value": "Prilagođena usluga povezana s uslugom željezničkog prijevoza putnika, povezana s tarifom."
      },
      {
        "@language": "lt",
        "@value": "Pritaikyta paslauga, susijusi su geležinkelių keleivių vežimo paslauga ir susieta su tarifu."
      },
      {
        "@language": "lv",
        "@value": "Pielāgots pakalpojums saistībā ar dzelzceļa pasažieru pārvadājumu pakalpojumu, kas saistīts ar tarifu."
      },
      {
        "@language": "mt",
        "@value": "Servizz imfassal apposta marbut ma' servizz tat-trasport ferrovjarju tal-passiġġieri, assoċjat ma' tariffa."
      },
      {
        "@language": "sk",
        "@value": "Služba na mieru týkajúca sa služby železničnej osobnej dopravy, spojená s tarifou."
      },
      {
        "@language": "bg",
        "@value": "Персонализирана услуга, свързана с услуга за железопътен превоз на пътници, обвързана с тарифа."
      },
      {
        "@language": "fi",
        "@value": "Räätälöity palvelu, joka liittyy rautateiden henkilöliikennepalveluun ja on yhdistetty tariffiin."
      }
    ],
