  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235874098">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Vehicle Type</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Voertuigtype</skos:prefLabel>
    <skos:definition xml:lang="nl">Classificatie van een voertuig op basis van de wettelijke indeling in het RVV 1990 en het Voertuigreglement. 

Relevant voor snelheidsbeperkingen omdat de wet bijzondere maximumsnelheden per voertuigcategorie vaststelt.</skos:definition>
    <skos:example xml:lang="nl">T-100 bus mag maximaal 100 km/h</skos:example>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/collections/geometrisch">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Geometrisch</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geometrisch</skos:prefLabel>
    <skos:memberList rdf:nodeID="N5e78ade1a6364123b562c9364b603024"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5dd89e350e824caab5da7451cad06625">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235385932"/>
    <rdf:rest rdf:nodeID="Nffacdbc5ca03488c80283532c135ad11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238916868">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Speed Limit Data Type</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gegevenstype Snelheidsbeperkingen</skos:prefLabel>
    <skos:definition xml:lang="nl">Gegevenstype binnen de RTTI-context dat de verzameling van concepten beschrijft die nodig zijn om een snelheidsbeperking op het Nederlandse wegennet eenduidig vast te leggen en uit te wisselen. Omvat de waarde van de snelheidsbeperking, de locatie, de geldigheid, de aanduiding en eventuele uitzonderingen.</skos:definition>
    <skos:scopeNote xml:lang="nl">Dit gegevenstype is gedefinieerd als onderdeel van de Nederlandse implementatie van de ITS-richtlijn (Richtlijn 2010/40/EU) en de daaronder vallende Gedelegeerde Verordening RTTI (EU) 2022/670.</skos:scopeNote>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N52c9615819a246e6974a134facbebe02">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235164125"/>
    <rdf:rest rdf:nodeID="N2ce6532a1ec242a19fae82cac744b65a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235313383">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Expressway</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Autoweg</skos:prefLabel>
    <skos:definition xml:lang="nl">Weg, aangeduid door bord G3. Buiten de bebouwde kom geldt op autowegen een wettelijke maximumsnelheid van 100 km/h voor motorvoertuigen tenzij anders aangegeven.

Op autowegen mogen uitsluitend motorvoertuigen rijden die minimaal 50 km/h kunnen en mogen rijden.</skos:definition>
    <skos:scopeNote xml:lang="nl">Langs autowegen gelegen parkeerplaatsen, tankstations en bushalteplaatsen maken geen deel van de autoweg uit.</skos:scopeNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N59bd04a37a584c60962d8ef59027a51a">
