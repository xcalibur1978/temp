  <rdf:Description rdf:nodeID="N966821f3e7de4e1882fed1a2ca5fcfb2">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"/>
    <rdf:rest rdf:nodeID="N9d1de1d9f445422aa9cdd7556bdca782"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236355335">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Digital Sign</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Digitaal bord</skos:prefLabel>
    <skos:definition xml:lang="nl">Elektronisch signaleringsbord waarop verkeersborden dynamisch kunnen worden weergegeven. Een digitaal bord kan een lagere snelheid aangeven dan het statische ('blikken') bord; in dat geval geldt de lagere snelheid van het digitale bord. Pas wanneer het digitale bord een einde-aanduiding toont of blanco is, herleeft de snelheidsbeperking van het statische bord. Digitale borden worden met name ingezet op autosnelwegen via matrixsignalering (RWS).</skos:definition>
    <skos:scopeNote xml:lang="nl">Het digitale bord heeft een hogere geldigheid indien een digitaal bord een lagere snelheid aan dan de blikken borden.

Pas als als het digitale bord een einde aanduiding aangeeft, dan geld het blikken bord in. 

"Zie het als een digitale zone"</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/collections/snelheidsbeperking-borden">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Snelheidsbeperking borden</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Snelheidsbeperking borden</skos:prefLabel>
    <skos:memberList rdf:nodeID="Ncbe0984a106c4ea0936ec012811ec788"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235085917">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Road section</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegvak</skos:prefLabel>
    <skos:definition xml:lang="en">Nog bepalen</skos:definition>
    <skos:definition xml:lang="nl">Gedeelte van een weg tussen twee opeenvolgende knooppunten of kruispunten, of – indien geen zijweg aanwezig is – tussen twee punten waarop een verkeersmaatregel betrekking heeft. 

In het Nationaal Wegenbestand (NWB) is een wegvak de kleinste eenheid waarvoor wegkenmerken worden geregistreerd.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb40c4e1fa41444a991a60ac9a07c2f67">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236355335"/>
    <rdf:rest rdf:nodeID="N1fd7e5a23c4e47e1835a4d6ab68b19c9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2ae73d2033b84003a8749c2def871176">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395"/>
    <rdf:rest rdf:nodeID="N8394de40918a4491ad8447f74dbeb2be"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238610163">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">A Sign</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">A bord</skos:prefLabel>
    <skos:definition xml:lang="nl">Het verkeersbord A1 geeft een maximumsnelheid aan; bord A2 duidt het einde van een maximumsnelheid aan. De plaatsing van A-borden voor snelheidslimieten geschiedt krachtens een verkeersbesluit. Op A-borden kan de snelheid zonaal worden toegepast met zone-indicatie (bijv. A01-30-ZB).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186214125">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="nl">Rijrichting</skos:prefLabel>
    <skos:definition xml:lang="nl">De richting waarin het verkeer zich op een rijbaan of rijstrook voortbeweegt. Relevant voor snelheidsbeperkingen waar een beperking slechts geldt voor één rijrichting, bijv. bij gescheiden rijbanen of bij borden die aan één zijde van de weg zijn geplaatst.</skos:definition>
    <skos:scopeNote xml:lang="nl">Er is bepaalt dat de toepassing van verkeersborden kan worden beperkt tot rijstroken, wat impliceert dat richting van belang is.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nde458c67c9cf42c2a9cf1dd8dba97a98">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235237134"/>
    <rdf:rest rdf:nodeID="N7ebac1d8b3d8458abdc9d8ac13df30d9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235331951">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Motorway</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Autosnelweg</skos:prefLabel>
    <skos:definition xml:lang="nl">Weg, aangeduid door bord G1. Buiten de bebouwde kom geldt op autosnelwegen een wettelijke maximumsnelheid van 130 km/h voor motorvoertuigen tenzij anders aangegeven.

Op autosnelwegen mogen uitsluitend motorvoertuigen rijden die minimaal 60 km/h kunnen en mogen rijden.</skos:definition>
    <skos:scopeNote xml:lang="nl">Langs autosnelwegen gelegen parkeerplaatsen, tankstations en bushalteplaatsen maken geen deel van de autosnelweg uit.</skos:scopeNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236446358">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Condition</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Conditie</skos:prefLabel>
    <skos:definition xml:lang="nl">Een conditie waardoor de standaard snelheidsbeperking op een wegvak wordt gemodificeerd. Uitzonderingen worden in de Nederlandse praktijk kenbaar gemaakt via onderborden en kunnen betrekking hebben op voertuigtype, tijdvenster, weersomstandigheden of andere voorwaarden.</skos:definition>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236028582"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186160984"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nccd082aa3fe24b0fa9a71e645a7928d8">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186160984"/>
    <rdf:rest rdf:nodeID="Neb109be92c7c4998ab3393039c300913"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne78230aae2e744049013566c370e58e5">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236446358"/>
    <rdf:rest rdf:nodeID="Nccd082aa3fe24b0fa9a71e645a7928d8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9d1de1d9f445422aa9cdd7556bdca782">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238916868"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236028582">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Weather Conditions</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Weersomstandigheden</skos:prefLabel>
    <skos:definition xml:lang="nl">Meteorologische condities (zoals regen, mist, sneeuw, ijzel of storm) die aanleiding geven tot een aangepaste snelheidsbeperking. 
In Nederland worden weersafhankelijke snelheidsbeperkingen met name dynamisch ingesteld via matrixsignalering op autosnelwegen (RWS – Praktijkrichtlijn Dynamisch Verkeersmanagement) of statisch aangegeven via onderborden (bijv. 'bij nat wegdek').</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7ebac1d8b3d8458abdc9d8ac13df30d9">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235874098"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772187859423">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="nl">N-weg</skos:prefLabel>
    <skos:definition xml:lang="nl">Het gebied buiten de door de gemeenteraad vastgestelde bebouwde kom. Buiten de bebouwde kom gelden de maximumsnelheden  130 km/h op autosnelwegen, 100 km/h op autowegen en 80 km/h op overige wegen, tenzij door verkeersborden anders is aangegeven.</skos:definition>
    <skos:editorialNote xml:lang="nl">Is dit een goede toevoeging voor 'rest categorie'? RobS: RVV noemt dit "andere wegen" https://wetten.overheid.nl/jci1.3:c:BWBR0004825&amp;hoofdstuk=II&amp;paragraaf=8&amp;artikel=21&amp;z=2026-01-01&amp;g=2026-01-01</skos:editorialNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186695677"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771857141294">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">L401 Sign</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">L401 bord</skos:prefLabel>
    <skos:definition xml:lang="nl">Informatie bord om mensen te informeren over de verkeersregels.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na248b1c2d0b84d17897d398de2f17eb5">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235022627"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235638908">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Lane</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Rijstrook</skos:prefLabel>
    <skos:definition xml:lang="nl">Door doorgetrokken of onderbroken strepen gemarkeerd gedeelte van de rijbaan van zodanige breedte dat bestuurders van motorvoertuigen op meer dan twee wielen daarvan gebruik kunnen maken. 

Bij toepassing van een verkeersbord op specifieke rijstroken kan een snelheidsbeperking beperkt worden tot één of meer rijstroken.
Bijvoorbeeld bij spitsstroken of matrixborden.</skos:definition>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186214125"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235085917"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8394de40918a4491ad8447f74dbeb2be">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236944308"/>
    <rdf:rest rdf:nodeID="N52c9615819a246e6974a134facbebe02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235164125">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Residential Area</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Woonerf</skos:prefLabel>
    <skos:definition xml:lang="en">Nog bepalen</skos:definition>
    <skos:definition xml:lang="nl">Een als erf aangeduid deel van de openbare weg, begrensd door bord G5 (begin erf) en bord G6 (einde erf). Op een erf geldt een maximumsnelheid van 15 km/h.</skos:definition>
    <skos:scopeNote xml:lang="nl">HR 1 november 2011, ECLI:NL:HR:2011:BR5927; voorheen 'stapvoets'</skos:scopeNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236090614">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Start Indication</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Aanduiding begin</skos:prefLabel>
    <skos:definition xml:lang="nl">Het verkeersteken dat het beginpunt aangeeft van de geldigheid van een snelheidsbeperking.</skos:definition>
    <skos:scopeNote xml:lang="nl">Dit kan zijn: een bord A1 (maximumsnelheid) of een zonebord (bijv. A01-30-ZB voor begin 30 km/h-zone), een bord G1/G3/G5 (begin autosnelweg/autoweg/erf), of de activering van een elektronisch signaleringsbord.</skos:scopeNote>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236172013"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/collections/zonale-snelheidsbeperking">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#OrderedCollection"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Zonale snelheidsbeperking</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Zonale snelheidsbeperking</skos:prefLabel>
    <skos:memberList rdf:nodeID="N9c8684a7f94748d9ab0112083e67064e"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e78ade1a6364123b562c9364b603024">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236944308"/>
    <rdf:rest rdf:nodeID="N98f96f37e9224f2d93175a93d63761bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236944308">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Built-Up Area</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Bebouwde kom</skos:prefLabel>
    <skos:definition xml:lang="nl">Het gebied dat als bebouwde kom is vastgesteld door de gemeenteraad.

De bebouwde kom wordt aangeduid door de borden H1 (begin bebouwde kom) en H2 (einde bebouwde kom). De snelheidsbeperking van 50 km/h is van toepassing tenzij door verkeersborden anders is aangegeven.</skos:definition>
    <skos:broader rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186704395"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N22cf9329c8744e659084abd881c35c7b">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235313383"/>
    <rdf:rest rdf:nodeID="N38fb8913cb324601b2585e56a6b7e356"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Geometry</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Geometrie</skos:prefLabel>
    <skos:definition xml:lang="nl">Een ruimtelijk afgebakend gebied waarbinnen een uniform verkeersregime geldt, begrensd door verkeerstekens die het begin en het einde van het regime aanduiden. 

Binnen de context van snelheidsbeperkingen is een gesloten zone een gebied waarvan de grenzen worden gemarkeerd door zoneborden (bijv. bord A01-30-ZB / A01-30-ZE voor een 30 km/h-zone, of bord G5/G6 voor een erf).</skos:definition>
    <skos:scopeNote xml:lang="nl">Het BABW art. 9 bepaalt dat in een verkeersbesluit kan worden bepaald dat geboden of verboden gelden in een bepaald gebied (zonale toepassing).</skos:scopeNote>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236142216"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236090614"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nee5a4e9bc26e4884927f913e9a23ac02">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236090614"/>
    <rdf:rest rdf:nodeID="N213b7b2a12824371a2d42bee3534fc0e"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N213b7b2a12824371a2d42bee3534fc0e">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237259923"/>
    <rdf:rest rdf:nodeID="Na248b1c2d0b84d17897d398de2f17eb5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5a1f5e0709ce453884364b603d5ffe9a">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237259923"/>
    <rdf:rest rdf:nodeID="N7118b4e4112144f6b2a2fb8751c0f15c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9c8684a7f94748d9ab0112083e67064e">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771237797860"/>
    <rdf:rest rdf:nodeID="N2ae73d2033b84003a8749c2def871176"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nafee63e91d734841a3d689e814d0752d">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771238610163"/>
    <rdf:rest rdf:nodeID="Nf5d9a3ac95ae451f9092c1fd3cc024ab"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N38fb8913cb324601b2585e56a6b7e356">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772187859423"/>
    <rdf:rest rdf:nodeID="N3810ca13d95f46df84cdf5aaf319bb2c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neb109be92c7c4998ab3393039c300913">
    <rdf:first rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771236028582"/>
    <rdf:rest rdf:nodeID="N59bd04a37a584c60962d8ef59027a51a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235620358">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen"/>
    <skos:prefLabel xml:lang="en">Carriageway</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Rijbaan</skos:prefLabel>
    <skos:definition xml:lang="nl">Elk voor rijdend verkeer bestemd weggedeelte, met uitzondering van de fietspaden en de fiets/bromfietspaden.</skos:definition>
    <skos:scopeNote xml:lang="nl">In het kader van snelheidsbeperkingen kan een aanduiding specifiek betrekking hebben op één rijbaan van een weg.</skos:scopeNote>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1772186214125"/>
    <skos:related rdf:resource="https://gegevenscatalogus.gov/rtti-snelheidsbeperkingen/concept-1771235638908"/>
  </rdf:Description>
