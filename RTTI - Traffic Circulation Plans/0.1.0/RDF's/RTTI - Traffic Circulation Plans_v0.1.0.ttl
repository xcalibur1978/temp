    skos:prefLabel "Related dynamic data"@en,
        "Gerelateerde dynamische gegevens"@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/collection-maatregelen> a skos:OrderedCollection ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:memberList ( <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-04> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-06> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-07> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-08> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-09> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-10> ) ;
    skos:prefLabel "Permanent circulation measures"@en,
        "Permanente circulatiemaatregelen"@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/collection-plankader> a skos:OrderedCollection ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:memberList ( <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-03> ) ;
    skos:prefLabel "Plan and framework"@en,
        "Plan en kader"@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/collection-zones> a skos:OrderedCollection ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:memberList ( <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-13> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14> <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-15> ) ;
    skos:prefLabel "Regulated traffic zones (UVAR)"@en,
        "Gereglementeerde verkeerszones (UVAR)"@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-1781184487446> a skos:Concept,
        dqv:Metric ;
    skos:definition "The reliability for datasets or data items"@en,
        "De betrouwbaarheid van een dataset of data items"@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Reliability"@en,
        "Betrouwbaarhied"@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-16> a skos:Concept ;
    dct:source "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:definition "Dynamic information disseminating the closure of road links of any type, which may be directional and either planned or unplanned."@en ;
    skos:editorialNote "Dynamisch gegeven; gekoppeld via skos:related aan het top-concept (geen broader)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Road closure"@en,
        "Wegafsluiting"@nl ;
    skos:related <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01> ;
    skos:scopeNote "Dynamisch (state-of-network) gegeven; daarom gerelateerd aan, niet ondergeschikt aan, het circulatieplan. Canonieke uitwerking in het zusterschema sluitingen van wegen."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-03> a skos:Concept ;
    dct:source "https://github.com/NAPCORE/its-data-dictionary",
        "https://inspire.ec.europa.eu/theme/tn" ;
    skos:altLabel "FRC"@en ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01> ;
    skos:definition "Classification of road links according to the importance of each road link within the road network (its functional role), as distinct from the physical form of way."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/INSPIRE)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Functional road classification"@en,
        "Functionele wegclassificatie"@nl ;
    skos:scopeNote "Door POLIS gepositioneerd als basis van een circulatieplan: 'a Traffic Circulation Plan consists of the Functional Road Classification, potentially supplemented with additional data'. Bronmodellen: INSPIRE Transport Networks en DATEX II."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-04> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/trafficregulation/index.html",
        "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Eenrichtingsverkeer"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "Road segments where traffic is allowed to move in only one direction."@en ;
    skos:editorialNote "Concept-niveau skos:closeMatch naar het eenrichtingsverkeer-schema toevoegen zodra de concept-IRI's bevestigd zijn; nu via rdfs:seeAlso op schemaniveau."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "One-way street"@en,
        "Eenrichtingsweg"@nl ;
    skos:scopeNote "In de Annex van (EU) 2022/670 opgesomd gegevenstype. Het kerngegeven in NL is het NWB-attribuut Rijrichting (muteerbaar via George). Canonieke uitwerking in het zusterschema eenrichtingsverkeer."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-06> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/trafficregulation/index.html",
        "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "Regulations indicating the direction that vehicles should travel on lanes where the direction is changeable based on traffic needs or time of day."@en ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Direction of travel on reversible lanes"@en,
        "Rijrichting op omkeerbare rijstroken"@nl ;
    skos:scopeNote "In de Annex van (EU) 2022/670 opgesomd gegevenstype. Technisch model: DATEX II DirectionRestriction."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-07> a skos:Concept ;
    dct:source "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "Permanent legal or physical restrictions or limitations on vehicles to access a specific road link of any type."@en ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Permanent access restriction"@en,
        "Permanente toegangsbeperking"@nl ;
    skos:scopeNote "In de Annex van (EU) 2022/670 opgesomd gegevenstype. Canonieke uitwerking in het zusterschema permanente toegangsbeperkingen."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-08> a skos:Concept ;
    dct:source "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "Regulations for delivering freight, such as the designation of certain road links or areas, loading or unloading permissions or prohibitions, and time-related restrictions."@en ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Freight delivery regulation"@en,
        "Goederenleveringsregeling"@nl ;
    skos:scopeNote "In de Annex van (EU) 2022/670 opgesomd gegevenstype. Canonieke uitwerking in het zusterschema goederenlevering (incl. UVAR/venstertijden)."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-09> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/trafficregulation/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "A location- and time-conditioned traffic restriction applied within a traffic circulation plan, such as restricting through traffic during school hours."@en ;
    skos:editorialNote "Definitie best-effort (afgeleid van NAPCORE-voorbeeldtekst), niet normatief."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "School zone / time-based restriction"@en,
        "Schoolzone- en tijdgebonden beperking"@nl ;
    skos:scopeNote "Afgeleid van het NAPCORE-voorbeeld bij het circulatieplan (schoolzones). Technisch model: DATEX II ValidityCondition/Condition."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-10> a skos:Concept ;
    dct:source "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Knip"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "A point on a road that prevents through motor traffic while allowing cyclists and pedestrians to pass, used as a measure within a traffic circulation plan."@en ;
    skos:editorialNote "Definitie best-effort (gangbaar vakbegrip / Wikipedia), indicatief en niet normatief."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Modal filter"@en,
        "Modale filter"@nl ;
    skos:scopeNote "Veelgebruikte circulatieplanmaatregel ('knip'). Geen normatieve EU-bron."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Zero-emissiezone"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> ;
    skos:definition "An area where access by the most polluting vehicles is restricted or deterred to improve air quality; one of the urban vehicle access regulation (UVAR) types."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II UVAR-profielen)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Low-emission zone"@en,
        "Milieuzone"@nl ;
    skos:scopeNote "UVAR-type onder de gereglementeerde verkeerszone. Technisch model: DATEX II ControlledZone/UVARBox."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> ;
    skos:definition "An area where vehicle access is restricted to authorised users or to specific conditions; one of the urban vehicle access regulation (UVAR) types."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II UVAR-profielen)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Limited traffic zone"@en,
        "Beperkt toegankelijke zone"@nl ;
    skos:scopeNote "UVAR-type onder de gereglementeerde verkeerszone."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-13> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Voetgangersgebied"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> ;
    skos:definition "An area reserved primarily for pedestrians where general motor traffic is prohibited or restricted; one of the urban vehicle access regulation (UVAR) types."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II UVAR-profielen)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Pedestrian zone"@en,
        "Voetgangerszone"@nl ;
    skos:scopeNote "UVAR-type onder de gereglementeerde verkeerszone."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Tolzone"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> ;
    skos:definition "An area where a charge is levied on vehicles in order to manage congestion; one of the urban vehicle access regulation (UVAR) types."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II UVAR-profielen)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Congestion charging zone"@en,
        "Congestieheffingszone"@nl ;
    skos:scopeNote "UVAR-type onder de gereglementeerde verkeerszone."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-15> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> ;
    skos:definition "An area subject to specific parking regulations or charges; one of the urban vehicle access regulation (UVAR) types."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II UVAR-profielen)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:prefLabel "Parking zone"@en,
        "Parkeerzone"@nl ;
    skos:scopeNote "UVAR-type onder de gereglementeerde verkeerszone."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01> a skos:Concept ;
    dct:source "http://data.europa.eu/eli/dir/2023/2661/oj",
        "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "TCP"@en ;
    skos:definition "The minimum information required for disseminating and describing the content of plans that are developed by local authorities to control and guide traffic flows in response to known and recurring traffic conditions as well as in consideration of seasonality effects and existing limitation and constraints (e.g. existence of school zones)."@en ;
    skos:editorialNote "Definitie verbatim uit de NAPCORE ITS Data Dictionary (indicatief). De regulatoire definitie wordt door POLIS gemeld als art. 2(21) van (EU) 2022/670; verifieer tegen de geconsolideerde EUR-Lex-tekst. De operationele mijlpaal voor digitalisering (~2028) en notificatie (31-12-2028) komen uit het POLIS-rapport (indicatief)."@nl ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:narrower <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02>,
        <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-03> ;
    skos:prefLabel "Traffic circulation plan"@en,
        "Verkeerscirculatieplan"@nl ;
    skos:scopeNote "Prioritair (cruciaal) gegevenstype onder Gedelegeerde Verordening (EU) 2022/670, art. 7(4): bestaande circulatieplannen van bevoegde autoriteiten moeten digitaal en machineleesbaar via het nationaal toegangspunt (NL: NTM, beheerd door NDW) beschikbaar worden gesteld. Statisch/duurzaam van aard en te onderscheiden van het scenario-gestuurde verkeersmanagementplan (TMP)."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/controlledzone/index.html",
        "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "UVAR zone"@en ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> ;
    skos:definition "Defined areas with specific traffic rules, including restricted access zones, their boundaries, and the current rules or conditions for vehicles entering these zones."@en ;
    skos:inScheme <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6> ;
    skos:narrower <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11>,
        <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12>,
        <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-13>,
        <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14>,
        <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-15> ;
    skos:prefLabel "Regulated traffic zone"@en,
        "Gereglementeerde verkeerszone"@nl ;
    skos:scopeNote "Annex-formulering: 'boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones'. Technisch model: DATEX II ControlledZone (UVARBox, CEN/TS 16157-11). Canonieke uitwerking in het zusterschema gereglementeerde verkeerszones."@nl .

<https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02> a skos:Concept ;
    dct:source "https://docs.datex2.eu/v3.6/trafficregulation/index.html",
        "https://eur-lex.europa.eu/eli/reg_del/2022/670/oj",
        "https://github.com/NAPCORE/its-data-dictionary" ;
    skos:altLabel "Verkeersregel"@nl ;
    skos:broader <https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01> ;
    skos:definition "Machine-interpretable rules and restrictions that control vehicle or pedestrian movement on the road network to ensure safety and traffic efficiency."@en ;
    skos:editorialNote "Definitie indicatief (NAPCORE/DATEX II)."@nl ;
