  <rdf:Description rdf:nodeID="N4e397c812f264e8cb45fc81f784211fa">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01"/>
    <rdf:rest rdf:nodeID="N1b2fb8e45cf4482d88c3bc4c7f5f9da4"/>
