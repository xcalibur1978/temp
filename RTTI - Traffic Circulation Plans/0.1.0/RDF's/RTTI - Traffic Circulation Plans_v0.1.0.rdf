  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title xml:lang="en">RTTI — Traffic Circulation Plans</dct:title>
    <dct:title xml:lang="nl">RTTI — Verkeerscirculatieplannen</dct:title>
    <dct:description xml:lang="en">SKOS concept scheme for the priority data type 'traffic circulation plan' under Delegated Regulation (EU) 2022/670 (RTTI), supplementing ITS Directive 2010/40/EU as amended by Directive (EU) 2023/2661. The plan-level concept is the single top concept; constituent regulation and zone concepts are arranged beneath it. Definitions follow the authoritative source wording (legally enumerated data types are normative per the Annex of (EU) 2022/670; prose definitions from the NAPCORE ITS Data Dictionary are indicative). Concepts that have a canonical home in a sibling RTTI scheme are referenced via rdfs:seeAlso rather than duplicated.</dct:description>
    <dct:description xml:lang="nl">test</dct:description>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-04T17:56:24.678942+00:00</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-11T13:31:49.975582+00:00</dct:modified>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5289e6146dc740409255666869b29e6c">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
    <rdf:rest rdf:nodeID="N47f3b39093974d31a12ce3dcc57d4291"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4653670420e248248e2b9ca451b5bf86">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-08"/>
    <rdf:rest rdf:nodeID="Nf5779d0d47ab4408b4172a824db39c88"/>
