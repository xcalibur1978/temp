<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-06">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Direction of travel on reversible lanes</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Rijrichting op omkeerbare rijstroken</skos:prefLabel>
    <skos:definition xml:lang="en">Regulations indicating the direction that vehicles should travel on lanes where the direction is changeable based on traffic needs or time of day.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de Annex van (EU) 2022/670 opgesomd gegevenstype. Technisch model: DATEX II DirectionRestriction.</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/v3.6/trafficregulation/index.html</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-10">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Modal filter</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Modale filter</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Knip</skos:altLabel>
    <skos:definition xml:lang="en">A point on a road that prevents through motor traffic while allowing cyclists and pedestrians to pass, used as a measure within a traffic circulation plan.</skos:definition>
    <skos:scopeNote xml:lang="nl">Veelgebruikte circulatieplanmaatregel ('knip'). Geen normatieve EU-bron.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie best-effort (gangbaar vakbegrip / Wikipedia), indicatief en niet normatief.</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-15">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Parking zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Parkeerzone</skos:prefLabel>
    <skos:definition xml:lang="en">An area subject to specific parking regulations or charges; one of the urban vehicle access regulation (UVAR) types.</skos:definition>
    <skos:scopeNote xml:lang="nl">UVAR-type onder de gereglementeerde verkeerszone.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II UVAR-profielen).</skos:editorialNote>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N78a9484d5a974d65b7be6b6505846373">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-10"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-1781184487446">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/dqv#Metric"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="nl">Betrouwbaarhied</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Reliability</skos:prefLabel>
    <skos:definition xml:lang="nl">De betrouwbaarheid van een dataset of data items</skos:definition>
    <skos:definition xml:lang="en">The reliability for datasets or data items</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Regulated traffic zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Gereglementeerde verkeerszone</skos:prefLabel>
    <skos:altLabel xml:lang="en">UVAR zone</skos:altLabel>
    <skos:definition xml:lang="en">Defined areas with specific traffic rules, including restricted access zones, their boundaries, and the current rules or conditions for vehicles entering these zones.</skos:definition>
    <skos:scopeNote xml:lang="nl">Annex-formulering: 'boundaries of restrictions, prohibitions or obligations with zonal validity, current access status and conditions for circulation in regulated traffic zones'. Technisch model: DATEX II ControlledZone (UVARBox, CEN/TS 16157-11). Canonieke uitwerking in het zusterschema gereglementeerde verkeerszones.</skos:scopeNote>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-15"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-13"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-09">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">School zone / time-based restriction</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Schoolzone- en tijdgebonden beperking</skos:prefLabel>
    <skos:definition xml:lang="en">A location- and time-conditioned traffic restriction applied within a traffic circulation plan, such as restricting through traffic during school hours.</skos:definition>
    <skos:scopeNote xml:lang="nl">Afgeleid van het NAPCORE-voorbeeld bij het circulatieplan (schoolzones). Technisch model: DATEX II ValidityCondition/Condition.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie best-effort (afgeleid van NAPCORE-voorbeeldtekst), niet normatief.</skos:editorialNote>
    <dct:source>https://docs.datex2.eu/v3.6/trafficregulation/index.html</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N47f3b39093974d31a12ce3dcc57d4291">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11"/>
    <rdf:rest rdf:nodeID="Nd19bb9f5ce224f1fb7b3687a85e95619"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Congestion charging zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Congestieheffingszone</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Tolzone</skos:altLabel>
    <skos:definition xml:lang="en">An area where a charge is levied on vehicles in order to manage congestion; one of the urban vehicle access regulation (UVAR) types.</skos:definition>
    <skos:scopeNote xml:lang="nl">UVAR-type onder de gereglementeerde verkeerszone.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II UVAR-profielen).</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-04">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">One-way street</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Eenrichtingsweg</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Eenrichtingsverkeer</skos:altLabel>
    <skos:definition xml:lang="en">Road segments where traffic is allowed to move in only one direction.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de Annex van (EU) 2022/670 opgesomd gegevenstype. Het kerngegeven in NL is het NWB-attribuut Rijrichting (muteerbaar via George). Canonieke uitwerking in het zusterschema eenrichtingsverkeer.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Concept-niveau skos:closeMatch naar het eenrichtingsverkeer-schema toevoegen zodra de concept-IRI's bevestigd zijn; nu via rdfs:seeAlso op schemaniveau.</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/trafficregulation/index.html</dct:source>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-03">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Functional road classification</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Functionele wegclassificatie</skos:prefLabel>
    <skos:altLabel xml:lang="en">FRC</skos:altLabel>
    <skos:definition xml:lang="en">Classification of road links according to the importance of each road link within the road network (its functional role), as distinct from the physical form of way.</skos:definition>
    <skos:scopeNote xml:lang="nl">Door POLIS gepositioneerd als basis van een circulatieplan: 'a Traffic Circulation Plan consists of the Functional Road Classification, potentially supplemented with additional data'. Bronmodellen: INSPIRE Transport Networks en DATEX II.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/INSPIRE).</skos:editorialNote>
    <dct:source>https://inspire.ec.europa.eu/theme/tn</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Limited traffic zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Beperkt toegankelijke zone</skos:prefLabel>
    <skos:definition xml:lang="en">An area where vehicle access is restricted to authorised users or to specific conditions; one of the urban vehicle access regulation (UVAR) types.</skos:definition>
    <skos:scopeNote xml:lang="nl">UVAR-type onder de gereglementeerde verkeerszone.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II UVAR-profielen).</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-07">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Permanent access restriction</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Permanente toegangsbeperking</skos:prefLabel>
    <skos:definition xml:lang="en">Permanent legal or physical restrictions or limitations on vehicles to access a specific road link of any type.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de Annex van (EU) 2022/670 opgesomd gegevenstype. Canonieke uitwerking in het zusterschema permanente toegangsbeperkingen.</skos:scopeNote>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3121c3b7401a42819fc1116f404ff853">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-16"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Traffic regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Verkeersregulatie</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Verkeersregel</skos:altLabel>
    <skos:definition xml:lang="en">Machine-interpretable rules and restrictions that control vehicle or pedestrian movement on the road network to ensure safety and traffic efficiency.</skos:definition>
    <skos:scopeNote xml:lang="nl">Overkoepelende categorie voor de in de Annex van (EU) 2022/670 opgesomde regulaties en beperkingen die samen een circulatieplan vormen. Technisch model: DATEX II TrafficRegulation (EN 16157 / CEN/TS 16157-11).</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II).</skos:editorialNote>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/trafficregulation/index.html</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-09"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-08"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-07"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-06"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-04"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-10"/>
  </rdf:Description>
