  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-16">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Road closure</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Wegafsluiting</skos:prefLabel>
    <skos:definition xml:lang="en">Dynamic information disseminating the closure of road links of any type, which may be directional and either planned or unplanned.</skos:definition>
    <skos:scopeNote xml:lang="nl">Dynamisch (state-of-network) gegeven; daarom gerelateerd aan, niet ondergeschikt aan, het circulatieplan. Canonieke uitwerking in het zusterschema sluitingen van wegen.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Dynamisch gegeven; gekoppeld via skos:related aan het top-concept (geen broader).</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <skos:related rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4cc5e419dfb84e34b3ef87440b92ecf1">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-14"/>
    <rdf:rest rdf:nodeID="N5d755f54785144c98f4a67bf729d315c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N814609a589a2492d880e9c559b71fdaf">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-07"/>
    <rdf:rest rdf:nodeID="N4653670420e248248e2b9ca451b5bf86"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-01">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Traffic circulation plan</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Verkeerscirculatieplan</skos:prefLabel>
    <skos:altLabel xml:lang="en">TCP</skos:altLabel>
    <skos:definition xml:lang="en">The minimum information required for disseminating and describing the content of plans that are developed by local authorities to control and guide traffic flows in response to known and recurring traffic conditions as well as in consideration of seasonality effects and existing limitation and constraints (e.g. existence of school zones).</skos:definition>
    <skos:scopeNote xml:lang="nl">Prioritair (cruciaal) gegevenstype onder Gedelegeerde Verordening (EU) 2022/670, art. 7(4): bestaande circulatieplannen van bevoegde autoriteiten moeten digitaal en machineleesbaar via het nationaal toegangspunt (NL: NTM, beheerd door NDW) beschikbaar worden gesteld. Statisch/duurzaam van aard en te onderscheiden van het scenario-gestuurde verkeersmanagementplan (TMP).</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie verbatim uit de NAPCORE ITS Data Dictionary (indicatief). De regulatoire definitie wordt door POLIS gemeld als art. 2(21) van (EU) 2022/670; verifieer tegen de geconsolideerde EUR-Lex-tekst. De operationele mijlpaal voor digitalisering (~2028) en notificatie (31-12-2028) komen uit het POLIS-rapport (indicatief).</skos:editorialNote>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>http://data.europa.eu/eli/dir/2023/2661/oj</dct:source>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
    <skos:narrower rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-03"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-08">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Freight delivery regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Goederenleveringsregeling</skos:prefLabel>
    <skos:definition xml:lang="en">Regulations for delivering freight, such as the designation of certain road links or areas, loading or unloading permissions or prohibitions, and time-related restrictions.</skos:definition>
    <skos:scopeNote xml:lang="nl">In de Annex van (EU) 2022/670 opgesomd gegevenstype. Canonieke uitwerking in het zusterschema goederenlevering (incl. UVAR/venstertijden).</skos:scopeNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://eur-lex.europa.eu/eli/reg_del/2022/670/oj</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-02"/>
  </rdf:Description>
