  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-13">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Pedestrian zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Voetgangerszone</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Voetgangersgebied</skos:altLabel>
    <skos:definition xml:lang="en">An area reserved primarily for pedestrians where general motor traffic is prohibited or restricted; one of the urban vehicle access regulation (UVAR) types.</skos:definition>
    <skos:scopeNote xml:lang="nl">UVAR-type onder de gereglementeerde verkeerszone.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II UVAR-profielen).</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-11">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6"/>
    <skos:prefLabel xml:lang="en">Low-emission zone</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Milieuzone</skos:prefLabel>
    <skos:altLabel xml:lang="nl">Zero-emissiezone</skos:altLabel>
    <skos:definition xml:lang="en">An area where access by the most polluting vehicles is restricted or deterred to improve air quality; one of the urban vehicle access regulation (UVAR) types.</skos:definition>
    <skos:scopeNote xml:lang="nl">UVAR-type onder de gereglementeerde verkeerszone. Technisch model: DATEX II ControlledZone/UVARBox.</skos:scopeNote>
    <skos:editorialNote xml:lang="nl">Definitie indicatief (NAPCORE/DATEX II UVAR-profielen).</skos:editorialNote>
    <dct:source>https://github.com/NAPCORE/its-data-dictionary</dct:source>
    <dct:source>https://docs.datex2.eu/v3.6/controlledzone/index.html</dct:source>
    <skos:broader rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-05"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd19bb9f5ce224f1fb7b3687a85e95619">
    <rdf:first rdf:resource="https://xcalibur1978.github.io/temp/id/460df05c-6ddc-4bbf-b868-b606870a4cc6/concept-12"/>
    <rdf:rest rdf:nodeID="N8c460376b7654dcba19f9ce125aad6f3"/>
  </rdf:Description>
